// Small building blocks shared by the Stone, Light and Checks tabs: a section header, a
// labelled block with an optional info button, a number field, a labelled slider and a
// picker row, and a radio mark.
//
// Everything reuses the shell's tokens and components; the verdict colors are the theme's
// success / warning / error roles (`Theme.verdict-*`).
import { Slider } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { Icons } from "../../icons.slint";
import { Icon } from "../../shell/icon.slint";
import { StateLayer } from "../../shell/state_layer.slint";
import { InfoButton } from "../../shell/info.slint";
import { PropsModel } from "props_model.slint";

// A section title: small, primary colored, with the page's side padding.
export component SectionHeader inherits Rectangle {
    in property <string> text;

    height: 40px;

    Text {
        x: Theme.space-lg;
        width: parent.width - 2 * Theme.space-lg;
        height: parent.height;
        text: root.text;
        color: Theme.primary;
        font-size: Theme.text-label-large;
        font-weight: 600;
        vertical-alignment: bottom;
        overflow: elide;
        accessible-role: AccessibleRole.text;
    }
}

// A titled block: the title (and the current value, and an info button when `info-body`
// is set), then the control below it. Put the control in as the child.
export component SettingBlock inherits VerticalLayout {
    in property <string> title;
    in property <string> value-text: "";
    // The explanation behind the info button; empty hides the button.
    in property <string> info-body: "";

    padding-left: Theme.space-lg;
    padding-right: Theme.space-lg;
    padding-top: Theme.space-xs;
    padding-bottom: Theme.space-xs;
    spacing: Theme.space-xs;

    HorizontalLayout {
        spacing: Theme.space-sm;

        Text {
            text: root.title;
            color: Theme.on-surface;
            font-size: Theme.text-body-large;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        if root.value-text != "": Text {
            text: root.value-text;
            color: Theme.primary;
            font-size: Theme.text-body-large;
            font-weight: 500;
            vertical-alignment: center;
        }

        if root.info-body != "": InfoButton {
            info-title: root.title;
            info-body: root.info-body;
        }
    }

    @children
}

// A tap-to-edit field for a number. Bind `text` two-way to the model; a tap opens the
// keypad sheet (`NumberSheet`, hosted by the tab) and `committed` fires with the new text
// when its "OK" or "Clear Value" is pressed. Give every field a unique `key`: the sheet
// reports back to the field it was opened for. (The system keyboard cannot be asked for
// a numeric layout, so no `LineEdit`.)
export component NumberField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: "";
    in property <string> unit: "";
    in property <bool> enabled: true;
    // Unique among all fields; names the field the keypad sheet is open for.
    in property <string> key;
    // The title of the keypad sheet; the placeholder when empty.
    in property <string> caption: "";
    // Whether the sheet offers "Clear Value" (a blank text means "not set").
    in property <bool> clearable: true;
    callback committed(string);

    property <int> commit-serial: PropsModel.number-serial;

    min-height: 56px;
    opacity: root.enabled ? 1.0 : Theme.disabled-content;
    accessible-role: AccessibleRole.button;
    accessible-label: (root.caption != "" ? root.caption : root.placeholder) + ", " + (root.text != "" ? root.text : "not set");
    accessible-enabled: root.enabled;
    accessible-action-default => {
        root.begin-edit();
    }

    changed commit-serial => {
        if (root.key != "" && PropsModel.number-key == root.key) {
            root.text = PropsModel.number-text;
            root.committed(root.text);
        }
    }

    function begin-edit() {
        if (root.enabled) {
            PropsModel.open-number(root.key, root.caption != "" ? root.caption : root.placeholder, root.unit, root.text, root.clearable);
        }
    }

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: Theme.row-height - Theme.space-sm;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: Theme.outline;

        StateLayer {
            pressed: touch.pressed;
            hovered: touch.has-hover;
            enabled: root.enabled;
            border-radius: parent.border-radius;
        }

        HorizontalLayout {
            padding-left: Theme.space-md;
            padding-right: Theme.space-md;
            spacing: Theme.space-sm;

            Text {
                text: root.text != "" ? root.text : root.placeholder;
                color: root.text != "" ? Theme.on-surface : Theme.on-surface-variant;
                font-size: Theme.text-body-large;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }

            if root.unit != "": Text {
                text: root.unit;
                color: Theme.on-surface-variant;
                font-size: Theme.text-body-large;
                vertical-alignment: center;
            }
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.begin-edit();
        }
    }
}

// A titled slider. Bind `value` two-way to the model; `released` fires when the finger
// lifts (or a key step ends), so a drag is one change, not hundreds.
export component SliderBlock inherits SettingBlock {
    in-out property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <float> step: 0.01;
    in property <bool> enabled: true;
    callback released();

    Slider {
        value <=> root.value;
        minimum: root.minimum;
        maximum: root.maximum;
        step: root.step;
        enabled: root.enabled;
        min-height: Theme.touch;
        accessible-label: root.title;

        released(v) => {
            root.released();
        }
    }
}

// A row of a picker list: the name, a second line, and a check mark on the chosen one.
// Fixed 64 px high so the list can virtualize.
export component PickerRow inherits Rectangle {
    in property <string> title;
    in property <string> detail: "";
    in property <bool> selected: false;
    callback clicked();

    height: 64px;
    accessible-role: AccessibleRole.button;
    accessible-label: root.detail == "" ? root.title : root.title + ", " + root.detail;
    accessible-checkable: true;
    accessible-checked: root.selected;

    StateLayer {
        pressed: touch.pressed;
        hovered: touch.has-hover;
    }

    HorizontalLayout {
        padding-left: Theme.space-lg;
        padding-right: Theme.space-lg;
        spacing: Theme.space-lg;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;

            Text {
                text: root.title;
                color: Theme.on-surface;
                font-size: Theme.text-body-large;
                overflow: elide;
            }

            if root.detail != "": Text {
                text: root.detail;
                color: Theme.on-surface-variant;
                font-size: Theme.text-body;
                overflow: elide;
            }
        }

        if root.selected: Rectangle {
            width: 24px;

            Icon {
                source: Icons.check;
                tint: Theme.primary;
            }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.outline-variant;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// A selectable row with a title and a wrapped description, and a trailing slot (put a
// `RadioMark` in it). At least the shared list row height (56 px) and always tall enough
// for its text, so the title and description of one row never touch the next row: the
// shell `ListRow` keeps its minimum height even when its description wraps, which is why
// this row measures its own content.
export component PresetRow inherits Rectangle {
    in property <string> title;
    in property <string> detail: "";
    in property <bool> enabled: true;
    callback clicked();

    height: max(Theme.row-height, content.preferred-height);
    opacity: root.enabled ? 1.0 : Theme.disabled-content;
    accessible-role: AccessibleRole.button;
    accessible-label: root.detail == "" ? root.title : root.title + ", " + root.detail;
    accessible-enabled: root.enabled;

    StateLayer {
        pressed: touch.pressed;
        hovered: touch.has-hover;
        enabled: root.enabled;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }

    content := HorizontalLayout {
        padding-left: Theme.space-lg;
        padding-right: Theme.space-lg;
        padding-top: Theme.space-sm;
        padding-bottom: Theme.space-sm;
        spacing: Theme.space-lg;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 2px;

            Text {
                text: root.title;
                color: Theme.on-surface;
                font-size: Theme.text-body-large;
                overflow: elide;
            }

            if root.detail != "": Text {
                text: root.detail;
                color: Theme.on-surface-variant;
                font-size: Theme.text-body;
                wrap: word-wrap;
            }
        }

        HorizontalLayout {
            alignment: end;
            cross-axis-alignment: center;
            spacing: Theme.space-sm;
            @children
        }
    }
}

// One metric: its name and value on one line, what it means below (wrapped). Measures its
// own content like `PresetRow`. `dimmed` greys numbers that are out of date.
export component MetricLine inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> meaning;
    in property <bool> dimmed: false;

    height: max(Theme.row-height, body.preferred-height);
    opacity: root.dimmed ? Theme.disabled-content : 1.0;
    accessible-role: AccessibleRole.text;
    accessible-label: root.label + ", " + root.value + ". " + root.meaning;

    body := VerticalLayout {
        padding-left: Theme.space-lg;
        padding-right: Theme.space-lg;
        padding-top: Theme.space-sm;
        padding-bottom: Theme.space-sm;
        spacing: 2px;
        alignment: center;

        HorizontalLayout {
            spacing: Theme.space-sm;

            Text {
                text: root.label;
                color: Theme.on-surface;
                font-size: Theme.text-body-large;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }

            Text {
                text: root.value;
                color: Theme.primary;
                font-size: Theme.text-body-large;
                font-weight: 600;
                vertical-alignment: center;
            }
        }

        Text {
            text: root.meaning;
            color: Theme.on-surface-variant;
            font-size: Theme.text-body;
            wrap: word-wrap;
        }
    }
}

// The radio mark at the end of a lighting-rig row.
export component RadioMark inherits Rectangle {
    in property <bool> checked: false;

    width: 20px;
    height: 20px;
    border-radius: 10px;
    border-width: 2px;
    border-color: root.checked ? Theme.primary : Theme.outline;

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        background: root.checked ? Theme.primary : transparent;
    }
}
