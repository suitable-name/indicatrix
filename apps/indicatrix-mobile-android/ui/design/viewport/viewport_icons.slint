// The icons only the Design page and its viewport use (the shell's own are in
// `ui/icons.slint`). Same 24x24 black line style; `Icon` recolors them.
export global ViewportIcons {
    out property <image> undo: @image-url("icons/undo.svg");
    out property <image> redo: @image-url("icons/redo.svg");
}
