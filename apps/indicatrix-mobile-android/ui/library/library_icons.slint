// The icons only the Library page uses (the shell's own are in `ui/icons.slint`). Same
// 24x24 black line style; `Icon` recolors them.
export global LibraryIcons {
    out property <image> grid: @image-url("icons/grid.svg");
    out property <image> list: @image-url("icons/list.svg");
    out property <image> sort: @image-url("icons/sort.svg");
    out property <image> filter: @image-url("icons/filter.svg");
    out property <image> search: @image-url("icons/search.svg");
    out property <image> tag: @image-url("icons/tag.svg");
    out property <image> trash: @image-url("icons/trash.svg");
    out property <image> hide: @image-url("icons/hide.svg");
    out property <image> select-all: @image-url("icons/select-all.svg");
}
