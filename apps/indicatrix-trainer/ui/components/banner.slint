import { Button } from "std-widgets.slint";
import { TrainerTheme } from "../theme.slint";

// A one-line banner. `kind`: 0 = info, 1 = warning, 2 = error.
export component Banner inherits Rectangle {
    in property <string> message;
    in property <int> kind: 0;
    in property <string> action_text;
    in property <string> action_tip;
    in property <bool> dismissible: true;
    // An optional second button after the action (empty hides it) and the dismiss button's label.
    in property <string> secondary_text;
    in property <string> secondary_tip;
    in property <string> dismiss_text: "Dismiss";
    callback action();
    callback secondary();
    callback dismiss();

    private property <color> tone: root.kind == 2 ? TrainerTheme.sev-error
        : root.kind == 1 ? TrainerTheme.sev-warning : TrainerTheme.accent-primary;

    height: 40px;
    background: root.kind == 2 ? TrainerTheme.tint-error
        : root.kind == 1 ? TrainerTheme.tint-warning : TrainerTheme.tint-info;
    border-radius: TrainerTheme.radius-small;
    border-width: 1px;
    border-color: root.tone.with-alpha(0.6);

    accessible-role: text;
    accessible-label: (root.kind == 2 ? "Error: " : root.kind == 1 ? "Warning: " : "Notice: ") + root.message;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 10px;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 4px;
                height: 20px;
                border-radius: 2px;
                background: root.tone;
            }
        }
        Text {
            text: root.message;
            color: TrainerTheme.text-primary;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.action_text != "": VerticalLayout {
            alignment: center;
            Button {
                text: root.action_text;
                primary: true;
                accessible-label: root.action_text;
                clicked => { root.action(); }
                if root.action_tip != "": Tooltip { text: @markdown("\{root.action_tip}"); }
            }
        }
        if root.secondary_text != "": VerticalLayout {
            alignment: center;
            Button {
                text: root.secondary_text;
                accessible-label: root.secondary_text;
                clicked => { root.secondary(); }
                if root.secondary_tip != "": Tooltip { text: @markdown("\{root.secondary_tip}"); }
            }
        }
        if root.dismissible: VerticalLayout {
            alignment: center;
            Button {
                text: root.dismiss_text;
                accessible-label: root.dismiss_text == "Dismiss" ? "Dismiss this message" : root.dismiss_text;
                clicked => { root.dismiss(); }
            }
        }
    }
}
