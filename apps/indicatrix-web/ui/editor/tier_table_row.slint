import { Theme } from "../components/theme.slint";
import { GuideModel } from "../models/guide_model.slint";
import { TableStyle } from "tier_table_style.slint";
import { TierRowData, TierTableModel } from "tier_table_model.slint";
import { TierAngleCell } from "tier_table_angle_cell.slint";

// The column widths, shared by the header and every row so they can never drift apart.
// NAME and INDICES stretch (with a minimum); everything else is fixed. The row's natural
// width can exceed a narrow dock: the table's `ScrollView` then scrolls horizontally, and
// the header follows it (`TierTable`).
export global Columns {
    out property <length> hash-width: 26px;
    out property <length> warn-width: 16px;
    out property <length> block-width: 20px;
    out property <length> angle-width: 96px;
    out property <length> name-min: 64px;
    out property <length> indices-min: 64px;
    out property <length> meets-width: 66px;
    out property <length> mast-width: 48px;
    out property <length> solve-width: 84px;
    out property <length> margin-width: 48px;
    out property <length> orbit-width: 56px;
    out property <length> adopt-width: 46px;
    out property <length> pin-width: 30px;
    out property <length> detach-width: 52px;
    out property <length> anchor-width: 54px;
    out property <length> move-width: 18px;
    out property <length> dup-width: 20px;
    out property <length> remove-width: 20px;
}

// A small action chip inside a cell (Adopt, Pin, Detach, Add Anchor, ...). `enabled` is
// false while the guided walkthrough locks the tier table: the chip dims, ignores clicks and
// its tooltip says why.
component CellButton inherits Rectangle {
    in property <string> text;
    in property <color> accent: Theme.accent-cyan;
    in property <string> hint;
    in property <length> font-size: 10px;
    in property <bool> enabled: true;
    callback clicked();
    opacity: root.enabled ? 1.0 : 0.4;
    background: touch.has-hover && root.enabled ? Theme.primary-glow : Theme.bg-card-hover;
    border-radius: 3px;
    Text {
        text: root.text;
        font-size: root.font-size;
        font-weight: 600;
        color: root.accent;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    if root.hint != "" || !root.enabled: Tooltip { text: root.enabled ? @markdown("\{root.hint}") : @markdown("\{GuideModel.locked-hint}"); }
}

// One row of the tier table, modelled on the desktop's `tier_table_row.slint`: multi-select
// check / row number, manufacturability badge, block letter (a click flips a 0-degree
// facet's side), the inline-editable angle, name, indices, what the tier meets, the solved
// mast, the solve-strategy badge, the critical-angle margin, the orbit badge ("Complete
// orbit" when amber), Adopt / Pin / Detach / Add Anchor chips and the row's move,
// duplicate and delete buttons.
//
// Problem tints: ruby for a tier the solver could not place (no anchor yet / blocked /
// a failed strategy), amber for a tier with a manufacturability warning. Both sit under
// the selection highlight.
export component TierTableRow inherits Rectangle {
    // Named `item`, not `row`: `row` is a reserved `GridLayout` cell-placement property.
    in property <TierRowData> item;
    in property <bool> table-focused: false;
    in property <bool> select-mode: false;
    in property <int> inline-edit-target: -1;
    in property <int> inline-edit-pulse: 0;
    callback request-focus-return();

    // False while the guided walkthrough locks the tier table's actions: the row still
    // selects, but its edit / adopt / pin / move / duplicate / delete controls do nothing.
    property <bool> unlocked: GuideModel.allows-tier-table();
    property <bool> selected: root.item.index == TierTableModel.selected-index;
    property <bool> problem: root.item.needs-anchor || root.item.strategy == "blocked" || root.item.strategy == "no anchor yet" || root.item.strategy == "FAILED (untrusted)";
    property <bool> visible-in-filter: TierTableModel.filter-text == ""
        || TierTableModel.matches-filter(
            root.item.name + " " + root.item.indices + " " + root.item.block + " " + root.item.strategy + " " + root.item.constraint-text,
            TierTableModel.filter-text);

    height: TableStyle.row-height;
    // Dimmed (not removed) when it fails the filter, so the arrow-key arithmetic stays
    // keyed on the whole list.
    opacity: root.visible-in-filter ? 1.0 : 0.35;
    background: root.selected ? Theme.primary-glow
        : ((row-touch.has-hover || angle-cell.hovered) ? Theme.bg-card-hover
        : (root.item.needs-anchor ? TableStyle.ruby-glow
        : (root.item.warning-text != "" ? TableStyle.amber-glow
        : (Math.mod(root.item.index, 2) == 0 ? Theme.bg-input : Theme.bg-card))));
    border-radius: 2px;
    // The cyan ring marks the keyboard cursor (the selected row) while the table has
    // focus; amber marks a multi-select member so it is never confused with the cursor.
    border-width: (root.selected && root.table-focused) ? 1.5px : (root.item.multi-selected ? 1px : 0px);
    border-color: (root.selected && root.table-focused) ? Theme.accent-cyan : Theme.accent-amber;

    // The modifiers of the LAST press, so `clicked` (which carries none) can tell a plain
    // click from a Ctrl or Shift click.
    property <bool> ctrl-down: false;
    property <bool> shift-down: false;
    row-touch := TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.ctrl-down = event.modifiers.control || event.modifiers.meta;
                root.shift-down = event.modifiers.shift;
            }
        }
        clicked => {
            root.request-focus-return();
            // Shift+click range-selects; it is checked before Ctrl+click so Shift+Ctrl
            // resolves to one clear behaviour.
            if root.shift-down {
                TierTableModel.select-range(root.item.index);
            } else if root.ctrl-down {
                TierTableModel.toggle-multi(root.item.index);
            } else {
                TierTableModel.select-tier(root.item.index);
            }
        }
    }

    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;

        // Row number, or the multi-select check.
        Rectangle {
            width: Columns.hash-width;
            height: 100%;
            background: root.item.multi-selected ? TableStyle.amber-glow
                : (root.select-mode && hash-touch.has-hover ? Theme.bg-card-hover : transparent);
            Text {
                text: root.item.multi-selected ? "\u{2713}" : (root.select-mode ? "\u{25A1}" : (root.item.index + 1));
                font-size: 11px;
                font-weight: root.item.multi-selected ? 700 : 400;
                color: root.item.multi-selected ? Theme.accent-amber : Theme.text-muted;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            // In Select mode a click toggles multi-select like Ctrl+click.
            hash-touch := TouchArea {
                enabled: root.select-mode && root.unlocked;
                clicked => { TierTableModel.toggle-multi(root.item.index); }
            }
        }

        // The tier's manufacturability warnings.
        Rectangle {
            width: Columns.warn-width;
            height: 100%;
            if root.item.warning-text != "": Text {
                text: "\u{26A0}";
                font-size: 11px;
                font-weight: 700;
                color: Theme.accent-amber;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            if root.item.warning-text != "": Tooltip { text: @markdown("\{root.item.warning-text}"); }
        }

        // Crown / Pavilion / Girdle, one letter. At exactly 0 degrees the side cannot be
        // seen from the angle, so a click flips it (sends "0" or "-0").
        Rectangle {
            property <bool> zero-angle: root.item.angle-deg == "0.00" || root.item.angle-deg == "-0.00";
            property <string> flip-hint: !self.zero-angle ? root.item.block + " facet."
                : (root.item.block == "Pavilion"
                    ? "Pavilion facet at 0\u{b0} -- click to flip to Crown."
                    : "Crown facet at 0\u{b0} -- click to flip to Pavilion.");
            width: Columns.block-width;
            height: 100%;
            background: self.zero-angle && block-touch.has-hover ? Theme.bg-card-hover : transparent;
            Text {
                text: root.item.block == "Crown" ? "C" : (root.item.block == "Pavilion" ? "P" : "G");
                font-size: 10px;
                font-weight: 600;
                color: Theme.text-muted;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            block-touch := TouchArea {
                enabled: parent.zero-angle && root.unlocked;
                clicked => { TierTableModel.flip-block(root.item.index, root.item.block == "Pavilion"); }
            }
            Tooltip { text: (root.unlocked || !parent.zero-angle) ? @markdown("\{parent.flip-hint}") : @markdown("\{GuideModel.locked-hint}"); }
        }

        angle-cell := TierAngleCell {
            width: Columns.angle-width;
            value: root.item.angle-deg;
            full-value: root.item.angle-full;
            proposed: root.item.proposed-angle;
            index: root.item.index;
            focus-target: root.inline-edit-target;
            focus-pulse: root.inline-edit-pulse;
            editable: root.unlocked;
            picked => {
                root.request-focus-return();
                TierTableModel.select-tier(root.item.index);
            }
            commit(text) => { TierTableModel.commit-angle(root.item.index, text); }
            nudge(idx, delta) => { TierTableModel.nudge(idx, delta); }
            closed => { root.request-focus-return(); }
        }

        Text {
            horizontal-stretch: 1;
            min-width: Columns.name-min;
            text: root.item.name == "" ? "(unnamed)" : root.item.name;
            font-size: 11px;
            color: Theme.text-secondary;
            overflow: elide;
            vertical-alignment: center;
        }
        Text {
            horizontal-stretch: 1;
            min-width: Columns.indices-min;
            text: root.item.indices;
            font-size: 11px;
            color: Theme.text-secondary;
            overflow: elide;
            vertical-alignment: center;
        }

        // What the constraint is: a pinned scale value, named facets, an unspecified
        // meet, or an authored depth / girdle-thickness / table-width target.
        Rectangle {
            width: Columns.meets-width;
            height: 100%;
            Text {
                text: root.item.constraint-kind == 2 ? ("\u{1F4CC} " + root.item.constraint-text)
                    : root.item.constraint-kind == 1 ? ("meets " + root.item.constraint-text)
                    : root.item.constraint-kind == 3 ? ("\u{2192} " + root.item.constraint-text + " mm depth")
                    : root.item.constraint-kind == 4 ? ("\u{2192} girdle " + root.item.constraint-text + " mm")
                    : root.item.constraint-kind == 5 ? ("\u{2192} table " + root.item.constraint-text + " mm")
                    : "meet";
                font-size: 10px;
                color: Theme.text-muted;
                overflow: elide;
                vertical-alignment: center;
            }
            if root.item.meet-partners-text != "": Tooltip { text: @markdown("\{root.item.meet-partners-text}"); }
        }

        // The solved mast in model units; the tooltip has millimetres.
        Rectangle {
            width: Columns.mast-width;
            height: 100%;
            if root.item.mast-mm != "": Tooltip { text: @markdown("\{root.item.mast-mm}"); }
            Text {
                text: root.item.mast;
                font-size: 11px;
                color: root.item.strategy-is-uncertain ? Theme.text-muted : Theme.text-secondary;
                overflow: elide;
                vertical-alignment: center;
            }
        }

        // The solve strategy; amber when the mast is an estimate, stale or missing, ruby
        // when the solver could not place the tier. The solver's detail is the tooltip.
        Rectangle {
            width: Columns.solve-width;
            height: 100%;
            if root.item.strategy-detail != "": Tooltip { text: @markdown("\{root.item.strategy-detail}"); }
            Text {
                text: root.item.strategy;
                font-size: 10px;
                font-weight: root.item.strategy-is-uncertain ? 700 : 400;
                color: root.problem ? TableStyle.ruby
                    : (root.item.strategy-is-uncertain ? Theme.accent-amber : Theme.text-muted);
                overflow: elide;
                vertical-alignment: center;
            }
        }

        // Margin over the critical angle and its risk band.
        Text {
            width: Columns.margin-width;
            text: root.item.margin-text == "" ? "-" : root.item.margin-text;
            font-size: 10px;
            font-weight: root.item.risk-level >= 1 ? 700 : 400;
            color: root.item.risk-level == 2 ? TableStyle.ruby
                : (root.item.risk-level == 1 ? Theme.accent-amber
                : (root.item.risk-level == 0 ? Theme.accent-emerald : Theme.text-muted));
            overflow: elide;
            vertical-alignment: center;
        }

        // The orbit shape; clickable ("Complete orbit") while amber and not detached.
        Rectangle {
            width: Columns.orbit-width;
            height: 100%;
            Text {
                text: root.item.orbit-status == "" ? "" : (root.item.is-detached ? root.item.orbit-status + " *" : root.item.orbit-status);
                font-size: 10px;
                font-weight: (root.item.orbit-incomplete && !root.item.is-detached) ? 700 : 400;
                color: root.item.is-detached ? Theme.text-muted
                    : (root.item.orbit-incomplete ? Theme.accent-amber : Theme.accent-emerald);
                overflow: elide;
                vertical-alignment: center;
            }
            if root.item.orbit-incomplete && !root.item.is-detached: TouchArea {
                enabled: root.unlocked;
                clicked => { TierTableModel.complete-orbit(root.item.index); }
            }
            if root.item.orbit-incomplete && !root.item.is-detached: Tooltip {
                text: root.unlocked ? @markdown("Click to complete this tier's orbit (adds the missing symmetric facets).") : @markdown("\{GuideModel.locked-hint}");
            }
        }

        // Adopt: switch this pinned tier to the meet the file actually stated.
        Rectangle {
            width: Columns.adopt-width;
            if root.item.imported-meet-text != "": CellButton {
                text: "Adopt";
                enabled: root.unlocked;
                hint: "File says this tier " + root.item.imported-meet-text + ". Click Adopt to switch to it so the solver and Optimize can move this facet.";
                clicked => { TierTableModel.adopt(root.item.index); }
            }
        }

        // Pin: freeze this tier's solved mast as an exact scale reference. Hidden when
        // already a scale reference, for authored targets, and while the mast is an
        // estimate or stale (pinning it would freeze the wrong number).
        Rectangle {
            width: Columns.pin-width;
            if root.item.constraint-kind != 2 && root.item.constraint-kind < 3 && !root.item.strategy-is-uncertain: CellButton {
                text: "Pin";
                enabled: root.unlocked;
                hint: "Pin this tier's current solved mast (" + root.item.mast-full + ") as an exact scale-reference anchor.";
                clicked => { TierTableModel.pin(root.item.index); }
            }
        }

        // Detach / Reattach the tier's facets from its orbit.
        Rectangle {
            width: Columns.detach-width;
            if root.item.orbit-status != "": CellButton {
                text: root.item.is-detached ? "Reattach" : "Detach";
                accent: root.item.is-detached ? Theme.accent-cyan : Theme.text-secondary;
                font-size: 9px;
                enabled: root.unlocked;
                hint: "Mark this tier's facets as hand-managed -- they stay independent and are not swept along when an orbit member elsewhere is removed.";
                clicked => { TierTableModel.toggle-detach(root.item.index); }
            }
        }

        // The missing-anchor remedy: selects the tier and points at the fix.
        Rectangle {
            width: Columns.anchor-width;
            if root.item.needs-anchor: CellButton {
                text: "Add Anchor";
                accent: Theme.accent-amber;
                font-size: 9px;
                enabled: root.unlocked;
                hint: root.item.strategy-detail;
                clicked => { TierTableModel.add-anchor(root.item.index); }
            }
        }

        // Reorder in cutting order.
        Rectangle {
            width: Columns.move-width;
            height: 100%;
            opacity: root.unlocked ? 1.0 : 0.4;
            VerticalLayout {
                Rectangle {
                    height: 13px;
                    Text { text: "\u{25B2}"; font-size: 8px; color: Theme.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { enabled: root.unlocked; clicked => { TierTableModel.move-tier(root.item.index, -1); } }
                }
                Rectangle {
                    height: 13px;
                    Text { text: "\u{25BC}"; font-size: 8px; color: Theme.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { enabled: root.unlocked; clicked => { TierTableModel.move-tier(root.item.index, 1); } }
                }
            }
            Tooltip { text: root.unlocked ? @markdown("Move this tier up/down in cutting order (Alt+Up / Alt+Down).") : @markdown("\{GuideModel.locked-hint}"); }
        }

        Rectangle {
            width: Columns.dup-width;
            height: 100%;
            opacity: root.unlocked ? 1.0 : 0.4;
            Text { text: "+"; font-size: 14px; font-weight: 700; color: Theme.accent-cyan; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { enabled: root.unlocked; clicked => { TierTableModel.duplicate-tier(root.item.index); } }
            Tooltip { text: root.unlocked ? @markdown("Duplicate this tier, inserted right after it (Ctrl+D).") : @markdown("\{GuideModel.locked-hint}"); }
        }
        Rectangle {
            width: Columns.remove-width;
            height: 100%;
            opacity: root.unlocked ? 1.0 : 0.4;
            Text { text: "\u{00D7}"; font-size: 14px; color: TableStyle.ruby; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { enabled: root.unlocked; clicked => { TierTableModel.remove-tier(root.item.index); } }
            Tooltip { text: root.unlocked ? @markdown("Remove this tier (Delete).") : @markdown("\{GuideModel.locked-hint}"); }
        }
    }
}
