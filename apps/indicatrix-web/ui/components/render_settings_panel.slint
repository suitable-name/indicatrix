import { Slider, ComboBox, Switch, SpinBox, Button, ScrollView, CheckBox } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { AppModel } from "../models/app_model.slint";
import { RenderModel } from "render_model.slint";
import { GuideModel } from "../models/guide_model.slint";
import { DesignSettingsModel } from "../editor/design_settings.slint";

// A section caption.
component Caption inherits Text {
    font-size: 10px;
    font-weight: 700;
    color: Theme.text-muted;
}

// A label with its current value on the right.
component ValueRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <bool> active: true;
    spacing: 6px;
    Text {
        text: root.label;
        font-size: 11px;
        font-weight: 600;
        color: root.active ? Theme.text-secondary : Theme.text-muted;
        overflow: elide;
        horizontal-stretch: 1;
    }
    Text {
        text: root.value;
        font-size: 11px;
        font-weight: 700;
        color: root.active ? Theme.accent-cyan : Theme.text-muted;
    }
}

// Pill choice (the desktop's backdrop picker). `selected` is the value of the chosen pill:
// its position, or `values[position]` when `values` is given (the backdrop row shows its
// pills in display order while the stored indices stay 0 as lit, 1 grey, 2 white, 3 black).
export component Pills inherits HorizontalLayout {
    in property <bool> enabled: true;
    in property <[string]> labels;
    in property <[int]> values;
    in-out property <int> selected;
    callback chosen(int);
    spacing: 4px;
    for label[i] in root.labels: Rectangle {
        property <int> value: root.values.length > i ? root.values[i] : i;
        accessible-role: button;
        accessible-label: label;
        horizontal-stretch: 1;
        height: 24px;
        opacity: root.enabled ? 1.0 : 0.5;
        border-radius: Theme.radius-sm;
        background: root.selected == value ? Theme.accent-cyan : (touch.has-hover ? Theme.bg-elevated : Theme.bg-input);
        border-width: 1px;
        border-color: root.selected == value ? Theme.accent-cyan : Theme.border-medium;
        touch := TouchArea {
            enabled: root.enabled;
            clicked => {
                root.selected = value;
                root.chosen(value);
            }
        }
        Text {
            text: label;
            font-size: 11px;
            font-weight: 600;
            color: root.selected == value ? Theme.bg-darkest : Theme.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// The render settings, a compact version of the desktop's settings dialog: lighting
// (the preset combo shares `AppModel.lighting-index` with the header, so the two
// stay in sync), exposure, light direction, backdrop, HDR, quality (bounces, target
// samples, denoise), and the material controls. Every control writes its
// `RenderModel` property and calls `RenderModel.settings-edited()`; Rust reads them
// all back (`src/render/panel.rs`). Two controls are the exceptions: the Surface Glare slider
// reports through `RenderModel.surface-glare-edited` (`src/app/callbacks.rs`), and the Body
// Color combo is the Design Settings dialog's own state (`DesignSettingsModel`).
export component RenderSettingsPanel inherits Rectangle {
    background: Theme.bg-card;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-medium;
    drop-shadow-blur: 16px;
    drop-shadow-color: Theme.toast-shadow;
    clip: true;

    ScrollView {
        width: 100%;
        height: 100%;
        VerticalLayout {
            padding: 10px;
            spacing: 6px;

            HorizontalLayout {
                Text {
                    text: "Render Settings";
                    font-size: 12px;
                    font-weight: 700;
                    color: Theme.text-primary;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: 20px;
                    height: 20px;
                    border-radius: Theme.radius-sm;
                    background: close.has-hover ? Theme.overlay-hover : transparent;
                    accessible-role: button;
                    accessible-label: "Close the Render Settings";
                    close := TouchArea {
                        clicked => { RenderModel.panel-open = false; }
                    }
                    Tooltip { text: @markdown("Close the render settings."); }
                    Text {
                        text: "\u{00D7}";
                        font-size: 15px;
                        color: Theme.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            Caption { text: "LIGHTING"; }
            ComboBox {
                height: 26px;
                model: AppModel.lighting-options;
                current-index <=> AppModel.lighting-index;
                selected(value) => { AppModel.lighting-changed(self.current-index); }
            }
            ValueRow {
                label: "Exposure";
                value: Math.round(RenderModel.exposure * 100) / 100 + "x";
            }
            Slider {
                minimum: 0.4;
                maximum: 2.5;
                step: 0.05;
                value <=> RenderModel.exposure;
                changed => { RenderModel.settings-edited(); }
            }
            ValueRow {
                label: "Head Shadow";
                value: Math.round(RenderModel.head-shadow-deg) == 0 ? "Off" : Math.round(RenderModel.head-shadow-deg) + "\u{b0}";
                active: RenderModel.head-shadow-used;
            }
            Slider {
                enabled: RenderModel.head-shadow-used;
                minimum: 0;
                maximum: 30;
                step: 1;
                value <=> RenderModel.head-shadow-deg;
                changed => { RenderModel.settings-edited(); }
            }
            // Surface glare scales the white mirror image of the light on the table, so the
            // inner facets stay visible (0 % keeps only light that entered the stone). It
            // belongs to the built-in lighting rigs: hidden while an HDR map lights the scene.
            if !(AppModel.hdr-name != "" && RenderModel.use-hdr): ValueRow {
                label: "Surface Glare";
                value: Math.round(RenderModel.surface-glare-percent / 5) * 5 + " %";
            }
            if !(AppModel.hdr-name != "" && RenderModel.use-hdr): Slider {
                minimum: 0;
                maximum: 100;
                step: 5;
                value <=> RenderModel.surface-glare-percent;
                changed => { RenderModel.surface-glare-edited(Math.round(self.value / 5) * 5); }
            }
            ValueRow {
                label: "Light Azimuth";
                value: Math.round(RenderModel.light-yaw-deg) + "\u{b0}";
                active: RenderModel.light-direction-used;
            }
            Slider {
                enabled: RenderModel.light-direction-used;
                minimum: 0;
                maximum: 360;
                value <=> RenderModel.light-yaw-deg;
                changed => { RenderModel.settings-edited(); }
            }
            ValueRow {
                label: "Light Elevation";
                value: Math.round(RenderModel.light-pitch-deg) + "\u{b0}";
                active: RenderModel.light-direction-used;
            }
            Slider {
                enabled: RenderModel.light-direction-used;
                minimum: 10;
                maximum: 90;
                value <=> RenderModel.light-pitch-deg;
                changed => { RenderModel.settings-edited(); }
            }
            Text {
                text: "Backdrop";
                font-size: 11px;
                font-weight: 600;
                color: Theme.text-secondary;
            }
            Pills {
                // The surface the stone lies on, lit by the lighting and seen around the
                // stone and through its windows. An HDR map is its own world.
                enabled: !(AppModel.hdr-name != "" && RenderModel.use-hdr);
                labels: ["As lit", "Black", "Grey", "White"];
                values: [0, 3, 1, 2];
                selected <=> RenderModel.backdrop-index;
                chosen => { RenderModel.settings-edited(); }
            }
            if AppModel.hdr-name != "": Switch {
                text: "Use HDR: " + AppModel.hdr-name;
                checked <=> RenderModel.use-hdr;
                toggled => { RenderModel.settings-edited(); }
            }
            Button {
                text: AppModel.hdr-name != "" ? "Load another HDR..." : "Load HDR environment...";
                clicked => { RenderModel.load-hdr(); }
            }

            Caption { text: "QUALITY"; }
            Pills {
                labels: ["Path-Traced", "Ray-Traced"];
                selected <=> RenderModel.engine;
                chosen => { RenderModel.settings-edited(); }
            }
            if RenderModel.engine == 1: VerticalLayout {
                spacing: 4px;
                Text { text: "Anti-Aliasing"; color: Theme.text-secondary; font-size: 11px; }
                Pills {
                    labels: ["Off", "4×", "8×", "16×"];
                    selected: RenderModel.ray-taps == 1 ? 0 : RenderModel.ray-taps == 4 ? 1 : RenderModel.ray-taps == 8 ? 2 : 3;
                    chosen(index) => {
                        RenderModel.ray-taps = index == 0 ? 1 : index == 1 ? 4 : index == 2 ? 8 : 16;
                        RenderModel.settings-edited();
                    }
                }
                Switch {
                    text: "Fire";
                    checked <=> RenderModel.ray-fire;
                    toggled => { RenderModel.settings-edited(); }
                }
                Text {
                    text: "Approximate tint and frost; no polarization, birefringent doubling, scattering, zoning or edge rounding. Metrics keep their own tracer.";
                    font-size: 10px; color: Theme.text-muted; wrap: word-wrap;
                }
            }
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: "Bounces";
                    font-size: 11px;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                SpinBox {
                    width: 90px;
                    minimum: 4;
                    maximum: 24;
                    value <=> RenderModel.bounces;
                    edited => { RenderModel.settings-edited(); }
                }
            }
            if RenderModel.engine == 0: HorizontalLayout {
                spacing: 6px;
                Text {
                    text: "Target spp";
                    font-size: 11px;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                SpinBox {
                    width: 90px;
                    minimum: 64;
                    maximum: 1024;
                    step-size: 64;
                    value <=> RenderModel.target-spp;
                    edited => { RenderModel.settings-edited(); }
                }
            }
            if RenderModel.engine == 0: Switch {
                text: "Denoise When Settled";
                checked <=> RenderModel.denoise;
                toggled => { RenderModel.settings-edited(); }
            }
            CheckBox {
                text: "GPU Rendering";
                checked <=> RenderModel.gpu-enabled;
                toggled => { RenderModel.settings-edited(); }
            }
            // What the app renders with, kept after the start-up test is over. Conditional
            // items (not `visible:`) so a hidden one takes no space.
            if RenderModel.gpu-summary != "": Text {
                text: RenderModel.gpu-summary;
                font-size: 11px;
                color: Theme.text-primary;
                wrap: word-wrap;
            }
            // The step of a running test or the result of a passed one; a failure is already in
            // the sentence above.
            if RenderModel.gpu-status-text != "" && (RenderModel.gpu-state == 2 || RenderModel.gpu-state == 3): Text {
                text: RenderModel.gpu-status-text;
                font-size: 11px;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }
            Text {
                text: "Needs WebGPU (Chrome or Edge). Ray-Traced supports every material class on the GPU; Path-Traced supports isotropic stones such as diamond and spinel. A qualification failure or scene limit uses the CPU.";
                font-size: 10px;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
            if RenderModel.gpu-state == 1: Button {
                text: "Test GPU";
                clicked => { RenderModel.gpu-test-clicked(); }
            }
            if RenderModel.gpu-state == 4 && RenderModel.gpu-can-forget: Button {
                text: "Forget GPU Test Result";
                clicked => { RenderModel.gpu-forget-clicked(); }
            }

            Caption { text: "MATERIAL"; }
            Switch {
                text: "Linked to Design";
                checked <=> RenderModel.link-material;
                toggled => { RenderModel.settings-edited(); }
            }
            // A quick copy of the Design Settings color combo (the same state, the same
            // Apply Material edit, one undo step): the stone's body color follows the design
            // while it is linked. "Custom..." opens Design Settings on the color editor.
            if AppModel.has-design && DesignSettingsModel.color-options.length > 0: VerticalLayout {
                spacing: 2px;
                Text {
                    text: "Body Color";
                    font-size: 11px;
                    font-weight: 600;
                    color: RenderModel.link-material ? Theme.text-secondary : Theme.text-muted;
                }
                ComboBox {
                    height: 26px;
                    enabled: RenderModel.link-material && GuideModel.allows-design-settings();
                    model: DesignSettingsModel.color-options;
                    current-index <=> DesignSettingsModel.color-index;
                    selected(value) => {
                        if self.current-index == DesignSettingsModel.color-options.length - 1 {
                            DesignSettingsModel.color-picker-open = true;
                            DesignSettingsModel.lch-open();
                            DesignSettingsModel.open = true;
                        } else {
                            DesignSettingsModel.color-picker-open = false;
                            DesignSettingsModel.apply-material();
                        }
                    }
                }
            }
            Switch {
                text: "Frosted Girdle";
                checked <=> RenderModel.frosted-girdle;
                toggled => { RenderModel.settings-edited(); }
            }
            ValueRow {
                label: RenderModel.engine == 1 ? "Inclusion Haze (not shown in Ray-Traced)" : "Inclusion Haze";
                value: RenderModel.inclusion-sigma-s <= 0 ? "Off" : Math.round(RenderModel.inclusion-sigma-s * 100) / 100 + "";
            }
            Slider {
                minimum: 0;
                maximum: 1;
                step: 0.01;
                value <=> RenderModel.inclusion-position;
                changed => { RenderModel.settings-edited(); }
            }
            ValueRow {
                label: RenderModel.engine == 1 ? "Edge Rounding (not shown in Ray-Traced)" : "Edge Rounding";
                value: RenderModel.edge-rounding <= 0 ? "Off" : Math.round(RenderModel.edge-rounding * 1000) / 1000 + "";
            }
            Slider {
                minimum: 0;
                maximum: 0.03;
                step: 0.001;
                value <=> RenderModel.edge-rounding;
                changed => { RenderModel.settings-edited(); }
            }
            ValueRow {
                label: RenderModel.link-material ? "Stone size (from the design)" : "Stone size";
                value: RenderModel.stone-width-mm <= 0 ? "Off" : Math.round(RenderModel.stone-width-mm * 100) / 100 + " mm";
                active: !RenderModel.link-material;
            }
            Slider {
                enabled: !RenderModel.link-material;
                minimum: 0;
                maximum: 20;
                step: 0.1;
                value <=> RenderModel.stone-width-mm;
                changed => { RenderModel.settings-edited(); }
            }
            Switch {
                text: RenderModel.engine == 1 ? "Crystal Axis Override (tint only in Ray-Traced)" : "Crystal Axis Override";
                checked <=> RenderModel.c-axis-override;
                toggled => { RenderModel.settings-edited(); }
            }
            ValueRow {
                label: "Axis Tilt";
                value: Math.round(RenderModel.c-axis-tilt-deg) + "\u{b0}";
                active: RenderModel.c-axis-override;
            }
            Slider {
                enabled: RenderModel.c-axis-override;
                minimum: 0;
                maximum: 90;
                value <=> RenderModel.c-axis-tilt-deg;
                changed => { RenderModel.settings-edited(); }
            }
            ValueRow {
                label: "Axis Azimuth";
                value: Math.round(RenderModel.c-axis-azimuth-deg) + "\u{b0}";
                active: RenderModel.c-axis-override;
            }
            Slider {
                enabled: RenderModel.c-axis-override;
                minimum: 0;
                maximum: 360;
                value <=> RenderModel.c-axis-azimuth-deg;
                changed => { RenderModel.settings-edited(); }
            }
        }
    }
}
