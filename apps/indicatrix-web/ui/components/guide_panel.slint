import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { GuideModel } from "../models/guide_model.slint";

// The guided walkthrough's step panel (modelled on the desktop's `guide_panel.slint`).
// Mounted two ways, never both at once: as a column beside the main view when the window
// is wide enough (`app.slint`), and floating over the window everywhere else -- the narrow
// layout, or a window too small to spare the column -- through `GuideOverlayLayer` below,
// so the guide never disappears mid-walkthrough.
//
// The panel sets NO height of its own. Docked, it fills the row it sits in; floating,
// `GuideOverlayLayer` sizes it against the window. Either way the step text scrolls
// internally.
//
// The header row drags the floating panel (`draggable`, reported through `dragged`), and
// its collapse button shrinks either mount to a small "Guide - Step N of M" pill that
// expands again on click (`GuideModel.collapsed`).
//
// Layout of one step: title, a muted one-sentence intro, the numbered actions, an emerald
// "Look for" line, an optional italic "why" note, then the status chip ("Waiting for: ..."
// until Rust reports the goal reached, then "Done") and the Back / Next-or-Skip row. Action
// steps advance by themselves; only manual (reading) steps show a primary Next.
export component GuidePanel inherits Rectangle {
    // Whether the header row (and the collapsed pill) drag the panel -- only the floating
    // mount, whose owner applies the moves.
    in property <bool> draggable: false;
    // An incremental move of `(dx, dy)` requested by a drag on the header or pill.
    callback dragged(length, length);
    // The collapsed pill's size, read by `GuideOverlayLayer` to size the floating mount
    // while collapsed.
    out property <length> collapsed-width: 176px;
    out property <length> collapsed-height: 30px;

    width: GuideModel.collapsed ? root.collapsed-width : 260px;
    background: Theme.bg-card;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.accent-cyan;
    clip: true;

    // Swallows clicks on the panel's own background: the floating mount sits over the
    // views, which must not receive a click aimed at the panel.
    TouchArea { }

    if GuideModel.collapsed: Rectangle {
        height: root.collapsed-height;
        // Set once the pointer has actually travelled, so the release that ends a drag does
        // not also expand the pill.
        property <bool> drag-moved: false;
        background: pill-touch.has-hover ? Theme.bg-card-hover : Theme.bg-card;
        pill-touch := TouchArea {
            mouse-cursor: pointer;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    parent.drag-moved = false;
                }
            }
            moved => {
                if self.pressed && root.draggable
                        && Math.abs(self.mouse-x - self.pressed-x) + Math.abs(self.mouse-y - self.pressed-y) > 2px {
                    parent.drag-moved = true;
                    root.dragged(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                }
            }
            clicked => {
                if !parent.drag-moved {
                    GuideModel.collapsed = false;
                }
            }
        }
        Text {
            x: 10px;
            width: parent.width - 20px;
            height: parent.height;
            text: "Guide \u{00B7} Step " + (GuideModel.step-index + 1) + " of " + GuideModel.total-steps + "  \u{25B6}";
            font-size: 10px;
            font-weight: 700;
            color: GuideModel.step-done ? Theme.accent-emerald : Theme.accent-cyan;
            vertical-alignment: center;
            overflow: elide;
        }
        Tooltip { text: root.draggable ? @markdown("Expand the guide. Drag to move it.") : @markdown("Expand the guide."); }
    }

    if !GuideModel.collapsed: VerticalLayout {
        padding: 12px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 6px;
            // The drag handle of the floating mount: the header text's own area.
            Rectangle {
                horizontal-stretch: 1;
                header-drag := TouchArea {
                    enabled: root.draggable;
                    mouse-cursor: root.draggable ? MouseCursor.move : MouseCursor.default;
                    moved => {
                        if self.pressed {
                            root.dragged(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                        }
                    }
                }
                Text {
                    text: "Guide \u{00B7} Step " + (GuideModel.step-index + 1) + " of " + GuideModel.total-steps;
                    font-size: 10px;
                    font-weight: 700;
                    color: Theme.accent-cyan;
                    vertical-alignment: center;
                    horizontal-alignment: left;
                }
            }
            Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 3px;
                background: collapse-touch.has-hover ? Theme.bg-card-hover : transparent;
                Text {
                    text: "\u{25BC}";
                    font-size: 11px;
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                collapse-touch := TouchArea { clicked => { GuideModel.collapsed = true; } }
                Tooltip { text: @markdown("Collapse the guide to a small pill; click the pill to expand it again. The guide keeps running."); }
            }
            // Always enabled: closing the guide lifts every lock it placed.
            Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 3px;
                background: close-touch.has-hover ? Theme.bg-card-hover : transparent;
                Text {
                    // (The web build's font has no U+2715 cross or U+25BE / U+25B8 small
                    // triangles: those drew as blanks, and the close button looked missing.)
                    text: "\u{00D7}";
                    font-size: 15px;
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                close-touch := TouchArea { clicked => { GuideModel.close(); } }
                Tooltip { text: @markdown("Close the guide and unlock every control. Reopen it any time from Help > Guided walkthrough."); }
            }
        }

        Text {
            text: GuideModel.current.title;
            font-size: 13px;
            font-weight: 700;
            color: Theme.text-primary;
            wrap: word-wrap;
        }

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: start;
                spacing: 8px;

                if GuideModel.current.intro != "": Text {
                    text: GuideModel.current.intro;
                    font-size: 11px;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }

                VerticalLayout {
                    spacing: 5px;
                    // One row per action. A word-wrapped Text inside a HorizontalLayout inside
                    // this scrolling column reports the height of ONE line to the layout above,
                    // so a wrapped action overlapped the lines below it. The row is therefore a
                    // Rectangle sized from the text's own preferred height at its set width
                    // (the same recipe as the status chip below).
                    for action[i] in GuideModel.current.actions: Rectangle {
                        height: action-text.preferred-height;
                        Text {
                            x: 0px;
                            y: 0px;
                            width: 16px;
                            text: "" + (i + 1);
                            font-size: 11px;
                            font-weight: 700;
                            color: Theme.accent-cyan;
                            horizontal-alignment: right;
                        }
                        action-text := Text {
                            x: 22px;
                            y: 0px;
                            width: max(20px, parent.width - 22px);
                            text: action;
                            font-size: 11px;
                            color: Theme.text-primary;
                            wrap: word-wrap;
                        }
                    }
                }

                if GuideModel.current.check != "": Text {
                    text: "\u{2713} Look for: " + GuideModel.current.check;
                    font-size: 10px;
                    color: Theme.accent-emerald;
                    wrap: word-wrap;
                }

                if GuideModel.current.why != "": Text {
                    text: GuideModel.current.why;
                    font-size: 9px;
                    font-italic: true;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
            }
        }

        // Status chip: what the guide is waiting for, then a short "Done" before the
        // automatic move to the next step.
        Rectangle {
            height: chip-txt.preferred-height + 8px;
            border-radius: Theme.radius-sm;
            background: GuideModel.step-done ? Theme.toast-success-surface : Theme.bg-input;
            border-width: 1px;
            border-color: GuideModel.step-done ? Theme.accent-emerald : Theme.border-subtle;
            chip-txt := Text {
                x: 8px;
                y: 4px;
                width: parent.width - 16px;
                height: self.preferred-height;
                text: GuideModel.step-done
                    ? "Done \u{2713}"
                    : (GuideModel.current-is-manual
                        ? "Read this step, then click " + (GuideModel.has-next ? "Next." : "Finish.")
                        : "Waiting for: " + GuideModel.current.waiting + "\u{2026}");
                font-size: 10px;
                font-weight: GuideModel.step-done ? 700 : 400;
                color: GuideModel.step-done ? Theme.accent-emerald : Theme.text-secondary;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }

        HorizontalLayout {
            spacing: 6px;
            Rectangle {
                width: back-txt.preferred-width + 16px;
                height: 26px;
                border-radius: Theme.radius-sm;
                background: GuideModel.has-back ? (back-touch.has-hover ? Theme.bg-elevated : Theme.bg-input) : Theme.bg-darkest;
                back-txt := Text {
                    text: "Back";
                    font-size: 10px;
                    color: GuideModel.has-back ? Theme.text-secondary : Theme.text-muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                back-touch := TouchArea {
                    enabled: GuideModel.has-back;
                    clicked => { GuideModel.back(); }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            // A manual (reading) step's primary Next / Finish; on an action step the same
            // slot is a quiet "Skip step" -- those steps advance by themselves once their
            // goal is reached.
            Rectangle {
                width: next-txt.preferred-width + 16px;
                height: 26px;
                border-radius: Theme.radius-sm;
                background: GuideModel.current-is-manual
                    ? (next-touch.has-hover ? #60a5fa : #3b82f6)
                    : (next-touch.has-hover ? Theme.bg-elevated : Theme.bg-input);
                next-txt := Text {
                    text: GuideModel.current-is-manual ? (GuideModel.has-next ? "Next" : "Finish") : "Skip step";
                    font-size: 10px;
                    font-weight: GuideModel.current-is-manual ? 700 : 400;
                    color: GuideModel.current-is-manual ? #ffffff : Theme.text-muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                next-touch := TouchArea {
                    enabled: !GuideModel.step-done;
                    clicked => { GuideModel.next(); }
                }
            }
        }
    }
}

// Mounted once by `app.slint` as an explicitly positioned full-window layer (so none of its
// constraints reach the window). Holds the timer behind the guide's short "Done" moment --
// here rather than inside `GuidePanel`, so it runs whichever way the panel is mounted --
// and the floating `GuidePanel` for every place the wide layout's own column does not
// exist. The layer itself has no `TouchArea`, so clicks outside the floating panel reach
// whatever is underneath.
export component GuideOverlayLayer inherits Rectangle {
    // `true` while the wide layout mounts its own `GuidePanel` column, which then replaces
    // the floating one.
    in property <bool> docked: false;

    Timer {
        interval: 700ms;
        running: GuideModel.step-done;
        triggered => { GuideModel.complete-advance(); }
    }

    // Default spot: bottom-right, its bottom edge 50px above the window's (clear of the
    // status strip) and its top well below the header. Once dragged,
    // `GuideModel.float-x` / `float-y` hold the spot; both are clamped here on every read,
    // so the panel always stays fully inside the window.
    if GuideModel.open && !root.docked: GuidePanel {
        draggable: true;
        height: GuideModel.collapsed ? self.collapsed-height : max(180px, min(480px, root.height - 140px));
        x: GuideModel.float-placed
            ? clamp(GuideModel.float-x, 0px, max(0px, root.width - self.width))
            : max(0px, root.width - self.width - 20px);
        y: GuideModel.float-placed
            ? clamp(GuideModel.float-y, 0px, max(0px, root.height - self.height))
            : max(0px, root.height - self.height - 50px);
        dragged(dx, dy) => {
            GuideModel.float-x = clamp(self.x + dx, 0px, max(0px, root.width - self.width));
            GuideModel.float-y = clamp(self.y + dy, 0px, max(0px, root.height - self.height));
            GuideModel.float-placed = true;
        }
    }
}
