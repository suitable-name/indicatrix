import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { GalleryModel } from "../models/app_model.slint";

// The New Design dialog's template gallery (the desktop's `components/template_gallery.slint`):
// a list of cards, one per `GalleryModel.templates` entry ("Empty" first), each showing its
// name, shape and one-line description. There are no rendered thumbnails, as on the
// desktop: a card shows a plain shape glyph. Selecting a card sets `selected-index` and
// calls `selected()`; a double click also calls `chosen()`.
export component TemplateGallery inherits Rectangle {
    in-out property <int> selected-index: 1;
    callback selected();
    callback chosen();

    // A fixed viewport of about four cards (a `ScrollView`'s own preferred height is
    // zero, so sizing the gallery from it collapsed the list); the cards scroll inside.
    height: 184px;

    content := ScrollView {
        width: 100%;
        height: 100%;
        VerticalLayout {
            width: parent.width - 14px;
            spacing: 4px;
            padding-right: 8px;
            for card[idx] in GalleryModel.templates: Rectangle {
                height: 44px;
                background: idx == root.selected-index
                    ? Theme.primary-glow
                    : (card-touch.has-hover ? Theme.bg-card-hover : Theme.bg-input);
                border-radius: Theme.radius-sm;
                border-width: idx == root.selected-index ? 1px : 0px;
                border-color: Theme.accent-cyan;

                card-touch := TouchArea {
                    clicked => {
                        root.selected-index = idx;
                        root.selected();
                    }
                    double-clicked => {
                        root.selected-index = idx;
                        root.selected();
                        root.chosen();
                    }
                }

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 8px;
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        y: (parent.height - self.height) / 2;
                        border-radius: Theme.radius-sm;
                        background: Theme.bg-darkest;
                        Text {
                            text: "\u{25BC}";
                            font-size: 14px;
                            color: Theme.accent-cyan;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        Text {
                            text: card.name;
                            font-size: 11px;
                            font-weight: 700;
                            color: Theme.text-primary;
                            overflow: elide;
                        }
                        Text {
                            text: card.shape + " -- " + card.description;
                            font-size: 9px;
                            color: Theme.text-muted;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }
}
