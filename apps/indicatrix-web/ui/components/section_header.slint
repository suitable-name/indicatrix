import { Theme } from "theme.slint";

// A 24px collapsible-section header: chevron, uppercase muted title and a
// right-side `@children` slot -- a copy of the desktop's
// `components/section_header.slint`. Owns no state: the caller drives
// `collapsed` and hides its own body.
export component SectionHeader inherits Rectangle {
    in property <string> title;
    in property <bool> collapsed: false;
    callback toggled();

    height: 24px;
    background: touch.has-hover ? Theme.bg-card-hover : transparent;
    border-radius: Theme.radius-sm;

    touch := TouchArea {
        clicked => { root.toggled(); }
    }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 6px;

        Rectangle {
            width: 10px;
            VerticalLayout {
                alignment: center;
                Path {
                    width: 8px;
                    height: 8px;
                    viewbox-width: 8;
                    viewbox-height: 8;
                    stroke: Theme.text-muted;
                    stroke-width: 1.5px;
                    commands: root.collapsed
                        ? "M 2 1.5 L 6 4 L 2 6.5"
                        : "M 1.5 2.5 L 4 6.5 L 6.5 2.5";
                }
            }
        }

        Text {
            text: root.title;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.5px;
            color: Theme.text-muted;
            vertical-alignment: center;
        }

        Rectangle { horizontal-stretch: 1; }

        @children
    }
}
