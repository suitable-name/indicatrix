import { Theme } from "theme.slint";
import { ComboBox, LineEdit, ScrollView } from "std-widgets.slint";
import { RoughPill, RoughField, ElidedText } from "components/rough_planner/fields.slint";
import { TipBox } from "components/tip_box.slint";
import { PhotoCanvas, CanvasMarker, CanvasPath, PhotoSlot, ReportRow } from "components/locate/photo_canvas.slint";

// One view of the rig as the form shows it: fifteen text fields (the order of
// `locate_io::rig_form::FIELD_LABELS`) and whether the view is orthographic.
export struct RigViewRow {
    fields: [string],
    orthographic: bool,
}

component FormTitle inherits Rectangle {
    in property <string> text;
    height: 18px;
    Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        font-size: 11px;
        font-weight: 700;
        color: Theme.text-muted;
        vertical-alignment: center;
    }
}

component FormNote inherits Rectangle {
    in property <string> text;
    in property <color> text_color: Theme.text-muted;
    preferred-height: note_text.preferred-height;
    note_text := Text {
        width: parent.width;
        text: root.text;
        font-size: 10px;
        color: root.text_color;
        wrap: word-wrap;
    }
}

component FormRows inherits VerticalLayout {
    in property <[ReportRow]> rows;
    spacing: 2px;
    for row in root.rows: Text {
        text: row.text;
        font-size: 10px;
        color: row.warn ? Theme.accent-amber : Theme.text-secondary;
        wrap: word-wrap;
    }
}

// "Edit rigs...": the camera rigs of "Locate inclusion from photos". The Rig tab edits a rig by
// hand (eight views: pose, focal length or orthographic scale, principal point, image size; the
// stone's and the surroundings' refractive index). The Calibrate tab refines a rig from photos of
// a beam-splitter cube of known size. Everything it shows is pushed from Rust
// (`gui::rough_plan::locate`).
export component RigWindow inherits Window {
    title: "Camera Rigs \u{2014} Indicatrix Cut";
    // See `MainWindow`'s `icon` (app.slint) for why every window sets it.
    icon: @image-url("../assets/icon.png");
    preferred-width: 1200px;
    preferred-height: 780px;
    min-width: 900px;
    min-height: 540px;
    background: Theme.bg-darkest;
    default-font-family: "Segoe UI";

    // 0 the Rig tab, 1 the Calibrate tab.
    in-out property <int> tab: 0;
    in property <[string]> rig_names;
    in-out property <int> rig_index: -1;
    in property <bool> busy: false;
    in property <string> busy_text;
    in property <string> message;
    in property <string> error_text;

    // The Rig tab.
    in-out property <string> name_text;
    in-out property <string> stone_n_text;
    in-out property <string> surround_n_text;
    in property <[RigViewRow]> view_rows;
    in property <[string]> field_labels;
    in-out property <string> gen_distance: "150";
    in-out property <string> gen_elevation: "30";
    in-out property <string> gen_scale: "4000";
    in-out property <string> gen_width: "4000";
    in-out property <string> gen_height: "3000";
    in-out property <bool> gen_ortho: false;
    in property <string> calibration_info;

    // The Calibrate tab.
    in property <[PhotoSlot]> slots;
    in property <string> view_title;
    in property <image> photo;
    in property <int> image_w: 1;
    in property <int> image_h: 1;
    in property <bool> has_photo: false;
    in property <[CanvasMarker]> markers;
    in property <[CanvasPath]> paths;
    in-out property <int> mode_index: 0;
    in-out property <int> zoom: 1;
    in-out property <string> cube_edge: "25.4";
    in-out property <string> cube_tolerance: "0.1";
    in-out property <string> cube_n: "1.5168";
    in-out property <string> focal_sigma: "10";
    in-out property <int> diag_axis_index: 2;
    in-out property <bool> diag_mirrored: false;
    in property <string> calib_text;
    in property <[ReportRow]> calib_rows;
    in property <string> caveat;
    in property <bool> can_save_calibrated: false;

    callback rig_selected(int);
    callback new_rig();
    callback delete_rig();
    callback save_rig();
    callback field_edited(int, int, string);
    callback projection_toggled(int);
    callback fill_layout();
    callback load_photo(int);
    callback select_view(int);
    callback canvas_clicked(float, float);
    callback mode_changed(int);
    callback undo_click();
    callback clear_view();
    callback calibrate();
    callback save_calibrated();

    Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;

        VerticalLayout {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            padding: 10px;
            spacing: 8px;

            // The rig picker, the tabs and the window's messages.
            HorizontalLayout {
                height: 28px;
                spacing: 8px;

                Text {
                    text: "Rig:";
                    font-size: 12px;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                }
                TipBox {
                    width: 220px;
                    hint: "The stored camera rigs. Pick one to edit or calibrate it.";
                    ComboBox {
                        min-width: 0px;
                        model: root.rig_names;
                        current-index <=> root.rig_index;
                        enabled: !root.busy && root.rig_names.length > 0;
                        accessible-label: "Camera rig";
                        selected(value) => { root.rig_selected(root.rig_index); }
                    }
                }
                RoughPill {
                    text: "New rig";
                    hint: "Start a new rig with the default eight views, then edit and save it.";
                    enabled: !root.busy;
                    clicked => { root.new_rig(); }
                }
                RoughPill {
                    text: "Delete rig";
                    hint: "Remove the picked rig from the stored rigs.";
                    enabled: !root.busy && root.rig_names.length > 0;
                    clicked => { root.delete_rig(); }
                }
                RoughPill {
                    text: "Rig";
                    hint: "Edit the rig by hand: the views, the stone's refractive index and the surroundings'.";
                    active: root.tab == 0;
                    clicked => { root.tab = 0; }
                }
                RoughPill {
                    text: "Calibrate";
                    hint: "Refine the rig from photos of a beam-splitter cube of known size.";
                    active: root.tab == 1;
                    clicked => { root.tab = 1; }
                }
                Text {
                    horizontal-stretch: 1;
                    text: root.busy ? root.busy_text : (root.error_text != "" ? root.error_text : root.message);
                    font-size: 11px;
                    color: root.busy ? Theme.text-secondary : (root.error_text != "" ? Theme.danger : Theme.text-secondary);
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            // The Rig tab.
            if root.tab == 0: VerticalLayout {
                vertical-stretch: 1;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 8px;
                    RoughField {
                        label: "Name";
                        hint: "The rig's name. Saving under an existing name replaces that rig.";
                        editable: !root.busy;
                        value <=> root.name_text;
                    }
                    RoughField {
                        label: "Stone n";
                        hint: "The stone's refractive index. It starts at the planner's material. For a birefringent stone use the ordinary index (n_o) and click the ordinary image.";
                        editable: !root.busy;
                        value <=> root.stone_n_text;
                    }
                    RoughField {
                        label: "Surrounding n";
                        hint: "The refractive index around the stone: 1 for air, the liquid's index when the stone is photographed in immersion. When it equals the stone's, light does not bend at the surface.";
                        editable: !root.busy;
                        value <=> root.surround_n_text;
                    }
                }

                FormTitle { text: "FILL THE EIGHT VIEWS"; }
                HorizontalLayout {
                    spacing: 8px;
                    RoughField {
                        label: "Distance (mm)";
                        hint: "How far each camera is from the stone, in millimetres.";
                        editable: !root.busy;
                        value <=> root.gen_distance;
                    }
                    RoughField {
                        label: "Elevation (deg)";
                        hint: "How far above (upper cameras) or below (lower cameras) the horizontal each camera looks at the stone.";
                        editable: !root.busy;
                        value <=> root.gen_elevation;
                    }
                    RoughField {
                        label: root.gen_ortho ? "Scale (px/mm)" : "Focal length (px)";
                        hint: "The focal length in pixels, or for an orthographic (telecentric) lens its scale in pixels per millimetre.";
                        editable: !root.busy;
                        value <=> root.gen_scale;
                    }
                    RoughField {
                        label: "Image width (px)";
                        hint: "The photos' width in pixels.";
                        editable: !root.busy;
                        value <=> root.gen_width;
                    }
                    RoughField {
                        label: "Image height (px)";
                        hint: "The photos' height in pixels.";
                        editable: !root.busy;
                        value <=> root.gen_height;
                    }
                    VerticalLayout {
                        alignment: end;
                        spacing: 2px;
                        RoughPill {
                            text: root.gen_ortho ? "Orthographic" : "Pinhole";
                            hint: "Whether the generated views use a pinhole camera or an orthographic (telecentric) lens.";
                            active: root.gen_ortho;
                            enabled: !root.busy;
                            clicked => { root.gen_ortho = !root.gen_ortho; }
                        }
                        RoughPill {
                            text: "Fill the 8 views";
                            hint: "Replace the views below with the default layout: +X, -X, +Y and -Y, each from an upper and a lower camera, all looking at the origin.";
                            enabled: !root.busy;
                            clicked => { root.fill_layout(); }
                        }
                    }
                }

                FormTitle { text: "VIEWS (positions and directions in the rig's frame, in mm; the photos' pixels for the rest)"; }
                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.bg-dark;
                    border-radius: Theme.radius-md;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    clip: true;

                    ScrollView {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                        content-width: 1130px;

                        VerticalLayout {
                            padding: 6px;
                            spacing: 3px;
                            alignment: start;

                            HorizontalLayout {
                                spacing: 2px;
                                height: 16px;
                                for label[j] in root.field_labels: Text {
                                    width: j == 0 ? 100px : 64px;
                                    text: label;
                                    font-size: 10px;
                                    color: Theme.text-muted;
                                    vertical-alignment: center;
                                }
                                Text {
                                    width: 90px;
                                    text: "Lens";
                                    font-size: 10px;
                                    color: Theme.text-muted;
                                    vertical-alignment: center;
                                }
                            }

                            for row[i] in root.view_rows: HorizontalLayout {
                                spacing: 2px;
                                height: 26px;
                                for field[j] in row.fields: LineEdit {
                                    width: j == 0 ? 100px : 64px;
                                    text: field;
                                    enabled: !root.busy;
                                    accessible-label: "View " + (i + 1) + " " + root.field_labels[j];
                                    edited(t) => { root.field_edited(i, j, t); }
                                }
                                VerticalLayout {
                                    width: 90px;
                                    alignment: center;
                                    RoughPill {
                                        text: row.orthographic ? "Orthographic" : "Pinhole";
                                        hint: "Switch this view between a pinhole camera and an orthographic (telecentric) lens. Its Scale is then the focal length in pixels or the pixels per millimetre.";
                                        active: row.orthographic;
                                        enabled: !root.busy;
                                        clicked => { root.projection_toggled(i); }
                                    }
                                }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    RoughPill {
                        text: "Save rig";
                        hint: "Store this rig in the settings file under its name. Changing a view's pose clears the rig's calibration, because it described the old poses.";
                        active: true;
                        enabled: !root.busy;
                        clicked => { root.save_rig(); }
                    }
                    Text {
                        text: root.calibration_info;
                        font-size: 11px;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                    }
                }
            }

            // The Calibrate tab.
            if root.tab == 1: HorizontalLayout {
                vertical-stretch: 1;
                spacing: 10px;

                Rectangle {
                    width: 350px;
                    background: Theme.bg-dark;
                    border-radius: Theme.radius-md;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    clip: true;

                    ScrollView {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;

                        VerticalLayout {
                            padding: 10px;
                            spacing: 6px;
                            alignment: start;

                            FormTitle { text: "THE CUBE"; }
                            FormNote { text: "Photograph a beam-splitter cube of known size at the stone's place, in every view, against a backlight or a dark field so its edges are sharp. Put a small opaque dot (paint or tape) on the corner at +X +Y +Z, the corner nearest the +X camera's upper side."; }
                            HorizontalLayout {
                                spacing: 6px;
                                RoughField {
                                    label: "Edge (mm)";
                                    hint: "The cube's datasheet edge length in millimetres.";
                                    editable: !root.busy;
                                    value <=> root.cube_edge;
                                }
                                RoughField {
                                    label: "Tolerance (mm)";
                                    hint: "The datasheet's tolerance of the edge length, plus or minus, in millimetres.";
                                    editable: !root.busy;
                                    value <=> root.cube_tolerance;
                                }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                RoughField {
                                    label: "Glass n_d";
                                    hint: "The glass's refractive index: 1.5168 for N-BK7, unless the datasheet says otherwise.";
                                    editable: !root.busy;
                                    value <=> root.cube_n;
                                }
                                RoughField {
                                    label: "Focal length known to (%)";
                                    hint: "How well the focal lengths in the rig are known, in percent. Small when you know them (the scale check then means something), larger when they are rough guesses.";
                                    editable: !root.busy;
                                    value <=> root.focal_sigma;
                                }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    text: "Coated diagonal runs along:";
                                    font-size: 10px;
                                    color: Theme.text-muted;
                                    vertical-alignment: center;
                                }
                                TipBox {
                                    hint: "The rig axis the coated diagonal plane is parallel to.";
                                    ComboBox {
                                        min-width: 0px;
                                        model: ["X", "Y", "Z"];
                                        current-index <=> root.diag_axis_index;
                                        enabled: !root.busy;
                                        accessible-label: "Axis the coated diagonal is parallel to";
                                    }
                                }
                                RoughPill {
                                    text: "Mirrored";
                                    hint: "The diagonal runs the other way round (from the other pair of cube edges).";
                                    active: root.diag_mirrored;
                                    enabled: !root.busy;
                                    clicked => { root.diag_mirrored = !root.diag_mirrored; }
                                }
                            }

                            FormTitle { text: "PHOTOS"; }
                            for slot[i] in root.slots: Rectangle {
                                height: 38px;
                                border-radius: Theme.radius-sm;
                                background: slot.active ? Theme.surface-selected : (slot_touch.has-hover ? Theme.bg-card-hover : Theme.bg-card);
                                slot_touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.select_view(i); }
                                }
                                HorizontalLayout {
                                    padding: 4px;
                                    spacing: 6px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        ElidedText {
                                            text: slot.name;
                                            font_size: 11px;
                                            font_weight: 700;
                                            text_color: slot.active ? Theme.accent-cyan : Theme.text-primary;
                                        }
                                        ElidedText {
                                            text: slot.file == "" ? "no photo" : (slot.status == "" ? slot.file : slot.file + " \u{2014} " + slot.status);
                                            font_size: 10px;
                                            text_color: Theme.text-muted;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        RoughPill {
                                            text: slot.loaded ? "Replace..." : "Load...";
                                            hint: "Pick the cube photo of this view (PNG or JPEG).";
                                            enabled: !root.busy;
                                            clicked => { root.load_photo(i); }
                                        }
                                    }
                                }
                            }

                            FormTitle { text: "CALIBRATE"; }
                            FormNote { text: "Pass 1 fits the poses and focal lengths from the cube's outer edges. Pass 2 (optional) marks the coated diagonal's four edges, as seen through the glass, and measures the rig's accuracy against the true plane."; }
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                RoughPill {
                                    text: "Calibrate";
                                    hint: "Fit the rig to the marks on the cube photos. Needs outer edges in at least two views.";
                                    active: true;
                                    enabled: !root.busy;
                                    clicked => { root.calibrate(); }
                                }
                                RoughPill {
                                    text: "Save calibrated rig";
                                    hint: root.can_save_calibrated ? "Store the refined poses and focal lengths, with the measured accuracy, in the picked rig." : "Calibrate first.";
                                    enabled: !root.busy && root.can_save_calibrated;
                                    clicked => { root.save_calibrated(); }
                                }
                            }
                            if root.calib_text != "": FormNote { text: root.calib_text; text_color: Theme.text-secondary; }
                            FormRows { rows: root.calib_rows; }
                            if root.caveat != "": FormNote { text: root.caveat; text_color: Theme.accent-amber; }
                        }
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 6px;

                    HorizontalLayout {
                        height: 22px;
                        spacing: 6px;

                        ElidedText {
                            text: root.view_title;
                            font_size: 12px;
                            font_weight: 700;
                        }
                        RoughPill {
                            text: "Edge";
                            hint: "Click the two ends of a visible outer edge of the cube. Any two points along the edge will do. Mark every edge you can see.";
                            active: root.mode_index == 0;
                            clicked => { root.mode_index = 0; root.mode_changed(0); }
                        }
                        RoughPill {
                            text: "Dot";
                            hint: "Click the orientation dot at the cube's +X +Y +Z corner.";
                            active: root.mode_index == 1;
                            clicked => { root.mode_index = 1; root.mode_changed(1); }
                        }
                        RoughPill {
                            text: "Diag 1";
                            hint: "Click several points along the first edge of the coated diagonal, as seen through the glass.";
                            active: root.mode_index == 2;
                            clicked => { root.mode_index = 2; root.mode_changed(2); }
                        }
                        RoughPill {
                            text: "Diag 2";
                            hint: "Click several points along the second edge of the coated diagonal.";
                            active: root.mode_index == 3;
                            clicked => { root.mode_index = 3; root.mode_changed(3); }
                        }
                        RoughPill {
                            text: "Diag 3";
                            hint: "Click several points along the third edge of the coated diagonal.";
                            active: root.mode_index == 4;
                            clicked => { root.mode_index = 4; root.mode_changed(4); }
                        }
                        RoughPill {
                            text: "Diag 4";
                            hint: "Click several points along the fourth edge of the coated diagonal.";
                            active: root.mode_index == 5;
                            clicked => { root.mode_index = 5; root.mode_changed(5); }
                        }
                        RoughPill {
                            text: "Undo click";
                            hint: "Take back the last click of the chosen tool in this view.";
                            clicked => { root.undo_click(); }
                        }
                        RoughPill {
                            text: "Clear view";
                            hint: "Remove every mark in this view.";
                            clicked => { root.clear_view(); }
                        }
                        RoughPill {
                            text: "1x";
                            hint: "Show the whole photo.";
                            active: root.zoom == 1;
                            clicked => { root.zoom = 1; }
                        }
                        RoughPill {
                            text: "4x";
                            hint: "Zoom in four times. Scroll to move around.";
                            active: root.zoom == 4;
                            clicked => { root.zoom = 4; }
                        }
                    }

                    PhotoCanvas {
                        vertical-stretch: 1;
                        photo: root.photo;
                        image_w: root.image_w;
                        image_h: root.image_h;
                        has_photo: root.has_photo;
                        markers: root.markers;
                        paths: root.paths;
                        zoom: root.zoom;
                        empty_text: "Load the cube photo of this view.";
                        clicked(fx, fy) => { root.canvas_clicked(fx, fy); }
                    }
                }
            }
        }
    }
}
