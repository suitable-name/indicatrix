    RenderJobsModel, RenderJobRow
}

// --- Sizing notes -----------------------------------------------------------
// 1. No layout constraint computed anywhere in this file (or anything it
//    pulls in) may reach `MainWindow` itself. The OS window's minimum AND
//    maximum size are derived from its content tree's computed layout
//    constraints: a stray `min-height` deep in a child component used to
//    force the window bigger than `MainWindow.min-height`, and -- the
//    subtler failure -- a component whose root is a plain `Rectangle` over a
//    layout of fixed-size children inherits that layout's small MAXIMUM, a
//    `HorizontalLayout` takes the smallest maximum of its children as its
//    own, and the window ends up with max-height == min-height, i.e. not
//    resizable in height (that was `CollapsedLibraryRail`, 38px). The fix:
//    the window's whole content is wrapped in a `Rectangle` positioned with
//    explicit `x`/`y` (see `global_shortcuts` below) -- an explicitly
//    positioned child is excluded from its parent's constraint computation
//    entirely -- and content that would have overflowed clips instead of
//    pushing the window around. Inside that wrapper the same rule still
//    applies to rows and columns: an overlay layout with only fixed-size
//    rows must not be a plain constraint-propagating child of a viewport
//    (`gem_viewport.slint`/`solid_viewport.slint` position theirs with
//    `x`/`y` for exactly this reason), and a component that is only a
//    stack of fixed-size children should use `alignment: start` so its
//    maximum stays unbounded (`CollapsedLibraryRail`).
// 2. Resizable sections (the Edit sub-tab's viewport|dock split, and its
//    tier-table|inspector split) are sized by drag handles
//    (`ui/components/split_handle.slint`) whose clamping lives in plain
//    Slint expressions, not Rust -- see the `SplitHandle` instances below and
//    in `editor_view.slint` for the clamp formulas, and `EditorModel.
//    dock_width`/`inspector_height` for where the clamped result lands.
// -----------------------------------------------------------------------------
export component MainWindow inherits Window {
    /// Currently loaded design's display name (bare .asc file name or catalogue title).
    /// Empty for brand-new, never-saved design. Set from native_io's Save/Open paths
    /// and from tier_actions' New Design and Load Selected callbacks.
    in property <string> loaded_design_name: "";

    // Leading "* " marker while Edit tab has unsaved changes (EditorModel.is_dirty).
    // same way it guards every other Edit-tab-only affordance in this file: a
    // non-`editor`-feature build never sets `is_dirty` at all, but this stays
    // explicit rather than relying on that default.
    title: (EditorModel.enabled && EditorModel.is_dirty ? "* " : "")
        + "Indicatrix Cut"
        + (root.loaded_design_name == "" ? "" : " — " + root.loaded_design_name);
    // The titlebar/taskbar icon. The `.exe`'s embedded icon resource (build.rs) only
    // covers Explorer: winit registers its window class without an icon, so a window
    // with no `icon` of its own shows the generic Windows application icon. Slint
    // embeds the image in the binary, so nothing needs to be installed beside it.
    // Every other top-level window sets the same icon.
    icon: @image-url("../assets/icon.png");
    preferred-width: 1600px;
    preferred-height: 900px;
    // Kept below the 1100px stacking threshold so a window between 720-1099px
    // still exercises the narrow (<1100px, stacked) layout further down
    // rather than the side-by-side split it has no room for -- `EditorView`'s
    // own command bar/design settings need real room, and `clip: true` is
    // what keeps a window this narrow readable instead of unreadable.
    min-width: 720px;
    min-height: 480px;
    background: Theme.bg-darkest;
    default-font-family: "Segoe UI";

    in-out property <int> active_tab: 0; // 0: 3D Gem, 1: Cutting Table, 2: Attachments
    callback active_tab_changed(int);
    in-out property <int> render_view_tab: 0;
    callback render_view_tab_changed(int);
    // Fired when the Edit sub-tab becomes the shown one, so the editor can take the
    // shared 3D viewport back from a Library selection.
    callback edit_view_entered();

    callback open_user_manual();

    // File > Open Recent: up to ten design-file paths, persisted in the settings
    // store -- populated once at startup from `AppSettings.recent_native_files`
    // (`gui::startup_settings::apply_loaded_ui_mirrors`) and kept live afterward by
    // `gui::editor::native_io::record_recent_native_file` on every successful Save
    // or Open of a design file (never written back to from Slint itself).
    // `open_recent_native_file` fires with the clicked entry's own path text.
    in property <[string]> recent_native_files: [];
    callback open_recent_native_file(string);

    // The window-close unsaved-changes guard: `gui::mod::build_main_window`'s
    // `on_close_requested` sets this instead of closing outright when
    // `EditorModel.is_dirty` is true, and its own `close_confirm_save`/
    // `close_confirm_discard` handlers do the actual `render_ctx.running = false` +
    // settings-flush + `window().hide()` that an ordinary close does
    // unconditionally. Cancel needs no Rust round trip -- it only ever resets this
    // property, handled inline below. The same guard also stops a close that would only
    // lose Rough Planner work (unsaved results, a running plan): `on_close_requested`
    // then sets `close_confirm_message` to what would be lost and `close_confirm_can_save`
    // to false, because there is no design to save, and the dialog hides its Save button.
    in-out property <bool> close_confirm_open: false;
    in-out property <string> close_confirm_message: "Closing the window will discard the current design's unsaved changes.";
    in-out property <bool> close_confirm_can_save: true;
    callback close_confirm_save();
    callback close_confirm_discard();

    in property <string> toast_message: "";
    in-out property <bool> toast_visible: false;
    in property <string> toast_type: "info";
    in-out property <int> toast_generation: 0;

    // Re-clamps `EditorModel.dock_width` against `available` (the Edit-mode row's
    // actual current width), using the exact same bounds the `SplitHandle` drag
    // handler below computes from an incremental delta -- `600px`/`1000px`/`380px`
    // must stay in lock-step with that clamp expression. Takes the width as a
    // parameter rather than reading an id directly, since its only call sites live
    // inside the `if root.render_view_tab == 1 && EditorModel.enabled` branch further
    // down and a conditional element's own id cannot be referenced from a function
    // declared on the root. `6px` is `SplitHandle`'s fixed thickness on this axis.
    function reclamp_dock_width(available: length) {
        EditorModel.dock_width = clamp(
            EditorModel.dock_width,
            600px,
            min(1000px, max(600px, available - 380px - 6px - 24px - (GuideModel.open ? 272px : 0px)))
        );
        EditorModel.layout_changed();
    }

    // Whether `LibraryModel.panel_collapsed` is currently `true`
    // because THIS reaction collapsed it for lack of width, as opposed to the user
    // having collapsed it themselves via `diagram_list.slint`'s own rail toggle.
    // Only that first case is ever auto-restored below -- a manual collapse must
    // never be silently reopened just because the window happened to grow again.
    // Deliberately does NOT call `LibraryModel.panel_collapsed_changed` (the manual
    // toggle's own persistence hook, `gui::mod::build_main_window`'s
    // `on_panel_collapsed_changed`): a width-driven collapse is a transient display
    // adjustment, not a change to the user's saved preference, and firing that
    // callback here would silently overwrite it on every resize.
    property <bool> library_auto_collapsed_by_width: false;
    function sync_library_auto_collapse() {
        if root.render_view_tab == 1 && EditorModel.enabled && root.active_tab == 0 {
            if root.width < 1200px && !LibraryModel.panel_collapsed {
                root.library_auto_collapsed_by_width = true;
                LibraryModel.panel_collapsed = true;
            } else if root.width >= 1200px && root.library_auto_collapsed_by_width {
                root.library_auto_collapsed_by_width = false;
                LibraryModel.panel_collapsed = false;
            }
        } else if root.library_auto_collapsed_by_width {
            root.library_auto_collapsed_by_width = false;
            LibraryModel.panel_collapsed = false;
        }
    }
    // Re-evaluated on every trigger that can make the rule above start/stop
    // applying, not only an actual resize -- switching INTO the Edit sub-tab while
    // already narrower than 1200px needs the same collapse `changed width` alone
    // would miss (nothing there changes width itself).
    changed width => { root.sync_library_auto_collapse(); }
    changed render_view_tab => {
        root.sync_library_auto_collapse();
        if root.render_view_tab == 1 { root.edit_view_entered(); }
    }
    changed active_tab => { root.sync_library_auto_collapse(); }

    // The command palette bumps `restore_focus_pulse` whenever it closes. Its search field
    // held the keyboard focus and is removed with it, which would leave no focused item and
    // silence every shortcut until the next click; taking the focus back here avoids that.
    // A command chosen in the palette runs a moment after this (see `gui::commands`), so a
    // dialog that command opens still ends up with the focus.
    property <int> command_palette_focus_pulse: CommandPaletteModel.restore_focus_pulse;
    changed command_palette_focus_pulse => { global_shortcuts.focus(); }

    // The empty state's "Start from a library design" card bumps `library_search_pulse`
    // (after opening the library panel): the cursor goes into the library's search box.
    property <int> library_search_pulse: TutorialsModel.library_search_pulse;
    changed library_search_pulse => { header_toolbar.focus_search(); }

    // Whether the welcome dialog shows: a new user's first start (or "Show the welcome tour
    // again"), once Preferences and the start-up restore question are out of the way.
    property <bool> welcome_open: PreferencesModel.first_run_tour_pending && EditorModel.enabled
        && !PreferencesModel.dialog_open && EditorModel.startup_restore_path == "";
    // The browser and the welcome dialog hold the keyboard while open and take it with them
    // when they go; the main window takes it back here, unless the answer opened a dialog of
    // its own (the New Design dialog, the unsaved-changes question), which keeps it.
    property <bool> tutorials_browser_open: TutorialsModel.browser_open;
    changed tutorials_browser_open => {
        if !root.tutorials_browser_open && !EditorModel.new_dialog_open && !EditorModel.unsaved_dialog_open {
            global_shortcuts.focus();
        }
    }
    changed welcome_open => {
        if !root.welcome_open && !EditorModel.new_dialog_open && !EditorModel.unsaved_dialog_open {
            global_shortcuts.focus();
        }
    }
    // The Edit as Text dialog holds the keyboard while open (its text box takes it on opening)
    // and the main window takes it back when the dialog closes.
    property <bool> raw_text_open: RawTextModel.is_open;
    changed raw_text_open => {
        if !root.raw_text_open && !EditorModel.new_dialog_open && !EditorModel.unsaved_dialog_open {
            global_shortcuts.focus();
        }
    }
    // The Angle Sweep dialog the same way: it takes the keyboard on opening and gives it back.
    property <bool> sweep_open: SweepModel.dialog_open;
    changed sweep_open => {
        if !root.sweep_open && !EditorModel.new_dialog_open && !EditorModel.unsaved_dialog_open {
            global_shortcuts.focus();
        }
    }
    // Cutting mode the same way: its screen takes the keyboard on opening and the main window
    // takes it back when the screen closes.
    property <bool> cutting_mode_open: CuttingModeModel.open;
    changed cutting_mode_open => {
        if !root.cutting_mode_open && !EditorModel.new_dialog_open && !EditorModel.unsaved_dialog_open {
            global_shortcuts.focus();
        }
    }

    // --- MENU BAR ---
    // NOTE: the Slint compiler requires `MenuBar` to be a direct child of a
    // `Window`-inheriting component ("MenuBar can only be within a Window
    // element") -- it cannot be moved into a separate component the way the
    // tab-pill row and the dialog overlay below were, so it stays here.
    MenuBar {
        Menu {
            title: "File";
            // Every accelerator text below is a label only -- the
            // actual key handling lives in `global_shortcuts.key-pressed` further
            // down, kept in lock-step by hand since a `MenuItem` has no accelerator
            // property of its own to bind.
            MenuItem {
                // Matches the command bar's own "New Design..." label -- both
                // start a brand-new design (discarding the current one),
                // unlike the inspector's unrelated "New Tier" button.
                title: "New Design... (Ctrl+N)";
                enabled: EditorModel.enabled && GuideModel.allows_new_design();
                activated => { EditorModel.new_dialog_open = true; }
            }
            MenuItem {
                title: "Open... (Ctrl+O)";
                enabled: EditorModel.enabled && GuideModel.allows_file_ops();
                activated => { EditorModel.open_native(); }
            }
            Menu {
                title: "Open Recent";
                enabled: EditorModel.enabled && root.recent_native_files.length > 0 && GuideModel.allows_file_ops();
                for path in root.recent_native_files: MenuItem {
                    title: path;
                    activated => { root.open_recent_native_file(path); }
                }
            }
            MenuItem {
                title: "Save (Ctrl+S)";
                enabled: EditorModel.enabled && GuideModel.allows_file_ops();
                activated => { EditorModel.save_native(); }
            }
            MenuItem {
                title: "Save As... (Ctrl+Shift+S)";
                enabled: EditorModel.enabled && GuideModel.allows_file_ops();
                activated => { EditorModel.save_native_as(); }
            }
            MenuItem {
                title: "Export Edited .asc";
                enabled: EditorModel.enabled && GuideModel.allows_file_ops();
                activated => { EditorModel.export_asc(); }
            }
            // Experimental: the `.gcs` writer follows the published Gem Cut Studio
            // 1.1 file description; the command bar's "Export..." entry carries
            // the tooltip saying so (a `MenuItem` has no tooltip).
            // Advanced: the Simple interface leaves it out, as it does the command bar's entry.
            if GuideModel.shows_advanced(): MenuItem {
                title: "Export as Gem Cut Studio (.gcs)... (experimental)";
                enabled: EditorModel.enabled && GuideModel.allows_file_ops();
                activated => { EditorModel.export_gcs(); }
            }
            // The render queue's Jobs window (also opened by the header's Jobs chip).
            MenuItem {
                title: "Render Jobs...";
                activated => { RenderJobsModel.panel_open = true; }
            }
            // "Export Cutting Sheet (HTML)..."/"Export Diagram (PNG)..." live on
            // the command bar's own "Export..." split button
            // (`ui/components/export_split_button.slint`, mounted in
            // `editor_command_bar.slint` next to Save), not on this File
            // menu -- same `EditorModel.export_cutting_sheet()`/`export_diagram()`
            // callbacks, just one menu instead of two to know to open.
        }
        Menu {
            title: "Edit";
            // `UndoRedoLabels.undo_label`/`redo_label` -- a cutter-facing summary of
            // what Ctrl+Z/Ctrl+Y will actually do (e.g. "Undo: Set P1 angle to
            // -41.0 degrees"), from `Edit::describe` via
            // `History::peek_undo`/`peek_redo`. `gui::editor::view::panel` pushes
            // both after every edit (`ui.global::<UndoRedoLabels>().set_undo_label`/
            // `set_redo_label`); empty only when there is nothing to undo/redo,
            // matching `can_undo`/`can_redo` above.
            MenuItem {
                title: (EditorModel.can_undo && UndoRedoLabels.undo_label != "" ? "Undo: " + UndoRedoLabels.undo_label : "Undo") + " (Ctrl+Z)";
                enabled: EditorModel.enabled && EditorModel.can_undo && GuideModel.allows_history();
                activated => { EditorModel.undo(); }
            }
            MenuItem {
                title: (EditorModel.can_redo && UndoRedoLabels.redo_label != "" ? "Redo: " + UndoRedoLabels.redo_label : "Redo") + " (Ctrl+Y)";
                enabled: EditorModel.enabled && EditorModel.can_redo && GuideModel.allows_history();
                activated => { EditorModel.redo(); }
            }
            // The cutting instructions as editable `.asc` text (`gui::editor::raw_text`). Not
            // offered while a confirm dialog waits for an answer, like the command palette.
            // Edit as Text and Angle Sweep are advanced: the Simple interface leaves them out of
            // the menu (the palette still lists them, with its own availability rules).
            if GuideModel.shows_advanced(): MenuItem {
                title: "Edit as Text...";
                enabled: EditorModel.enabled && EditorModel.has_design && GuideModel.allows_advanced()
                    && !RawTextModel.is_open && !EditorModel.unsaved_dialog_open
                    && !EditorModel.write_confirm_open && !EditorModel.mismatch_dialog_open
                    && !root.close_confirm_open;
                activated => { RawTextModel.open(); }
            }
            // One tier's angle over a range, as a table, a chart and CSV (`gui::editor::sweep`).
            // Not offered while a confirm dialog waits for an answer, like the command palette.
            if GuideModel.shows_advanced(): MenuItem {
                title: "Angle Sweep...";
                enabled: EditorModel.enabled && EditorModel.has_design && GuideModel.allows_advanced()
                    && !SweepModel.dialog_open && !EditorModel.unsaved_dialog_open
                    && !EditorModel.write_confirm_open && !EditorModel.mismatch_dialog_open
                    && !root.close_confirm_open;
                activated => { SweepModel.open_dialog(); }
            }
            // The cutting steps one page at a time over the whole window, with done marks kept
            // for the design (`gui::editor::cutting_mode`). Dim while there is nothing to cut
            // (no design, no tiers, a design that does not solve); the command bar's Cut Mode
            // button shows the reason. Not offered while a confirm dialog waits for an answer.
            MenuItem {
                title: "Cutting Mode...";
                enabled: EditorModel.enabled && CuttingModeModel.unavailable_reason() == ""
                    && GuideModel.allows_advanced() && !CuttingModeModel.open
                    && !EditorModel.unsaved_dialog_open && !EditorModel.write_confirm_open
                    && !EditorModel.mismatch_dialog_open && !root.close_confirm_open;
                activated => { CuttingModeModel.open_cutting_mode(); }
            }
            // App-wide preferences, not about one design: the Simple/Advanced interface,
            // UI scale, high contrast, larger handles and tutorials. Locked with the other
            // advanced controls while the worked-example guide runs.
            MenuItem {
                title: "Preferences... (Ctrl+,)";
                enabled: GuideModel.allows_advanced();
                activated => { PreferencesModel.dialog_open = true; }
            }
            // A search box over every command in the app (`gui::commands`). Not offered
            // while a confirm dialog waits for an answer, so the palette cannot be used to
            // act behind it.
            MenuItem {
                title: "Command Palette... (Ctrl+K)";
                enabled: !EditorModel.unsaved_dialog_open && !EditorModel.write_confirm_open
                    && !EditorModel.mismatch_dialog_open && !root.close_confirm_open
                    && EditorModel.startup_restore_path == "";
                activated => { CommandPaletteModel.open_palette(); }
            }
        }
        // Whole-catalogue batches (`gui::batch::regenerate_all`): each item opens the
        // same confirm step the other triggers use. Disabled only while that batch is
        // RUNNING (`start_batch` refuses a second one anyway). A showing confirm step
        // or finished summary does not block the menu: `offer_batch_confirmation`
        // rewrites the whole offer, so re-offering over it is harmless, and gating on
        // `*_visible` left the menu dead whenever a dialog was left open.
        Menu {
            title: "Library";
            // The three whole-library batches are advanced: the Simple interface leaves them out.
            if GuideModel.shows_advanced(): MenuItem {
                title: "Regenerate All Preview Images...";
                enabled: !BatchModel.preview_batch_running;
                activated => { LibraryModel.regenerate_all_previews(); }
            }
            if GuideModel.shows_advanced(): MenuItem {
                title: "Regenerate All Tilt Curves...";
                enabled: !BatchModel.tilt_batch_running;
                activated => { LibraryModel.regenerate_all_tilt_curves(); }
            }
            if GuideModel.shows_advanced(): MenuItem {
                title: "Regenerate Both...";
                enabled: !BatchModel.preview_batch_running && !BatchModel.tilt_batch_running;
                activated => { LibraryModel.regenerate_all_previews_and_tilt_curves(); }
            }
            MenuItem {
                title: "Plan Rough...";
                activated => { RoughPlanModel.open(); }
            }
            // The actions of the library list's right-click menu, for the design selected in the
            // list, so they can be reached from the keyboard too (a right-click menu is mouse
            // only). Dim while no design is selected.
            Menu {
                title: "Selected Design";
                enabled: LibraryModel.selected_entry_id >= 0;
                MenuItem {
                    title: "Generate Previews";
                    activated => { LibraryModel.generate_previews_for_entry(LibraryModel.selected_entry_id); }
                }
                MenuItem {
                    title: "Compute Tilt Curves";
                    activated => { LibraryModel.compute_tilt_curves_for_entry(LibraryModel.selected_entry_id); }
                }
                MenuItem {
                    title: "Ignore or Un-ignore";
                    activated => { LibraryModel.toggle_ignored(LibraryModel.selected_entry_id); }
                }
                MenuItem {
                    title: "Exclude from or Include in Planner";
                    activated => { LibraryModel.toggle_planner_excluded(LibraryModel.selected_entry_id); }
                }
                MenuItem {
                    title: "Build this Design";
                    enabled: !BuildDesignModel.busy;
                    activated => { BuildDesignModel.start(LibraryModel.selected_entry_id); }
                }
            }
        }
        Menu {
            title: "Help";
            // Opens the in-app help window at the contents (`gui::help`); the glossary is
            // a dialog over this window (`GlossaryDialog`, mounted below).
            MenuItem {
                title: "User Manual";
                activated => { root.open_user_manual(); }
            }
            // The manual page for what is on screen (F1); Rust picks it (`gui::help::context`).
            MenuItem {
                title: "Help for This Screen (F1)";
                activated => { HelpModel.open_context_help(); }
            }
            MenuItem {
                title: "Glossary";
                activated => { HelpModel.open_glossary(""); }
            }
            // Opens the keyboard-shortcuts overlay and the worked-example
            // walkthrough -- see `ui/models/shortcuts.slint`/`ui/models/guide.slint`.
            MenuItem {
                title: "Keyboard Shortcuts";
                activated => { ShortcutsModel.open = true; }
            }
            MenuItem {
                title: "Guide: New Design Walkthrough";
                enabled: EditorModel.enabled;
                activated => { GuideModel.start(); }
            }
            // The tutorial browser: a short guided lesson for each tool -- see
            // `ui/models/tutorials.slint`.
            MenuItem {
                title: "Tutorials...";
                enabled: EditorModel.enabled;
                activated => { TutorialsModel.open_browser(); }
            }
        }
    }

    // --- GLOBAL KEYBOARD SHORTCUTS ---
    global_shortcuts := FocusScope {
        width: 100%;
        height: 100%;
        init => { self.focus(); }
        key-pressed(event) => {
            // Shift-modified first: the plain branch below excludes Shift, so the
            // order is not load-bearing, but reading them adjacently is. Slint
            // reports a shifted letter in upper case, hence "S" here and "s" below.
            // Every action arm also checks the same `GuideModel.allows_*()` helper
            // as its button, so a control the worked-example guide locks stays
            // locked from the keyboard too (the key is still swallowed).
            // Cutting mode covers the window and takes every key; its own screen handles them
            // first, this is the fallback when the keyboard focus is somewhere else.
            if CuttingModeModel.open {
                CuttingModeModel.handle_key(event.text, event.modifiers.control || event.modifiers.meta || event.modifiers.alt);
                return accept;
            }
            if (event.modifiers.control || event.modifiers.meta) && event.modifiers.shift && event.text == "S" {
                if EditorModel.enabled && GuideModel.allows_file_ops() {
                    EditorModel.save_native_as();
                }
                return accept;
            } else if (event.modifiers.control || event.modifiers.meta) && !event.modifiers.shift && event.text == "s" {
                if EditorModel.enabled && GuideModel.allows_file_ops() {
                    EditorModel.save_native();
                }
                return accept;
            } else if (event.modifiers.control || event.modifiers.meta) && !event.modifiers.shift && event.text == "z" {
                // A text field mid-correction (a facet name, a
                // typed angle) must keep Ctrl+Z for itself -- without this guard
                // the design's last edit was undone instead, with no on-screen
                // explanation, while the caret sat unmoved in the field. See
                // `EditorModel.text_focus`'s own doc comment for what sets this
                // and which files still need to.
                if EditorModel.enabled && !EditorModel.text_focus && GuideModel.allows_history() {
                    EditorModel.undo();
                }
                return accept;
            } else if (event.modifiers.control || event.modifiers.meta) && (event.text == "y" || (event.modifiers.shift && event.text == "Z")) {
                // Same guard as Ctrl+Z above.
                if EditorModel.enabled && !EditorModel.text_focus && GuideModel.allows_history() {
                    EditorModel.redo();
                }
                return accept;
            } else if (event.modifiers.control || event.modifiers.meta) && event.text == "f" {
                // On the Edit tab, Ctrl+F belongs to the tier
                // filter, not the catalogue search -- the cutter is looking at a
                // schedule, not a library. Everywhere else it keeps its usual target.
                if root.active_tab == 0 && root.render_view_tab == 1 && EditorModel.enabled {
                    EditorModel.filter_focus_pulse += 1;
                } else {
                    header_toolbar.focus_search();
                }
                return accept;
            } else if (event.modifiers.control || event.modifiers.meta) && !event.modifiers.shift && event.text == "n" {
                if EditorModel.enabled && GuideModel.allows_new_design() {
                    EditorModel.new_dialog_open = true;
                }
                return accept;
            } else if (event.modifiers.control || event.modifiers.meta) && !event.modifiers.shift && event.text == "o" {
                if EditorModel.enabled && GuideModel.allows_file_ops() {
                    EditorModel.open_native();
                }
                return accept;
            } else if (event.modifiers.control || event.modifiers.meta) && !event.modifiers.shift && event.text == "e" {
                // Toggles the 3D Gem tab's Live Render/Edit pill --
                // only meaningful (and only offered as a pill at all) while the Edit
                // sub-tab exists. Back to Edit always works; over to Live Render
                // only while the guide leaves the view tabs unlocked.
                if EditorModel.enabled && (root.render_view_tab == 0 || GuideModel.allows_view_tabs()) {
                    root.render_view_tab = root.render_view_tab == 0 ? 1 : 0;
                    root.render_view_tab_changed(root.render_view_tab);
                }
                return accept;
            } else if (event.modifiers.control || event.modifiers.meta) && event.text == "1" {
                root.active_tab = 0;
                root.active_tab_changed(0);
                return accept;
            } else if (event.modifiers.control || event.modifiers.meta) && event.text == "2" {
                if GuideModel.allows_view_tabs() {
                    root.active_tab = 1;
                    root.active_tab_changed(1);
                }
                return accept;
            } else if (event.modifiers.control || event.modifiers.meta) && event.text == "3" {
                if GuideModel.allows_view_tabs() {
                    root.active_tab = 2;
                    root.active_tab_changed(2);
                }
                return accept;
            } else if (event.modifiers.control || event.modifiers.meta) && !event.modifiers.shift && event.text == "," {
                // Opens the Preferences dialog. A text field that is being typed into
                // keeps its own keys, like `?` below; the guide's lock follows the menu item.
                if !EditorModel.text_focus && GuideModel.allows_advanced() {
                    PreferencesModel.dialog_open = true;
                }
                return accept;
            } else if (event.modifiers.control || event.modifiers.meta) && !event.modifiers.shift && event.text == "k" {
                // Opens the command palette from anywhere, also while a text field has
                // focus: neither Ctrl+K nor Ctrl+Shift+P types a character, so no field
                // needs them. The palette's own search field keeps focus once it is open.
                CommandPaletteModel.open_palette();
                return accept;
            } else if (event.modifiers.control || event.modifiers.meta) && event.modifiers.shift && event.text == "P" {
                CommandPaletteModel.open_palette();
                return accept;
            } else if event.text == Key.F5 {
                // Documented (appendix-b-keyboard-shortcuts.md, 05-solving.md); gated the
                // same way the command bar's own Solve button is (`editor_command_bar.slint`)
                // so F5 cannot start a second solve on top of one already running.
                if EditorModel.enabled && !EditorModel.solve_running && GuideModel.allows_solve() {
                    EditorModel.solve();
                }
                return accept;
            } else if event.text == Key.F1 {
                // Help for this screen: the manual page for what is on screen (Rust picks it,
                // `gui::help::context`). Types no character, so it also works in a text field.
                HelpModel.open_context_help();
                return accept;
            } else if !event.modifiers.control && !event.modifiers.meta && !event.modifiers.alt
                    && (event.text == "1" || event.text == "2" || event.text == "3" || event.text == "4")
                    && root.active_tab == 0 && root.render_view_tab == 1 && EditorModel.enabled {
                // Solid/Diagram viewport view-mode shortcuts
                // (`SolidPreviewModel.view_mode` 0-3). Only bound while the Edit
                // sub-tab's Solid viewport is actually on screen, so a plain digit
                // typed anywhere else (the 3D Gem tab, or a text field that already
                // consumed it before this handler ever saw it -- `TextInput`
                // swallows unmodified printable keys while focused) is left alone.
                if event.text == "1" {
                    SolidPreviewModel.view_mode = 0;
                } else if event.text == "2" {
                    SolidPreviewModel.view_mode = 1;
                } else if event.text == "3" {
                    SolidPreviewModel.view_mode = 2;
                } else {
                    SolidPreviewModel.view_mode = 3;
                }
                return accept;
            } else if event.text == Key.Escape {
                // Global fallback: clears the tier selection and dismisses whatever toast
                // is showing. Only fires when nothing more specific (a dialog, the inline
                // angle editor) already consumed the key first.
                EditorModel.selected_tier_index = -1;
                root.toast_visible = false;
                return accept;
            } else if event.text == "?" && !EditorModel.text_focus {
                // Opens the Keyboard Shortcuts overlay -- same `!EditorModel.text_focus`
                // guard the Ctrl+Z/Ctrl+Y arms above already use, so typing a
                // literal "?" into a text field (a search box, a facet name)
                // is left alone.
                ShortcutsModel.open = true;
                return accept;
            }
            return reject;
        }

        // Wraps the whole window body -- see this file's "Sizing notes"
        // comment above (rule 1). The explicit `x`/`y` are load-bearing: the
        // Slint compiler only folds a child's layout constraints (minimum AND
        // maximum) into its parent when the child has no `x`/`y` binding
        // (`passes/default_geometry.rs`, `gen_layout_info_prop`). A child
        // that is positioned explicitly contributes nothing, so no minimum
        // or maximum computed anywhere below can reach `MainWindow`; the
        // window is left with only its own `min-*`/`preferred-*` above.
        // `clip: true` is what makes that safe: content that would have
        // overflowed at a size below its natural minimum clips instead of
        // spilling out or forcing the window bigger.
        Rectangle {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            clip: true;

        VerticalLayout {
            padding: 12px;
            // Tightens the gap above/below the app bar (this spacing) and around
            // the design header (below) -- part of the <=150px "app bar top to
            // viewport top" budget.
            spacing: 6px;

            // 1. TOP BAR
            // 1160px, not the 1100px stacking threshold below: the Simple | Advanced pill
            // widens the logo cluster by ~130px, and the one-row header needs about 1140px.
            header_toolbar := HeaderToolbar { compact: root.width < 1160px; }

            // 2. MAIN SPLIT WORKSPACE
            HorizontalLayout {
                spacing: 12px;

                if !LibraryModel.panel_collapsed: DiagramListView {}
                if LibraryModel.panel_collapsed: CollapsedLibraryRail {}

                // Right: Detail Area (Header + Tab/View-Pill Row + Tab Content)
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 6px;

                    DetailHeaderView {
                        compact: root.render_view_tab == 1 && EditorModel.enabled;
                        // `user_collapsed`'s own default-collapse-under-900px-window
                        // fallback (see that property's doc comment) reads this.
                        window_height: root.height;
                        // `narrow`'s own chip-wrap threshold (see that property's doc
                        // comment for why it reads the WINDOW's width, not this
                        // column's).
                        window_width: root.width;
                    }

                    // Catalogue tab pills + the Live Render/Edit view pills --
                    // see `TabViewPillRow`'s own doc comment
                    // (`components/app/tab_pill_row.slint`) for why this is split out.
                    TabViewPillRow {
                        compact: root.width < 1200px;
                        active_tab <=> root.active_tab;
                        active_tab_changed(v) => { root.active_tab_changed(v); }
                        render_view_tab <=> root.render_view_tab;
                        render_view_tab_changed(v) => { root.render_view_tab_changed(v); }
                    }

                    // Tab 0: 3D Preview
                    if root.active_tab == 0: VerticalLayout {
                        spacing: 8px;

                        // The Live Render/Edit view pills live in the shared
                        // tab/view-pill row above (see that row's own doc comment for why).
                        if root.render_view_tab == 0: GemViewportView {}

                        // Edit mode: the solid viewport and the resizable edit
                        // dock side by side (full column height), with a single
                        // status strip below spanning both -- see this file's own
                        // doc comment on the Edit-mode layout split
                        // (`editor_view.slint`/`editor_command_bar.slint`/
                        // `editor_design_settings.slint`/`editor_tier_table.slint`/
                        // `editor_inspector.slint`/`editor_status_strip.slint`).
                        // The viewport|dock split is dragged via `SplitHandle`
                        // (`ui/components/split_handle.slint`), bound to
                        // `EditorModel.dock_width` -- neither side carries a
                        // `min-width` (see this file's "Sizing notes" above): the
                        // viewport's own is already 0 (`solid_viewport.slint`),
                        // and the dock's minimum comes from this clamp instead,
                        // not from a layout minimum that could reach the window.
                        if root.render_view_tab == 1 && EditorModel.enabled: VerticalLayout {
                            spacing: 8px;
                            vertical-stretch: 1;

                            // Below ~1100px (plus 272px while the guide is docked), dock >= 600px + the
                            // viewport's own 380px + the handle + gaps already exceeds
                            // the window, so the side-by-side split below always left
                            // the dock (Detach/Duplicate/delete, first) silently
                            // clipped with nothing telling the user why. Below that
                            // width the viewport stacks ABOVE the dock instead (further
                            // down): `EditorView` then gets the window's own full,
                            // still-narrow width rather than whatever a side-by-side
                            // split would have left it -- the 380px reserved for the
                            // viewport is what was starving it.
                            if root.width >= 1100px + (GuideModel.open ? 272px : 0px): edit_row := HorizontalLayout {
                                spacing: 12px;
                                vertical-stretch: 1;

                                // Re-clamps a persisted `EditorModel.dock_width` against
                                // THIS row's actual width -- not only against the delta
                                // the drag handler below sees. Without this, a dock width
                                // saved on a wide monitor is pushed back unclamped on a
                                // narrower one and can leave the
                                // viewport narrower than its 380px guarantee, or the dock
                                // wider than the row itself. `6px` is `SplitHandle`'s own
                                // fixed thickness on this axis (`split_handle.slint`),
                                // matching the literal the drag handler already uses via
                                // `self.width` there.
                                init => { root.reclamp_dock_width(self.width); }
                                changed width => { root.reclamp_dock_width(self.width); }

                                Rectangle {
                                    horizontal-stretch: 1;

                                    SolidViewportView {
                                        width: 100%;
                                        height: 100%;
                                    }

                                    // Drawn OVER `solid_viewport.slint` from the wrapping
                                    // `Rectangle` this file owns: the empty-state card grid
                                    // until a real design is installed
                                    // (`EditorModel.has_design`), then a small non-blocking
                                    // "no tiers yet" hint while the design has zero tiers --
                                    // see `EditorViewportOverlay`'s own doc comment.
                                    EditorViewportOverlay {
                                        width: 100%;
                                        height: 100%;
                                        recent_native_files: root.recent_native_files;
                                        open_recent(path) => { root.open_recent_native_file(path); }
                                    }
                                }

                                // Docked guide column. Wrapped so it can never cap
                                // this row's height (see `GuidePanel`'s doc comment):
                                // expanded it stretches to the full row; collapsed,
                                // the stretchy filler below the pill takes the rest.
                                if GuideModel.open: VerticalLayout {
                                    GuidePanel { vertical-stretch: GuideModel.collapsed ? 0 : 1; }
                                    Rectangle { vertical-stretch: GuideModel.collapsed ? 1 : 0; }
                                }

                                editor_split_handle := SplitHandle {
                                    dragged(d) => {
                                        // Keeps the viewport itself at least
                                        // 380px: `max_dock` is the widest the
                                        // dock may get without pushing the
                                        // viewport narrower than that, given
                                        // this row's own current width, the
                                        // handle's own width, and the two
                                        // 12px gaps either side of it.
                                        EditorModel.dock_width = clamp(
                                            EditorModel.dock_width - d,
                                            600px,
                                            min(1000px, max(600px, parent.width - 380px - self.width - 24px - (GuideModel.open ? 272px : 0px)))
                                        );
                                        EditorModel.layout_changed();
                                    }
                                }

                                EditorView {
                                    width: EditorModel.dock_width;
                                }
                            }

                            // The narrow (<1100px, or <1372px with the guide docked) stack: no drag handle -- there is
                            // nothing horizontal left to drag -- so a fixed 2:3
                            // (viewport:dock) `vertical-stretch` ratio takes its place.
                            if root.width < 1100px + (GuideModel.open ? 272px : 0px): VerticalLayout {
                                spacing: 8px;
                                vertical-stretch: 1;

                                Rectangle {
                                    vertical-stretch: 2;

                                    SolidViewportView {
                                        width: 100%;
                                        height: 100%;
                                    }

                                    // Same overlay as the wide (>=1100px) layout's copy
                                    // above. No `GuidePanel` column here -- the narrow
                                    // stack has no spare width, so the guide floats
                                    // instead (`GuideOverlayLayer`, below).
                                    EditorViewportOverlay {
                                        width: 100%;
                                        height: 100%;
                                        recent_native_files: root.recent_native_files;
                                        open_recent(path) => { root.open_recent_native_file(path); }
                                    }
                                }

                                EditorView {
                                    vertical-stretch: 3;
                                }
                            }

                            EditorStatusStrip { window_height: root.height; }
                        }
                    }

                    // Tab 1: Cutting Instructions Table
                    if root.active_tab == 1: CuttingTableView {}

                    // Tab 2: Attached Files & GemCAD downloads
                    if root.active_tab == 2: AttachmentsView {}
                }
            }
        }

        // The guide's advance timer, and its floating panel wherever the wide Edit
        // layout's own `GuidePanel` column (above) does not exist -- the narrow
        // stack, Live Render, the catalogue tabs. Before the dialogs, so they cover it.
        GuideOverlayLayer {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            docked: root.active_tab == 0 && root.render_view_tab == 1 && EditorModel.enabled && root.width >= 1100px + (GuideModel.open ? 272px : 0px);
        }

        // Cutting mode (Edit > Cutting Mode..., the command bar's Cut Mode, the palette): the
        // cutting steps one page at a time over the whole window -- see
        // `models/cutting_mode.slint`. At the default z and before the dialogs below, so the
        // palette, the confirm questions and the glossary still draw above it. The wrapping
        // `FocusScope` takes the keyboard on opening and swallows every key, Tab included, so
        // no shortcut can fire on the design underneath; `CuttingModeModel.handle_key` decides
        // what the keys mean (Esc leaves). A key with Ctrl, Alt or Meta held does nothing there.
        if CuttingModeModel.open: FocusScope {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            init => { self.focus(); }
            key-pressed(event) => {
                CuttingModeModel.handle_key(event.text, event.modifiers.control || event.modifiers.meta || event.modifiers.alt);
                return accept;
            }

            CuttingModeScreen {
                width: 100%;
                height: 100%;
            }
        }

        // Every dialog driven only by a global model -- see
        // `GlobalDialogsOverlay`'s own doc comment
        // (`components/app/global_dialogs.slint`) for the full list and why this
        // is split out. That list includes `MaterialEditorDialog` and
        // `PerformanceGraphDialog`; only `ExportDialog` is still mounted in
        // `gem_viewport.slint`.
        // `close_confirm_open`'s dialog and `Toast` below stay here since both
        // read `MainWindow`'s own local properties/callbacks.
        // The size is explicit (and `x`/`y` too, so it adds no constraints to the
        // window): the overlay's children are all `if` branches, so left to
        // itself it would be 0 x 0 and every dialog would draw nothing.
        GlobalDialogsOverlay {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
        }

        // The glossary (Help > Glossary, "More in the glossary" in a tooltip) -- see
        // `models/help.slint`. Same wrapping-`FocusScope` convention as the dialogs
        // above: Escape closes it, every other key is swallowed so a shortcut cannot
        // fire on the design underneath, and Tab moves between its own controls.
        if HelpModel.glossary_open: FocusScope {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            z: 420;
            key-pressed(event) => {
                if event.text == Key.Escape {
                    HelpModel.glossary_open = false;
                } else if event.text == Key.Tab || event.text == Key.Backtab {
                    return reject;
                }
                return accept;
            }

            GlossaryDialog {
                width: 100%;
                height: 100%;
            }
        }

        // The Edit as Text dialog (Edit > Edit as Text..., the palette) -- see
        // `models/raw_text.slint`. Same wrapping-`FocusScope` convention: every key the text
        // box does not use is swallowed so a shortcut cannot fire on the design underneath.
        // Escape leaves the comparison first, then closes (asking first when there are edits
        // that were not applied); Tab moves between the dialog's own controls.
        if RawTextModel.is_open: FocusScope {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            z: 415;
            key-pressed(event) => {
                if event.text == Key.Escape {
                    if RawTextModel.compare_open {
                        RawTextModel.compare_open = false;
                    } else {
                        RawTextModel.request_close();
                    }
                } else if event.text == Key.Tab || event.text == Key.Backtab {
                    return reject;
                }
                return accept;
            }

            RawTextDialog {
                width: 100%;
                height: 100%;
            }
        }

        // The Angle Sweep dialog (Edit > Angle Sweep..., the palette) -- see `models/sweep.slint`.
        // Same wrapping-`FocusScope` convention: Escape stops a running sweep, else closes
        // the dialog; every other key the number fields do not use is swallowed so a shortcut
        // cannot fire on the design underneath; Tab moves between the dialog's own controls.
        if SweepModel.dialog_open: FocusScope {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            z: 405;
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape {
                    if SweepModel.running {
                        SweepModel.cancel();
                    } else {
                        SweepModel.close_dialog();
                    }
                } else if event.text == Key.Tab || event.text == Key.Backtab {
                    return reject;
                }
                return accept;
            }

            SweepDialog {
                width: 100%;
                height: 100%;
            }
        }

        // The tutorial browser (Help > Tutorials..., the palette, the empty state) -- see
        // `models/tutorials.slint`. Same wrapping-`FocusScope` convention as the glossary
        // above: Escape closes it, every other key is swallowed, Tab moves between its own
        // controls. Its search box takes the keyboard when it opens.
        if TutorialsModel.browser_open: FocusScope {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            z: 410;
            key-pressed(event) => {
                if event.text == Key.Escape {
                    TutorialsModel.close_browser();
                } else if event.text == Key.Tab || event.text == Key.Backtab {
                    return reject;
                }
                return accept;
            }

            TutorialBrowser {
                width: 100%;
                height: 100%;
            }
        }

        // The welcome dialog: shown once to a new user and whenever Preferences > "Show the
        // welcome tour again" asks for it (it waits until Preferences and the start-up
        // restore question are out of the way). Escape means "Not now", Enter takes the tour.
        if root.welcome_open: FocusScope {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            z: 430;
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape {
                    TutorialsModel.tour_dismiss();
                } else if event.text == Key.Return {
                    TutorialsModel.tour_start();
                } else if event.text == Key.Tab || event.text == Key.Backtab {
                    return reject;
                }
                return accept;
            }

            WelcomeDialog {
                width: 100%;
                height: 100%;
            }
        }

        // Window-close unsaved-changes guard -- see `close_confirm_open`'s own doc
        // comment. Its own Save/Discard buttons call straight into `MainWindow`'s own
        // callbacks (handled in Rust, `gui::mod::build_main_window`) rather than
        // `EditorModel`'s, since closing the whole window is this file's own concern,
        // not the Edit tab's.
        if root.close_confirm_open: ConfirmActionDialog {
            width: 100%;
            height: 100%;
            z: 500;
            heading: "Unsaved Changes";
            message: root.close_confirm_message;
            // An empty label hides the button: nothing to save without a dirty design.
            primary_label: root.close_confirm_can_save ? "Save" : "";
            secondary_label: "Discard";
            primary => { root.close_confirm_save(); }
            secondary => { root.close_confirm_discard(); }
            cancel => { root.close_confirm_open = false; }
        }

        Toast {
            width: min(380px, parent.width - 32px);
            x: (parent.width - self.width) / 2;
            // Offset above the Edit sub-tab's status strip while it
            // is showing, so a sticky error toast never hides the exact solver/
            // validation line it tells the user to read. The strip is the LAST child
            // of the body's own outer `VerticalLayout` (`padding: 12px`, above), so
            // its top edge sits 12px (that padding) + 26px (the strip's own fixed
            // height, `editor_status_strip.slint`) == 38px above the window's bottom
            // edge. Adding the base case's same 24px breathing margin above THAT
            // edge gives 62px.
            y: parent.height - self.height - (root.active_tab == 0 && root.render_view_tab == 1 && EditorModel.enabled ? 62px : 24px);
            text: root.toast_message;
            is_visible: root.toast_visible;
            toast_type: root.toast_type;

            dismiss => {
                root.toast_visible = false;
            }
        }
        } // Rectangle (min-width/min-height: 0px, clip -- see "Sizing notes")
    } // global_shortcuts
}
