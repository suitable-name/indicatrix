import { Slider } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { GuideModel } from "../../models/guide.slint";
import { TipBox } from "../tip_box.slint";

// One labelled slider: the caption with its plain-language tooltip on the left, the value on the
// right, and the slider under them. `step` is what an arrow key moves the slider by, so a keyboard
// user can set the number, not just a mouse user.
component OpticsSlider inherits VerticalLayout {
    in property <string> label;
    in property <string> hint;
    in property <string> value_text;
    in property <color> value_color;
    in property <float> minimum;
    in property <float> maximum;
    in property <float> step;
    in-out property <float> value;

    spacing: 4px;

    HorizontalLayout {
        alignment: space-between;
        Rectangle {
            height: caption.preferred-height;
            Tooltip { text: @markdown("\{root.hint}"); }
            caption := Text { text: root.label; font-size: 11px; font-weight: 600; color: Theme.text-secondary; }
        }
        Text { text: root.value_text; font-size: 11px; font-weight: 700; color: root.value_color; }
    }

    TipBox {
        hint: root.hint;
        Slider {
            minimum: root.minimum;
            maximum: root.maximum;
            step: root.step;
            value <=> root.value;
            accessible-label: root.label;
        }
    }
}

// The Refractive Index / Dispersion / Specific Gravity / Birefringence
// sliders -- split out of `material_editor_dialog.slint` to keep that file
// under its line budget. Each value is two-way bound back to
// `MaterialEditorDialog`'s own identically-named property (see that file's
// own doc comments -- `sg_val`'s "0.0 = not recorded" convention in
// particular).
//
// Simple mode hides the birefringence slider (`GuideModel.shows_advanced()`); its value stays and
// still applies, and the dialog says so when it is not zero.
export component MaterialOpticsSliders inherits VerticalLayout {
    spacing: 14px;

    in-out property <float> ri_val: 2.417;
    in-out property <float> disp_val: 0.0256;
    in-out property <float> sg_val: 0.0;
    in-out property <float> biref_val: 0.000;
    // False while the Dispersion section types the refractive-index curve as Sellmeier or
    // Cauchy coefficients (`material_editor/dispersion_coefficients.slint`): that curve fixes
    // n_d and n_F - n_C, so the two sliders would only mislead. The values themselves stay.
    in property <bool> show_dispersion_sliders: true;

    // 3. Refractive Index (RI) Slider
    if root.show_dispersion_sliders : OpticsSlider {
        label: "Refractive Index (nd):";
        hint: "Refractive index n_d: how strongly the stone bends light, measured for yellow light. Gems are typically 1.4 to 2.7; this editor allows up to 3.2 for rare high-index materials. See the glossary.";
        value_text: "" + Math.round(root.ri_val * 1000.0) / 1000.0;
        value_color: Theme.accent-cyan;
        minimum: 1.30;
        maximum: 3.20;
        step: 0.001;
        value <=> root.ri_val;
    }

    // 4. Dispersion (Fire Index) Slider
    if root.show_dispersion_sliders : OpticsSlider {
        label: "Dispersion (Fire ΔnF-C):";
        hint: "Dispersion: how much the stone spreads white light into colours, which is its fire. Typically 0.005 to 0.03 (diamond 0.0256, moissanite 0.0635; rutile reaches 0.207). See the glossary.";
        value_text: "" + Math.round(root.disp_val * 1000.0) / 1000.0;
        value_color: Theme.accent-purple;
        minimum: 0.000;
        maximum: 0.210;
        step: 0.0005;
        value <=> root.disp_val;
    }

    // Specific gravity -- without this, a custom
    // material's Est. Carat Weight stays empty unless a cutter separately
    // types an SG override in the Yield panel for every design that uses it.
    // `0.0` reads as "not recorded" on the Rust side (see `MaterialEditorDialog.
    // sg_val`'s own doc comment) rather than a real zero-density material.
    OpticsSlider {
        label: "Specific Gravity:";
        hint: "Specific gravity: the density of the material compared with water. It is used to estimate carat weight. Leave it at 0 to leave it unrecorded.";
        value_text: root.sg_val <= 0.0001 ? "not recorded" : "" + Math.round(root.sg_val * 100.0) / 100.0;
        value_color: Theme.accent-amber;
        minimum: 0.0;
        maximum: 7.0;
        step: 0.01;
        value <=> root.sg_val;
    }

    // 5. Birefringence (Double Refraction) Slider -- Advanced mode only.
    if GuideModel.shows_advanced() : OpticsSlider {
        label: "Birefringence (Δn = ne - no):";
        hint: "Double refraction: the difference between the two refractive indices of a stone that splits light in two. 0 for isotropic gems, typically up to 0.05 for most species (higher for zircon or calcite). See the glossary.";
        value_text: "" + Math.round(root.biref_val * 1000.0) / 1000.0;
        value_color: Theme.accent-emerald;
        minimum: -0.050;
        maximum: 0.100;
        step: 0.001;
        value <=> root.biref_val;
    }
}
