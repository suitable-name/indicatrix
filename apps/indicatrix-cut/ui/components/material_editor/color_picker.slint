import { LineEdit } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { PhysicscolorModel } from "../../models/physics_color.slint";

// A small color picker: a saturation/value square over the current hue, a hue strip, a hex
// field and Apply/Cancel. Used by the physics mode's "Pick color..." (the applied color is the
// solver's target) and by the fantasy mode's "Pick..." -- the caller decides what `applied`
// does. color maths stays in Slint (`Colors.hsv`, `to-hsv`); only hex text formatting/parsing
// is Rust (`PhysicscolorModel.format_hex`/`parse_hex`).
export component colorPicker inherits Rectangle {
    // The color the picker opens on.
    in property <color> initial: #c0392b;
    in property <string> apply_label: "Apply";
    callback applied(color);
    callback cancelled();

    in-out property <float> hue: 0.0;
    in-out property <float> sat: 0.8;
    in-out property <float> val: 0.75;
    in-out property <string> hex_text: "";
    property <color> current: Colors.hsv(root.hue, root.sat, root.val, 1.0);

    function sync_hex() {
        root.hex_text = PhysicscolorModel.format_hex(root.current);
    }
    function load(c: color) {
        root.hue = c.to-hsv().hue;
        root.sat = c.to-hsv().saturation;
        root.val = c.to-hsv().value;
        root.sync_hex();
    }
    init => { root.load(root.initial); }

    background: Theme.surface-sunken;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Theme.border-dialog;
    height: content.preferred-height;

    content := VerticalLayout {
        padding: 8px;
        spacing: 8px;

        // Saturation (x) / value (y) square over the current hue.
        sv := Rectangle {
            height: 110px;
            border-radius: 3px;
            clip: true;
            background: Colors.hsv(root.hue, 1.0, 1.0, 1.0);
            Rectangle { background: @linear-gradient(90deg, #ffffff 0%, #ffffff00 100%); }
            Rectangle { background: @linear-gradient(180deg, #00000000 0%, #000000 100%); }
            Rectangle {
                x: root.sat * parent.width - 5px;
                y: (1.0 - root.val) * parent.height - 5px;
                width: 10px;
                height: 10px;
                border-radius: 5px;
                border-width: 2px;
                border-color: #ffffff;
                background: root.current;
            }
            sv_touch := TouchArea {
                pointer-event(e) => {
                    if (e.button == PointerEventButton.left && (e.kind == PointerEventKind.down || e.kind == PointerEventKind.move)) {
                        root.sat = max(0.0, min(1.0, self.mouse-x / self.width));
                        root.val = 1.0 - max(0.0, min(1.0, self.mouse-y / self.height));
                        root.sync_hex();
                    }
                }
                moved => {
                    if (self.pressed) {
                        root.sat = max(0.0, min(1.0, self.mouse-x / self.width));
                        root.val = 1.0 - max(0.0, min(1.0, self.mouse-y / self.height));
                        root.sync_hex();
                    }
                }
            }
        }

        // Hue strip.
        hue_strip := Rectangle {
            height: 14px;
            border-radius: 3px;
            background: @linear-gradient(90deg, #ff0000 0%, #ffff00 17%, #00ff00 33%, #00ffff 50%, #0000ff 67%, #ff00ff 83%, #ff0000 100%);
            Rectangle {
                x: root.hue / 360.0 * parent.width - 2px;
                width: 4px;
                height: parent.height;
                background: #ffffff;
                border-width: 1px;
                border-color: #000000;
            }
            hue_touch := TouchArea {
                pointer-event(e) => {
                    if (e.button == PointerEventButton.left && (e.kind == PointerEventKind.down || e.kind == PointerEventKind.move)) {
                        root.hue = max(0.0, min(359.9, self.mouse-x / self.width * 360.0));
                        root.sync_hex();
                    }
                }
                moved => {
                    if (self.pressed) {
                        root.hue = max(0.0, min(359.9, self.mouse-x / self.width * 360.0));
                        root.sync_hex();
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            Rectangle {
                width: 32px;
                height: 24px;
                border-radius: 3px;
                background: root.current;
                border-width: 1px;
                border-color: Theme.border-dialog;
            }
            LineEdit {
                width: 90px;
                text <=> root.hex_text;
                placeholder-text: "#rrggbb";
                edited(t) => {
                    root.load(PhysicscolorModel.parse_hex(t, root.current));
                    root.hex_text = t;
                }
            }
            Rectangle { horizontal-stretch: 1; }
            Rectangle {
                width: 56px;
                height: 24px;
                border-radius: Theme.radius-sm;
                background: cancel_touch.has-hover ? Theme.surface-raised : Theme.surface-sunken;
                border-width: 1px;
                border-color: Theme.border-dialog;
                cancel_touch := TouchArea { clicked => { root.cancelled(); } }
                Text { text: "Cancel"; font-size: 10px; font-weight: 600; color: Theme.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
            }
            Rectangle {
                width: 70px;
                height: 24px;
                border-radius: Theme.radius-sm;
                background: apply_touch.has-hover ? Theme.accent-cyan-hover : Theme.accent-cyan;
                apply_touch := TouchArea { clicked => { root.applied(root.current); } }
                Text { text: root.apply_label; font-size: 10px; font-weight: 700; color: Theme.text-on-accent; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
    }
}
