import { Slider, ComboBox } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { PhysicscolorModel, PhysicsRow } from "../../models/physics_color.slint";
import { colorPicker } from "color_picker.slint";
import { ActionButton } from "../chip_toggle.slint";
import { IconButton } from "../icon_button.slint";
import { TipBox, FieldCaption } from "../tip_box.slint";

// The material editor's physics color section (spec 7): host, data-confidence banner, the
// element rows (log-scale amount sliders bounded by the host's concentration maximum, lock,
// remove, "estimated data" note and a Sources popover per item), the two views (strength +
// fractions / absolute amounts), treatments, the equivalent path, the D65 and 3200 K swatches
// (unpolarised plus o/e/beta), the color picker whose pick is the solver's target, and the
// "dE from your pick" readout. Everything shown is pushed from Rust
// (`gui::optics::physics_ui`); this file holds no recipe logic.
//
// Rows and chips are STATELESS views (`value`/`on` come only from the model, interaction only
// emits callbacks): a std `Slider` assigned by the user stops following its binding, which
// would leave a row stale after an undo or a solver write.
//
// Keyboard: the chips and the row sliders take Tab and Space or Enter; a row slider moves by
// 5 % with Left and Right. The "+ Add" and "Sources" popups open from the keyboard, but their
// entries are reached with the mouse or a screen reader's default action.

// A flat chip: a label that is either on or off.
component Chip inherits Rectangle {
    in property <string> text;
    // One plain sentence: what the chip does. Shown as the tooltip.
    in property <string> hint;
    in property <bool> on: false;
    in property <bool> enabled: true;
    // A toggle chip (Lock, a treatment, a view): a screen reader says whether it is on.
    in property <bool> checkable: false;
    callback clicked();
    height: 22px;
    min-width: 40px;
    border-radius: Theme.radius-sm;
    background: root.on ? Theme.surface-raised : Theme.surface-sunken;
    border-width: chip_focus.has-focus ? 2px : 1px;
    border-color: chip_focus.has-focus ? Theme.accent-cyan-hover : (root.on ? Theme.accent-cyan : Theme.border-dialog);
    opacity: root.enabled ? 1.0 : 0.5;

    accessible-role: AccessibleRole.button;
    accessible-label: root.text;
    accessible-description: root.hint;
    accessible-checkable: root.checkable;
    accessible-checked: root.on;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    if root.hint != "": Tooltip { text: @markdown("\{root.hint}"); }

    chip_focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        Text {
            text: root.text;
            font-size: 10px;
            font-weight: 600;
            color: root.on ? Theme.accent-cyan : Theme.text-secondary;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

// A small color swatch with a caption under the row it belongs to.
component Swatch inherits Rectangle {
    in property <color> swatch;
    in property <string> caption;
    // What a screen reader says (the caption is often one letter). Empty: the caption.
    in property <string> reader;
    // The tooltip. Empty: none.
    in property <string> hint;

    width: swatch_row.preferred-width;
    height: 18px;
    accessible-role: AccessibleRole.image;
    accessible-label: (root.reader != "" ? root.reader : root.caption) + " colour";

    if root.hint != "": Tooltip { text: @markdown("\{root.hint}"); }

    swatch_row := HorizontalLayout {
        spacing: 4px;
        Rectangle {
            width: 28px;
            height: 18px;
            border-radius: 3px;
            background: root.swatch;
            border-width: 1px;
            border-color: Theme.border-dialog;
        }
        Text { text: root.caption; font-size: 9px; color: Theme.text-muted; vertical-alignment: center; }
    }
}

// A stateless horizontal slider: `value` is 0..1 and only ever comes from the model. Left and
// Right move it by 5 % (a step and its release, like a short drag).
component PhysSlider inherits Rectangle {
    in property <float> value: 0.0;
    in property <string> label;
    callback changed(float);
    callback released();
    height: 18px;
    min-width: 60px;
    horizontal-stretch: 1;

    accessible-role: AccessibleRole.slider;
    accessible-label: root.label;
    accessible-value: "" + Math.round(root.value * 100) + " percent";
    accessible-value-minimum: 0;
    accessible-value-maximum: 100;
    accessible-value-step: 5;
    accessible-action-increment => { root.changed(min(1.0, root.value + 0.05)); root.released(); }
    accessible-action-decrement => { root.changed(max(0.0, root.value - 0.05)); root.released(); }

    function position(x: length) -> float {
        return max(0.0, min(1.0, (x - 6px) / max(1px, root.width - 12px)));
    }
    Rectangle {
        y: (parent.height - 4px) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.surface-sunken;
        border-width: 1px;
        border-color: Theme.border-dialog;
    }
    Rectangle {
        y: (parent.height - 4px) / 2;
        height: 4px;
        border-radius: 2px;
        width: root.value * (parent.width - 12px) + 6px;
        background: Theme.accent-cyan;
    }
    Rectangle {
        x: root.value * (parent.width - 12px);
        y: (parent.height - 12px) / 2;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Theme.accent-cyan;
        border-width: slider_focus.has-focus ? 2px : 1px;
        border-color: slider_focus.has-focus ? Theme.accent-cyan-hover : Theme.toggle-knob;
    }
    slider_focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.LeftArrow {
                root.changed(max(0.0, root.value - 0.05));
                root.released();
                return accept;
            } else if event.text == Key.RightArrow {
                root.changed(min(1.0, root.value + 0.05));
                root.released();
                return accept;
            }
            return reject;
        }
    }
    TouchArea {
        pointer-event(e) => {
            if (e.button == PointerEventButton.left) {
                if (e.kind == PointerEventKind.down) {
                    slider_focus.focus();
                    root.changed(root.position(self.mouse-x));
                } else if (e.kind == PointerEventKind.up) {
                    root.released();
                }
            }
        }
        moved => {
            if (self.pressed) {
                root.changed(root.position(self.mouse-x));
            }
        }
    }
}

// One recipe row: label, slider, amount, lock, remove, Sources, and the estimated-data note.
component PhysicsRowItem inherits Rectangle {
    in property <PhysicsRow> item;
    in property <bool> fractions;
    height: col.preferred-height + 4px;

    col := VerticalLayout {
        spacing: 2px;
        HorizontalLayout {
            spacing: 6px;
            Text {
                text: root.item.label;
                font-size: 11px;
                font-weight: 700;
                color: Theme.text-primary;
                width: 64px;
                vertical-alignment: center;
                overflow: elide;
            }
            PhysSlider {
                label: "Amount of " + root.item.label;
                value: root.fractions ? root.item.fraction : root.item.slider;
                changed(v) => {
                    if (root.fractions) {
                        PhysicscolorModel.fraction_changed(root.item.id, v);
                    } else {
                        PhysicscolorModel.amount_changed(root.item.id, v);
                    }
                }
                released => { PhysicscolorModel.amount_released(); }
            }
            Text {
                text: root.fractions ? root.item.fraction_text + "  " + root.item.amount_text : root.item.amount_text;
                font-size: 10px;
                color: Theme.accent-cyan;
                min-width: 120px;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
            Chip {
                text: root.item.locked ? "Locked" : "Lock";
                hint: root.item.locked ? "This amount is locked: the colour solver will not change it. Press to unlock." : "Lock this amount so the colour solver does not change it.";
                on: root.item.locked;
                checkable: true;
                clicked => { PhysicscolorModel.lock_toggled(root.item.id); }
            }
            Chip {
                text: "Sources";
                hint: "Show where the data for this item comes from.";
                clicked => { sources_popup.show(); }
            }
            IconButton {
                icon: @image-url("../../icons/close.svg");
                hint: "Remove " + root.item.label + " from the recipe";
                tint: Theme.danger;
                hover_fill: Theme.danger-surface-hover;
                glyph: 10px;
                width: 22px;
                height: 22px;
                clicked => { PhysicscolorModel.remove_item(root.item.id); }
            }
        }
        if root.item.estimated : Text {
            text: "estimated data (" + root.item.confidence + ") - treat the strength as approximate";
            font-size: 9px;
            color: Theme.accent-amber;
        }
    }

    sources_popup := PopupWindow {
        x: 0px;
        y: root.height;
        width: 340px;
        Rectangle {
            background: Theme.surface-raised;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: Theme.border-dialog;
            height: src_col.preferred-height + 16px;
            src_col := VerticalLayout {
                padding: 8px;
                spacing: 4px;
                Text { text: "Sources \u{2014} " + root.item.label; font-size: 11px; font-weight: 700; color: Theme.text-primary; }
                Text { text: root.item.sources; font-size: 9px; color: Theme.text-secondary; wrap: word-wrap; }
            }
        }
    }
}

export component ChromophorePicker inherits VerticalLayout {
    spacing: 10px;

    // The color picker for "Pick color..." is inline (expands below the button).
    property <bool> picker_open: false;

    // ---- Host crystal ----
    VerticalLayout {
        spacing: 4px;
        HorizontalLayout {
            alignment: space-between;
            FieldCaption {
                text: "Host Crystal:";
                hint: "The crystal the colouring elements sit in, such as corundum for ruby. It fixes the crystal system and optical character, and fills in a refractive index and specific gravity to start from.";
            }
            Text { text: "(locks crystal system & character; prefills RI and SG)"; font-size: 10px; color: Theme.text-muted; }
        }
        TipBox {
            hint: "Pick the host crystal of the stone.";
            ComboBox {
                model: PhysicscolorModel.host_names;
                current-index <=> PhysicscolorModel.host_index;
                accessible-label: "Host crystal";
                selected(val) => {
                    PhysicscolorModel.host_selected(self.current-index);
                }
            }
        }
    }

    // ---- One data-confidence banner per host (only when some coefficient is not verified) ----
    if PhysicscolorModel.banner_visible : Rectangle {
        border-radius: Theme.radius-sm;
        background: Theme.surface-warning;
        border-width: 1px;
        border-color: Theme.accent-amber;
        height: banner_text.preferred-height + 12px;
        // The warning sign is an icon: the UI font has no glyph for it.
        Image {
            source: @image-url("../../icons/warning.svg");
            colorize: Theme.accent-amber;
            x: 8px;
            y: 7px;
            width: 12px;
            height: 12px;
        }
        banner_text := Text {
            x: 26px;
            width: parent.width - 34px;
            y: 6px;
            text: PhysicscolorModel.banner_text;
            font-size: 10px;
            font-weight: 600;
            color: Theme.accent-amber;
            wrap: word-wrap;
        }
    }

    // ---- Recipe built with older catalogue data: a badge, never a silent update ----
    if PhysicscolorModel.data_updated : Rectangle {
        border-radius: Theme.radius-sm;
        background: Theme.surface-info;
        height: 28px;
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 8px;
            Text {
                text: "Color data updated \u{2014} this recipe still renders from its stored bands.";
                font-size: 10px;
                color: Theme.text-primary;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            Chip {
                text: "Update to current data";
                hint: "Recompute the colour from the current catalogue data. The recipe keeps rendering from its stored bands until you do.";
                clicked => { PhysicscolorModel.update_data(); }
            }
        }
    }

    // ---- Elements ----
    VerticalLayout {
        spacing: 6px;
        HorizontalLayout {
            spacing: 6px;
            Text { text: "Elements"; font-size: 11px; font-weight: 600; color: Theme.text-secondary; vertical-alignment: center; horizontal-stretch: 1; }
            Chip {
                text: "Undo";
                hint: "Undo the last change to the recipe. Fifty steps are kept while this dialog is open. Ctrl+Z does the same.";
                enabled: PhysicscolorModel.can_undo;
                clicked => { PhysicscolorModel.undo(); }
            }
            Chip {
                text: "Redo";
                hint: "Redo the change you undid. Ctrl+Y does the same.";
                enabled: PhysicscolorModel.can_redo;
                clicked => { PhysicscolorModel.redo(); }
            }
            add_chip := Chip {
                text: "+ Add";
                hint: "Add an element or end-member to the recipe.";
                clicked => { add_popup.show(); }
                add_popup := PopupWindow {
                    x: 0px;
                    y: parent.height;
                    width: 280px;
                    Rectangle {
                        background: Theme.surface-raised;
                        border-radius: Theme.radius-sm;
                        border-width: 1px;
                        border-color: Theme.border-dialog;
                        height: add_col.preferred-height + 12px;
                        add_col := VerticalLayout {
                            padding: 6px;
                            spacing: 2px;
                            for opt in PhysicscolorModel.add_options : Rectangle {
                                height: opt.enabled ? 22px : 34px;
                                opacity: opt.enabled ? 1.0 : 0.55;
                                background: opt_touch.has-hover && opt.enabled ? Theme.surface-control-hover : transparent;
                                border-radius: 3px;
                                accessible-role: AccessibleRole.list-item;
                                accessible-label: opt.label + (opt.enabled ? "" : ", not available: " + opt.reason);
                                accessible-enabled: opt.enabled;
                                accessible-action-default => {
                                    if opt.enabled {
                                        PhysicscolorModel.add_item(opt.id);
                                    }
                                }
                                opt_touch := TouchArea {
                                    enabled: opt.enabled;
                                    clicked => { PhysicscolorModel.add_item(opt.id); }
                                }
                                VerticalLayout {
                                    padding-left: 6px;
                                    alignment: center;
                                    Text { text: opt.label; font-size: 11px; color: Theme.text-primary; }
                                    if !opt.enabled : Text { text: opt.reason; font-size: 9px; color: Theme.accent-amber; }
                                }
                            }
                            if PhysicscolorModel.add_options.length == 0 : Text {
                                text: "Every item offered for this host is already in the recipe.";
                                font-size: 10px;
                                color: Theme.text-muted;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }
        for r in PhysicscolorModel.rows : PhysicsRowItem {
            item: r;
            fractions: PhysicscolorModel.view_fractions;
        }
        if PhysicscolorModel.rows.length == 0 : Text {
            text: PhysicscolorModel.note_text != "" ? PhysicscolorModel.note_text : "No elements yet \u{2014} add one or pick a color.";
            font-size: 10px;
            color: Theme.text-muted;
        }
    }

    // ---- View toggle ----
    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        Text { text: "View:"; font-size: 11px; font-weight: 600; color: Theme.text-secondary; vertical-alignment: center; }
        Chip {
            text: "Strength + fractions";
            hint: "Show one overall strength and each item's share of the recipe.";
            on: PhysicscolorModel.view_fractions;
            checkable: true;
            clicked => {
                PhysicscolorModel.view_fractions = true;
                PhysicscolorModel.view_changed(true);
            }
        }
        Chip {
            text: "Absolute amounts";
            hint: "Show the real amount of every item, for example in weight percent.";
            on: !PhysicscolorModel.view_fractions;
            checkable: true;
            clicked => {
                PhysicscolorModel.view_fractions = false;
                PhysicscolorModel.view_changed(false);
            }
        }
    }

    // ---- Strength: a multiplier on every item's absorption (hue unchanged) ----
    VerticalLayout {
        spacing: 4px;
        HorizontalLayout {
            alignment: space-between;
            FieldCaption {
                text: "Strength (multiplier on all items):";
                hint: "Make every item absorb more or less light by the same factor. The hue stays; the colour gets deeper or paler.";
            }
            Text { text: Math.round(PhysicscolorModel.strength * 100.0) / 100.0 + "\u{d7}"; font-size: 11px; font-weight: 700; color: Theme.accent-cyan; }
        }
        TipBox {
            hint: "From 0.05 to 10 times the recipe's own strength.";
            Slider {
                minimum: 0.05;
                maximum: 10.0;
                step: 0.05;
                value <=> PhysicscolorModel.strength;
                accessible-label: "Strength multiplier";
                changed(v) => { PhysicscolorModel.strength_changed(v); }
                released(v) => { PhysicscolorModel.strength_released(); }
            }
        }
    }

    // ---- Treatments valid for the host (and the present elements) ----
    if PhysicscolorModel.treatments.length > 0 : VerticalLayout {
        spacing: 4px;
        FieldCaption {
            text: "Treatments:";
            hint: "Treatments such as heating or irradiation change the colour. Only those that are possible for this host and these elements are offered.";
        }
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            for t in PhysicscolorModel.treatments : Chip {
                text: t.name;
                hint: t.conditions;
                on: t.active;
                checkable: true;
                clicked => { PhysicscolorModel.treatment_toggled(t.id, !t.active); }
            }
        }
    }

    // ---- Equivalent path ----
    VerticalLayout {
        spacing: 4px;
        HorizontalLayout {
            alignment: space-between;
            FieldCaption {
                text: "Equivalent path (mm):";
                hint: "How far light travels through the stone, in millimetres. The colour you see depends on it; the default is one and a half times the girdle width.";
            }
            Text { text: Math.round(PhysicscolorModel.reference_path_mm * 10.0) / 10.0 + " mm"; font-size: 11px; font-weight: 700; color: Theme.accent-cyan; }
        }
        TipBox {
            hint: "From 1 to 40 millimetres.";
            Slider {
                minimum: 1.0;
                maximum: 40.0;
                step: 0.5;
                value <=> PhysicscolorModel.reference_path_mm;
                accessible-label: "Equivalent path in millimetres";
                changed(v) => { PhysicscolorModel.path_changed(v); }
                released(v) => { PhysicscolorModel.path_released(); }
            }
        }
        Text { text: PhysicscolorModel.path_hint; font-size: 9px; color: Theme.text-muted; wrap: word-wrap; }
    }

    // ---- Computed body color: D65 and 3200 K, unpolarised plus o / e / beta ----
    VerticalLayout {
        spacing: 6px;
        FieldCaption {
            text: "Computed body color:";
            hint: "The colour the recipe gives, in daylight (D65) and in warm lamp light (3200 K). A doubly refracting stone shows a different colour for each ray: o is the ordinary ray, e the extraordinary one, beta the middle ray of a biaxial stone.";
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Text { text: "D65"; font-size: 10px; font-weight: 600; color: Theme.text-muted; width: 44px; vertical-alignment: center; }
            Swatch { swatch: PhysicscolorModel.d65_unpol; caption: "unpol."; reader: "Daylight, unpolarised"; }
            Swatch { swatch: PhysicscolorModel.d65_o; caption: "o"; reader: "Daylight, ordinary ray"; }
            Swatch { swatch: PhysicscolorModel.d65_e; caption: "e"; reader: "Daylight, extraordinary ray"; }
            if PhysicscolorModel.has_beta : Swatch { swatch: PhysicscolorModel.d65_beta; caption: "\u{3b2}"; reader: "Daylight, beta ray"; }
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Text { text: "3200 K"; font-size: 10px; font-weight: 600; color: Theme.text-muted; width: 44px; vertical-alignment: center; }
            Swatch { swatch: PhysicscolorModel.a_unpol; caption: "unpol."; reader: "Lamp light, unpolarised"; }
            Swatch { swatch: PhysicscolorModel.a_o; caption: "o"; reader: "Lamp light, ordinary ray"; }
            Swatch { swatch: PhysicscolorModel.a_e; caption: "e"; reader: "Lamp light, extraordinary ray"; }
            if PhysicscolorModel.has_beta : Swatch { swatch: PhysicscolorModel.a_beta; caption: "\u{3b2}"; reader: "Lamp light, beta ray"; }
        }
        Text { text: PhysicscolorModel.color_change_text; font-size: 9px; font-weight: 600; color: Theme.accent-purple; }
        if PhysicscolorModel.show_stone : HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Text { text: PhysicscolorModel.stone_text; font-size: 10px; color: Theme.text-muted; vertical-alignment: center; }
            Swatch { swatch: PhysicscolorModel.stone_d65; caption: "D65"; reader: "Whole stone, daylight"; }
            Swatch { swatch: PhysicscolorModel.stone_a; caption: "3200 K"; reader: "Whole stone, lamp light"; }
        }

        // ---- Fluorescence: the analytic glow of the recipe's emitters under the UV lamps ----
        fluorescence_slot := VerticalLayout {
            spacing: 4px;
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Text { text: PhysicscolorModel.fluorescence_text; font-size: 10px; font-weight: 600; color: Theme.text-secondary; vertical-alignment: center; }
                if PhysicscolorModel.quench_text != "" : Text { text: "\u{b7} " + PhysicscolorModel.quench_text; font-size: 10px; font-weight: 600; color: Theme.accent-purple; vertical-alignment: center; }
            }
            if PhysicscolorModel.has_glow : HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Text { text: "UV 365"; font-size: 10px; font-weight: 600; color: Theme.text-muted; width: 44px; vertical-alignment: center; }
                Swatch { swatch: PhysicscolorModel.glow365; caption: PhysicscolorModel.glow365_text; reader: "Glow under a 365 nanometre lamp"; }
                Text { text: "UV 395"; font-size: 10px; font-weight: 600; color: Theme.text-muted; width: 44px; vertical-alignment: center; }
                Swatch { swatch: PhysicscolorModel.glow395; caption: PhysicscolorModel.glow395_text; reader: "Glow under a 395 nanometre lamp"; }
            }
        }
    }

    // ---- Pick color: the picked color is the solver's target ----
    VerticalLayout {
        spacing: 6px;
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            ActionButton {
                width: 110px;
                height: 26px;
                text: "Pick color\u{2026}";
                hint: "Pick the colour you want the stone to be. The program looks for the elements and amounts that come closest.";
                fill: Theme.surface-raised;
                hover_fill: Theme.surface-control-hover;
                font_size: 10px;
                clicked => { root.picker_open = !root.picker_open; }
            }
            if PhysicscolorModel.has_target : Rectangle {
                width: 28px;
                height: 18px;
                y: 4px;
                border-radius: 3px;
                background: PhysicscolorModel.target_color;
                border-width: 1px;
                border-color: Theme.border-dialog;
                accessible-role: AccessibleRole.image;
                accessible-label: "Picked colour";
                Tooltip { text: @markdown("The colour you picked: the target the solver aims for."); }
            }
            if PhysicscolorModel.solving : Text {
                text: PhysicscolorModel.note_text != "" ? PhysicscolorModel.note_text : "Solving\u{2026}";
                font-size: 10px;
                font-weight: 600;
                color: Theme.accent-cyan;
                vertical-alignment: center;
            }
            if !PhysicscolorModel.solving && PhysicscolorModel.match_text != "" : Text {
                text: PhysicscolorModel.match_text;
                font-size: 10px;
                font-weight: PhysicscolorModel.match_warn ? 700 : 400;
                color: PhysicscolorModel.match_warn ? Theme.accent-amber : Theme.text-muted;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }
        if root.picker_open : colorPicker {
            initial: PhysicscolorModel.has_target ? PhysicscolorModel.target_color : PhysicscolorModel.d65_unpol;
            apply_label: "Solve";
            applied(c) => {
                root.picker_open = false;
                PhysicscolorModel.pick_solve(c);
            }
            cancelled => { root.picker_open = false; }
        }
    }
}
