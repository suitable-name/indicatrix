import { Theme } from "../theme.slint";
import { ComboBox, Slider, LineEdit } from "std-widgets.slint";
import { ViewportModel } from "../models/viewport.slint";
import { ConfirmActionDialog } from "confirm_action_dialog.slint";

export component MaterialEditorDialog inherits Rectangle {
    // Delete used to be a single, unconfirmed click that permanently removed a
    // custom material (with any design referencing it silently falling back to a
    // built-in of the same name, or Diamond) -- this gates it behind an explicit
    // "Are you sure" step instead, the same modal idiom `ConfirmActionDialog` is
    // already used for elsewhere.
    property <bool> confirm_delete_open: false;
    // A blank (or whitespace-only) name can never be saved or deleted -- the
    // authoritative check still lives in Rust (`gui::optics::custom_materials`,
    // which also refuses a name that collides with a built-in material), but the
    // empty-string case is cheap to also reject right here so Save/Delete visibly
    // disable instead of silently no-op-ing against the database.
    property <bool> name_is_blank: root.mat_name == "";
    // CAD audit items 87/88: the authoritative built-in/existing-custom name
    // checks still live in Rust (`gui::optics::custom_materials`) -- a built-in
    // collision is refused outright there, and an existing-custom collision's own
    // success toast says "Overwrote" rather than "Saved". These two `in`
    // properties let THIS dialog also disable/prompt proactively instead of only
    // reacting after the fact, but neither is wired yet: `gem_viewport.slint`
    // (owned by another lane) still mounts `MaterialEditorDialog { ... }` with no
    // property bindings at all (see this file's own handoff note), so both
    // default to `[]` and every check below against them is vacuously
    // permissive until that wiring lands.
    // Both answers come from Rust (`gui::optics::custom_materials`), recomputed
    // whenever the name field is edited, because Slint has no way to search a list
    // from inside an expression: a `pure function` admits no loop construct, and
    // there is no `contains` on an array or a string. Keeping the search on the
    // Rust side also means these agree with the authoritative checks by
    // construction rather than by a second implementation that could drift.
    property <bool> name_is_existing_custom: ViewportModel.material_name_is_existing_custom;
    property <bool> name_collides_with_builtin: ViewportModel.material_name_collides_with_builtin;

    // Item 87: Delete must only ever be enabled for a name that actually names an
    // existing custom material -- previously gated on "non-blank" alone, so
    // typing an arbitrary new name and pressing Delete looked like a legitimate
    // action right up until the DB layer reported it removed zero rows.
    // Item 88: a name that already names a BUILT-IN material can never be saved
    // (the Rust layer refuses it outright) -- disabling Save proactively means
    // the cutter sees why immediately instead of getting an error toast only
    // after clicking.
    property <bool> can_save: root.optics_valid && !root.name_is_blank && !root.name_collides_with_builtin;

    // Item 88: saving over an EXISTING custom name silently overwrites it today
    // (the Rust layer allows it, only distinguishing "Saved" from "Overwrote" in
    // its own success toast afterward) -- this intercepts both Save buttons with
    // an explicit "Overwrite?" step first, the same modal idiom already used for
    // Delete/discard below. `pending_apply` remembers which of the two Save
    // buttons was pressed (plain Save vs. Save & Apply) so the confirmation's
    // own `primary` handler can forward the right `apply` flag.
    property <bool> confirm_overwrite_open: false;
    property <bool> pending_apply: false;

    function request_save(apply: bool) {
        if (!root.can_save) {
            return;
        }
        if (root.name_is_existing_custom) {
            root.pending_apply = apply;
            root.confirm_overwrite_open = true;
        } else {
            root.save_material(
                root.mat_name,
                root.ri_val,
                root.disp_val,
                root.biref_val,
                root.selected_color_preset,
                root.selected_crystal_system_idx,
                root.selected_optical_character_idx,
                root.biaxial_delta_beta_alpha_val,
                root.sg_val,
                apply
            );
        }
    }

    // Item 170: a stray click on the backdrop used to silently discard adjustments
    // to all five sliders/combos. This dialog is recreated fresh (all `in-out`
    // properties back at their literal defaults below) every time `if
    // ViewportModel.material_editor_open: MaterialEditorDialog { ... }`
    // (`gem_viewport.slint`, owned by another lane) turns the condition true again --
    // it never carries an existing custom material's own values in -- so "the state
    // the dialog opened with" IS those literal defaults, compared here directly
    // rather than snapshotted at `init` (there is no earlier value to snapshot from).
    property <bool> is_dirty: root.mat_name != "Custom Diamond"
        || Math.abs(root.ri_val - 2.417) > 0.0001
        || Math.abs(root.disp_val - 0.044) > 0.0001
        || Math.abs(root.sg_val) > 0.0001
        || Math.abs(root.biref_val) > 0.0001
        || root.selected_color_preset != 0
        || root.selected_template_idx != 0
        || root.selected_crystal_system_idx != 0
        || root.selected_optical_character_idx != 0
        || Math.abs(root.biaxial_delta_beta_alpha_val) > 0.0001;
    property <bool> discard_confirm_open: false;

    function request_close() {
        if root.is_dirty {
            root.discard_confirm_open = true;
        } else {
            root.close();
        }
    }

    in property <[string]> base_templates: [
        "Custom", "Diamond", "Sapphire", "Ruby", "Emerald", 
        "Tanzanite", "Synthetic Moissanite", "Zircon", "Topaz", "Spinel", "Quartz", "Cubic Zirconia"
    ];
    
    // Every write to this reports the new name to Rust, which answers the two
    // collision questions above. `changed` rather than the `LineEdit`'s own
    // `edited` callback so the preset buttons further down, which assign this
    // directly, are covered too.
    in-out property <string> mat_name: "Custom Diamond";
    changed mat_name => { ViewportModel.material_name_edited(self.mat_name); }
    in-out property <float> ri_val: 2.417;        // Refractive Index (1.30 - 3.20)
    in-out property <float> disp_val: 0.044;      // Dispersion (0.000 - 0.120)
    // CAD audit item 169: specific gravity, needed for Est. Carat Weight -- `0.0`
    // means "not recorded" (this dialog has no preset SG data to seed the "Load
    // Preset Template" combo above with, so every preset still leaves this blank
    // rather than guessing a number). Depends on a `specific_gravity` column/
    // migration in `crates/indicatrix-vault` and a `MaterialLookup::
    // specific_gravity` addition in `crates/indicatrix-cut-core`, neither of which
    // this lane owns -- see this file's own handoff note for the exact additions.
    in-out property <float> sg_val: 0.0;          // Specific Gravity (0 = not recorded)
    in-out property <float> biref_val: 0.000;     // Birefringence (-0.050 - +0.100)
    in-out property <int> selected_color_preset: 0; // 0=Clear, 1=Blue, 2=Red, 3=Green, 4=Violet, 5=Yellow, 6=Pink, 7=Teal, 8=Amber
    in-out property <int> selected_template_idx: 0;

    // Crystal-optically complete custom materials: these three mirror
    // `indicatrix::optics::materials::CrystalSystem`/`OpticalCharacter`/
    // `GemMaterial::biaxial_delta_beta_alpha` -- see `gui::crystal_optics` (the Rust
    // side of this boundary) for the index<->enum mapping these combo indices feed.
    // Defaults (0, 0) are Cubic/Isotropic, matching what `GemMaterial::new_custom`
    // itself infers for the dialog's own default (birefringence 0.000, "Custom
    // Diamond") -- so a user who never touches either combo gets exactly today's
    // inferred behaviour, unchanged.
    in-out property <int> selected_crystal_system_idx: 0;
    in-out property <int> selected_optical_character_idx: 0;
    // n_beta - n_alpha at the sodium D line -- only meaningful (and only shown) when
    // `selected_optical_character_idx` is one of the two biaxial options (index 3/4).
    // Bounds (0.0..birefringence) below keep it physically valid (n_alpha <= n_beta
    // <= n_gamma) by construction rather than by a separate rejected-on-save check.
    in-out property <float> biaxial_delta_beta_alpha_val: 0.0;

    property <[string]> crystal_system_options: [
        "Cubic", "Tetragonal", "Hexagonal", "Trigonal", "Orthorhombic", "Monoclinic", "Triclinic"
    ];
    // Index 3/4 (Biaxial +/-) must stay last -- `is_biaxial` below reads the index
    // range, and `gui::crystal_optics::OPTICAL_CHARACTERS` on the Rust side lists the
    // same five in this same order.
    property <[string]> optical_character_options: [
        "Isotropic", "Uniaxial (+)", "Uniaxial (\u{2212})", "Biaxial (+)", "Biaxial (\u{2212})"
    ];

    property <bool> is_biaxial: root.selected_optical_character_idx >= 3;

    // Physical validity of the character/birefringence combination: this dialog
    // REJECTS a contradictory combination by disabling Save rather than silently
    // deriving a sign or silently saving it.
    // Isotropic needs zero birefringence; a uniaxial character's sign must match
    // `biref_val`'s own sign exactly the way `GemMaterial::new_custom`'s own inference
    // already ties them together; a biaxial character needs a positive birefringence
    // (this crate's convention: `birefringence_delta` = n_gamma - n_alpha, which is
    // never negative by definition -- see the built-in Alexandrite/Topaz/Tanzanite
    // entries in `materials.rs`, all positive) with `biaxial_delta_beta_alpha_val`
    // between 0 and it (n_alpha <= n_beta <= n_gamma). Note there is no further
    // constraint distinguishing Biaxial(+) from Biaxial(-): unlike the uniaxial case,
    // that sign is a genuinely independent mineralogical property (the acute
    // bisectrix), not derivable from birefringence and delta-beta-alpha alone -- the
    // three real biaxial built-ins (Alexandrite/Topaz/Tanzanite) are all
    // BiaxialPositive despite differing delta-beta-alpha/birefringence ratios, which
    // is exactly what rules out deriving the sign from those two numbers.
    property <bool> optics_valid:
        root.selected_optical_character_idx == 0 ? Math.abs(root.biref_val) < 0.0001 :
        root.selected_optical_character_idx == 1 ? root.biref_val > 0.0001 :
        root.selected_optical_character_idx == 2 ? root.biref_val < -0.0001 :
        (root.biref_val > 0.0001
            && root.biaxial_delta_beta_alpha_val >= 0.0
            && root.biaxial_delta_beta_alpha_val <= root.biref_val);

    property <string> optics_validation_message:
        root.optics_valid ? "" :
        root.selected_optical_character_idx == 0 ? "Isotropic requires zero birefringence (\u{394}n = 0)." :
        root.selected_optical_character_idx == 1 ? "Uniaxial (+) requires positive birefringence (\u{394}n > 0)." :
        root.selected_optical_character_idx == 2 ? "Uniaxial (\u{2212}) requires negative birefringence (\u{394}n < 0)." :
        root.biref_val <= 0.0001 ? "Biaxial requires positive birefringence (\u{394}n > 0)." :
        "n\u{03b2} \u{2212} n\u{03b1} must be between 0 and the birefringence.";

    callback close();
    close => { ViewportModel.material_editor_open = false; }
    // name, ri, dispersion, birefringence, color_idx, crystal_system_idx,
    // optical_character_idx, biaxial_delta_beta_alpha, apply_to_live_render --
    // Item 243: the last argument gates whether the save also switches the live
    // render's material (`custom_materials.rs`'s `ctx.material_name`/`ctx.dirty`),
    // so a cutter preparing several custom materials in a row can save each one
    // without re-rendering the viewport with it.
    // CAD audit item 169: `sg` (specific gravity from the new slider below, `0.0` =
    // not recorded) is collected here and threaded through this dialog's own
    // `save_material` callback, but NOT YET passed on to `ViewportModel.
    // save_custom_material` below -- that global still only takes nine arguments
    // (`ui/models/viewport.slint`, not owned by this lane), and calling it with a
    // tenth would fail the whole crate's Slint build for every lane, not just this
    // one. See this file's own handoff note for the exact `ViewportModel`/
    // `gui::optics::custom_materials` additions this is waiting on, and the
    // one-line change to make here (add `sg` to the call below) once they land.
    callback save_material(string, float, float, float, int, int, int, float, float, bool);
    save_material(name, ri, disp, biref, color_idx, crystal_system_idx, optical_character_idx, biaxial_delta_beta_alpha, sg, apply) => {
        ViewportModel.save_custom_material(name, ri, disp, biref, color_idx, crystal_system_idx, optical_character_idx, biaxial_delta_beta_alpha, apply);
        ViewportModel.material_editor_open = false;
    }
    callback delete_material(string);
    delete_material(name) => {
        ViewportModel.delete_custom_material(name);
        ViewportModel.material_editor_open = false;
    }

    // Full viewport modal backdrop
    background: Theme.overlay-backdrop;

    TouchArea {
        clicked => { root.request_close(); }
    }

    // Escape = ask-then-cancel, same `init => { self.focus(); }` + `key-pressed`
    // idiom `new_design_dialog.slint`/`ui/app.slint`'s `global_shortcuts` use.
    //
    // CAD audit item 199: `accept` (not `reject`) for every other key -- otherwise
    // an unhandled key bubbles past this dialog to `global_shortcuts` and fires a
    // shortcut (Ctrl+S, etc.) on the design underneath it.
    key_scope := FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.request_close();
                return accept;
            }
            accept
        }
    }

    // Modal Card Container
    Rectangle {
        width: 440px;
        // Content-driven height: without this, `Rectangle`'s default sizing ("expand to
        // fill the parent" when width/height aren't both set explicitly) makes this card
        // inherit the full-viewport backdrop's height -- i.e. it stretches to the bottom
        // of the window instead of sizing to its content. Same idiom, and same reason, as
        // `settings_dialog.slint` and `import_dialog.slint`.
        height: content.preferred-height;
        background: Theme.surface-dialog;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: Theme.border-dialog;
        drop-shadow-blur: 24px;
        drop-shadow-color: Theme.modal-shadow;
        clip: true;

        // Isolate clicks inside modal
        TouchArea {}

        content := VerticalLayout {
            padding: 16px;
            spacing: 14px;

            // 1. Header Bar
            HorizontalLayout {
                alignment: space-between;

                HorizontalLayout {
                    spacing: 8px;
                    Image { source: @image-url("../icons/gem.svg"); colorize: Theme.text-primary; width: 16px; height: 16px; vertical-alignment: center; }
                    Text {
                        text: "Gem Material Editor";
                        font-size: 14px;
                        font-weight: 700;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: Theme.radius-sm;
                    background: close_touch.has-hover ? Theme.surface-control-hover : Theme.surface-control;

                    close_touch := TouchArea {
                        clicked => { root.request_close(); }
                    }

                    Image {
                        source: @image-url("../icons/close.svg");
                        colorize: Theme.text-muted;
                        width: 12px;
                        height: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle { height: 1px; background: Theme.surface-raised; }

            // 2. Base Template Selector & Name Input
            HorizontalLayout {
                spacing: 10px;

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    Text { text: "Load Preset Template:"; font-size: 11px; font-weight: 600; color: Theme.text-secondary; }
                    
                    Rectangle {
                        height: 32px;
                        background: Theme.surface-raised;
                        border-radius: Theme.radius-sm;
                        border-width: 1px;
                        border-color: Theme.border-dialog;

                        ComboBox {
                            model: root.base_templates;
                            current-index <=> root.selected_template_idx;
                            selected(val) => {
                                // Crystal system indices: 0 Cubic, 1 Tetragonal,
                                // 2 Hexagonal, 3 Trigonal, 4 Orthorhombic,
                                // 5 Monoclinic, 6 Triclinic. Optical character
                                // indices: 0 Isotropic, 1 Uniaxial(+), 2 Uniaxial(-),
                                // 3 Biaxial(+), 4 Biaxial(-). Both orders match
                                // `indicatrix::optics::materials::{CrystalSystem,
                                // OpticalCharacter}`'s own declared variant order --
                                // see `gui::crystal_optics` on the Rust side. Values
                                // below are each preset's REAL classification, read
                                // from its `indicatrix` built-in entry in materials.rs.
                                if (val == "Diamond") {
                                    root.mat_name = "Custom Diamond";
                                    root.ri_val = 2.417;
                                    root.disp_val = 0.044;
                                    root.biref_val = 0.000;
                                    root.selected_color_preset = 0;
                                    root.selected_crystal_system_idx = 0; // Cubic
                                    root.selected_optical_character_idx = 0; // Isotropic
                                    root.biaxial_delta_beta_alpha_val = 0.0;
                                } else if (val == "Sapphire") {
                                    root.mat_name = "Custom Sapphire";
                                    root.ri_val = 1.768;
                                    root.disp_val = 0.018;
                                    root.biref_val = -0.008;
                                    root.selected_color_preset = 1;
                                    root.selected_crystal_system_idx = 3; // Trigonal
                                    root.selected_optical_character_idx = 2; // Uniaxial(-)
                                    root.biaxial_delta_beta_alpha_val = 0.0;
                                } else if (val == "Ruby") {
                                    root.mat_name = "Custom Ruby";
                                    root.ri_val = 1.768;
                                    root.disp_val = 0.018;
                                    root.biref_val = -0.008;
                                    root.selected_color_preset = 2;
                                    root.selected_crystal_system_idx = 3; // Trigonal
                                    root.selected_optical_character_idx = 2; // Uniaxial(-)
                                    root.biaxial_delta_beta_alpha_val = 0.0;
                                } else if (val == "Emerald") {
                                    root.mat_name = "Custom Emerald";
                                    root.ri_val = 1.577;
                                    root.disp_val = 0.014;
                                    root.biref_val = -0.006;
                                    root.selected_color_preset = 3;
                                    root.selected_crystal_system_idx = 2; // Hexagonal
                                    root.selected_optical_character_idx = 2; // Uniaxial(-)
                                    root.biaxial_delta_beta_alpha_val = 0.0;
                                } else if (val == "Tanzanite") {
                                    root.mat_name = "Custom Tanzanite";
                                    root.ri_val = 1.691;
                                    root.disp_val = 0.030;
                                    root.biref_val = 0.013;
                                    root.selected_color_preset = 4;
                                    root.selected_crystal_system_idx = 4; // Orthorhombic
                                    root.selected_optical_character_idx = 3; // Biaxial(+)
                                    root.biaxial_delta_beta_alpha_val = 0.0070;
                                } else if (val == "Synthetic Moissanite") {
                                    root.mat_name = "Custom Moissanite";
                                    root.ri_val = 2.650;
                                    root.disp_val = 0.104;
                                    root.biref_val = 0.043;
                                    root.selected_color_preset = 0;
                                    root.selected_crystal_system_idx = 2; // Hexagonal
                                    root.selected_optical_character_idx = 1; // Uniaxial(+)
                                    root.biaxial_delta_beta_alpha_val = 0.0;
                                } else if (val == "Zircon") {
                                    root.mat_name = "Custom Zircon";
                                    root.ri_val = 1.950;
                                    root.disp_val = 0.039;
                                    root.biref_val = 0.059;
                                    root.selected_color_preset = 7;
                                    root.selected_crystal_system_idx = 1; // Tetragonal
                                    root.selected_optical_character_idx = 1; // Uniaxial(+)
                                    root.biaxial_delta_beta_alpha_val = 0.0;
                                } else if (val == "Topaz") {
                                    root.mat_name = "Custom Topaz";
                                    root.ri_val = 1.620;
                                    root.disp_val = 0.014;
                                    root.biref_val = 0.008;
                                    root.selected_color_preset = 8;
                                    root.selected_crystal_system_idx = 4; // Orthorhombic
                                    root.selected_optical_character_idx = 3; // Biaxial(+)
                                    root.biaxial_delta_beta_alpha_val = 0.0024;
                                } else if (val == "Spinel") {
                                    root.mat_name = "Custom Spinel";
                                    root.ri_val = 1.718;
                                    root.disp_val = 0.020;
                                    root.biref_val = 0.000;
                                    root.selected_color_preset = 6;
                                    root.selected_crystal_system_idx = 0; // Cubic
                                    root.selected_optical_character_idx = 0; // Isotropic
                                    root.biaxial_delta_beta_alpha_val = 0.0;
                                } else if (val == "Quartz") {
                                    root.mat_name = "Custom Quartz";
                                    root.ri_val = 1.544;
                                    root.disp_val = 0.013;
                                    root.biref_val = 0.009;
                                    root.selected_color_preset = 0;
                                    root.selected_crystal_system_idx = 3; // Trigonal
                                    root.selected_optical_character_idx = 1; // Uniaxial(+)
                                    root.biaxial_delta_beta_alpha_val = 0.0;
                                } else if (val == "Cubic Zirconia") {
                                    root.mat_name = "Custom CZ";
                                    root.ri_val = 2.160;
                                    root.disp_val = 0.060;
                                    root.biref_val = 0.000;
                                    root.selected_color_preset = 0;
                                    root.selected_crystal_system_idx = 0; // Cubic
                                    root.selected_optical_character_idx = 0; // Isotropic
                                    root.biaxial_delta_beta_alpha_val = 0.0;
                                }
                            }
                        }
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    Text { text: "Material Name:"; font-size: 11px; font-weight: 600; color: Theme.text-secondary; }
                    
                    Rectangle {
                        height: 32px;
                        background: Theme.surface-raised;
                        border-radius: Theme.radius-sm;
                        border-width: 1px;
                        border-color: Theme.border-dialog;

                        LineEdit {
                            text <=> root.mat_name;
                            placeholder-text: "Enter gem name...";
                        }
                    }
                }
            }

            // 3. Refractive Index (RI) Slider
            VerticalLayout {
                spacing: 4px;

                HorizontalLayout {
                    alignment: space-between;
                    Rectangle {
                        height: ri_lbl.preferred-height;
                        Tooltip { text: @markdown("Refractive index n_d, typically 1.4-2.7 for gems (up to 3.2 here for rare high-RI materials)."); }
                        ri_lbl := Text { text: "Refractive Index (nd):"; font-size: 11px; font-weight: 600; color: Theme.text-secondary; }
                    }
                    Text { text: Math.round(root.ri_val * 1000.0) / 1000.0; font-size: 11px; font-weight: 700; color: Theme.accent-cyan; }
                }

                Slider {
                    minimum: 1.30;
                    maximum: 3.20;
                    value <=> root.ri_val;
                }
            }

            // 4. Dispersion (Fire Index) Slider
            VerticalLayout {
                spacing: 4px;

                HorizontalLayout {
                    alignment: space-between;
                    Rectangle {
                        height: disp_lbl.preferred-height;
                        Tooltip { text: @markdown("Fire-producing dispersion, typically 0.01-0.044 for gems (diamond is the high end at 0.044)."); }
                        disp_lbl := Text { text: "Dispersion (Fire ΔnF-C):"; font-size: 11px; font-weight: 600; color: Theme.text-secondary; }
                    }
                    Text { text: Math.round(root.disp_val * 1000.0) / 1000.0; font-size: 11px; font-weight: 700; color: Theme.accent-purple; }
                }

                Slider {
                    minimum: 0.000;
                    maximum: 0.120;
                    value <=> root.disp_val;
                }
            }

            // CAD audit item 169: specific gravity -- without this, a custom
            // material's Est. Carat Weight stays empty unless a cutter separately
            // types an SG override in the Yield panel for every design that uses it.
            // `0.0` reads as "not recorded" on the Rust side (see `sg_val`'s own doc
            // comment) rather than a real zero-density material.
            VerticalLayout {
                spacing: 4px;

                HorizontalLayout {
                    alignment: space-between;
                    Rectangle {
                        height: sg_lbl.preferred-height;
                        Tooltip { text: @markdown("Specific gravity (density relative to water) -- used to estimate carat weight. Leave at 0 to leave it unrecorded."); }
                        sg_lbl := Text { text: "Specific Gravity:"; font-size: 11px; font-weight: 600; color: Theme.text-secondary; }
                    }
                    Text { text: root.sg_val <= 0.0001 ? "not recorded" : Math.round(root.sg_val * 100.0) / 100.0; font-size: 11px; font-weight: 700; color: Theme.accent-amber; }
                }

                Slider {
                    minimum: 0.0;
                    maximum: 7.0;
                    step: 0.01;
                    value <=> root.sg_val;
                }
            }

            // 5. Birefringence (Double Refraction) Slider
            VerticalLayout {
                spacing: 4px;

                HorizontalLayout {
                    alignment: space-between;
                    Rectangle {
                        height: biref_lbl.preferred-height;
                        Tooltip { text: @markdown("Double refraction, 0 for isotropic gems, typically up to 0.05 for most birefringent species (higher for e.g. zircon, calcite)."); }
                        biref_lbl := Text { text: "Birefringence (Δn = ne - no):"; font-size: 11px; font-weight: 600; color: Theme.text-secondary; }
                    }
                    Text { text: Math.round(root.biref_val * 1000.0) / 1000.0; font-size: 11px; font-weight: 700; color: Theme.accent-emerald; }
                }

                Slider {
                    minimum: -0.050;
                    maximum: 0.100;
                    value <=> root.biref_val;
                }
            }

            // 5b. Crystal Classification: lets the user set crystal_system/
            // optical_character/biaxial_delta_beta_alpha explicitly instead of only
            // ever getting `GemMaterial::new_custom`'s two-variant inference (Cubic-
            // or-Trigonal, Isotropic-or-Uniaxial+/-). See `gui::crystal_optics` for
            // the Rust-side index<->enum mapping these two combos feed.
            HorizontalLayout {
                spacing: 10px;

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    Text { text: "Crystal System:"; font-size: 11px; font-weight: 600; color: Theme.text-secondary; }
                    Rectangle {
                        height: 32px;
                        background: Theme.surface-raised;
                        border-radius: Theme.radius-sm;
                        border-width: 1px;
                        border-color: Theme.border-dialog;
                        ComboBox {
                            model: root.crystal_system_options;
                            current-index <=> root.selected_crystal_system_idx;
                        }
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    Text { text: "Optical Character:"; font-size: 11px; font-weight: 600; color: Theme.text-secondary; }
                    Rectangle {
                        height: 32px;
                        background: Theme.surface-raised;
                        border-radius: Theme.radius-sm;
                        border-width: 1px;
                        border-color: Theme.border-dialog;
                        ComboBox {
                            model: root.optical_character_options;
                            current-index <=> root.selected_optical_character_idx;
                        }
                    }
                }
            }

            // n_beta - n_alpha: only meaningful, so only shown, for a biaxial
            // optical character. Bounded to [0, birefringence] so the slider itself
            // cannot express an unphysical n_alpha <= n_beta <= n_gamma ordering.
            if root.is_biaxial: VerticalLayout {
                spacing: 4px;
                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "Biaxial n\u{03b2} \u{2212} n\u{03b1}:"; font-size: 11px; font-weight: 600; color: Theme.text-secondary; }
                    Text { text: Math.round(root.biaxial_delta_beta_alpha_val * 10000.0) / 10000.0; font-size: 11px; font-weight: 700; color: Theme.accent-purple; }
                }
                Slider {
                    minimum: 0.0;
                    maximum: Math.max(root.biref_val, 0.0001);
                    value <=> root.biaxial_delta_beta_alpha_val;
                }
                // No GPU consequence to warn about any more. This slot used to carry
                // an amber "renders on the CPU only" warning, because
                // `GemMaterial::gpu_supported()` returned false whenever
                // `biaxial_delta_beta_alpha` was set. The `BiaxialIndicatrix`
                // machinery is now ported to WGSL and verified at the same
                // Tier 2 / Tier 3 bar as every other material, so `gpu_supported()`
                // is unconditionally true and a biaxial custom material is dispatched
                // exactly like any other -- see `indicatrix::renderer::gpu_backend`'s
                // module doc comment for the current decline list.
            }

            if !root.optics_valid: Text {
                text: root.optics_validation_message;
                font-size: 9px;
                font-weight: 600;
                color: Theme.accent-ruby;
                wrap: word-wrap;
            }

            // Item 88: proactive collision warning -- disables Save (see `can_save`)
            // rather than letting the cutter find out only from an error toast
            // after clicking.
            if root.name_collides_with_builtin: Text {
                text: "\u{26a0} \"" + root.mat_name + "\" is a built-in material name and cannot be used for a custom one.";
                font-size: 9px;
                font-weight: 600;
                color: Theme.accent-ruby;
                wrap: word-wrap;
            }

            // 6. Body Color & Transmission Preset Swatches
            VerticalLayout {
                spacing: 6px;
                Text { text: "Gem Body Color & Transmission:"; font-size: 11px; font-weight: 600; color: Theme.text-secondary; }

                HorizontalLayout {
                    spacing: 6px;

                    // 0: Clear / White
                    Rectangle {
                        width: 40px; height: 26px; border-radius: Theme.radius-sm;
                        background: root.selected_color_preset == 0 ? #e2e8f0 : #94a3b844;
                        border-width: root.selected_color_preset == 0 ? 2px : 1px;
                        border-color: root.selected_color_preset == 0 ? Theme.accent-cyan : #475569;
                        TouchArea { clicked => { root.selected_color_preset = 0; } }
                        Text { text: "Clear"; font-size: 9px; font-weight: 700; color: root.selected_color_preset == 0 ? Theme.text-on-accent : Theme.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                    }

                    // 1: Sapphire Blue
                    Rectangle {
                        width: 40px; height: 26px; border-radius: Theme.radius-sm;
                        background: #1e40af;
                        border-width: root.selected_color_preset == 1 ? 2px : 1px;
                        border-color: root.selected_color_preset == 1 ? Theme.accent-cyan : #1d4ed8;
                        TouchArea { clicked => { root.selected_color_preset = 1; } }
                        Text { text: "Blue"; font-size: 9px; font-weight: 700; color: Theme.text-on-primary; horizontal-alignment: center; vertical-alignment: center; }
                    }

                    // 2: Ruby Red
                    Rectangle {
                        width: 40px; height: 26px; border-radius: Theme.radius-sm;
                        background: #be123c;
                        border-width: root.selected_color_preset == 2 ? 2px : 1px;
                        border-color: root.selected_color_preset == 2 ? Theme.accent-cyan : #e11d48;
                        TouchArea { clicked => { root.selected_color_preset = 2; } }
                        Text { text: "Red"; font-size: 9px; font-weight: 700; color: Theme.text-on-primary; horizontal-alignment: center; vertical-alignment: center; }
                    }

                    // 3: Emerald Green
                    Rectangle {
                        width: 40px; height: 26px; border-radius: Theme.radius-sm;
                        background: #047857;
                        border-width: root.selected_color_preset == 3 ? 2px : 1px;
                        border-color: root.selected_color_preset == 3 ? Theme.accent-cyan : #059669;
                        TouchArea { clicked => { root.selected_color_preset = 3; } }
                        Text { text: "Green"; font-size: 9px; font-weight: 700; color: Theme.text-on-primary; horizontal-alignment: center; vertical-alignment: center; }
                    }

                    // 4: Tanzanite Violet
                    Rectangle {
                        width: 40px; height: 26px; border-radius: Theme.radius-sm;
                        background: #6b21a8;
                        border-width: root.selected_color_preset == 4 ? 2px : 1px;
                        border-color: root.selected_color_preset == 4 ? Theme.accent-cyan : #7c3aed;
                        TouchArea { clicked => { root.selected_color_preset = 4; } }
                        Text { text: "Violet"; font-size: 9px; font-weight: 700; color: Theme.text-on-primary; horizontal-alignment: center; vertical-alignment: center; }
                    }

                    // 5: Canary Yellow
                    Rectangle {
                        width: 40px; height: 26px; border-radius: Theme.radius-sm;
                        background: #b45309;
                        border-width: root.selected_color_preset == 5 ? 2px : 1px;
                        border-color: root.selected_color_preset == 5 ? Theme.accent-cyan : #d97706;
                        TouchArea { clicked => { root.selected_color_preset = 5; } }
                        Text { text: "Yellow"; font-size: 9px; font-weight: 700; color: Theme.text-on-primary; horizontal-alignment: center; vertical-alignment: center; }
                    }

                    // 6: Pink Spinel
                    Rectangle {
                        width: 40px; height: 26px; border-radius: Theme.radius-sm;
                        background: #be185d;
                        border-width: root.selected_color_preset == 6 ? 2px : 1px;
                        border-color: root.selected_color_preset == 6 ? Theme.accent-cyan : #db2777;
                        TouchArea { clicked => { root.selected_color_preset = 6; } }
                        Text { text: "Pink"; font-size: 9px; font-weight: 700; color: Theme.text-on-primary; horizontal-alignment: center; vertical-alignment: center; }
                    }

                    // 7: Teal / Zircon
                    Rectangle {
                        width: 40px; height: 26px; border-radius: Theme.radius-sm;
                        background: #0f766e;
                        border-width: root.selected_color_preset == 7 ? 2px : 1px;
                        border-color: root.selected_color_preset == 7 ? Theme.accent-cyan : #0d9488;
                        TouchArea { clicked => { root.selected_color_preset = 7; } }
                        Text { text: "Teal"; font-size: 9px; font-weight: 700; color: Theme.text-on-primary; horizontal-alignment: center; vertical-alignment: center; }
                    }

                    // 8: Amber Topaz
                    Rectangle {
                        width: 40px; height: 26px; border-radius: Theme.radius-sm;
                        background: #9a3412;
                        border-width: root.selected_color_preset == 8 ? 2px : 1px;
                        border-color: root.selected_color_preset == 8 ? Theme.accent-cyan : #c2410c;
                        TouchArea { clicked => { root.selected_color_preset = 8; } }
                        Text { text: "Amber"; font-size: 9px; font-weight: 700; color: Theme.text-on-primary; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }

            Rectangle { height: 1px; background: Theme.surface-raised; }

            // 7. Action Buttons Bar
            HorizontalLayout {
                spacing: 8px;

                // Delete Button -- opens the confirmation overlay below rather than
                // deleting immediately (see `confirm_delete_open`'s own doc comment).
                Rectangle {
                    width: 70px;
                    height: 32px;
                    border-radius: Theme.radius-sm;
                    background: root.name_is_existing_custom ? (del_touch.has-hover ? Theme.danger-surface-hover : Theme.danger-surface) : Theme.danger-surface;
                    opacity: root.name_is_existing_custom ? 1.0 : 0.5;
                    border-width: 1px;
                    border-color: Theme.danger-border;

                    // Item 87: only enabled for a name that actually names an
                    // existing custom material -- see `name_is_existing_custom`'s
                    // own doc comment.
                    del_touch := TouchArea {
                        enabled: root.name_is_existing_custom;
                        clicked => { root.confirm_delete_open = true; }
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 5px;
                        Image { source: @image-url("../icons/trash.svg"); colorize: Theme.danger; width: 11px; height: 11px; vertical-alignment: center; }
                        Text { text: "Delete"; font-size: 11px; font-weight: 600; color: Theme.danger; vertical-alignment: center; }
                    }
                }

                // Cancel Button
                Rectangle {
                    width: 70px;
                    height: 32px;
                    border-radius: Theme.radius-sm;
                    background: cancel_touch.has-hover ? Theme.surface-raised : Theme.surface-sunken;
                    border-width: 1px;
                    border-color: Theme.border-dialog;

                    cancel_touch := TouchArea {
                        clicked => { root.request_close(); }
                    }

                    Text { text: "Cancel"; font-size: 11px; font-weight: 600; color: Theme.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                }

                // Save Button (Item 243): saves/overwrites the custom material in the
                // database and the in-memory material list WITHOUT touching the live
                // render's selected material -- lets a cutter prepare several custom
                // materials in a row without re-rendering the viewport with each one.
                // Disabled (and visibly dimmed) while `!root.can_save`: either a
                // contradictory optical-character/birefringence combination (see
                // `optics_valid`'s own doc comment) or a blank name.
                Rectangle {
                    horizontal-stretch: 1;
                    height: 32px;
                    border-radius: Theme.radius-sm;
                    background: root.can_save ? (save_only_touch.has-hover ? Theme.surface-raised : Theme.surface-sunken) : Theme.surface-sunken;
                    opacity: root.can_save ? 1.0 : 0.6;
                    border-width: 1px;
                    border-color: Theme.border-dialog;

                    save_only_touch := TouchArea {
                        enabled: root.can_save;
                        clicked => { root.request_save(false); }
                    }

                    Text { text: "Save"; font-size: 12px; font-weight: 700; color: root.can_save ? Theme.text-primary : Theme.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                }

                // Save & Apply Button: saves, then also switches the live render's
                // material (see `save_material`'s own doc comment above). Same
                // enablement rule as the plain Save button.
                Rectangle {
                    horizontal-stretch: 1;
                    height: 32px;
                    border-radius: Theme.radius-sm;
                    background: root.can_save ? (save_apply_touch.has-hover ? Theme.accent-cyan-hover : Theme.accent-cyan) : Theme.surface-disabled;
                    opacity: root.can_save ? 1.0 : 0.6;

                    save_apply_touch := TouchArea {
                        enabled: root.can_save;
                        // `save_material`'s own handler (above) already sets
                        // `ViewportModel.material_editor_open = false` -- Item 170: a
                        // second `root.close()` here was a no-op that happened to
                        // work only because both write the same property to the
                        // same value. Item 88: routed through `request_save`, which
                        // interposes an "Overwrite?" confirmation when `mat_name`
                        // already names an existing custom material.
                        clicked => { root.request_save(true); }
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;
                        Image { source: @image-url("../icons/check.svg"); colorize: root.can_save ? Theme.text-on-accent : Theme.text-muted; width: 12px; height: 12px; vertical-alignment: center; }
                        Text { text: "Save & Apply"; font-size: 12px; font-weight: 700; color: root.can_save ? Theme.text-on-accent : Theme.text-muted; vertical-alignment: center; }
                    }
                }
            }
        }
    }

    // Delete confirmation -- a full-viewport overlay ON TOP of the card above (same
    // stacking idiom as the modal card itself), since one click here permanently
    // removes the row from the database.
    if root.confirm_delete_open: ConfirmActionDialog {
        heading: "Delete Material";
        message: "Permanently delete the custom material \"" + root.mat_name
            + "\"? This cannot be undone. Any design currently selecting it will fall back to a built-in material of the same name, or Diamond.";
        primary_label: "Delete";
        secondary_label: "";
        primary => {
            // `delete_material`'s own handler (above) already sets
            // `ViewportModel.material_editor_open = false` -- see the matching
            // comment on the Save button's handler for why the extra `root.close()`
            // this replaced was redundant, not merely harmless.
            root.delete_material(root.mat_name);
            root.confirm_delete_open = false;
        }
        cancel => { root.confirm_delete_open = false; }
    }

    // Item 88: confirms before overwriting an EXISTING custom material -- see
    // `request_save`'s own doc comment for when this opens instead of saving
    // straight away.
    if root.confirm_overwrite_open: ConfirmActionDialog {
        heading: "Overwrite Material";
        message: "A custom material named \"" + root.mat_name
            + "\" already exists. Overwrite it with these values? Any design currently using it will pick up the change.";
        primary_label: "Overwrite";
        secondary_label: "";
        primary => {
            root.confirm_overwrite_open = false;
            root.save_material(
                root.mat_name,
                root.ri_val,
                root.disp_val,
                root.biref_val,
                root.selected_color_preset,
                root.selected_crystal_system_idx,
                root.selected_optical_character_idx,
                root.biaxial_delta_beta_alpha_val,
                root.sg_val,
                root.pending_apply
            );
        }
        cancel => { root.confirm_overwrite_open = false; }
    }

    if root.discard_confirm_open: ConfirmActionDialog {
        heading: "Discard Changes?";
        message: "This custom material has unsaved edits. Discard them?";
        primary_label: "";
        secondary_label: "Discard";
        cancel => { root.discard_confirm_open = false; }
        secondary => {
            root.discard_confirm_open = false;
            root.close();
        }
    }
}
