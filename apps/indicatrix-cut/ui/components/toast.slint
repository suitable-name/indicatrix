import { Theme } from "../theme.slint";

export component Toast inherits Rectangle {
    in property <string> text: "";
    in property <bool> is_visible: false;
    in property <string> toast_type: "info"; // info, success, error

    callback dismiss();

    visible: is_visible;
    width: 380px;
    background: toast_type == "success" ? #064e3bcc : (toast_type == "error" ? #7f1d1dcc : #0f172acc);
    border-color: toast_type == "success" ? #10b981 : (toast_type == "error" ? #ef4444 : #38bdf8);
    border-width: 1px;
    border-radius: Theme.radius-md;
    drop-shadow-blur: 20px;
    drop-shadow-color: #000000aa;
    drop-shadow-offset-y: 6px;
    clip: true;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 10px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 10px;
        alignment: space-between;

        HorizontalLayout {
            spacing: 10px;
            alignment: start;

            Image {
                source: toast_type == "success" ? @image-url("../icons/check.svg") : (toast_type == "error" ? @image-url("../icons/warning.svg") : @image-url("../icons/info.svg"));
                colorize: toast_type == "success" ? #34d399 : (toast_type == "error" ? #f87171 : #38bdf8);
                width: 15px;
                height: 15px;
                y: 1px;
            }

            // UI/UX review finding 7: was `overflow: elide` on a single-line row, so
            // any message longer than ~40 characters was silently truncated. Wraps
            // instead, with the toast's own height (no longer fixed -- see `root`'s
            // own `height` removal above) growing to fit.
            Text {
                text: root.text;
                font-size: 12px;
                font-weight: 600;
                color: #f8fafc;
                wrap: word-wrap;
            }
        }

        // Close '✕' Button
        Rectangle {
            width: 24px;
            height: 24px;
            border-radius: Theme.radius-sm;
            background: close_touch.has-hover ? #ffffff22 : transparent;

            close_touch := TouchArea {
                clicked => { root.dismiss(); }
            }

            Image {
                source: @image-url("../icons/close.svg");
                colorize: #94a3b8;
                width: 11px;
                height: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
