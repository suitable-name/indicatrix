import { Theme } from "../theme.slint";

export component Toast inherits Rectangle {
    in property <string> text: "";
    in property <bool> is_visible: false;
    // "warning" sits between info and error: like an error it never auto-dismisses
    // (see `gui::mod::show_toast`), because it reports something the cutter has to
    // act on -- a schedule saved with fabricated masts, say -- but it is not a
    // failure, and colouring it as one would cry wolf.
    in property <string> toast_type: "info"; // info, success, warning, error

    callback dismiss();

    visible: is_visible;
    width: 380px;
    // A Rectangle outside a layout has no intrinsic size: with no `height` it fills
    // its parent (the whole window). Size it to the wrapped content instead.
    height: content.preferred-height;
    background: toast_type == "success" ? Theme.toast-success-surface : (toast_type == "error" ? Theme.toast-error-surface : (toast_type == "warning" ? Theme.toast-warning-surface : Theme.toast-info-surface));
    border-color: toast_type == "success" ? Theme.accent-emerald : (toast_type == "error" ? Theme.danger : (toast_type == "warning" ? Theme.accent-amber : Theme.accent-cyan));
    border-width: 1px;
    border-radius: Theme.radius-md;
    drop-shadow-blur: 20px;
    drop-shadow-color: Theme.toast-shadow;
    drop-shadow-offset-y: 6px;
    clip: true;

    content := HorizontalLayout {
        padding-left: 14px;
        padding-right: 10px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 10px;
        alignment: space-between;

        HorizontalLayout {
            spacing: 10px;
            alignment: start;

            Image {
                source: toast_type == "success" ? @image-url("../icons/check.svg") : ((toast_type == "error" || toast_type == "warning") ? @image-url("../icons/warning.svg") : @image-url("../icons/info.svg"));
                colorize: toast_type == "success" ? Theme.success : (toast_type == "error" ? Theme.danger : (toast_type == "warning" ? Theme.accent-amber : Theme.accent-cyan));
                width: 15px;
                height: 15px;
                y: 1px;
            }

            // Wraps rather than eliding a single-line row, so a long message stays
            // fully readable instead of being silently truncated; the toast's own
            // height (bound to `content.preferred-height` above) grows to fit the
            // wrapped text.
            Text {
                text: root.text;
                font-size: 12px;
                font-weight: 600;
                color: Theme.text-primary;
                wrap: word-wrap;
            }
        }

        // Close '✕' Button
        Rectangle {
            width: 24px;
            height: 24px;
            border-radius: Theme.radius-sm;
            background: close_touch.has-hover ? Theme.overlay-hover : transparent;

            close_touch := TouchArea {
                clicked => { root.dismiss(); }
            }

            Image {
                source: @image-url("../icons/close.svg");
                colorize: Theme.text-secondary;
                width: 11px;
                height: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
