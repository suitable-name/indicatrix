import { ScrollView } from "std-widgets.slint";
import { AngleItem } from "../types.slint";
import { Theme } from "../theme.slint";
import { LibraryModel } from "../models/library.slint";
import { CuttingTableModel } from "../models/cutting_table.slint";
import { HelpTopics } from "../models/help.slint";
import { HelpButton } from "help_button.slint";
import { ModePill } from "pill_button.slint";
import { TipButton } from "compact_controls.slint";

// The library's Cutting Instructions tab: the selected design's steps as a table.
//
// Keyboard: Tab reaches the three filter pills (Space or Enter picks one), the Copy button and
// the "?" button, and then the table itself. In the table Up and Down move a cursor from row to
// row (over the rows the filter shows), Home and End jump to the first and last row, and Enter or
// Space copies the cursor row. A click on a row copies it too. A screen reader hears each row as
// one list item ("Step 3: facet A, angle 50.00, index 12, ...").
export component CuttingTableView inherits Rectangle {
    in property <[AngleItem]> angles: LibraryModel.current_angles;
    in-out property <int> filter_mode: 0; // 0 = All, 1 = Pavilion, 2 = Crown
    // The row the keyboard cursor is on (its `order_idx`); -1 for none. Reset whenever another
    // design is shown or the filter changes.
    in-out property <int> cursor: -1;
    changed angles => { root.cursor = -1; }
    changed filter_mode => { root.cursor = -1; }

    callback copy_row(int); // order_idx
    copy_row(idx) => { LibraryModel.copy_cutting_row(idx); }
    callback copy_table();
    copy_table => { LibraryModel.copy_cutting_table(); }

    // Each pill shows its own per-mode row count via
    // `LibraryModel.filtered_row_count(mode)` (Rust body:
    // `gui::library::detail::count_angles_for_mode`, registered by
    // `setup_filtered_row_count_callback` from `gui::mod::build_main_window`),
    // matching `row_shown` below's own visibility predicate exactly (mode 0 ->
    // every row, mode 1 -> `side < 0`, mode 2 -> `side > 0`). Slint's
    // imperative statements have no general loop or array `.filter`/`.reduce`,
    // and a `pure function` here cannot even recurse to fake one (confirmed by
    // trying it -- `cargo clippy -p indicatrix-cut` reported "the binding for
    // the property 'count-from' is part of a binding loop"), hence the
    // Rust-side callback rather than a Slint helper. The keyboard cursor needs the same
    // predicate, so it asks `CuttingTableModel.step_row` for the same reason.
    background: Theme.bg-darkest;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-subtle;
    accessible-role: AccessibleRole.groupbox;
    accessible-label: "Cutting instructions";

    VerticalLayout {
        padding: 12px;
        spacing: 10px;

        // Table Action Header
        HorizontalLayout {
            alignment: space-between;
            spacing: 8px;

            Rectangle {
                accessible-role: AccessibleRole.groupbox;
                accessible-label: "Which steps to show";
                HorizontalLayout {
                    spacing: 6px;

                    ModePill {
                        width: 116px;
                        font_size: 11px;
                        text: "All Steps (" + LibraryModel.filtered_row_count(0) + ")";
                        hint: "Show every step of the cutting instructions.";
                        selected: root.filter_mode == 0;
                        picked => { root.filter_mode = 0; }
                    }
                    ModePill {
                        width: 108px;
                        font_size: 11px;
                        text: "Pavilion (" + LibraryModel.filtered_row_count(1) + ")";
                        hint: "Show only the pavilion steps, the ones below the girdle.";
                        selected: root.filter_mode == 1;
                        picked => { root.filter_mode = 1; }
                    }
                    ModePill {
                        width: 96px;
                        font_size: 11px;
                        text: "Crown (" + LibraryModel.filtered_row_count(2) + ")";
                        hint: "Show only the crown steps, the ones above the girdle.";
                        selected: root.filter_mode == 2;
                        picked => { root.filter_mode = 2; }
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                TipButton {
                    text: "Copy Instructions";
                    hint: "Copy the whole cutting table to the clipboard, so you can paste it into a document.";
                    icon: @image-url("../icons/clipboard.svg");
                    clicked => { root.copy_table(); }
                }
                VerticalLayout {
                    alignment: center;
                    HelpButton {
                        topic: HelpTopics.cutting-table;
                        hint: "Open the manual page on the cutting instructions";
                    }
                }
            }
        }

        // Table Column Headers
        Rectangle {
            height: 32px;
            background: Theme.bg-card;
            border-radius: Theme.radius-sm;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                alignment: start;

                Text { width: 50px; text: "#"; font-size: 11px; font-weight: 700; color: Theme.text-muted; vertical-alignment: center; }
                Text { width: 90px; text: "FACET"; font-size: 11px; font-weight: 700; color: Theme.text-muted; vertical-alignment: center; }
                Text { width: 90px; text: "ANGLE"; font-size: 11px; font-weight: 700; color: Theme.text-muted; vertical-alignment: center; }
                // "INDICES" here matches `editor_view.slint`'s own tier-list column
                // for the same concept -- the shorter, already-used-elsewhere name,
                // used for both.
                Text { width: 150px; text: "INDICES"; font-size: 11px; font-weight: 700; color: Theme.text-muted; vertical-alignment: center; }
                Text { horizontal-stretch: 1; text: "INSTRUCTIONS / NOTES"; font-size: 11px; font-weight: 700; color: Theme.text-muted; vertical-alignment: center; }
            }
        }

        if root.angles.length == 0: VerticalLayout {
            alignment: center;
            spacing: 8px;
            vertical-stretch: 1;

            Image { source: @image-url("../icons/ruler.svg"); colorize: Theme.text-muted; width: 32px; height: 32px; horizontal-alignment: center; }
            Text { text: "No cutting instructions recorded for this diagram"; font-size: 13px; color: Theme.text-muted; horizontal-alignment: center; }
        }

        if root.angles.length > 0: Rectangle {
            vertical-stretch: 1;
            table_focus := FocusScope {
                accessible-role: AccessibleRole.list;
                accessible-label: "Cutting instruction steps";
                accessible-description: "Up and Down move between steps. Enter copies the step you are on.";

                key-pressed(event) => {
                    if event.text == Key.DownArrow {
                        root.cursor = CuttingTableModel.step_row(root.angles, root.cursor, 1, root.filter_mode);
                        return accept;
                    }
                    if event.text == Key.UpArrow {
                        root.cursor = CuttingTableModel.step_row(root.angles, root.cursor, -1, root.filter_mode);
                        return accept;
                    }
                    if event.text == Key.Home {
                        root.cursor = CuttingTableModel.step_row(root.angles, root.cursor, -1000000, root.filter_mode);
                        return accept;
                    }
                    if event.text == Key.End {
                        root.cursor = CuttingTableModel.step_row(root.angles, root.cursor, 1000000, root.filter_mode);
                        return accept;
                    }
                    if (event.text == Key.Return || event.text == Key.Space) && root.cursor >= 0 {
                        root.copy_row(root.cursor);
                        return accept;
                    }
                    reject
                }

                table_scroll := ScrollView {
                    VerticalLayout {
                        spacing: 2px;

                        for row in root.angles: Rectangle {
                            // Pavilion/Crown filtering, driven by `AngleItem.side`
                            // (-1 pavilion, 1 crown, 0 neither) so the filter never has to
                            // reparse the formatted angle text. A row that does not match the
                            // active filter collapses to zero height and `visible: false`
                            // rather than being excluded from the `for`, since Slint has no
                            // way to skip a repeater iteration outright.
                            property <bool> row_shown: root.filter_mode == 0
                                || (root.filter_mode == 1 && row.side < 0)
                                || (root.filter_mode == 2 && row.side > 0);
                            // A concave tier is ONE band of two lines: the facet line above and its
                            // tool line (`AngleItem.second_line`) under it. The zebra alternates per
                            // tier, not per line, so the two lines share this one background.
                            property <bool> has_second_line: row.second_line != "";
                            // The keyboard cursor is on this row.
                            property <bool> is_cursor: root.cursor == row.order_idx;
                            // Keep the cursor row inside the scrolled area.
                            changed is_cursor => {
                                if self.is_cursor && self.row_shown {
                                    if self.y < -table_scroll.content-y {
                                        table_scroll.content-y = -self.y;
                                    } else if self.y + self.height > -table_scroll.content-y + table_scroll.visible-height {
                                        table_scroll.content-y = -(self.y + self.height - table_scroll.visible-height);
                                    }
                                }
                            }
                            height: self.row_shown ? (self.has_second_line ? 54px : 32px) : 0px;
                            visible: self.row_shown;
                            clip: true;
                            background: row_touch.has-hover ? Theme.bg-card-hover : (Math.mod(row.order_idx, 2) == 0 ? Theme.bg-input : Theme.bg-card);
                            border-radius: 2px;
                            border-width: self.is_cursor && table_focus.has-focus ? 2px : 0px;
                            border-color: Theme.accent-cyan-hover;

                            accessible-role: AccessibleRole.list-item;
                            accessible-label: "Step " + (row.order_idx + 1) + ": facet " + row.code
                                + (row.facet != "" && row.code != row.facet ? " (was " + row.facet + ")" : "")
                                + ", angle " + row.angle
                                + (row.index_val != "" ? ", index " + row.index_val : "")
                                + (row.notes != "" ? ", " + row.notes : "")
                                + (row.second_line != "" ? ", " + row.second_line : "");
                            accessible-description: "Click or press Enter to copy this row.";
                            accessible-item-selectable: true;
                            accessible-item-selected: self.is_cursor;
                            accessible-item-index: row.order_idx;
                            accessible-item-count: root.angles.length;
                            accessible-action-default => { root.copy_row(row.order_idx); }

                            row_touch := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => {
                                    root.cursor = row.order_idx;
                                    root.copy_row(row.order_idx);
                                }
                            }
                            Tooltip { text: @markdown("Click to copy this row."); }

                            VerticalLayout {
                                HorizontalLayout {
                                    height: 32px;
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    alignment: start;

                                    Text { width: 50px; text: row.order_idx + 1; font-size: 11px; color: Theme.text-muted; vertical-alignment: center; accessible-role: AccessibleRole.none; }
                                    // The standard code (`P1`, `G1`, `C1`, `T`); a catalogue row that
                                    // kept the old 123/ABC labels also shows its own label, small, as
                                    // "was 3", so the original stays visible.
                                    Rectangle {
                                        width: 90px;
                                        HorizontalLayout {
                                            spacing: 4px;
                                            alignment: start;
                                            Text { text: row.code; font-size: 11px; font-weight: 600; color: Theme.accent-cyan; vertical-alignment: center; accessible-role: AccessibleRole.none; }
                                            if row.facet != "" && row.code != row.facet: Text { text: "was " + row.facet; font-size: 10px; color: Theme.text-muted; vertical-alignment: center; accessible-role: AccessibleRole.none; }
                                        }
                                    }
                                    Text { width: 90px; text: row.angle; font-size: 11px; font-weight: 600; color: Theme.accent-amber; vertical-alignment: center; accessible-role: AccessibleRole.none; }
                                    Text { width: 150px; text: row.index_val; font-size: 11px; color: Theme.text-primary; vertical-alignment: center; accessible-role: AccessibleRole.none; }
                                    Text { horizontal-stretch: 1; text: row.notes; font-size: 11px; color: Theme.text-secondary; overflow: elide; vertical-alignment: center; accessible-role: AccessibleRole.none; }
                                    // A clipboard icon on hover gives a copy-on-click row a
                                    // visible affordance for that behaviour, instead of being a
                                    // plain-looking row that happens to react to a click.
                                    Image {
                                        source: @image-url("../icons/clipboard.svg");
                                        colorize: Theme.text-muted;
                                        width: 12px;
                                        height: 12px;
                                        visible: row_touch.has-hover;
                                        vertical-alignment: center;
                                    }
                                }
                                // The tool line, indented to sit under the facet name.
                                if row.second_line != "": HorizontalLayout {
                                    height: 20px;
                                    padding-left: 62px;
                                    padding-right: 12px;
                                    Text {
                                        horizontal-stretch: 1;
                                        text: row.second_line;
                                        font-size: 11px;
                                        color: Theme.accent-cyan;
                                        overflow: elide;
                                        vertical-alignment: center;
                                        accessible-role: AccessibleRole.none;
                                    }
                                }
                            }
                        }
                    }
                }

                // The focus ring of the whole table while the cursor is not on a row yet.
                Rectangle {
                    background: transparent;
                    border-radius: Theme.radius-sm;
                    border-width: table_focus.has-focus && root.cursor < 0 ? 2px : 0px;
                    border-color: Theme.accent-cyan-hover;
                }
            }
        }
    }
}
