import { OpticalModel } from "../models/optical.slint";
import { OpticalPanel } from "gem_viewport/optical_panel.slint";
import { Theme } from "../theme.slint";
import { LightingPresetItem } from "../types.slint";
import { ExportDialog } from "export_dialog.slint";
import { ExportModel } from "../models/export.slint";
import { ViewportModel } from "../models/viewport.slint";
import { SolidPreviewModel } from "../models/solid_preview.slint";
import { SettingsModel } from "../models/settings.slint";
import { TiltModel } from "../models/tilt.slint";
import { EditorModel } from "../models/editor.slint";
// The Material/Lighting selectors and action-button row -- see
// `GemViewportToolbarActions`'s own doc comment
// (`gem_viewport/toolbar_actions.slint`) for why this is split out.
import { GemViewportToolbarActions } from "gem_viewport/toolbar_actions.slint";
// "Cut: After P2 (3 of 12)" with a "Show finished" button, while this picture is the Edit
// tab's design cut back by the Cut slider -- see `LiveCutBadge`'s own doc comment.
import { LiveCutBadge } from "gem_viewport/live_cut_badge.slint";
import { ModePill } from "pill_button.slint";
import { HelpButton } from "help_button.slint";
import { HelpTopics } from "../models/help.slint";

export component GemViewportView inherits Rectangle {
    vertical-stretch: 1;
    min-height: 0px;
    min-width: 0px;
    preferred-height: 480px;
    clip: true;

    property <length> last_mouse_x;
    property <length> last_mouse_y;
    property <bool> is_right_drag: false;
    property <bool> is_dragging: false;
    // The picture is the Edit tab's design, cut back by the Cut slider (which Live Render
    // follows): say so. A Library row on the viewport is always drawn whole, so no pill then.
    property <bool> cut_visible: EditorModel.enabled && ViewportModel.shows_editor_design && SolidPreviewModel.tier_cutoff != -1;

    background: Theme.viewport-bg;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-subtle;

    // Slint has no built-in way to report a widget's rendered size back to Rust -- see
    // `solid_viewport.slint`'s own identical `changed width`/`changed height` doc
    // comment. Pushed unconditionally (not just while `live_view_mode == 0`): this
    // component and `SolidViewportView` are mutually exclusive (only the Live Render
    // OR the Edit sub-tab is ever mounted at once -- see `app.slint`), so there is
    // never a competing writer, and pushing on every resize (not just a mode switch)
    // means the size is already correct the moment the user flips into Solid mode,
    // rather than stale until the next resize.
    //
    // `live_viewport_width`/`live_viewport_height`, NOT `SolidPreviewModel.
    // viewport_width`/`viewport_height`: if this component and `SolidViewportView`
    // pushed their layout size into the SAME two properties, whichever one
    // resized last would silently clobber the other's pending redraw size
    // (resizing the Live Render viewport while the Edit tab was open
    // would leave ITS next redraw sized to the Live tab's viewport, or vice
    // versa). See `SolidPreviewModel.live_viewport_width`'s own doc comment.
    changed width => { OpticalModel.invalidate(); SolidPreviewModel.live_viewport_width = self.width; }
    changed height => { OpticalModel.invalidate(); SolidPreviewModel.live_viewport_height = self.height; }
    // Also pushed once on mount, not left to the two `changed` handlers above
    // alone: those only fire on a REAL size change relative to what this
    // component's own tracker last saw, but a fresh instance (this component
    // sits inside a conditional elsewhere -- switching away from and back to
    // the Live Render tab remounts it) starts with no size pushed at all,
    // which can leave `SolidPreviewModel.live_viewport_*` reading a stale size
    // from whatever WAS mounted before, right up until the next real resize.
    init => {
        SolidPreviewModel.live_viewport_width = self.width;
        SolidPreviewModel.live_viewport_height = self.height;
    }

    // Viewport TouchArea for Orbit, Pan, Zoom with True Incremental Deltas
    touch_area := TouchArea {
        enabled: !ViewportModel.material_editor_open && !TiltModel.dialog_open;

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.last_mouse_x = touch_area.mouse-x;
                root.last_mouse_y = touch_area.mouse-y;
                // Shift+drag is an ALTERNATIVE to the right button, not a convenience:
                // on a Windows Precision Touchpad, holding the two-finger right-click
                // gesture and moving is delivered by the driver as a held *left*
                // button, so a laptop user physically cannot produce a right-drag no
                // matter how this is wired. The light would silently orbit the camera
                // instead. A modifier+left-drag is the standard answer (it is why 3D
                // applications have one at all), and it costs mouse users nothing --
                // the right button still works exactly as before.
                //
                // Captured once, at `down`, rather than read live during `moved`: the
                // gesture's meaning is fixed when it starts, so pressing or releasing
                // Shift mid-drag must not flip the camera into the light halfway
                // through a movement.
                root.is_right_drag = (event.button == PointerEventButton.right)
                    || event.modifiers.shift;
                root.is_dragging = true;
                OpticalModel.invalidate();
                ViewportModel.camera_drag_begin();
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                if (root.is_dragging) {
                    root.is_dragging = false;
                    ViewportModel.camera_drag_end();
                }
            }
        }
        // Belt and braces for a release that never arrives as `up`/`cancel` (a lost
        // grab, focus loss) or an area disabled mid-drag (settings, the material
        // editor, the Tilt Curve dialog): whenever Slint's own pressed state drops,
        // the drag is over.
        changed pressed => {
            if (!self.pressed && root.is_dragging) {
                root.is_dragging = false;
                ViewportModel.camera_drag_end();
            }
        }
        changed enabled => {
            if (!self.enabled && root.is_dragging) {
                root.is_dragging = false;
                ViewportModel.camera_drag_end();
            }
        }
        moved => {
            let image_w = min(root.width, root.height * OpticalModel.aspect);
            let image_h = image_w / OpticalModel.aspect;
            OpticalModel.hover(
                (self.mouse-x - (root.width - image_w) / 2) / image_w,
                (self.mouse-y - (root.height - image_h) / 2) / image_h
            );
            if (root.is_dragging) {
                let dx = (touch_area.mouse-x - root.last_mouse_x) / 1px;
                let dy = (touch_area.mouse-y - root.last_mouse_y) / 1px;
                root.last_mouse_x = touch_area.mouse-x;
                root.last_mouse_y = touch_area.mouse-y;
                if (root.is_right_drag) {
                    ViewportModel.light_move(dx, dy);
                } else {
                    ViewportModel.camera_orbit(dx, dy);
                }
            }
        }
        scroll-event(event) => {
            ViewportModel.camera_zoom(event.delta-y / 1px);
            accept
        }
    }

    // Live Rendered Image -- Path-traced mode only; Solid mode shows the flat-shaded
    // CPU raster below instead (see `ViewportModel.live_view_mode`'s own doc comment).
    if (ViewportModel.live_view_mode == 1 || ViewportModel.live_view_mode == 2) && ViewportModel.has_render: Image {
        width: 100%;
        height: 100%;
        source: ViewportModel.render_image;
        image-fit: contain;
        // Dimmed to a bare silhouette while `ViewportModel.trace_refusal` is set --
        // see that property's own doc comment. Never hidden outright: a dimmed
        // last-good frame still orients the cutter better than a blank rectangle,
        // while the banner below makes it unmistakable that the material is refused,
        // not merely that this reflects the current design.
        opacity: ViewportModel.trace_refusal == "" ? 1.0 : 0.15;
    }

    // Material-refusal banner -- shown instead of trusting a render, export or tilt
    // sweep that would otherwise trace the wrong stone (as Diamond, or as whatever
    // the previous design's material was) -- see `ViewportModel.trace_refusal`'s own
    // doc comment. Path-traced mode only: the Solid raster carries no material at
    // all, so there is nothing wrong with it to warn about.
    if (ViewportModel.live_view_mode == 1 || ViewportModel.live_view_mode == 2) && ViewportModel.trace_refusal != "": Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;

        VerticalLayout {
            alignment: center;
            padding: 32px;

            Rectangle {
                border-radius: Theme.radius-md;
                background: Theme.accent-amber;

                VerticalLayout {
                    padding: 16px;
                    spacing: 6px;

                    Text {
                        text: "Cannot trace this design";
                        font-size: 14px;
                        font-weight: 700;
                        color: Theme.bg-darkest;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }

                    Text {
                        text: ViewportModel.trace_refusal;
                        font-size: 12px;
                        color: Theme.bg-darkest;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }

    // Optical diagnostic layer: a separate transparent image over the live render.
    if ViewportModel.live_view_mode == 1 && ViewportModel.has_render && ViewportModel.trace_refusal == "" && !ViewportModel.trace_stale && OpticalModel.enabled && OpticalModel.ready: Image {
        width: min(root.width, root.height * OpticalModel.aspect);
        height: self.width / OpticalModel.aspect;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        source: OpticalModel.image;
        image-rendering: pixelated;
        image-fit: fill;
    }
    // Solid Rendered Image -- Solid mode only. `SolidPreviewModel.image` is the SAME
    // flat-shaded raster the Edit tab's `SolidViewportView` shows, always forced to
    // `view_mode` 0 here regardless of the Edit tab's own choice -- see
    // `gui::render::camera_lighting::resubmit_live_solid`'s own doc comment for why
    // that must never leak across tabs.
    if ViewportModel.live_view_mode == 0 && SolidPreviewModel.has_solid: Image {
        width: 100%;
        height: 100%;
        source: SolidPreviewModel.image;
        image-fit: contain;
    }

    // Fallback: Solid mode, nothing solved/selected yet.
    if ViewportModel.live_view_mode == 0 && !SolidPreviewModel.has_solid: VerticalLayout {
        alignment: center;
        spacing: 12px;

        // Centred by a layout of its own: a fixed-size Image in the column sits at the left of
        // its cell (`horizontal-alignment` only places the picture inside the Image).
        HorizontalLayout {
            alignment: center;
            Image {
                source: @image-url("../icons/gem.svg");
                colorize: Theme.text-muted;
                width: 56px;
                height: 56px;
            }
        }

        Text {
            text: "Select a design to preview";
            font-size: 16px;
            font-weight: 700;
            color: Theme.text-primary;
            horizontal-alignment: center;
        }
    }

    // Fallback: Path-traced mode, initial state (nothing rendered yet).
    if (ViewportModel.live_view_mode == 1 || ViewportModel.live_view_mode == 2) && !ViewportModel.has_render: VerticalLayout {
        alignment: center;
        spacing: 12px;

        HorizontalLayout {
            alignment: center;
            Image {
                source: @image-url("../icons/gem.svg");
                colorize: Theme.text-muted;
                width: 56px;
                height: 56px;
            }
        }

        Text {
            text: "Physically Based Spectral Gem Viewport";
            font-size: 16px;
            font-weight: 700;
            color: Theme.text-primary;
            horizontal-alignment: center;
        }

        Text {
            text: "Drag with left mouse button to rotate freely in 3D";
            font-size: 12px;
            color: Theme.text-muted;
            horizontal-alignment: center;
        }
    }

    // --- TOP CONTROLS OVERLAY (Mode Toggle, Material, Lighting, Settings & Metrics) ---
    // Explicit `x`/`y`/`width`/`height`: this overlay is a stack of fixed-height
    // rows, and a plain (default-positioned) layout child would hand its small
    // maximum height and the toolbar's summed width up to the viewport as ITS
    // constraints, capping the viewport at ~150px tall. An explicitly
    // positioned child contributes no constraints -- see `app.slint`'s
    // "Sizing notes".
    VerticalLayout {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        padding: 12px;
        spacing: 8px;

        // --- Solid / Path-traced mode toggle -- top-left of the viewport image area,
        // same pill style as `solid_viewport.slint`'s Edit-tab toggle. Lets a user
        // browse the library with the fast CPU solid rasterizer and only pay for the
        // spectral path tracer on the design they actually want to inspect -- see
        // `gui::render::render_visibility::render_is_visible`'s own doc comment for how
        // this gates the tracer itself, not just what's displayed.
        HorizontalLayout {
            spacing: 8px;

            ModePill {
                width: 84px;
                text: "Solid";
                hint: "Flat-shaded quick picture of the solved stone. It is fast, and the spectral light tracer stays off while this is showing.";
                selected: ViewportModel.live_view_mode == 0;
                picked => { ViewportModel.live_view_mode = 0; }
            }

            ModePill {
                width: 110px;
                text: "Path-Traced";
                hint: "The realistic picture: a spectral path tracer follows light through the stone. Turns the graphics-card or remote tracer on for this design.";
                selected: ViewportModel.live_view_mode == 1;
                picked => { ViewportModel.live_view_mode = 1; }
            }

            ModePill {
                width: 110px;
                text: "Ray-Traced";
                hint: "Ray-Traced is an approximation: one index per color chain and averaged color; no polarization, doubling, haze, zoning, edge rounding or diffuse frost light. Energy past the bounce limit is omitted.";
                selected: ViewportModel.live_view_mode == 2;
                picked => { ViewportModel.live_view_mode = 2; }
            }

            // Live Render follows the Edit tab's Cut slider; exports never do.
            if root.cut_visible: LiveCutBadge { }

            Rectangle { horizontal-stretch: 1; }

            VerticalLayout {
                alignment: center;
                HelpButton {
                    topic: HelpTopics.live-render;
                    hint: "Open the manual page on the Live Render viewport";
                }
            }
        }

        // A layout never shrinks below its children's minimum width; without this
        // wrapper a toolbar wider than the window inflates the whole render column and
        // pushes the viewport image off-centre. Overflow is clipped here instead.
        // The metrics HUD used to share this row and squeezed the actions; it now has
        // its own row below.
        Rectangle {
            min-width: 0px;
            clip: true;
            height: toolbar.preferred-height;
            toolbar := HorizontalLayout {
                // Material & Lighting Selectors & Action Buttons -- see
                // `GemViewportToolbarActions`'s own doc comment
                // (`gem_viewport/toolbar_actions.slint`) for why this is split out.
                // `compact` drops the labels that only decorate an icon or a toggle.
                // 1180 px, not 1100: the colour pill added about 80 px to the full-width
                // row (the least it needs is about 1060 px with a colour readout showing),
                // and the Parameters dock's three buttons in place of the one gear another
                // 64 px plus gaps, so the labels drop earlier. This is the VIEWPORT's width,
                // which the docked Parameters panel narrows by its own.
                // `wrap`: the row needs about 800px inside the 12px padding (Advanced mode, all
                // pills showing) -- 824px of viewport -- so from 860px of viewport it is one row;
                // narrower, pause / the Parameters buttons / Export drop to a second row instead
                // of being clipped. The left row then needs about 570px, and `app.slint` never
                // docks the Parameters panel beside a viewport narrower than 700px.
                //
                // The amber "Previewing <material>" badge (about 220px compact, 290px full: name +
                // "Back to design" button) sits in the FIRST row while the row is single, so both
                // thresholds grow while it shows: `wrap` by 230px (compact single row: 825 + 230 =
                // 1055px, threshold 1090px) and `compact` by the badge's full 290px (the full row's
                // 1060px least plus 290px = 1350px against 1180 + 290 = 1470px, keeping the 120px
                // slack the row has without the badge). Once the tail wraps, the badge moves
                // to the second row beside the tail, so the left row keeps its 570px need and the
                // 700px docking minimum. (The "Color data updated" badge only shows in the full row,
                // whose 1060px figure already counts it.)
                // The Optical Diagnostics button (Path-Traced only) adds about 170px with its
                // label and 40px as an icon, so both thresholds include it: 1180 + 180 and
                // 860 + 40. The wrapped left row then needs about 610px, still under the 700px
                // docking minimum.
                GemViewportToolbarActions {
                    compact: root.width < 1360px + (ViewportModel.previewing ? 290px : 0px);
                    wrap: root.width < 900px + (ViewportModel.previewing ? 230px : 0px);
                }
            }
        }

        // Real-Time 5-Point Gemological Metrics HUD -- belongs to the tracer:
        // only shown in Path-traced mode (`live_view_mode == 1`). Solid mode's
        // flat-shaded raster has no brilliance/fire/scintillation/windowing/
        // extinction samples to report. Its own row under the actions (it is about
        // 450px wide), so neither squeezes the other. When it is the whole width and
        // no wider, it clips.
        if ViewportModel.live_view_mode == 1: HorizontalLayout {
            alignment: start;

            Rectangle {
                min-width: 0px;
                clip: true;
                background: Theme.hud-surface;
                border-radius: Theme.radius-sm;
                border-width: hud_focus.has-focus ? 2px : 1px;
                border-color: hud_focus.has-focus ? Theme.accent-cyan-hover : Theme.border-medium;

                accessible-role: AccessibleRole.button;
                accessible-label: "Copy the Five Gemological Numbers";
                accessible-description: "Brilliance " + Math.round(ViewportModel.brilliance_pct) + " percent, scintillation " + Math.round(ViewportModel.scintillation_pct) + " percent, windowing " + Math.round(ViewportModel.windowing_pct) + " percent, extinction " + Math.round(ViewportModel.extinction_pct) + " percent.";
                accessible-action-default => { ViewportModel.copy_metrics(); }

                hud_focus := FocusScope {
                    key-pressed(event) => {
                        if event.text == Key.Space || event.text == Key.Return {
                            ViewportModel.copy_metrics();
                            return accept;
                        }
                        return reject;
                    }
                }
                hud_touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { ViewportModel.copy_metrics(); }
                }
                Tooltip { text: @markdown("Click to copy these five numbers. **Brilliance**: the share of light returned to the eye. **Fire**: how much rainbow color the stone throws. **Scintillation**: sparkle as the light or stone moves. **Windowing**: the share of the face that looks see-through. **Extinction**: the share that looks dead dark. See the glossary."); }

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    spacing: 12px;

                    HorizontalLayout {
                        spacing: 4px;
                        Text { text: "Brilliance:"; font-size: 11px; font-weight: 600; color: Theme.text-muted; }
                        Text { text: Math.round(ViewportModel.brilliance_pct) + "%"; font-size: 11px; font-weight: 700; color: Theme.accent-emerald; }
                    }

                    HorizontalLayout {
                        spacing: 4px;
                        Text { text: "Fire:"; font-size: 11px; font-weight: 600; color: Theme.text-muted; }
                        Text { text: Math.round(ViewportModel.fire_index * 100.0) / 100.0; font-size: 11px; font-weight: 700; color: Theme.accent-cyan; }
                    }

                    HorizontalLayout {
                        spacing: 4px;
                        Text { text: "Scintillation:"; font-size: 11px; font-weight: 600; color: Theme.text-muted; }
                        Text { text: Math.round(ViewportModel.scintillation_pct) + "%"; font-size: 11px; font-weight: 700; color: Theme.accent-purple; }
                    }

                    HorizontalLayout {
                        spacing: 4px;
                        Text { text: "Windowing:"; font-size: 11px; font-weight: 600; color: Theme.text-muted; }
                        Text { text: Math.round(ViewportModel.windowing_pct) + "%"; font-size: 11px; font-weight: 700; color: ViewportModel.windowing_pct > 10.0 ? Theme.accent-ruby : Theme.text-secondary; }
                    }

                    HorizontalLayout {
                        spacing: 4px;
                        Text { text: "Extinction:"; font-size: 11px; font-weight: 600; color: Theme.text-muted; }
                        Text { text: Math.round(ViewportModel.extinction_pct) + "%"; font-size: 11px; font-weight: 700; color: ViewportModel.extinction_pct > 12.0 ? Theme.accent-amber : Theme.text-secondary; }
                    }
                }
            }
        }

        // Pushes the hint badges below to the bottom edge -- replaces the outer
        // VerticalLayout's old `alignment: space-between` (now `spacing: 8px`, to make
        // room for the mode-toggle row above without shoving it away from the top).
        Rectangle { vertical-stretch: 1; }

        // --- BOTTOM INTERACTION HINT BADGES ---
        HorizontalLayout {
            spacing: 6px;
            alignment: center;

            Rectangle {
                background: Theme.hint-surface;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.border-subtle;
                HorizontalLayout {
                    padding-left: 8px; padding-right: 8px; padding-top: 4px; padding-bottom: 4px; spacing: 5px;
                    // Centred by a layout of its own: a fixed-size Image in the row sits at the
                    // top of its cell (`vertical-alignment` only places the picture inside the Image).
                    VerticalLayout {
                        alignment: center;
                        Image { source: @image-url("../icons/mouse.svg"); colorize: Theme.hint-text; width: 10px; height: 10px; }
                    }
                    Text { text: "Left Drag: 360° Gem Orbit"; font-size: 10px; font-weight: 600; color: Theme.hint-text; vertical-alignment: center; }
                }
            }

            Rectangle {
                background: Theme.hint-surface;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.border-subtle;
                HorizontalLayout {
                    padding-left: 8px; padding-right: 8px; padding-top: 4px; padding-bottom: 4px; spacing: 5px;
                    VerticalLayout {
                        alignment: center;
                        Image { source: @image-url("../icons/lightbulb.svg"); colorize: Theme.hint-text; width: 10px; height: 10px; }
                    }
                    Text { text: "Right / Shift+Drag: Move Light"; font-size: 10px; font-weight: 600; color: Theme.hint-text; vertical-alignment: center; }
                }
            }

            Rectangle {
                background: Theme.hint-surface;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.border-subtle;
                HorizontalLayout {
                    padding-left: 8px; padding-right: 8px; padding-top: 4px; padding-bottom: 4px; spacing: 5px;
                    VerticalLayout {
                        alignment: center;
                        Image { source: @image-url("../icons/search.svg"); colorize: Theme.hint-text; width: 10px; height: 10px; }
                    }
                    Text { text: "Scroll: Zoom"; font-size: 10px; font-weight: 600; color: Theme.hint-text; vertical-alignment: center; }
                }
            }

            // The HUD tip, dropped on a narrow viewport so the row keeps the three
            // gesture badges whole.
            if root.width >= 760px: Rectangle {
                background: Theme.hint-surface;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.border-subtle;
                HorizontalLayout {
                    padding-left: 8px; padding-right: 8px; padding-top: 4px; padding-bottom: 4px; spacing: 5px;
                    VerticalLayout {
                        alignment: center;
                        Image { source: @image-url("../icons/clipboard.svg"); colorize: Theme.hint-text; width: 10px; height: 10px; }
                    }
                    Text { text: "Click HUD: Copy Metrics"; font-size: 10px; font-weight: 600; color: Theme.hint-text; vertical-alignment: center; }
                }
            }
        }
    }

    if ViewportModel.live_view_mode == 2: Text {
        x: 8px;
        y: root.height - self.height - 8px;
        width: root.width - 16px;
        text: "Ray-Traced: approximate color and frost; one index per color chain. No polarization, doubling, haze, zoning or edge rounding; bounce-limited. Metrics use a separate analytic tracer.";
        color: Theme.text-secondary;
        font-size: 10px;
        wrap: word-wrap;
    }

    // The Rendering Settings card that used to open here is the Parameters dock now: beside this
    // viewport (`app.slint`), with Stone, Lighting & Environment and Render & Output tabs. The
    // toolbar's three buttons open it (`GemViewportToolbarActions`).

    // The gem material editor and the tilt-performance chart are mounted at window size
    // in `GlobalDialogsOverlay` (`components/app/global_dialogs.slint`), not here.

    // --- MODAL HIGH-RESOLUTION EXPORT DIALOG ---
    if ExportModel.is_open: ExportDialog {
        width: 100%;
        height: 100%;
        z: 400;
    }
    // The panel's toggle is the toolbar's "Optical Diagnostics" button (`toolbar_actions.slint`).
    if ViewportModel.live_view_mode == 1 && OpticalModel.panel_open && !TiltModel.dialog_open && !ExportModel.is_open && !ViewportModel.material_editor_open: OpticalPanel {
        x: 10px; y: 92px; width: min(460px, root.width - 20px);
        height: min(420px, root.height - 100px);
    }
    if OpticalModel.enabled && ViewportModel.live_view_mode == 1: Rectangle {
        x: 8px; y: root.height - self.height - 8px; width: root.width - 16px;
        // Grows with its wrapped text instead of clipping the second line in a narrow window.
        height: max(64px, optical_strip.preferred-height);
        background: Theme.surface-dialog;
        optical_strip := VerticalLayout {
            padding: 5px;
            Text { text: OpticalModel.status + " | " + (OpticalModel.windowing ? "Cyan / Windowing; " : "") + (OpticalModel.extinction ? "magenta X Extinction; " : "") + (OpticalModel.brilliance ? "green dots Brilliance; " : "") + (OpticalModel.fire ? "gold Fire = dispersion potential (0-0.1 weighted degrees); " : "") + (OpticalModel.scintillation ? "white diamonds Scintillation = sparkle across views and neighbors" : ""); color: Theme.text-primary; wrap:word-wrap; }
            Text { text: "Analytical light paths, ten-bounce estimate; absorption/scattering/advanced material effects are not reproduced."; color: Theme.text-primary; wrap:word-wrap; }
        }
    }
}
