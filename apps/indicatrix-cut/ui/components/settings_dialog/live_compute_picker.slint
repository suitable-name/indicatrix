import { Theme } from "../../theme.slint";
import { SettingsModel } from "../../models/settings.slint";
import { RemoteWorkerModel } from "../../models/remote_worker.slint";
import { SegmentPill } from "../pill_button.slint";
import { ToggleRow } from "../toggle_switch.slint";
import { SettingLabel } from "setting_label.slint";

// Live Compute: which engine(s) trace the settled viewport image. Same
// segmented-pill idiom, and the same disabled-with-a-reason treatment, as
// `export_dialog.slint`'s "Compute" section. Advanced: Simple mode hides it
// (`settings_dialog.slint`).
export component LiveComputePicker inherits VerticalLayout {
    // Explanatory text shown when no remote worker is available; empty falls
    // back to a generic "No remote worker is configured." message below.
    in property <string> unavailable_reason: "";
    // The Live Transfer pills only mean something with a remote in the loop.
    property <bool> transfer_enabled: RemoteWorkerModel.live_remote_available && SettingsModel.live_compute_target_index != 0;

    spacing: 6px;
    SettingLabel {
        text: "Live Compute";
        hint: "Live Compute: which computer traces the settled picture in the Live Render view. Local only uses this computer, Remote only hands the picture to the remote worker, and Local + Remote uses both.";
    }

    HorizontalLayout {
        spacing: 4px;

        SegmentPill {
            text: "Local only";
            hint: "Trace the live picture on this computer only.";
            selected: SettingsModel.live_compute_target_index == 0;
            picked => {
                SettingsModel.live_compute_target_index = 0;
                SettingsModel.live_compute_target_changed(0);
            }
        }

        SegmentPill {
            text: "Remote only";
            hint: RemoteWorkerModel.live_remote_available
                ? "Hand the whole live picture to the remote worker."
                : "Needs a remote worker. None is available right now.";
            enabled: RemoteWorkerModel.live_remote_available;
            selected: SettingsModel.live_compute_target_index == 1;
            picked => {
                SettingsModel.live_compute_target_index = 1;
                SettingsModel.live_compute_target_changed(1);
            }
        }

        SegmentPill {
            text: "Local + Remote";
            hint: RemoteWorkerModel.live_remote_available
                ? "Trace the live picture on this computer and on the remote worker together."
                : "Needs a remote worker. None is available right now.";
            enabled: RemoteWorkerModel.live_remote_available;
            selected: SettingsModel.live_compute_target_index == 2;
            picked => {
                SettingsModel.live_compute_target_index = 2;
                SettingsModel.live_compute_target_changed(2);
            }
        }
    }

    if !RemoteWorkerModel.live_remote_available: Text {
        text: root.unavailable_reason == "" ? "No remote coordinator is configured." : root.unavailable_reason;
        font-size: 11px;
        color: Theme.text-muted;
        wrap: word-wrap;
    }

    if RemoteWorkerModel.live_remote_available: Text {
        text: "Once the camera settles, Local + Remote lets both engines keep tracing the same image together for a faster converge; Remote only hands the whole image to the remote.";
        font-size: 11px;
        color: Theme.text-muted;
        wrap: word-wrap;
    }

    // Live transfer: how the remote's contribution comes home.
    // Meaningless for "Local only" and without a remote, so disabled (not hidden)
    // then, the same treatment the Remote pills above get.
    SettingLabel {
        text: "Live Transfer";
        hint: "Live Transfer: how the remote worker sends its share back. Full data sends the raw samples, which combine with your own. Final picture sends only finished, denoised frames.";
    }

    HorizontalLayout {
        spacing: 4px;
        for label[idx] in ["Full data", "Final picture"]: SegmentPill {
            text: label;
            hint: idx == 0
                ? "The remote sends its raw samples, so they combine with the ones traced here."
                : "The remote sends finished, denoised frames. Less data travels, but this computer pauses its own tracing after the handoff.";
            enabled: root.transfer_enabled;
            selected: SettingsModel.live_transfer_index == idx;
            picked => {
                SettingsModel.live_transfer_index = idx;
                SettingsModel.live_transfer_changed(idx);
            }
        }
    }

    Text {
        text: "Final picture: the server sends finished, denoised frames -- less bandwidth, but your own GPU/CPU pauses after the handoff; results can't be combined.";
        font-size: 11px;
        color: Theme.text-muted;
        wrap: word-wrap;
    }

    // v16: final-picture EXPORTS (the still export and tilt videos, not the live
    // viewport above) can fold this machine's own idle samples into the remote's --
    // same switch idiom as `settings_dialog.slint`'s "Frosted Girdle" toggle.
    ToggleRow {
        text: "Final-picture exports: this machine renders a share too";
        hint: "Your GPU or CPU traces part of the samples and uploads them; the coordinator merges them before tone-mapping.";
        enabled: RemoteWorkerModel.live_remote_available;
        checked: SettingsModel.contribute_to_final_picture;
        toggled => {
            SettingsModel.contribute_to_final_picture = !SettingsModel.contribute_to_final_picture;
            SettingsModel.contribute_to_final_picture_changed(SettingsModel.contribute_to_final_picture);
        }
    }
}
