import { Theme } from "../../theme.slint";
import { SettingsModel } from "../../models/settings.slint";
import { SegmentPill } from "../pill_button.slint";
import { SettingLabel } from "setting_label.slint";

// Ray Bounces - Segmented Pill Selector.
//
// Ladder is 4/8/12/24/64/128, backed by
// `crates/indicatrix/examples/bounce_cost.rs` measurements: cost is nearly
// flat in the cap (an 85x spread from 12 to 1024 costs under 1.4x wall-clock,
// CPU) because the path population is short-tailed (median 4 bounces, p95 29,
// only 0.03% ever reach 128). 12 is the default, the sane interactive middle.
// 64 and 128 are the measured points where the hardest case (Diamond) crosses
// 99.5% and 99.99% converged against a 1024-bounce reference; nothing above
// 128 is offered since the measurement shows zero further change up to 1024.
//
// Advanced: Simple mode hides it (`settings_dialog.slint`). The ladder is also in
// `gui::render::advanced_in_use` (the test table there), which says when the hidden pick is
// off its default.
export component BouncesPicker inherits VerticalLayout {
    // The pill index to the bounce cap it stands for.
    pure function cap_for(idx: int) -> int {
        return idx == 0 ? 4 : (idx == 1 ? 8 : (idx == 2 ? 12 : (idx == 3 ? 24 : (idx == 4 ? 64 : 128))));
    }

    spacing: 6px;
    SettingLabel {
        text: "Max Ray Bounces (Dispersion Depth)";
        hint: "Max Ray Bounces: the most times one light path may bounce inside the stone before it is dropped. A higher cap follows long, faint paths and shows more colour play. 12 is a good middle.";
    }

    HorizontalLayout {
        spacing: 4px;

        // 12 Bounces is the default; 128 is the ceiling.
        for label[idx] in ["4", "8", "12", "24", "64", "128"]: SegmentPill {
            text: label;
            hint: "Stop a light path after " + label + " bounces.";
            selected: SettingsModel.bounce_index == idx;
            picked => {
                SettingsModel.bounce_index = idx;
                SettingsModel.bounces_changed(root.cap_for(idx));
            }
        }
    }

    // Flat cost holds on CPU, but GPU threads run in lockstep, so the few
    // long paths in the tail stall the whole workgroup at this rung range.
    if SettingsModel.bounce_index >= 4: Text {
        text: "Modest cost on CPU, but noticeably steeper on GPU -- long paths stall the whole workgroup there since threads run in lockstep.";
        font-size: 11px;
        color: Theme.text-muted;
        wrap: word-wrap;
    }
}
