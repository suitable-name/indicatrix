import { Theme } from "../../theme.slint";
import { SettingsModel } from "../../models/settings.slint";
import { SegmentPill } from "../pill_button.slint";
import { SettingLabel } from "setting_label.slint";

// Render Resolution - Segmented Pill Selector, same idiom as the Ray Bounces
// picker and `export_dialog.slint`'s "Output Size" pills. A fixed list
// rather than a slider -- see `SettingsDialog.resolution_index` for why.
export component ResolutionPicker inherits VerticalLayout {
    // 0 = 640x480, 1 = 800x600 (the default), 2 = 1280x720, 3 = 1920x1080.
    pure function width_for(idx: int) -> int {
        return idx == 0 ? 640 : (idx == 1 ? 800 : (idx == 2 ? 1280 : 1920));
    }
    pure function height_for(idx: int) -> int {
        return idx == 0 ? 480 : (idx == 1 ? 600 : (idx == 2 ? 720 : 1080));
    }

    spacing: 6px;
    SettingLabel {
        text: "Render Resolution";
        hint: "Render Resolution: the size in pixels of the picture the Live Render view traces. Bigger pictures are sharper and take proportionally longer to settle.";
    }

    HorizontalLayout {
        spacing: 4px;

        for label[idx] in ["640×480", "800×600", "1280×720", "1920×1080"]: SegmentPill {
            text: label;
            hint: "Trace the live picture at " + label + " pixels.";
            selected: SettingsModel.resolution_index == idx;
            picked => {
                SettingsModel.resolution_index = idx;
                SettingsModel.resolution_changed(root.width_for(idx), root.height_for(idx));
            }
        }
    }

    // Plain factual cost note, not an estimator -- render time depends on
    // scene/hardware in ways this dialog has no way to know.
    Text {
        text: "Higher resolutions render more pixels per sample and take proportionally longer to converge.";
        font-size: 11px;
        color: Theme.text-muted;
        wrap: word-wrap;
    }
}
