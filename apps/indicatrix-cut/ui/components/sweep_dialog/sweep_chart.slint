// The Angle Sweep dialog's chart: a line per figure over the swept angles. Each line is
// scaled to its own lowest and highest value (so figures of different size can sit on one
// chart); the legend under the chart says what each line's top and bottom mean.
//
// Moving the pointer over the plot reads off the nearest angle; a click selects it (the
// table follows). With the keyboard, Tab reaches the plot and Left and Right choose the previous
// or next angle. Rust draws everything from `SweepModel`: it owns the path data, the guide
// positions and the readout sentence.
import { Theme } from "../../theme.slint";
import { SweepModel } from "../../models/sweep.slint";
import { SweepStyle } from "sweep_style.slint";

// One figure's toggle above the chart: a coloured dot and the figure's name.
component SeriesPill inherits Rectangle {
    in property <string> text;
    in property <color> tone;
    in property <bool> shown;
    callback toggled();

    height: 22px;
    width: pill_label.preferred-width + 32px;
    border-radius: 11px;
    background: root.shown ? Theme.tint-neutral : Theme.surface-chip;
    border-width: pill_focus.has-focus ? 2px : 1px;
    border-color: pill_focus.has-focus ? Theme.accent-cyan-hover : (root.shown ? root.tone : Theme.border-dialog);

    accessible-role: AccessibleRole.button;
    accessible-label: root.text;
    accessible-description: "Show or hide this figure's line on the chart.";
    accessible-checkable: true;
    accessible-checked: root.shown;
    accessible-action-default => { root.toggled(); }

    Tooltip { text: @markdown("Show or hide the line for this figure on the chart. The table keeps its column either way."); }

    pill_focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.toggled();
                return accept;
            }
            return reject;
        }
    }

    pill_touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }

    Rectangle {
        x: 9px;
        y: (parent.height - self.height) / 2;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: root.shown ? root.tone : Theme.text-disabled;
    }
    pill_label := Text {
        x: 23px;
        y: (parent.height - self.height) / 2;
        text: root.text;
        font-size: 10px;
        font-weight: 600;
        color: root.shown ? Theme.text-primary : Theme.text-muted;
    }
}

export component SweepChart inherits VerticalLayout {
    spacing: 6px;

    // Which lines the chart draws.
    HorizontalLayout {
        spacing: 6px;
        Text {
            text: "Lines:";
            font-size: 10px;
            font-weight: 700;
            color: Theme.text-muted;
            vertical-alignment: center;
        }
        for column in SweepModel.columns: SeriesPill {
            text: column.title;
            tone: SweepStyle.series_color(column.series);
            shown: column.shown;
            toggled => { SweepModel.toggle_series(column.series); }
        }
        Rectangle { horizontal-stretch: 1; }
    }

    plot := Rectangle {
        height: 150px;
        background: Theme.chart-bg;
        border-width: 1px;
        border-color: Theme.chart-border;
        border-radius: Theme.radius-sm;
        clip: true;

        // Reference lines at 25, 50 and 75 percent of the height.
        Rectangle { y: plot.height * 0.25; width: 100%; height: 1px; background: Theme.chart-grid; }
        Rectangle { y: plot.height * 0.5; width: 100%; height: 1px; background: Theme.chart-grid-mid; }
        Rectangle { y: plot.height * 0.75; width: 100%; height: 1px; background: Theme.chart-grid; }

        // The design's own angle.
        if SweepModel.current_x >= 0: Rectangle {
            x: plot.width * SweepModel.current_x / 100 - 0.5px;
            y: 0px;
            width: 1px;
            height: plot.height;
            background: Theme.text-muted;
        }
        if SweepModel.current_x >= 0: Text {
            x: min(plot.width * SweepModel.current_x / 100 + 4px, plot.width - self.width - 2px);
            y: 2px;
            text: "current";
            font-size: 9px;
            color: Theme.text-muted;
        }

        // The selected row: a band and a line.
        if SweepModel.selected_x >= 0: Rectangle {
            x: plot.width * SweepModel.selected_x / 100 - 3px;
            y: 0px;
            width: 6px;
            height: plot.height;
            background: Theme.tint-neutral;
        }
        if SweepModel.selected_x >= 0: Rectangle {
            x: plot.width * SweepModel.selected_x / 100 - 0.5px;
            y: 0px;
            width: 1px;
            height: plot.height;
            background: Theme.text-primary;
        }

        for line in SweepModel.paths: Path {
            x: 0px;
            y: 0px;
            width: plot.width;
            height: plot.height;
            fit: fill;
            commands: line.commands;
            viewbox-width: 100;
            viewbox-height: 100;
            stroke: SweepStyle.series_color(line.series);
            stroke-width: 1.5px;
            fill: transparent;
        }

        // The pointer.
        if SweepModel.hover_x >= 0: Rectangle {
            x: plot.width * SweepModel.hover_x / 100 - 0.5px;
            y: 0px;
            width: 1px;
            height: plot.height;
            background: Theme.chart-crosshair;
        }

        // Left and Right choose the previous or next angle, Home and End the first or last; the
        // table and the readout follow, exactly as for a click.
        plot_focus := FocusScope {
            accessible-role: AccessibleRole.slider;
            accessible-label: "Angle on the chart";
            accessible-description: "Left and Right choose the previous or next angle. The table and the readout below follow.";
            accessible-value: SweepModel.selected_row < 0 ? "none chosen" : "" + (SweepModel.selected_row + 1) + " of " + SweepModel.rows.length;
            accessible-value-minimum: 0;
            accessible-value-maximum: max(SweepModel.rows.length - 1, 0);
            accessible-value-step: 1;
            accessible-action-increment => {
                if SweepModel.selected_row < SweepModel.rows.length - 1 {
                    SweepModel.select_row(SweepModel.selected_row + 1);
                }
            }
            accessible-action-decrement => {
                if SweepModel.selected_row > 0 {
                    SweepModel.select_row(SweepModel.selected_row - 1);
                }
            }
            key-pressed(event) => {
                if event.text == Key.RightArrow {
                    if SweepModel.selected_row < SweepModel.rows.length - 1 {
                        SweepModel.select_row(SweepModel.selected_row + 1);
                    }
                    return accept;
                } else if event.text == Key.LeftArrow {
                    if SweepModel.selected_row > 0 {
                        SweepModel.select_row(SweepModel.selected_row - 1);
                    } else if SweepModel.selected_row < 0 && SweepModel.rows.length > 0 {
                        SweepModel.select_row(0);
                    }
                    return accept;
                } else if event.text == Key.Home {
                    if SweepModel.rows.length > 0 {
                        SweepModel.select_row(0);
                    }
                    return accept;
                } else if event.text == Key.End {
                    if SweepModel.rows.length > 0 {
                        SweepModel.select_row(SweepModel.rows.length - 1);
                    }
                    return accept;
                }
                return reject;
            }
        }

        plot_touch := TouchArea {
            mouse-cursor: pointer;
            pointer-event(event) => {
                if event.kind == PointerEventKind.move {
                    SweepModel.chart_hover(self.mouse-x / self.width);
                }
            }
            changed has-hover => {
                if !self.has-hover {
                    SweepModel.chart_hover(-1.0);
                }
            }
            clicked => {
                plot_focus.focus();
                if SweepModel.hover_row >= 0 {
                    SweepModel.select_row(SweepModel.hover_row);
                }
            }
        }

        // The keyboard focus ring, drawn over the plot.
        if plot_focus.has-focus: Rectangle {
            border-width: 2px;
            border-color: Theme.accent-cyan-hover;
            border-radius: Theme.radius-sm;
        }

        Tooltip { text: @markdown("Move the pointer over the chart to read off an angle, and click to select it. With the keyboard, Tab to the chart, then Left and Right choose an angle."); }
    }

    // The ends of the angle axis.
    HorizontalLayout {
        Text { text: SweepModel.axis_low; font-size: 9px; color: Theme.text-muted; }
        Text {
            horizontal-stretch: 1;
            text: "angle (degrees)";
            font-size: 9px;
            color: Theme.text-muted;
            horizontal-alignment: center;
        }
        Text { text: SweepModel.axis_high; font-size: 9px; color: Theme.text-muted; horizontal-alignment: right; }
    }

    // What the top and bottom of each line mean.
    HorizontalLayout {
        spacing: 12px;
        for item in SweepModel.legend: Text {
            horizontal-stretch: 1;
            text: item.text;
            font-size: 9px;
            font-weight: 600;
            color: SweepStyle.series_color(item.series);
            overflow: elide;
        }
    }

    // The angle under the pointer, else the selected angle.
    Rectangle {
        height: 32px;
        Text {
            width: 100%;
            height: 100%;
            text: SweepModel.readout_text;
            font-size: 11px;
            color: Theme.text-primary;
            wrap: word-wrap;
            vertical-alignment: top;
        }
    }
}
