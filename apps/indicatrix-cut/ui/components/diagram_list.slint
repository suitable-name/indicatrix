import { LineEdit, ListView } from "std-widgets.slint";
import { DiagramItem, PreviewThumbnails } from "../types.slint";
import { Theme } from "../theme.slint";
import { LibraryModel } from "../models/library.slint";
import { RemoteWorkerModel } from "../models/remote_worker.slint";
import { BuildDesignModel } from "../models/build_design.slint";
import { HelpTopics } from "../models/help.slint";
import { HelpButton } from "help_button.slint";
// The hand-drawn buttons of the list are buttons for the keyboard and a screen reader too.
import { TouchButton } from "touch_button.slint";

export component CollapsedLibraryRail inherits Rectangle {
    width: 40px;
    horizontal-stretch: 0;
    background: Theme.bg-card;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-subtle;

    callback expand_requested();
    expand_requested => {
        LibraryModel.panel_collapsed = false;
        LibraryModel.panel_collapsed_changed(false);
    }

    VerticalLayout {
        padding-top: 10px;
        // `start`, not the default `stretch`: a stretch layout's maximum height
        // is the sum of its children's, so this 28px icon would otherwise cap the
        // whole main row (and, through it, the window) at 38px -- see
        // `app.slint`'s "Sizing notes".
        alignment: start;

        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: Theme.radius-sm;
                background: expand_touch.has_hover ? Theme.bg-elevated : Theme.bg-input;
                border-width: 1px;
                border-color: Theme.border-medium;

                Image {
                    source: @image-url("../icons/folder.svg");
                    colorize: Theme.text-secondary;
                    width: 13px;
                    height: 13px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                expand_touch := TouchButton {
                    label: "Show the library list";
                    hint: "Show the library list again.";
                    clicked => { root.expand_requested(); }
                }
            }
        }
    }
}

export component DiagramListView inherits Rectangle {
    property <int> keyboard_focus_index: -1;
    // Tracks the WHOLE list, not just its length -- a same-length result
    // set (e.g. switching to a different filter that happens to match the same count)
    // must also drop stale keyboard focus, not leave the focus ring (and Return) on
    // whatever card previously sat at this index. `apply_diagram_list_to_ui` replaces
    // `LibraryModel.diagram_list` with a brand-new model (never mutates one in place)
    // whenever the fetched rows differ from the shown ones, so this fires on every real
    // list update; a refresh that returns the very same rows keeps the model, and the
    // focus ring stays on a card that still sits at this index.
    property <[DiagramItem]> tracked_diagram_list: LibraryModel.diagram_list;
    changed tracked_diagram_list => { root.keyboard_focus_index = -1; }

    callback collapse_requested();
    collapse_requested => {
        LibraryModel.panel_collapsed = true;
        LibraryModel.panel_collapsed_changed(true);
    }
    min-width: 260px;
    max-width: 440px;
    preferred-width: 340px;
    horizontal-stretch: 0;
    background: Theme.bg-card;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-subtle;

    VerticalLayout {
        padding: 10px;
        spacing: 8px;

        // List Header with counters
        HorizontalLayout {
            padding-left: 4px;
            padding-right: 4px;
            alignment: space-between;

            Text {
                // Shown page vs. the real match count, not the whole-catalogue total
                // -- see `LibraryModel.matched_count`'s doc comment, and
                // `filter_panel.slint`'s `match_summary` for the fuller wording of
                // the same explanation.
                text: "Catalog (" + LibraryModel.diagram_list.length + " of " + LibraryModel.matched_count + ")";
                font-size: 12px;
                font-weight: 700;
                color: Theme.text-primary;
            }

            HorizontalLayout {
                spacing: 6px;

                if LibraryModel.diagram_list.length == 0: Text {
                    text: "No matches";
                    font-size: 11px;
                    color: Theme.accent-amber;
                }

                // The manual page on the library list and its search row.
                HelpButton {
                    topic: HelpTopics.library;
                    hint: "Open the manual page on searching and filtering the library";
                }

                // Collapses the panel down to a thin rail -- see
                // `collapse_requested`'s own doc comment above.
                Rectangle {
                    width: 20px;
                    height: 20px;
                    border-radius: Theme.radius-sm;
                    background: collapse_touch.has_hover ? Theme.bg-elevated : transparent;
                    Image {
                        source: @image-url("../icons/close.svg");
                        colorize: Theme.text-secondary;
                        width: 10px;
                        height: 10px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    collapse_touch := TouchButton {
                        label: "Hide the library list";
                        hint: "Shrink the library list to a thin strip to give the viewport more room. Click the strip to bring it back.";
                        clicked => { root.collapse_requested(); }
                    }
                }
            }
        }

        // While `recent_import_filter` restricts the list to a just-completed
        // multi-file import, say so explicitly and offer an obvious way back to the
        // full catalogue -- otherwise a cutter who doesn't immediately notice the
        // (N of M) count shrank would have no idea why their other designs seem to
        // have vanished.
        //
        // This restriction is local-import-only by construction (a remote-sourced
        // search never populates it, and switching library source clears it -- see
        // `gui::library::diagram_list::reset_search_and_filter_ui_inputs`), but the
        // row is greyed out and its "Clear" click disabled while
        // `RemoteWorkerModel.library_is_remote` too, defensively, rather than relying
        // solely on that being true today.
        if LibraryModel.recent_import_filter.length > 0: Rectangle {
            background: Theme.surface-info;
            border-radius: Theme.radius-sm;
            height: 26px;
            opacity: RemoteWorkerModel.library_is_remote ? 0.45 : 1.0;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                alignment: space-between;
                Text {
                    text: LibraryModel.id_filter_label != "" ? LibraryModel.id_filter_label : "Showing " + LibraryModel.recent_import_filter.length + " just-imported design(s).";
                    font-size: 10px;
                    color: Theme.accent-cyan;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: clear_txt.preferred-width + 12px;
                    clear_txt := Text {
                        text: "Clear";
                        font-size: 10px;
                        font-weight: 700;
                        color: clear_touch.has_hover ? Theme.accent-cyan-hover : Theme.accent-cyan;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    clear_touch := TouchButton {
                        enabled: !RemoteWorkerModel.library_is_remote;
                        label: "Clear the filter";
                        hint: "Stop showing only the designs you just imported and show the whole library again.";
                        clicked => {
                            LibraryModel.recent_import_filter = [];
                            LibraryModel.id_filter_label = "";
                            LibraryModel.filters_changed();
                        }
                    }
                }
            }
        }

        // Empty state when search yields 0 items
        if LibraryModel.diagram_list.length == 0: Rectangle {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: center;
                spacing: 8px;

                Image {
                    source: @image-url("../icons/search.svg");
                    colorize: Theme.text-secondary;
                    width: 28px;
                    height: 28px;
                    horizontal-alignment: center;
                }

                Text {
                    text: "No diagrams found";
                    font-size: 13px;
                    font-weight: 600;
                    color: Theme.text-secondary;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Try adjusting your search terms or filters";
                    font-size: 11px;
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                }
            }
        }

        // Diagram Cards List
        if LibraryModel.diagram_list.length > 0: FocusScope {
            key-pressed(event) => {
                if event.text == Key.DownArrow {
                    root.keyboard_focus_index = root.keyboard_focus_index < 0
                        ? 0
                        : Math.min(root.keyboard_focus_index + 1, LibraryModel.diagram_list.length - 1);
                    return accept;
                } else if event.text == Key.UpArrow {
                    root.keyboard_focus_index = root.keyboard_focus_index <= 0
                        ? 0
                        : root.keyboard_focus_index - 1;
                    return accept;
                } else if event.text == Key.Return || event.text == Key.Space {
                    if root.keyboard_focus_index >= 0 && root.keyboard_focus_index < LibraryModel.diagram_list.length {
                        LibraryModel.select_diagram(LibraryModel.diagram_list[root.keyboard_focus_index].id);
                    }
                    return accept;
                }
                reject
            }

            // Virtualised: only the rows in or near view are instantiated, so a result
            // list of up to a thousand designs costs a screenful of cards, not a
            // thousand (each with its own thumbnail lookup, context menu and tag chips).
            // Rows are laid out at their own preferred heights, which differ with the
            // tag row.
            ListView {
                for item[idx] in LibraryModel.diagram_list: list_row := Rectangle {
                    // The card plus the 6px gap that separates it from the next row
                    // (a ListView has no `spacing`). The row is sized by its content
                    // (`card_body`), exactly as the card was when it sat in a layout.
                    height: card_body.preferred-height + 6px;

                    card := Rectangle {
                        y: 0px;
                        height: card_body.preferred-height;
                        // Ignored rows (shown only while "Show ignored designs" is
                        // on -- see `RangeFilter::include_ignored`) render visually
                        // distinct from a normal row: a dimmed background/opacity plus a
                        // dashed-looking amber border, so they never look like an ordinary
                        // catalogue entry that just happens to be selected or hovered.
                        background: LibraryModel.selected_entry_id == item.id ? Theme.surface-selected : (item_touch.has-hover ? Theme.bg-card-hover : Theme.bg-input);
                        opacity: item.ignored ? 0.55 : 1.0;
                        border-radius: Theme.radius-sm;
                        // One row of the library list for a screen reader: the design, who
                        // designed it, its gear and facet count, and whether it is the one
                        // selected. Up and Down move the ring, Enter or Space selects (the
                        // list's own FocusScope, above); the right-click actions are in the
                        // Library menu, under "Selected Design".
                        accessible-role: AccessibleRole.list-item;
                        accessible-label: item.title
                            + (item.designer != "" ? ", by " + item.designer : "")
                            + (item.gear != "" ? ", gear " + item.gear : "")
                            + (item.facets != "" ? ", " + item.facets + " facets" : "")
                            + (item.ignored ? ", ignored" : "")
                            + (item.is_local ? ", your own design" : "");
                        accessible-description: "Select this design to see it in the detail view.";
                        accessible-item-selectable: true;
                        accessible-item-selected: LibraryModel.selected_entry_id == item.id;
                        accessible-item-index: idx;
                        accessible-item-count: LibraryModel.diagram_list.length;
                        accessible-action-default => { LibraryModel.select_diagram(item.id); }
                        // Keyboard focus ring: takes priority over the plain-hover border
                        // so Up/Down is visibly trackable even with the mouse sitting
                        // still elsewhere; selection (blue background above) and ignored
                        // (amber, above) still read through since only the border color
                        // changes here.
                        border-width: (item.ignored || idx == root.keyboard_focus_index) ? 1.5px : 1px;
                        border-color: idx == root.keyboard_focus_index
                            ? Theme.primary
                            : (item.ignored ? Theme.accent-amber : (LibraryModel.selected_entry_id == item.id ? Theme.accent-cyan : (item_touch.has-hover ? Theme.border-medium : transparent)));

                        // Rendered front/top previews for this row -- looked up once per
                        // card via the cache-backed callback declared above; see this
                        // property's own use below for the fixed-size-box-or-placeholder
                        // rule that keeps a row with no previews yet from ever showing a
                        // broken/stretched image or shifting this card's layout relative
                        // to a row that has them.
                        property <PreviewThumbnails> preview: LibraryModel.get_preview_thumbnails(item.id, LibraryModel.preview_cache_version);

                        // The "Add tag..." context-menu entry opens this inline text
                        // field rather than a modal dialog -- same idiom as
                        // `detail_header.slint`'s inline rename (`renaming`/`rename_draft`).
                        property <bool> adding_tag: false;
                        property <string> tag_draft: "";

                        item_touch := TouchArea {
                            clicked => {
                                LibraryModel.select_diagram(item.id);
                            }
                        }

                        // An unobtrusive per-design "regenerate previews" action -- a
                        // builtin native context menu (cursor positioning, outside-click
                        // dismissal, and OS-native rendering all handled by Slint itself --
                        // see `i-slint-compiler`'s
                        // `widgets/common/menus.slint`/`internal-components.slint` for the
                        // `ContextMenuArea`/`Menu`/`MenuItem` this uses directly, no
                        // hand-rolled equivalent needed). `expands_to_parent_geometry`
                        // (this element's own default) makes it cover the whole card
                        // without an explicit width/height.
                        ContextMenuArea {
                            Menu {
                                MenuItem {
                                    title: "Generate Previews";
                                    activated => {
                                        LibraryModel.generate_previews_for_entry(item.id);
                                    }
                                }
                                MenuItem {
                                    title: "Compute Tilt Curves";
                                    activated => {
                                        LibraryModel.compute_tilt_curves_for_entry(item.id);
                                    }
                                }
                                MenuItem {
                                    title: item.ignored ? "Un-ignore" : "Ignore";
                                    activated => {
                                        LibraryModel.toggle_ignored(item.id);
                                    }
                                }
                                MenuItem {
                                    title: item.planner_excluded ? "Include in planner" : "Exclude from planner";
                                    activated => {
                                        LibraryModel.toggle_planner_excluded(item.id);
                                    }
                                }
                                MenuItem {
                                    title: "Build this design";
                                    enabled: !BuildDesignModel.busy;
                                    activated => {
                                        BuildDesignModel.start(item.id);
                                    }
                                }
                                MenuItem {
                                    title: "Add tag...";
                                    activated => {
                                        card.tag_draft = "";
                                        card.adding_tag = true;
                                    }
                                }
                            }
                        }

                        // The three-dots icon is a real button: clicking it opens the same
                        // actions in a small floating menu, since Slint's
                        // `ContextMenuArea`/`Menu` (used by the right-click path above)
                        // has no API in this version to open programmatically from a
                        // left click.
                        property <bool> kebab_open: false;
                        if item_touch.has-hover || card.kebab_open: Rectangle {
                            x: card.width - self.width - 4px;
                            y: 2px;
                            width: 20px;
                            height: 20px;
                            border-radius: 3px;
                            background: kebab_touch.has_hover || card.kebab_open ? Theme.bg-card-hover : transparent;
                            Image {
                                source: @image-url("../icons/more.svg");
                                colorize: Theme.text-muted;
                                width: 14px;
                                height: 14px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                image-fit: contain;
                            }
                            kebab_touch := TouchButton {
                                label: "More actions for " + item.title;
                                hint: "More actions for this design: previews, tilt curves, ignore, planner, build it as a lesson, tags. Also on right-click and in the Library menu under Selected Design.";
                                expandable: true;
                                expanded: card.kebab_open;
                                ring_radius: 3px;
                                clicked => { card.kebab_open = !card.kebab_open; }
                            }
                        }
                        if card.kebab_open: Rectangle {
                            // Backdrop -- dismisses the menu on an outside click.
                            x: -2000px;
                            y: -2000px;
                            width: 4000px;
                            height: 4000px;
                            z: 90;
                            TouchArea { clicked => { card.kebab_open = false; } }
                        }
                        if card.kebab_open: Rectangle {
                            x: card.width - self.width - 4px;
                            y: 24px;
                            z: 91;
                            width: 150px;
                            height: kebab_menu_col.preferred-height;
                            background: Theme.surface-dialog;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: Theme.border-dialog;
                            drop-shadow-blur: 10px;
                            drop-shadow-color: Theme.modal-shadow;
                            clip: true;
                            kebab_menu_col := VerticalLayout {
                                Rectangle {
                                    height: 24px;
                                    background: kebab_item1.has_hover ? Theme.bg-card-hover : transparent;
                                    Text { text: "Generate Previews"; font-size: 9px; color: Theme.text-primary; x: 8px; vertical-alignment: center; }
                                    kebab_item1 := TouchButton {
                                        label: "Generate Previews";
                                        hint: "Draw this design's front and top pictures for the list.";
                                        clicked => { card.kebab_open = false; LibraryModel.generate_previews_for_entry(item.id); }
                                    }
                                }
                                Rectangle {
                                    height: 24px;
                                    background: kebab_item2.has_hover ? Theme.bg-card-hover : transparent;
                                    Text { text: "Compute Tilt Curves"; font-size: 9px; color: Theme.text-primary; x: 8px; vertical-alignment: center; }
                                    kebab_item2 := TouchButton {
                                        label: "Compute Tilt Curves";
                                        hint: "Work out how bright or dark this design looks as it is tilted, ahead of time. See the glossary.";
                                        clicked => { card.kebab_open = false; LibraryModel.compute_tilt_curves_for_entry(item.id); }
                                    }
                                }
                                Rectangle {
                                    height: 24px;
                                    background: kebab_item3.has_hover ? Theme.bg-card-hover : transparent;
                                    Text { text: item.ignored ? "Un-ignore" : "Ignore"; font-size: 9px; color: Theme.text-primary; x: 8px; vertical-alignment: center; }
                                    kebab_item3 := TouchButton {
                                        label: item.ignored ? "Un-ignore" : "Ignore";
                                        hint: item.ignored
                                            ? "Show this design in the list again."
                                            : "Hide this design from the list. You can still show it with Show ignored designs in the filters.";
                                        clicked => { card.kebab_open = false; LibraryModel.toggle_ignored(item.id); }
                                    }
                                }
                                Rectangle {
                                    height: 24px;
                                    background: kebab_item_planner.has_hover ? Theme.bg-card-hover : transparent;
                                    Text { text: item.planner_excluded ? "Include in planner" : "Exclude from planner"; font-size: 9px; color: Theme.text-primary; x: 8px; vertical-alignment: center; }
                                    kebab_item_planner := TouchButton {
                                        label: item.planner_excluded ? "Include in planner" : "Exclude from planner";
                                        hint: item.planner_excluded
                                            ? "Let the Rough Planner use this design again."
                                            : "Keep this design out of the Rough Planner's candidates. It stays in the list.";
                                        clicked => { card.kebab_open = false; LibraryModel.toggle_planner_excluded(item.id); }
                                    }
                                }
                                Rectangle {
                                    height: 24px;
                                    background: kebab_item_build.has_hover ? Theme.bg-card-hover : transparent;
                                    Text { text: "Build this design"; font-size: 9px; color: BuildDesignModel.busy ? Theme.text-muted : Theme.text-primary; x: 8px; vertical-alignment: center; }
                                    kebab_item_build := TouchButton {
                                        enabled: !BuildDesignModel.busy;
                                        label: "Build this design";
                                        hint: "Turn this design into a step-by-step lesson that rebuilds it from an empty design.";
                                        clicked => { card.kebab_open = false; BuildDesignModel.start(item.id); }
                                    }
                                }
                                Rectangle {
                                    height: 24px;
                                    background: kebab_item4.has_hover ? Theme.bg-card-hover : transparent;
                                    Text { text: "Add tag..."; font-size: 9px; color: Theme.text-primary; x: 8px; vertical-alignment: center; }
                                    kebab_item4 := TouchButton {
                                        label: "Add tag";
                                        hint: "Type a tag to put on this design, for example the stone you cut it in.";
                                        clicked => {
                                            card.kebab_open = false;
                                            card.tag_draft = "";
                                            card.adding_tag = true;
                                        }
                                    }
                                }
                            }
                        }

                        card_body := VerticalLayout {
                            padding: 10px;
                            spacing: 6px;

                            // Front/top preview thumbnails -- two fixed-size boxes side
                            // by side, always both present regardless of `has_front`/
                            // `has_top` (a placeholder Rectangle stands in for either
                            // that's missing) so no card's height ever depends on whether
                            // its previews have been generated yet.
                            HorizontalLayout {
                                spacing: 6px;

                                // Front and top boxes are written out explicitly (rather
                                // than looped over a small array) -- each is a fixed
                                // 56x56px box regardless of whether its image is ready, so
                                // neither view's presence/absence ever changes this row's
                                // height or the other box's position.
                                Rectangle {
                                    width: 56px;
                                    height: 56px;
                                    border-radius: Theme.radius-sm;
                                    background: Theme.bg-input;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;
                                    clip: true;

                                    if card.preview.has_front: Image {
                                        source: card.preview.front;
                                        width: 100%;
                                        height: 100%;
                                        image-fit: contain;
                                    }
                                    // Placeholder: never generated yet, or still decoding
                                    // -- a small centered glyph rather than an empty box.
                                    if !card.preview.has_front: Text {
                                        text: "F";
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: Theme.text-muted;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: 100%;
                                        height: 100%;
                                    }
                                }

                                Rectangle {
                                    width: 56px;
                                    height: 56px;
                                    border-radius: Theme.radius-sm;
                                    background: Theme.bg-input;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;
                                    clip: true;

                                    if card.preview.has_top: Image {
                                        source: card.preview.top;
                                        width: 100%;
                                        height: 100%;
                                        image-fit: contain;
                                    }
                                    if !card.preview.has_top: Text {
                                        text: "T";
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: Theme.text-muted;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: 100%;
                                        height: 100%;
                                    }
                                }

                                // Marks a design the Rough Planner leaves out. Sits in
                                // the free space right of the two thumbnails, bottom-
                                // right (the kebab button owns the top-right corner),
                                // and elides rather than widening the card.
                                if item.planner_excluded: Text {
                                    text: "not planned";
                                    font-size: 9px;
                                    color: Theme.text-muted;
                                    overflow: elide;
                                    horizontal-alignment: right;
                                    vertical-alignment: bottom;
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                }
                            }

                            // Title & Shape Badge
                            HorizontalLayout {
                                spacing: 8px;

                                Text {
                                    text: item.title;
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: Theme.text-primary;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                }

                                if item.shape != "": Rectangle {
                                    background: Theme.primary;
                                    border-radius: 3px;
                                    height: 18px;
                                    HorizontalLayout {
                                        padding-left: 5px;
                                        padding-right: 5px;
                                        Text {
                                            text: item.shape;
                                            font-size: 10px;
                                            font-weight: 600;
                                            color: Theme.text-on-primary;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                if item.ignored: Rectangle {
                                    background: Theme.badge-amber-bg;
                                    border-radius: 3px;
                                    height: 18px;
                                    HorizontalLayout {
                                        padding-left: 5px;
                                        padding-right: 5px;
                                        Text {
                                            text: "Ignored";
                                            font-size: 10px;
                                            font-weight: 600;
                                            color: Theme.accent-amber;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Source badge: distinguishes the cutter's own
                                // locally-imported designs from the wider scraped corpus,
                                // the same way the shape/Ignored badges above already
                                // flag their own conditions.
                                if item.is_local: Rectangle {
                                    background: Theme.badge-emerald-bg;
                                    border-radius: 3px;
                                    height: 18px;
                                    HorizontalLayout {
                                        padding-left: 5px;
                                        padding-right: 5px;
                                        Text {
                                            text: "Mine";
                                            font-size: 10px;
                                            font-weight: 600;
                                            color: Theme.accent-emerald;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            // Tag chips -- the whole chip is the "remove" target (a
                            // `TouchArea` sibling covering the chip Rectangle, same idiom
                            // as `item_touch` covering the whole card two levels up), not
                            // just its "x" glyph, so the hit target is comfortably larger
                            // than the 9px text. Hidden entirely for a row with no tags
                            // and the inline entry not open, so an untagged catalogue
                            // (the common case today) shows no empty row.
                            if item.tags.length > 0 || card.adding_tag: HorizontalLayout {
                                spacing: 4px;
                                alignment: start;
                                for tag_name in item.tags: Rectangle {
                                    background: Theme.badge-purple-bg;
                                    border-radius: 3px;
                                    height: 16px;
                                    HorizontalLayout {
                                        padding-left: 5px;
                                        padding-right: 3px;
                                        spacing: 3px;
                                        Text {
                                            text: tag_name;
                                            font-size: 9px;
                                            font-weight: 600;
                                            color: Theme.accent-purple;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: "x";
                                            font-size: 9px;
                                            font-weight: 700;
                                            color: Theme.accent-purple;
                                            vertical-alignment: center;
                                        }
                                    }
                                    TouchButton {
                                        label: "Remove tag " + tag_name;
                                        hint: "Remove the tag " + tag_name + " from this design.";
                                        clicked => {
                                            LibraryModel.remove_tag_from_entry(item.id, tag_name);
                                        }
                                    }
                                }
                                if card.adding_tag: LineEdit {
                                    width: 90px;
                                    height: 16px;
                                    font-size: 9px;
                                    accessible-label: "New tag";
                                    accessible-description: "Type a tag and press Enter.";
                                    text <=> card.tag_draft;
                                    accepted => {
                                        if card.tag_draft != "" {
                                            LibraryModel.add_tag_to_entry(item.id, card.tag_draft);
                                        }
                                        card.adding_tag = false;
                                    }
                                }
                            }

                            // Designer & Specs row
                            HorizontalLayout {
                                spacing: 8px;

                                Text {
                                    text: item.designer != "" ? item.designer : "Unknown Designer";
                                    font-size: 11px;
                                    color: Theme.text-muted;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    if item.gear != "": HorizontalLayout {
                                        spacing: 3px;
                                        Image { source: @image-url("../icons/gear.svg"); colorize: Theme.accent-cyan; width: 9px; height: 9px; vertical-alignment: center; }
                                        Text {
                                            text: item.gear;
                                            font-size: 10px;
                                            color: Theme.accent-cyan;
                                            vertical-alignment: center;
                                        }
                                    }
                                    if item.facets != "": HorizontalLayout {
                                        spacing: 3px;
                                        Image { source: @image-url("../icons/diamond.svg"); colorize: Theme.accent-amber; width: 9px; height: 9px; vertical-alignment: center; }
                                        Text {
                                            text: item.facets;
                                            font-size: 10px;
                                            color: Theme.accent-amber;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            } // ListView
        } // FocusScope
    }
}
