import { LineEdit, ComboBox, SpinBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { WorkerItem } from "../types.slint";
import { RemoteWorkerModel } from "../models/remote_worker.slint";
import { GuideModel } from "../models/guide.slint";
import { HelpTopics } from "../models/help.slint";
import { HelpButton } from "help_button.slint";
import { IconButton } from "icon_button.slint";
import { SegmentPill } from "pill_button.slint";
import { TipButton } from "compact_controls.slint";
import { ToggleRow } from "toggle_switch.slint";
import { TipBox, FieldCaption } from "tip_box.slint";
import { AdvancedNote } from "advanced_note.slint";

// Remote rendering: the "Remote coordinator" form -- the ONE remote endpoint this
// viewer renders with and browses the library of (a coordinator, rendering itself when
// started with `--render`). Shows the configured endpoint with "Test
// connection", library browse/mirror and remove; the form edits name/address/
// certificate folder, token-based enrollment ("Redeem" -- claims an
// `indicatrix-worker cert issue-token` token directly), the live stream preferences and
// the default export "Transfer". Kept thin: every field is plain
// data round-tripped to Rust (`gui::remote::worker_callbacks`); all protocol/connection
// logic lives in `indicatrix_net::client`/`bridge::remote`, unit-tested there.
//
// Simple mode keeps what setting a remote up needs (name, address, certificate folder, the
// token, the connection test, the library switch, mirror) and hides the stream tuning (live
// stream, cadence, preview scale, export transfer, batch lanes). The form still holds those
// values and saves them unchanged; `RemoteWorkerModel.advanced_in_use` says when one is off its
// default so the note can appear.
//
// Inherits `PopupWindow`, not `Rectangle`, because a plain `Rectangle`-based
// conditional child of `HeaderToolbar` paints as part of `HeaderToolbar`'s
// subtree -- and `HeaderToolbar` is declared before the main workspace layout in
// `app.slint`, so it would always paint underneath the detail panel with no `z` value
// able to fix it (`z` only reorders siblings, it can't reach across subtrees). A
// `PopupWindow` renders in Slint's dedicated popup layer, always on top of the rest of
// the window regardless of declaration order. See `filter_panel.slint`'s doc comment
// for the full mechanism, including why an explicit content-driven `height` is needed
// (`Rectangle`'s default sizing fills whatever it's anchored to). See `header.slint`'s
// `remote_popup` instantiation for the show()/close() wiring this requires --
// `PopupWindow` cannot be used with the `if condition: RemoteWorkerDialog { ... }`
// pattern (that's a compile error).
export component RemoteWorkerDialog inherits PopupWindow {
    in property <string> claimed_cert_dir: RemoteWorkerModel.claimed_cert_dir;
    in property <string> picked_cert_dir: RemoteWorkerModel.picked_cert_dir;

    property <bool> editing: false;
    property <string> form_name: "";
    property <string> form_address: "";
    property <string> form_cert_dir: "";
    property <int> form_transfer_mode_index: 0;
    property <int> form_cadence_ms: 500;
    property <int> form_preview_scale_index: 2;
    property <int> form_preview_scale_percent: 50;
    property <int> form_export_transfer_index: 0;
    property <string> form_enroll_addr: "";
    property <string> form_token: "";

    // Whether a hidden stream setting is off its default (the pure rule is
    // `gui::remote::advanced_in_use`): the saved endpoint's, plus the batch lane count.
    property <bool> advanced_note_visible: !GuideModel.shows_advanced()
        && RemoteWorkerModel.advanced_in_use(
            RemoteWorkerModel.endpoint.transfer_mode_index,
            RemoteWorkerModel.endpoint.cadence_ms,
            RemoteWorkerModel.endpoint.preview_scale_index,
            RemoteWorkerModel.endpoint.preview_scale_percent,
            RemoteWorkerModel.endpoint.export_transfer_index,
            RemoteWorkerModel.remote_batch_lanes);

    changed claimed_cert_dir => {
        if (root.editing && root.claimed_cert_dir != "") {
            root.form_cert_dir = root.claimed_cert_dir;
            root.form_token = "";
            // Save needs a render address; suggest the enrollment host on the
            // server's default serve port so a redeemed token is one click from saved.
            if (root.form_address == "") {
                root.form_address = RemoteWorkerModel.claimed_address;
            }
        }
    }

    // `pick_cert_dir`'s own completion -- see `RemoteWorkerModel.picked_cert_dir`'s
    // own doc comment. Empty is "no pick landed yet" (initial value, and a
    // cancelled dialog never sets this at all), not a real folder, so it is never
    // copied into `form_cert_dir`.
    changed picked_cert_dir => {
        if (root.picked_cert_dir != "") {
            root.form_cert_dir = root.picked_cert_dir;
        }
    }

    // Opens the form on the configured endpoint, or on defaults when there is none.
    function open_form() {
        root.editing = true;
        root.form_name = RemoteWorkerModel.configured ? RemoteWorkerModel.endpoint.name : "";
        root.form_address = RemoteWorkerModel.configured ? RemoteWorkerModel.endpoint.address : "";
        root.form_cert_dir = RemoteWorkerModel.configured ? RemoteWorkerModel.endpoint.cert_dir : "";
        root.form_transfer_mode_index = RemoteWorkerModel.configured ? RemoteWorkerModel.endpoint.transfer_mode_index : 0;
        root.form_cadence_ms = RemoteWorkerModel.configured ? RemoteWorkerModel.endpoint.cadence_ms : 500;
        root.form_preview_scale_index = RemoteWorkerModel.configured ? RemoteWorkerModel.endpoint.preview_scale_index : 2;
        root.form_preview_scale_percent = RemoteWorkerModel.configured ? RemoteWorkerModel.endpoint.preview_scale_percent : 50;
        root.form_export_transfer_index = RemoteWorkerModel.configured ? RemoteWorkerModel.endpoint.export_transfer_index : 0;
        root.form_enroll_addr = "";
        root.form_token = "";
    }
    close-policy: PopupClosePolicy.no-auto-close;

    width: 420px;
    // Content-driven height: matches whatever `content` (the padded VerticalLayout
    // below) actually needs, instead of defaulting to the height of whatever this
    // popup happens to be anchored to.
    height: content.preferred-height;

    Rectangle {
        background: Theme.popup-surface;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: Theme.border-dialog;
        drop-shadow-blur: 24px;
        drop-shadow-color: Theme.shadow-heavy;
        drop-shadow-offset-y: 6px;
        clip: true;

        // Escape closes the popup (nothing typed is lost that was not already unsaved), and Tab
        // moves between the controls below.
        FocusScope {
            width: 100%;
            height: 100%;
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.close();
                    return accept;
                }
                return reject;
            }

        content := VerticalLayout {
            padding: 16px;
            spacing: 12px;

            HorizontalLayout {
                spacing: 6px;

                HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: 8px;
                    Image { source: @image-url("../icons/gem.svg"); colorize: Theme.accent-cyan; width: 15px; height: 15px; vertical-alignment: center; }
                    Text { text: "Remote Coordinator"; font-size: 13px; font-weight: 700; color: Theme.text-primary; vertical-alignment: center; accessible-role: AccessibleRole.text; }
                }

                VerticalLayout {
                    alignment: center;
                    HelpButton {
                        topic: HelpTopics.remote-worker;
                        hint: "Open the manual page on setting up a remote worker";
                    }
                }
                IconButton {
                    icon: @image-url("../icons/close.svg");
                    hint: "Close this panel";
                    tint: Theme.text-secondary;
                    clicked => { root.close(); }
                }
            }

            // Which backend produced what's currently on screen.
            HorizontalLayout {
                spacing: 6px;
                Rectangle {
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: RemoteWorkerModel.served_by_remote ? Theme.accent-emerald : Theme.text-muted;
                    y: 4px;
                }
                Text {
                    text: RemoteWorkerModel.served_by_remote
                        ? "Last frame rendered by: " + RemoteWorkerModel.served_by_worker_name
                        : "Last frame rendered locally.";
                    font-size: 10px;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                    accessible-role: AccessibleRole.text;
                }
            }

            Rectangle { height: 1px; background: Theme.surface-raised; }

            // Which library is currently being browsed: the local one, or the remote's.
            HorizontalLayout {
                spacing: 6px;
                FieldCaption {
                    horizontal-stretch: 1;
                    text: "Library";
                    hint: "Which design library the Library tab shows: the one on this computer, or the remote coordinator's.";
                }
                for label[idx] in ["Local", "Remote"]: SegmentPill {
                    horizontal-stretch: 0;
                    width: 90px;
                    height: 24px;
                    text: label;
                    hint: idx == 0
                        ? "Show the library on this computer."
                        : (RemoteWorkerModel.configured ? "Show the remote coordinator's library." : "Set up a remote coordinator first.");
                    selected: RemoteWorkerModel.library_source_worker_index == idx - 1;
                    enabled: idx == 0 || RemoteWorkerModel.configured;
                    picked => { RemoteWorkerModel.switch_library_source(idx - 1); }
                }
            }

            Rectangle { height: 1px; background: Theme.surface-raised; }

            // Denoise toggle -- applies to the merged image regardless of source. See
            // `settings::model::AppSettings::denoise_enabled`'s doc comment on why this is
            // one global switch.
            ToggleRow {
                text: "Denoise merged image";
                hint: "Smooth the grain out of the picture that combines this computer's render with the remote's.";
                label_color: Theme.text-secondary;
                checked: RemoteWorkerModel.denoise_enabled;
                toggled => { RemoteWorkerModel.denoise_toggled(!RemoteWorkerModel.denoise_enabled); }
            }

            // Remote lanes for batches -- how many pictures a catalogue preview or tilt batch
            // keeps in flight on the remote at once (`AppSettings::remote_batch_lanes`). One
            // app-wide choice like the denoise toggle above, not part of the endpoint form:
            // it is saved the moment the spin box changes. The explanation has a stated
            // two-line height because a wrapped `Text`'s preferred height is one line.
            // Advanced mode only.
            if GuideModel.shows_advanced(): VerticalLayout {
                spacing: 2px;
                HorizontalLayout {
                    alignment: space-between;
                    FieldCaption {
                        text: "Remote lanes for batches";
                        hint: "How many pictures a preview or tilt batch keeps being drawn on the remote at the same time.";
                    }
                    TipBox {
                        hint: "From 1 to 32. A coordinator with several workers can use more.";
                        SpinBox {
                            minimum: 1;
                            maximum: 32;
                            step-size: 1;
                            value <=> RemoteWorkerModel.remote_batch_lanes;
                            accessible-label: "Remote lanes for batches";
                            edited(lanes) => { RemoteWorkerModel.remote_batch_lanes_changed(lanes); }
                        }
                    }
                }
                Text {
                    text: "Pictures a preview or tilt batch keeps in flight on the remote at once; a coordinator with several workers wants more.";
                    font-size: 9px;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                    height: 24px;
                    accessible-role: AccessibleRole.text;
                }
            }

            // The configured endpoint.
            if RemoteWorkerModel.configured && !root.editing: Rectangle {
                background: Theme.surface-sunken;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.border-dialog;

                VerticalLayout {
                    padding: 8px;
                    spacing: 4px;

                    HorizontalLayout {
                        spacing: 4px;
                        Text { text: RemoteWorkerModel.endpoint.name == "" ? RemoteWorkerModel.endpoint.address : RemoteWorkerModel.endpoint.name; font-size: 11px; font-weight: 700; color: Theme.text-primary; overflow: elide; horizontal-stretch: 1; min-width: 0px; vertical-alignment: center; accessible-role: AccessibleRole.text; }
                        IconButton {
                            icon: @image-url("../icons/pencil.svg");
                            hint: "Edit this remote coordinator";
                            width: 24px;
                            height: 24px;
                            glyph: 11px;
                            clicked => { root.open_form(); }
                        }
                        IconButton {
                            icon: @image-url("../icons/close.svg");
                            hint: "Remove this remote coordinator. Renders stay on this computer.";
                            width: 24px;
                            height: 24px;
                            glyph: 11px;
                            tint: Theme.danger;
                            hover_fill: Theme.danger-surface-hover;
                            clicked => { RemoteWorkerModel.remove_remote(); }
                        }
                    }
                    Text { text: RemoteWorkerModel.endpoint.address; font-size: 10px; color: Theme.text-muted; accessible-role: AccessibleRole.text; }
                    if GuideModel.shows_advanced(): Text {
                        text: (RemoteWorkerModel.endpoint.transfer_mode_index == 0 ? "Live progressive" : "Final only")
                            + " · " + RemoteWorkerModel.endpoint.cadence_ms + "ms cadence · export transfer: "
                            + (RemoteWorkerModel.endpoint.export_transfer_index == 1 ? "final picture only" : "full data");
                        font-size: 9px;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                        accessible-role: AccessibleRole.text;
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        TipButton {
                            text: RemoteWorkerModel.testing_connection ? "Testing..." : "Test connection";
                            hint: "Check that this computer can reach the remote coordinator with the saved address and certificates.";
                            enabled: !RemoteWorkerModel.testing_connection;
                            height: 24px;
                            clicked => { RemoteWorkerModel.test_worker_connection(RemoteWorkerModel.endpoint.address, RemoteWorkerModel.endpoint.cert_dir); }
                        }
                        TipButton {
                            text: RemoteWorkerModel.mirror_in_progress ? "Cancel mirror" : "Mirror library to local";
                            hint: RemoteWorkerModel.mirror_in_progress
                                ? "Stop copying the remote library to this computer."
                                : "Copy the remote coordinator's designs into the library on this computer.";
                            height: 24px;
                            clicked => {
                                if (RemoteWorkerModel.mirror_in_progress) {
                                    RemoteWorkerModel.cancel_mirror_sync();
                                } else {
                                    RemoteWorkerModel.start_mirror_sync();
                                }
                            }
                        }
                    }
                    if RemoteWorkerModel.test_connection_result != "": Text {
                        text: RemoteWorkerModel.test_connection_result;
                        font-size: 9px;
                        color: RemoteWorkerModel.test_connection_is_error ? Theme.danger : Theme.accent-emerald;
                        wrap: word-wrap;
                        accessible-role: AccessibleRole.text;
                    }
                    if RemoteWorkerModel.mirror_in_progress: Rectangle {
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.surface-raised;
                        accessible-role: AccessibleRole.progress-indicator;
                        accessible-label: "Library copy progress";
                        accessible-value: Math.round(RemoteWorkerModel.mirror_progress_fraction * 100) + " percent";
                        Rectangle {
                            x: 0px;
                            width: parent.width * RemoteWorkerModel.mirror_progress_fraction;
                            height: 4px;
                            border-radius: 2px;
                            background: Theme.accent-cyan;
                            animate width { duration: 150ms; }
                        }
                    }
                    if RemoteWorkerModel.mirror_status_text != "": Text {
                        text: RemoteWorkerModel.mirror_status_text;
                        font-size: 9px;
                        color: RemoteWorkerModel.mirror_in_progress ? Theme.text-muted : (RemoteWorkerModel.mirror_has_error ? Theme.danger : Theme.accent-emerald);
                        wrap: word-wrap;
                        accessible-role: AccessibleRole.text;
                    }
                }
            }

            if !RemoteWorkerModel.configured && !root.editing: Text {
                text: "No remote coordinator configured -- renders stay local. One remote serves everything: a coordinator (with joined workers), or a single worker started with --render.";
                font-size: 10px;
                color: Theme.text-muted;
                wrap: word-wrap;
                accessible-role: AccessibleRole.text;
            }

            if !RemoteWorkerModel.configured && !root.editing: TipButton {
                text: "Set up remote coordinator";
                hint: "Enter the address and certificates of a remote coordinator to render on it.";
                clicked => { root.open_form(); }
            }

            if root.advanced_note_visible && !root.editing: AdvancedNote {}

            // The form.
            if root.editing: VerticalLayout {
                spacing: 6px;
                Rectangle { height: 1px; background: Theme.surface-raised; }
                Text { text: RemoteWorkerModel.configured ? "Edit remote coordinator" : "Set up remote coordinator"; font-size: 11px; font-weight: 700; color: Theme.text-primary; accessible-role: AccessibleRole.text; }

                TipBox {
                    hint: "A name you will recognise, for example Office coordinator. It may be left empty.";
                    LineEdit { placeholder-text: "Name (e.g. \"Office coordinator\")"; text <=> root.form_name; accessible-label: "Name of the remote coordinator"; }
                }
                TipBox {
                    hint: "Where the coordinator listens, written as host:port.";
                    LineEdit { placeholder-text: "Address (host:port)"; text <=> root.form_address; accessible-label: "Address of the remote coordinator"; }
                }
                HorizontalLayout {
                    spacing: 6px;
                    TipBox {
                        horizontal-stretch: 1;
                        hint: "The folder with this computer's certificates for the coordinator: ca.pem, client.pem and client.key.";
                        LineEdit {
                            placeholder-text: "Certificate bundle folder (ca.pem / client.pem / client.key)";
                            text <=> root.form_cert_dir;
                            accessible-label: "Certificate folder";
                        }
                    }
                    TipButton {
                        text: "Browse...";
                        hint: "Pick the certificate folder with a folder dialog.";
                        clicked => { RemoteWorkerModel.pick_cert_dir(root.form_cert_dir); }
                    }
                }

                // Token-based enrollment: redeem a one-time token from `indicatrix-worker cert
                // issue-token` directly, instead of installing the worker binary and running
                // `cert claim` in a terminal by hand. On success this fills in
                // `form_cert_dir` above automatically (see `changed claimed_cert_dir`).
                Text { text: "-- or redeem an enrollment token --"; font-size: 11px; color: Theme.text-muted; accessible-role: AccessibleRole.text; }
                TipBox {
                    hint: "Paste the address and token from \"cert issue-token\" on the coordinator.";
                    LineEdit {
                        placeholder-text: "Enrollment address (host:port, from \"cert issue-token\")";
                        text <=> root.form_enroll_addr;
                        accessible-label: "Enrollment address";
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    TipBox {
                        horizontal-stretch: 1;
                        hint: "Paste the address and token from \"cert issue-token\" on the coordinator.";
                        LineEdit {
                            placeholder-text: "Token (GW1-...)";
                            text <=> root.form_token;
                            accessible-label: "Enrollment token";
                        }
                    }
                    TipButton {
                        text: RemoteWorkerModel.claiming_token ? "Redeeming..." : "Redeem";
                        hint: "Use the one-time token to get the certificates this computer needs. The certificate folder is filled in for you.";
                        enabled: !RemoteWorkerModel.claiming_token && root.form_token != "" && root.form_enroll_addr != "";
                        clicked => {
                            RemoteWorkerModel.claim_token(root.form_name, root.form_enroll_addr, root.form_token);
                        }
                    }
                }
                if RemoteWorkerModel.claim_result_text != "": Text {
                    text: RemoteWorkerModel.claim_result_text;
                    font-size: 11px;
                    color: RemoteWorkerModel.claim_result_is_error ? Theme.danger : Theme.accent-emerald;
                    wrap: word-wrap;
                    accessible-role: AccessibleRole.text;
                }

                // The stream tuning -- Advanced mode only. The form keeps the endpoint's values
                // and saves them unchanged when these are hidden.
                if GuideModel.shows_advanced(): HorizontalLayout {
                    spacing: 6px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        FieldCaption {
                            text: "Live stream";
                            hint: "Live progressive shows the image improving as the remote works. Final only waits for the finished result.";
                        }
                        TipBox {
                            hint: "How the remote sends pictures while you look around.";
                            ComboBox { model: ["Live progressive", "Final only"]; current-index <=> root.form_transfer_mode_index; accessible-label: "Live stream"; }
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        FieldCaption {
                            text: "Cadence (ms)";
                            hint: "How often the remote sends an updated image, in milliseconds. A lower number updates more often and uses more network traffic.";
                        }
                        TipBox {
                            hint: "From 50 to 5000 milliseconds between updates.";
                            SpinBox { minimum: 50; maximum: 5000; step-size: 50; value <=> root.form_cadence_ms; accessible-label: "Cadence in milliseconds"; }
                        }
                    }
                }

                if GuideModel.shows_advanced(): HorizontalLayout {
                    spacing: 6px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        FieldCaption {
                            text: "Preview scale";
                            hint: "The size of the in-progress pictures compared with the final one. Smaller previews arrive faster.";
                        }
                        TipBox {
                            hint: "Pick how large the in-progress pictures are.";
                            ComboBox { model: ["Full", "Half", "Quarter", "Custom"]; current-index <=> root.form_preview_scale_index; accessible-label: "Preview scale"; }
                        }
                    }
                    if root.form_preview_scale_index == 3: VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        FieldCaption {
                            text: "Custom %";
                            hint: "The preview size as a percentage of the final picture.";
                            font_size: 9px;
                        }
                        TipBox {
                            hint: "From 1 to 100 percent.";
                            SpinBox { minimum: 1; maximum: 100; step-size: 5; value <=> root.form_preview_scale_percent; accessible-label: "Custom preview scale in percent"; }
                        }
                    }
                }

                if GuideModel.shows_advanced(): VerticalLayout {
                    spacing: 2px;
                    FieldCaption {
                        text: "Export transfer (default)";
                        hint: "The starting choice for the export dialog and the tilt video. Full data merges your own computer's samples with the remote's. Final picture only has the coordinator send one finished PNG per image.";
                    }
                    TipBox {
                        hint: "How exports come back from the remote by default.";
                        ComboBox { model: ["Full data", "Final picture only"]; current-index <=> root.form_export_transfer_index; accessible-label: "Export transfer"; }
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    TipButton {
                        text: RemoteWorkerModel.testing_connection ? "Testing..." : "Test connection";
                        hint: "Check that this computer can reach the coordinator with the address and certificates above.";
                        enabled: !RemoteWorkerModel.testing_connection && root.form_address != "";
                        clicked => { RemoteWorkerModel.test_worker_connection(root.form_address, root.form_cert_dir); }
                    }
                }
                if RemoteWorkerModel.test_connection_result != "": Text {
                    text: RemoteWorkerModel.test_connection_result;
                    font-size: 9px;
                    color: RemoteWorkerModel.test_connection_is_error ? Theme.danger : Theme.accent-emerald;
                    wrap: word-wrap;
                    accessible-role: AccessibleRole.text;
                }

                if root.advanced_note_visible: AdvancedNote {}

                HorizontalLayout {
                    spacing: 8px;
                    TipButton {
                        text: "Cancel";
                        hint: "Leave the form without saving.";
                        horizontal-stretch: 1;
                        clicked => { root.editing = false; }
                    }
                    TipButton {
                        text: "Save";
                        hint: root.form_address == "" ? "Enter an address first." : "Save this remote coordinator.";
                        horizontal-stretch: 1;
                        primary: true;
                        enabled: root.form_address != "";
                        clicked => {
                            RemoteWorkerModel.save_remote({
                                name: root.form_name,
                                address: root.form_address,
                                cert_dir: root.form_cert_dir,
                                transfer_mode_index: root.form_transfer_mode_index,
                                cadence_ms: root.form_cadence_ms,
                                preview_scale_index: root.form_preview_scale_index,
                                preview_scale_percent: root.form_preview_scale_percent,
                                export_transfer_index: root.form_export_transfer_index,
                            });
                            root.editing = false;
                        }
                    }
                }
            }
        }
        }
    }
}
