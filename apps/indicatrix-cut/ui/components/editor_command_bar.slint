import { Button, ComboBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { EditorModel } from "../models/editor.slint";
import { RetargetModel } from "../models/retarget.slint";

// Item 77: a cutter-facing summary of what Ctrl+Z/Ctrl+Y will actually do, from
// `Edit::describe` (`crates/indicatrix-cut-core/src/edit/edit_type.rs`) via
// `History::peek_undo`/`peek_redo`. Declared here (a file this lane owns) rather
// than as two more properties on `EditorModel` (`ui/models/editor.slint`, owned
// elsewhere) purely to avoid a hard cross-lane dependency for two plain strings --
// `ui/app.slint`'s Edit menu imports this same global to show the identical text.
// `gui::editor::view::push_tier_list_and_undo_redo` (`src/gui/editor/view.rs`,
// shared by every refresh path that also pushes `EditorModel.can_undo`/`can_redo`)
// already pushes both labels alongside those two flags, so this is live, not a
// pending handoff.
export global UndoRedoLabels {
    in property <string> undo_label: "";
    in property <string> redo_label: "";
}

// CAD audit items 151/240: `EditorModel.solve_state`/`last_solve_duration_ms`
// (declared on `ui/models/editor.slint`, owned elsewhere) are live. `solve_state`
// replaces `status_is_problem` as the signal this file's Solve button
// (`SolveGroup.solve_btn` below) and `EditorStatusStrip`'s persistent state
// segment key off, since `status_is_problem` is set unconditionally `true` by
// every edit's stale-marker refresh and cannot tell "needs a Solve" apart from
// "solved, but genuinely failed" -- see the Solve button's own doc comment below
// for why that matters. Pushed from `gui/editor/view.rs` (`refresh_editor_panel`,
// `push_stale_content`, `refresh_all`'s synchronous branch) and
// `gui/editor/auto_solve.rs` (`dispatch_background_solve`,
// `apply_background_solve_result`) -- both consumers below compile and render
// off these properties already.

// `Button`/`ComboBox` in this Slint version expose no `has-hover` of their own
// (unlike `TouchArea`, used everywhere else in this app for a custom hover
// treatment), so each control below is wrapped in a plain, passive `TouchArea` --
// sized explicitly from its child's own preferred size, the same idiom the old
// `editor_view.slint` already used to place a `Tooltip` next to a `Button`. That
// wrapper never wires `clicked`/`pointer-event`, so it never consumes the press
// meant for the real control inside it; it only observes `has-hover` for the hint
// shown below the row(s) (`EditorModel.hover_hint`, cleared on pointer-exit).
//
// New/Load Selected/Undo/Redo travel together (`NewLoadUndoRedoGroup`), as do
// Solve/Auto-solve/Deep Solve/Optimize/Retarget (`SolveGroup`) and Export/Save
// Native/Open Native (`FileActionsGroup`) -- each a small `HorizontalLayout`
// bundling controls that always appear together, so `EditorCommandBar` itself can
// arrange them into either one row (wide) or two (narrow, see its own doc
// comment below) without duplicating any button's hover/TouchArea/callback
// wiring.
component NewLoadUndoRedoGroup inherits HorizontalLayout {
    height: 34px;
    spacing: 8px;

    function set_hint(text: string) {
        EditorModel.hover_hint = text;
    }
    function clear_hint(text: string) {
        if EditorModel.hover_hint == text {
            EditorModel.hover_hint = "";
        }
    }

    // Item 77: see `UndoRedoLabels`'s own doc comment above (this file) for what
    // populates `undo_label`/`redo_label` and the handoff that's still pending.
    // cad_todo.md #221: appends the keyboard shortcut so it is discoverable from
    // the hover hint alone, not only from the manual (Appendix B).
    function undo_hint() -> string {
        return (EditorModel.can_undo && UndoRedoLabels.undo_label != "" ? "Undo: " + UndoRedoLabels.undo_label : "Undo the last edit.") + " (Ctrl+Z)";
    }
    function redo_hint() -> string {
        return (EditorModel.can_redo && UndoRedoLabels.redo_label != "" ? "Redo: " + UndoRedoLabels.redo_label : "Redo the last undone edit.") + " (Ctrl+Y)";
    }

    // cad_todo.md #220: "New" read the same as the Tier tab's own "New"
    // (clear-the-form) button below it, even though this one discards the
    // WHOLE design -- renamed to match the ellipsis convention `Retarget...`/
    // `Open Native...` already use for "opens a dialog first," and to read as
    // clearly different from the inspector's unrelated same-named button.
    TouchArea {
        width: new_btn.preferred-width;
        height: new_btn.preferred-height;
        changed has-hover => { if self.has-hover { root.set_hint("Start a new design from a preform."); } else { root.clear_hint("Start a new design from a preform."); } }
        new_btn := Button {
            text: "New Design...";
            clicked => { EditorModel.new_dialog_open = true; }
        }
    }
    TouchArea {
        width: load_btn.preferred-width;
        height: load_btn.preferred-height;
        changed has-hover => { if self.has-hover { root.set_hint("Load the selected catalogue design into the editor."); } else { root.clear_hint("Load the selected catalogue design into the editor."); } }
        load_btn := Button {
            text: "Load Selected";
            clicked => { EditorModel.load_selected(); }
        }
    }
    TouchArea {
        width: undo_btn.preferred-width;
        height: undo_btn.preferred-height;
        changed has-hover => { if self.has-hover { root.set_hint(root.undo_hint()); } else { root.clear_hint(root.undo_hint()); } }
        undo_btn := Button {
            text: "Undo";
            enabled: EditorModel.can_undo;
            clicked => { EditorModel.undo(); }
        }
    }
    TouchArea {
        width: redo_btn.preferred-width;
        height: redo_btn.preferred-height;
        changed has-hover => { if self.has-hover { root.set_hint(root.redo_hint()); } else { root.clear_hint(root.redo_hint()); } }
        redo_btn := Button {
            text: "Redo";
            enabled: EditorModel.can_redo;
            clicked => { EditorModel.redo(); }
        }
    }
}

// Solve/Auto-solve/Deep Solve/Optimize/Retarget -- see `NewLoadUndoRedoGroup`'s
// own doc comment above for why these travel together as one sub-component.
component SolveGroup inherits HorizontalLayout {
    height: 34px;
    spacing: 8px;

    function set_hint(text: string) {
        EditorModel.hover_hint = text;
    }
    function clear_hint(text: string) {
        if EditorModel.hover_hint == text {
            EditorModel.hover_hint = "";
        }
    }

    // CAD audit item 216: this hint text used to only ever mention what Solve
    // itself does -- it now also names whichever OTHER action (Deep Solve/
    // Optimize) is the reason the button below is disabled, mirroring
    // `AnalysisGroup`'s own `busy_suffix` below. cad_todo.md #221: "(F5)"
    // appended so the shortcut is discoverable from the hover hint itself --
    // `app.slint` wires F5 to this same `EditorModel.solve()` call.
    function solve_hint() -> string {
        return "Recompute every tier's depth and validate the design. Runs in the background above 16 tiers. (F5)"
            + (EditorModel.busy_action != "" && EditorModel.busy_action != "Solve" ? (" Disabled while " + EditorModel.busy_action + " is running.") : "");
    }

    // Styled with the same "problem" ruby accent the old validation banner
    // used while stale, so the button that clears staleness stays visually
    // tied to the status strip announcing it (see `EditorStatusStrip`).
    TouchArea {
        width: solve_btn.preferred-width;
        height: solve_btn.preferred-height;
        changed has-hover => { if self.has-hover { root.set_hint(root.solve_hint()); } else { root.clear_hint(root.solve_hint()); } }
        solve_btn := Button {
            text: EditorModel.solve_running ? "Solving..." : "Solve";
            // CAD audit item 216: Solve, Deep Solve and Optimize used to each
            // guard only their own `*_running` flag, so any two could run at
            // once. `busy_action` (`EditorModel`, derived from all three) is
            // "" only when none of them are running -- cross-disabling every
            // launcher on it, not only its own flag.
            enabled: EditorModel.busy_action == "";
            // CAD audit item 240: `status_is_problem` used to be the ONLY signal
            // here, and it is set unconditionally `true` by every ordinary edit's
            // stale-marker refresh (`push_stale_content`, `gui::editor::view`),
            // not only by a real solve failure -- with auto-solve on, that flipped
            // the button blue/red on every keystroke. `EditorModel.solve_state`
            // (CAD audit items 151/240's shared handoff -- see `ui/models/
            // editor.slint`) tells "genuinely stale, needs a manual Solve" apart
            // from "solving"/"solved"/"failed" explicitly. Restricted to
            // auto-solve OFF (`auto_solve_budget_ms == 0`) on top of that: with
            // auto-solve on, a background solve is already coming shortly, so
            // highlighting Solve as primary the moment an edit lands would still
            // flicker for the fraction of a second before that solve starts --
            // the accent is only useful when nothing else is going to clear the
            // staleness for the user.
            primary: EditorModel.auto_solve_budget_ms == 0 && EditorModel.solve_state == "stale";
            clicked => { EditorModel.solve(); }
        }
    }

    // CAD audit item 112: shown only while a solve is actually running, exactly
    // like the Deep Solve and Optimize cancels further down. The wording says
    // "Abandon" rather than "Cancel" on purpose: `Design::solve` has no mid-run
    // checkpoint, so the worker does finish in the background -- what this stops is
    // its result being applied, and the editor staying locked until it lands.
    if EditorModel.solve_running: Button {
        text: "Abandon Solve";
        clicked => { EditorModel.solve_cancel(); }
    }

    // Auto-solve budget: after an edit, a background re-solve is scheduled
    // automatically (debounced) whenever this design's last measured solve
    // took less than the selected budget. Collapsed from five separate
    // pill buttons into one combo; the exact five `auto_solve_budget_ms`
    // values (and "Off" == plain stale-marker behaviour) are unchanged.
    // Explicit width: a `ComboBox`'s preferred width is not derived from its
    // model, so sizing this wrapper from it collapsed the cell and the combo
    // drew over the Solve button next to it. CAD audit item 249: shrinks below
    // a narrow dock instead of always spending 150px -- keyed off `EditorModel.
    // dock_width` (set externally, by the drag handle in `app.slint`) rather
    // than this component's OWN rendered width, which would instead feed back
    // into the very layout pass computing it (a binding loop `cargo clippy`'s
    // own `.slint` compilation step rejects outright -- see `EditorCommandBar`'s
    // own doc comment for the exact loop a first attempt hit).
    // cad_todo.md #217: the combo used to have no label of its own next to it,
    // only the shared hover hint below -- a cutter had to hover it once just to
    // learn it exists. `combo_width` keeps the exact `dock_width` breakpoint
    // logic item 249 already established (see that item's own doc comment
    // below on this component), now sized separately from the wrapper so the
    // label can sit beside it without changing the combo's own on-screen size.
    property <length> combo_width: EditorModel.dock_width < 760px ? 96px : 150px;
    TouchArea {
        width: auto_solve_label.preferred-width + 4px + root.combo_width;
        height: auto_solve_combo.preferred-height;
        changed has-hover => { if self.has-hover { root.set_hint("After an edit, automatically re-solve (debounced) once this design's own last solve took less than the selected budget. \"Off\" only marks the panel stale."); } else { root.clear_hint("After an edit, automatically re-solve (debounced) once this design's own last solve took less than the selected budget. \"Off\" only marks the panel stale."); } }
        HorizontalLayout {
            spacing: 4px;
            auto_solve_label := Text {
                text: "Auto-solve:";
                font-size: 10px;
                color: Theme.text-muted;
                vertical-alignment: center;
            }
            auto_solve_combo := ComboBox {
                // The style's own minimum width is wider than this cell, so the
                // combo is pinned to `combo_width` instead of overflowing it onto
                // the Solve button.
                width: root.combo_width;
                model: ["Off", "150 ms", "300 ms", "1 s", "3 s"];
                current-index: EditorModel.auto_solve_budget_ms == 0 ? 0
                    : EditorModel.auto_solve_budget_ms == 150 ? 1
                    : EditorModel.auto_solve_budget_ms == 300 ? 2
                    : EditorModel.auto_solve_budget_ms == 1000 ? 3
                    : 4;
                selected(val) => {
                    EditorModel.auto_solve_budget_ms = val == "Off" ? 0
                        : val == "150 ms" ? 150
                        : val == "300 ms" ? 300
                        : val == "1 s" ? 1000
                        : 3000;
                }
            }
        }
    }

}

// Add / Duplicate / Delete / Move -- cad_todo.md #219: a command-bar-level way to
// manage the currently selected tier. `EditorTierTable` (this lane's other owned
// file) already exposes every one of these as a per-row action (and "+ Add Tier"
// as its own header button), but a first-time user scanning the command bar for
// "how do I add a facet" found nothing there at all. Add is always enabled (it
// only switches the inspector to the Tier tab in add mode, mirroring the tier
// table's own "+ Add Tier" button exactly); Duplicate/Delete/Move act on
// `EditorModel.selected_tier_index` and are disabled with nothing selected, the
// same convention `AnalysisGroup`'s Deep Solve/Optimize use for "not applicable
// right now" rather than hiding the button outright.
component TierGroup inherits HorizontalLayout {
    height: 34px;
    spacing: 8px;

    function set_hint(text: string) {
        EditorModel.hover_hint = text;
    }
    function clear_hint(text: string) {
        if EditorModel.hover_hint == text {
            EditorModel.hover_hint = "";
        }
    }

    property <bool> has_selection: EditorModel.selected_tier_index >= 0;

    TouchArea {
        width: add_tier_btn.preferred-width;
        height: add_tier_btn.preferred-height;
        changed has-hover => { if self.has-hover { root.set_hint("Open the Tier tab in Add mode to author a new tier."); } else { root.clear_hint("Open the Tier tab in Add mode to author a new tier."); } }
        add_tier_btn := Button {
            text: "+ Add Tier";
            clicked => {
                EditorModel.selected_tier_index = -1;
                EditorModel.inspector_tab = 0;
                EditorModel.inspector_collapsed = false;
            }
        }
    }
    TouchArea {
        width: duplicate_tier_btn.preferred-width;
        height: duplicate_tier_btn.preferred-height;
        changed has-hover => { if self.has-hover { root.set_hint("Duplicate the selected tier, inserted right after it (Ctrl+D)."); } else { root.clear_hint("Duplicate the selected tier, inserted right after it (Ctrl+D)."); } }
        duplicate_tier_btn := Button {
            text: "Duplicate";
            enabled: root.has_selection;
            clicked => { EditorModel.duplicate_tier(EditorModel.selected_tier_index); }
        }
    }
    TouchArea {
        width: delete_tier_btn.preferred-width;
        height: delete_tier_btn.preferred-height;
        changed has-hover => { if self.has-hover { root.set_hint("Remove the selected tier (Delete)."); } else { root.clear_hint("Remove the selected tier (Delete)."); } }
        delete_tier_btn := Button {
            text: "Delete";
            enabled: root.has_selection;
            clicked => { EditorModel.remove_tier(EditorModel.selected_tier_index); }
        }
    }
    TouchArea {
        width: move_up_btn.preferred-width;
        height: move_up_btn.preferred-height;
        changed has-hover => { if self.has-hover { root.set_hint("Move the selected tier earlier in cutting order (Alt+Up)."); } else { root.clear_hint("Move the selected tier earlier in cutting order (Alt+Up)."); } }
        move_up_btn := Button {
            text: "\u{25B2}";
            enabled: root.has_selection;
            clicked => { EditorModel.move_tier(EditorModel.selected_tier_index, -1); }
        }
    }
    TouchArea {
        width: move_down_btn.preferred-width;
        height: move_down_btn.preferred-height;
        changed has-hover => { if self.has-hover { root.set_hint("Move the selected tier later in cutting order (Alt+Down)."); } else { root.clear_hint("Move the selected tier later in cutting order (Alt+Down)."); } }
        move_down_btn := Button {
            text: "\u{25BC}";
            enabled: root.has_selection;
            clicked => { EditorModel.move_tier(EditorModel.selected_tier_index, 1); }
        }
    }
}

// Deep Solve / Optimize / Retarget -- the slower analyses, on the command bar's
// second row (see `EditorCommandBar` below).
component AnalysisGroup inherits HorizontalLayout {
    height: 34px;
    spacing: 8px;

    function set_hint(text: string) {
        EditorModel.hover_hint = text;
    }
    function clear_hint(text: string) {
        if EditorModel.hover_hint == text {
            EditorModel.hover_hint = "";
        }
    }

    // CAD audit item 154: a purely local latch -- no new `EditorModel` property
    // needed (`ui/models/editor.slint` is not owned by this group) -- so a second
    // click on "Cancel Optimize" while a cancel is already in flight cannot re-fire
    // `EditorModel.optimize_cancel()`. Mirrors `EditorModel.optimize_running` in a
    // local property (`self.foo`, not `EditorModel.foo`, is what a `changed`
    // handler can rely on here) purely so `changed` can watch it; reset the moment
    // a run is no longer active, which covers both this run's own completion AND,
    // belt and braces, the state a brand new run starts in.
    property <bool> optimize_running_mirror: EditorModel.optimize_running;
    property <bool> optimize_cancel_requested: false;
    changed optimize_running_mirror => {
        if !self.optimize_running_mirror {
            self.optimize_cancel_requested = false;
        }
    }

    // CAD audit item 216: appended to each button's own tooltip/hint text
    // below whenever some OTHER action (not `own_action`) is the reason it is
    // currently disabled -- `EditorModel.busy_action` names Solve, Deep Solve
    // or Optimize, so this is "" whenever nothing is running or `own_action`
    // itself is the one running (that case already has its own "Cancel ..."
    // button/text, nothing more to explain). A named function rather than an
    // inline ternary: `@markdown`'s dynamic text must be a plain expression,
    // never a nested ternary -- see the two `Tooltip`s below.
    function busy_suffix(own_action: string) -> string {
        return (EditorModel.busy_action != "" && EditorModel.busy_action != own_action)
            ? ("\n\nDisabled while " + EditorModel.busy_action + " is running.")
            : "";
    }

    // A separate, slower, externally-verified action from "Solve".
    // Disabled (with the reason surfaced in `EditorStatusStrip`'s log)
    // rather than hidden, so a design with nothing to verify against reads
    // as "not applicable right now," not "missing."
    if !EditorModel.deep_solve_running: TouchArea {
        width: deep_solve_btn.preferred-width;
        height: deep_solve_btn.preferred-height;
        changed has-hover => { if self.has-hover { root.set_hint("Slow check against the catalogue's printed proportions. Never changes the design."); } else { root.clear_hint("Slow check against the catalogue's printed proportions. Never changes the design."); } }
        // The always-present explanation of why Deep Solve is (or isn't) available
        // right now (`view::deep_solve_hint`) -- moved here, off `EditorStatusStrip`,
        // so it no longer permanently occupies that strip's one message slot ahead
        // of the design's own solved/stale/failed state. Still fully discoverable,
        // just on hover instead of always-on. CAD audit item 216: now also names
        // Solve/Optimize as the reason when either is the one keeping this button
        // disabled (`deep_solve_tooltip_text`, a plain property -- see
        // `busy_suffix`'s own doc comment for why this can't be inlined here).
        property <string> deep_solve_tooltip_text: EditorModel.deep_solve_hint + root.busy_suffix("Deep Solve");
        Tooltip { text: @markdown("\{deep_solve_tooltip_text}"); }
        deep_solve_btn := Button {
            text: "Deep Solve";
            // CAD audit item 216: cross-disabled on `busy_action`, not only
            // `deep_solve_available` -- see the Solve button's own doc comment
            // on `busy_action` for why a fourth flag isn't needed.
            enabled: EditorModel.deep_solve_available && EditorModel.busy_action == "";
            clicked => { EditorModel.deep_solve(); }
        }
    }
    if EditorModel.deep_solve_running: Button {
        text: "Cancel Deep Solve";
        clicked => { EditorModel.deep_solve_cancel(); }
    }

    // Same disabled-with-a-hint treatment as Deep Solve, except genuinely
    // DISABLED when there is nothing free to move.
    if !EditorModel.optimize_running: TouchArea {
        width: optimize_btn.preferred-width;
        height: optimize_btn.preferred-height;
        changed has-hover => { if self.has-hover { root.set_hint("Search free (unpinned) tiers for better optics. Adopt a tier first if disabled."); } else { root.clear_hint("Search free (unpinned) tiers for better optics. Adopt a tier first if disabled."); } }
        // Same reasoning as the Deep Solve button's own `Tooltip` above --
        // `view::optimize_hint`'s always-present explanation lives here instead of
        // permanently occupying a shared status line. CAD audit item 216: see
        // the Deep Solve button's own `deep_solve_tooltip_text` doc comment.
        property <string> optimize_tooltip_text: EditorModel.optimize_hint + root.busy_suffix("Optimize");
        Tooltip { text: @markdown("\{optimize_tooltip_text}"); }
        optimize_btn := Button {
            text: "Optimize";
            // CAD audit item 216: see the Deep Solve button's own comment above.
            enabled: EditorModel.optimize_available && EditorModel.busy_action == "";
            clicked => {
                EditorModel.optimize(EditorModel.optimize_weight_windowing, EditorModel.optimize_weight_extinction, EditorModel.optimize_weight_tilt_brilliance);
            }
        }
    }
    // CAD audit item 154: labelled "Cancelling..." and disabled the instant it's
    // clicked (see `optimize_cancel_requested` above) -- previously nothing on
    // this button changed for the several seconds `optimize_status` still took to
    // read back "Cancelling -- finishing the current evaluation...", so a cutter
    // who saw no reaction clicked it again.
    if EditorModel.optimize_running: Button {
        text: root.optimize_cancel_requested ? "Cancelling..." : "Cancel Optimize";
        enabled: !root.optimize_cancel_requested;
        clicked => {
            root.optimize_cancel_requested = true;
            EditorModel.optimize_cancel();
        }
    }

    // Proposes new facet angles for a different material, reviewed in a
    // modal dialog before anything is applied.
    TouchArea {
        width: retarget_btn.preferred-width;
        height: retarget_btn.preferred-height;
        changed has-hover => { if self.has-hover { root.set_hint("Propose new facet angles for a different material, reviewed before applying."); } else { root.clear_hint("Propose new facet angles for a different material, reviewed before applying."); } }
        retarget_btn := Button {
            text: "Retarget...";
            clicked => { RetargetModel.open(); }
        }
    }
}

// Export Edited .asc / Save Native / Open Native -- see `NewLoadUndoRedoGroup`'s
// own doc comment above for why these travel together as one sub-component.
component FileActionsGroup inherits HorizontalLayout {
    height: 34px;
    spacing: 8px;

    function set_hint(text: string) {
        EditorModel.hover_hint = text;
    }
    function clear_hint(text: string) {
        if EditorModel.hover_hint == text {
            EditorModel.hover_hint = "";
        }
    }

    // The native design-file format. "Save Native" always writes a real
    // `.asc` alongside its `.indicatrix.toml` sidecar, never the sidecar
    // alone. "Export Edited .asc" exports the design AS EDITED in this tab,
    // distinct from `detail_header.slint`'s catalogue-original "Export
    // .asc" -- kept as a distinguishing label since the two buttons used
    // to share that exact label with nothing to tell them apart; see
    // `detail_header.slint`'s own "Export .asc" doc comment. cad_todo.md
    // #253: this button's own text used to say plain "Export Edited" while
    // `app.slint`'s File-menu entry for the identical action spelled it out
    // in full as "Export Edited .asc" -- unified here to the File menu's
    // fuller name, matching the manual (Chapter 3/11)'s description.
    TouchArea {
        width: export_btn.preferred-width;
        height: export_btn.preferred-height;
        // cad_todo.md #260: appended "...to disk; your library is not
        // updated" -- Export Edited/Save Native genuinely never register
        // anything in, or change anything about, the catalogue (Chapter 11),
        // the mirror image of `detail_header.slint`'s own catalogue-side
        // "Save the original file... not your edits" warning.
        changed has-hover => { if self.has-hover { root.set_hint("Export the design as edited in this tab to disk; your library is not updated."); } else { root.clear_hint("Export the design as edited in this tab to disk; your library is not updated."); } }
        export_btn := Button {
            text: "Export Edited .asc";
            clicked => { EditorModel.export_asc(); }
        }
    }
    TouchArea {
        width: save_native_btn.preferred-width;
        height: save_native_btn.preferred-height;
        // cad_todo.md #260: see the Export Edited TouchArea's own comment above.
        changed has-hover => { if self.has-hover { root.set_hint("Write the native .asc plus its .indicatrix.toml sidecar to disk; your library is not updated."); } else { root.clear_hint("Write the native .asc plus its .indicatrix.toml sidecar to disk; your library is not updated."); } }
        save_native_btn := Button {
            text: "Save Native";
            clicked => { EditorModel.save_native(); }
        }
    }
    TouchArea {
        width: open_native_btn.preferred-width;
        height: open_native_btn.preferred-height;
        changed has-hover => { if self.has-hover { root.set_hint("Open a native design file."); } else { root.clear_hint("Open a native design file."); } }
        open_native_btn := Button {
            text: "Open Native";
            clicked => { EditorModel.open_native(); }
        }
    }
}

// The Edit sub-tab's command bar, two fixed rows sized for the dock's 600px
// minimum width (`app.slint`'s `dock_width` clamp): row 1 is the editing
// group (New Design.../Load Selected/Undo/Redo) plus Solve and its auto-solve
// budget, row 2 the tier group (cad_todo.md #219: Add/Duplicate/Delete/Move),
// the slower analyses (Deep Solve/Optimize/Retarget) and the native file
// actions. Each row ends in a stretch spacer so a wider dock leaves the
// buttons left-aligned instead of spreading them. (`FlexboxLayout`, which
// would wrap automatically, is not enabled in this Slint build.)
//
// No 9px caption text lives under any one button any more: hovering any control
// in any group sets `EditorModel.hover_hint`, shown as a single line below the
// row(s) instead -- see `hover_hint`'s own doc comment on `EditorModel`.
//
// CAD audit item 249 (partial): the auto-solve combo (`SolveGroup`) now
// shrinks below a narrow dock instead of always spending a fixed 150px, keyed
// off `EditorModel.dock_width` -- a value set externally (the drag handle in
// `app.slint`), never derived from this bar's own content, so reading it here
// carries none of the "one fixed dimension pins the whole window" risk a width
// derived from THIS layout pass would. (A first attempt read `self.width` on
// this very component instead and fed it back into a child's `width` --
// `cargo clippy`'s own build, which compiles every `.slint` file, rejected it
// outright as a `layoutinfo-h -> layout-cache -> width -> ... -> narrow`
// binding loop; reverted in favour of `dock_width`.)
//
// Still two fixed rows sized for the dock's 600px minimum, not the "one row of
// icon buttons, `...`-overflowing below ~760px" the full item asks for --
// left undone (too large a redesign for this pass, and unverifiable without a
// visual check this pass cannot perform): converting every button here to an
// icon (`ui/icons` only covers five of this bar's dozen actions today, not all
// of them), collapsing to a single row above the same `dock_width` breakpoint,
// and an overflow "..." menu for the Analysis group below it.
export component EditorCommandBar inherits Rectangle {
    VerticalLayout {
        spacing: 2px;

        HorizontalLayout {
            height: 34px;
            spacing: 8px;
            NewLoadUndoRedoGroup {}
            Rectangle { width: 1px; background: Theme.border-subtle; }
            SolveGroup {}
            Rectangle { horizontal-stretch: 1; }
        }
        HorizontalLayout {
            height: 34px;
            spacing: 8px;
            TierGroup {}
            Rectangle { width: 1px; background: Theme.border-subtle; }
            AnalysisGroup {}
            Rectangle { width: 1px; background: Theme.border-subtle; }
            FileActionsGroup {}
            Rectangle { horizontal-stretch: 1; }
        }

        // CAD audit item 249: wraps instead of eliding a single line, so a long
        // hint ("After an edit, automatically re-solve (debounced)...") reads in
        // full instead of teaching nothing past the cutoff. Capped at two lines'
        // worth of height (not the old function's literal "auto height") so a
        // very long hint still cannot push the tier table below it around --
        // `overflow: clip` on the rare hint long enough to need a third line,
        // rather than `elide`, which only ever elides a single line and would
        // leave the wrapped second line's own tail truncated mid-word instead.
        Text {
            text: EditorModel.hover_hint;
            font-size: 11px;
            color: Theme.text-muted;
            height: 28px;
            wrap: word-wrap;
            overflow: clip;
        }
    }
}
