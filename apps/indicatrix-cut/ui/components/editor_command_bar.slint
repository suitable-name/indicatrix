import { Button, ComboBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { EditorModel } from "../models/editor.slint";
import { RetargetModel } from "../models/retarget.slint";
import { GuideModel } from "../models/guide.slint";
import { CuttingModeModel } from "../models/cutting_mode.slint";
import { GuideLockTip } from "guide_lock.slint";
import { WarningLine } from "warning_line.slint";
// Mounted by `FileActionsGroup` below, next to Save; see that file's own
// doc comment.
import { ExportSplitButton } from "export_split_button.slint";
// The "?" at the right end of the first row opens the manual page on this bar.
import { HelpButton } from "help_button.slint";
import { HelpTopics } from "../models/help.slint";

// A cutter-facing summary of what Ctrl+Z/Ctrl+Y will actually do, from
// `Edit::describe` (`crates/indicatrix-cut-core/src/edit/edit_type.rs`) via
// `History::peek_undo`/`peek_redo`. A separate global rather than two more
// `EditorModel` properties, since `ui/app.slint`'s Edit menu imports this same
// global to show the identical text. Pushed by
// `gui::editor::view::push_tier_list_and_undo_redo` alongside
// `EditorModel.can_undo`/`can_redo`.
export global UndoRedoLabels {
    in property <string> undo_label: "";
    in property <string> redo_label: "";
}

// `EditorModel.solve_state` (not `status_is_problem`) is the signal this file's
// Solve button (`SolveGroup.solve_btn` below) and `EditorStatusStrip`'s persistent
// state segment key off: `status_is_problem` is set unconditionally `true` by
// every edit's stale-marker refresh and cannot tell "needs a Solve" apart from
// "solved, but genuinely failed". `solve_state`/`last_solve_duration_ms` are
// pushed from `gui/editor/view.rs` and `gui/editor/auto_solve.rs`.

// `Button`/`ComboBox` in this Slint version expose no `has-hover` of their own
// (unlike `TouchArea`, used everywhere else in this app for a custom hover
// treatment), so each control below is wrapped in a plain, passive `TouchArea`
// sized explicitly from its child's own preferred size. That wrapper never wires
// `clicked`/`pointer-event`, so it never consumes the press meant for the real
// control inside it; it only observes `has-hover` for the hint shown below the
// row(s) (`EditorModel.hover_hint`, cleared on pointer-exit).
//
// Every control below also ANDs the matching `GuideModel.allows_*()` helper into
// its `enabled:` and carries a `GuideLockTip`, so the worked-example guide can lock
// whatever its current step does not ask for (see `GuideAllow`, `models/guide.slint`).
//
// New/Load Selected/Undo/Redo travel together (`NewLoadUndoRedoGroup`), as do
// Solve/Auto-solve/Deep Solve/Optimize/Retarget (`SolveGroup`) and Export/Save/Open
// (`FileActionsGroup`) -- each a small `HorizontalLayout`
// bundling controls that always appear together, so `EditorCommandBar` itself can
// arrange them into shared or separate rows (wide vs narrow, see its own doc
// comment below) without duplicating any button's hover/TouchArea/callback
// wiring.
component NewLoadUndoRedoGroup inherits HorizontalLayout {
    height: 34px;
    spacing: 8px;

    function set_hint(text: string) {
        EditorModel.hover_hint = text;
    }
    function clear_hint(text: string) {
        if EditorModel.hover_hint == text {
            EditorModel.hover_hint = "";
        }
    }

    // See `UndoRedoLabels`'s own doc comment above for what populates
    // `undo_label`/`redo_label`. The keyboard shortcut is appended so it is
    // discoverable from the hover hint alone, not only from the manual.
    function undo_hint() -> string {
        return (EditorModel.can_undo && UndoRedoLabels.undo_label != "" ? "Undo: " + UndoRedoLabels.undo_label : "Undo the last edit.") + " (Ctrl+Z)";
    }
    function redo_hint() -> string {
        return (EditorModel.can_redo && UndoRedoLabels.redo_label != "" ? "Redo: " + UndoRedoLabels.redo_label : "Redo the last undone edit.") + " (Ctrl+Y)";
    }

    // "New Design..." discards the WHOLE design, unlike the Tier tab's own
    // clear-the-form "New" button below it. The ellipsis follows the
    // `Retarget...`/`Open...` convention for "opens a dialog first" and
    // keeps the label clearly distinct from the inspector's same-named button.
    TouchArea {
        width: new_btn.preferred-width;
        height: new_btn.preferred-height;
        changed has-hover => { if self.has-hover { root.set_hint("Start a new design from a preform."); } else { root.clear_hint("Start a new design from a preform."); } }
        new_btn := Button {
            text: "New Design...";
            accessible-description: "Start a new design from a shape or a blank preform. Asks first if the open design has unsaved changes.";
            enabled: GuideModel.allows_new_design();
            clicked => { EditorModel.new_dialog_open = true; }
        }
        if GuideModel.highlight_target == "new_design_dialog": Rectangle {
            border-width: 2px;
            border-color: Theme.accent-cyan;
            border-radius: Theme.radius-sm;
        }
        GuideLockTip { locked: !GuideModel.allows_new_design(); }
    }
    TouchArea {
        width: load_btn.preferred-width;
        height: load_btn.preferred-height;
        changed has-hover => { if self.has-hover { root.set_hint("Load the selected catalogue design into the editor."); } else { root.clear_hint("Load the selected catalogue design into the editor."); } }
        load_btn := Button {
            text: "Load Selected";
            accessible-description: "Open the design selected in the library list so you can edit it here.";
            enabled: GuideModel.allows_file_ops();
            clicked => { EditorModel.load_selected(); }
        }
        // The library tutorial's "Load it" step outlines this button.
        if GuideModel.highlight_target == "load_button": Rectangle {
            border-width: 2px;
            border-color: Theme.accent-cyan;
            border-radius: Theme.radius-sm;
        }
        GuideLockTip { locked: !GuideModel.allows_file_ops(); }
    }
    TouchArea {
        width: undo_btn.preferred-width;
        height: undo_btn.preferred-height;
        changed has-hover => { if self.has-hover { root.set_hint(root.undo_hint()); } else { root.clear_hint(root.undo_hint()); } }
        undo_btn := Button {
            text: "Undo";
            accessible-description: root.undo_hint();
            enabled: EditorModel.can_undo && GuideModel.allows_history();
            clicked => { EditorModel.undo(); }
        }
        GuideLockTip { locked: !GuideModel.allows_history(); }
    }
    TouchArea {
        width: redo_btn.preferred-width;
        height: redo_btn.preferred-height;
        changed has-hover => { if self.has-hover { root.set_hint(root.redo_hint()); } else { root.clear_hint(root.redo_hint()); } }
        redo_btn := Button {
            text: "Redo";
            accessible-description: root.redo_hint();
            enabled: EditorModel.can_redo && GuideModel.allows_history();
            clicked => { EditorModel.redo(); }
        }
        GuideLockTip { locked: !GuideModel.allows_history(); }
    }
}

// Solve/Auto-solve/Deep Solve/Optimize/Retarget -- see `NewLoadUndoRedoGroup`'s
// own doc comment above for why these travel together as one sub-component.
component SolveGroup inherits HorizontalLayout {
    height: 34px;
    spacing: 8px;

    function set_hint(text: string) {
        EditorModel.hover_hint = text;
    }
    function clear_hint(text: string) {
        if EditorModel.hover_hint == text {
            EditorModel.hover_hint = "";
        }
    }

    // Besides what Solve does, names whichever OTHER action (Deep Solve/
    // Optimize) is the reason the button below is disabled, mirroring
    // `AnalysisGroup`'s own `busy_suffix` below. "(F5)" is appended so the
    // shortcut is discoverable from the hover hint itself -- `app.slint` wires
    // F5 to this same `EditorModel.solve()` call.
    function solve_hint() -> string {
        return "Recompute every tier's depth and validate the design. Runs in the background above 16 tiers. (F5)"
            + (EditorModel.busy_action != "" && EditorModel.busy_action != "Solve" ? (" Disabled while " + EditorModel.busy_action + " is running.") : "");
    }

    // Styled with the same "problem" ruby accent the status strip uses while
    // stale, so the button that clears staleness stays visually tied to the
    // strip announcing it (see `EditorStatusStrip`).
    TouchArea {
        width: solve_btn.preferred-width;
        height: solve_btn.preferred-height;
        changed has-hover => { if self.has-hover { root.set_hint(root.solve_hint()); } else { root.clear_hint(root.solve_hint()); } }
        solve_btn := Button {
            text: EditorModel.solve_running ? "Solving..." : "Solve";
            accessible-description: root.solve_hint();
            // `busy_action` (`EditorModel`, derived from all three `*_running`
            // flags) is "" only when none of Solve/Deep Solve/Optimize is
            // running -- every launcher cross-disables on it, not only its own
            // flag, so no two can run at once.
            enabled: EditorModel.busy_action == "" && GuideModel.allows_solve();
            // Keyed off `EditorModel.solve_state`, not `status_is_problem`: the
            // latter is set unconditionally `true` by every ordinary edit's
            // stale-marker refresh (`push_stale_content`, `gui::editor::view`),
            // which with auto-solve on would flip the button blue/red on every
            // keystroke. `solve_state` tells "genuinely stale, needs a manual
            // Solve" apart from "solving"/"solved"/"failed". Restricted to
            // auto-solve OFF (`auto_solve_budget_ms == 0`) on top of that: with
            // auto-solve on, a background solve is already coming shortly, so
            // highlighting Solve the moment an edit lands would flicker for the
            // fraction of a second before that solve starts -- the accent is
            // only useful when nothing else is going to clear the staleness.
            primary: EditorModel.auto_solve_budget_ms == 0 && EditorModel.solve_state == "stale";
            clicked => { EditorModel.solve(); }
        }
        // The guide's "Solve and check" step outlines this button.
        if GuideModel.highlight_target == "solve_button": Rectangle {
            border-width: 2px;
            border-color: Theme.accent-cyan;
            border-radius: Theme.radius-sm;
        }
        GuideLockTip { locked: !GuideModel.allows_solve(); }
    }

    // Shown only while a solve is actually running, exactly like the Deep Solve
    // and Optimize cancels further down. The wording says
    // "Abandon" rather than "Cancel" on purpose: `Design::solve` has no mid-run
    // checkpoint, so the worker does finish in the background -- what this stops is
    // its result being applied, and the editor staying locked until it lands.
    if EditorModel.solve_running: Button {
        text: "Abandon Solve";
        accessible-description: "Stop waiting for the running solve and ignore its result. The calculation itself finishes in the background.";
        clicked => { EditorModel.solve_cancel(); }
    }

    // Auto-solve budget: after an edit, a background re-solve is scheduled
    // automatically (debounced) whenever this design's last measured solve
    // took less than the selected budget; "Off" means plain stale-marker
    // behaviour. One combo holds the five `auto_solve_budget_ms` values.
    // Explicit width: a `ComboBox`'s preferred width is not derived from its
    // model, so sizing this wrapper from it collapses the cell and the combo
    // draws over the Solve button next to it. Shrinks below a narrow dock
    // instead of always spending 150px -- keyed off `EditorModel.dock_width`
    // (set externally, by the drag handle in `app.slint`) rather than this
    // component's OWN rendered width, which would feed back into the very
    // layout pass computing it (a binding loop the `.slint` compiler rejects
    // outright -- see `EditorCommandBar`'s own doc comment for the exact loop).
    // `combo_width` is sized separately from the wrapper so the "Auto-solve:"
    // label can sit beside the combo without changing its on-screen size; the
    // label is there so a cutter learns the combo exists without hovering it.
    property <length> combo_width: EditorModel.dock_width < 760px ? 96px : 150px;
    TouchArea {
        width: auto_solve_label.preferred-width + 4px + root.combo_width;
        height: auto_solve_combo.preferred-height;
        changed has-hover => { if self.has-hover { root.set_hint("Auto-solve: after an edit, solve again by itself when this design's last solve was quicker than the chosen time (a short pause lets you finish typing first). Off only marks the panel out of date until you press Solve."); } else { root.clear_hint("Auto-solve: after an edit, solve again by itself when this design's last solve was quicker than the chosen time (a short pause lets you finish typing first). Off only marks the panel out of date until you press Solve."); } }
        HorizontalLayout {
            spacing: 4px;
            auto_solve_label := Text {
                text: "Auto-solve:";
                font-size: 10px;
                color: Theme.text-muted;
                vertical-alignment: center;
            }
            auto_solve_combo := ComboBox {
                // The style's own minimum width is wider than this cell, so the
                // combo is pinned to `combo_width` instead of overflowing it onto
                // the Solve button.
                width: root.combo_width;
                enabled: GuideModel.allows_solve();
                accessible-label: "Auto-solve";
                accessible-description: "After an edit, solve again by itself when the last solve was quicker than this time. Off only marks the panel out of date.";
                model: ["Off", "150 ms", "300 ms", "1 s", "3 s"];
                current-index: EditorModel.auto_solve_budget_ms == 0 ? 0
                    : EditorModel.auto_solve_budget_ms == 150 ? 1
                    : EditorModel.auto_solve_budget_ms == 300 ? 2
                    : EditorModel.auto_solve_budget_ms == 1000 ? 3
                    : 4;
                selected(val) => {
                    EditorModel.auto_solve_budget_ms = val == "Off" ? 0
                        : val == "150 ms" ? 150
                        : val == "300 ms" ? 300
                        : val == "1 s" ? 1000
                        : 3000;
                    // The guide's auto-solve lesson waits for the choice, off or on.
                    if val == "Off" {
                        GuideModel.event("auto_solve_off");
                    } else {
                        GuideModel.event("auto_solve_on");
                    }
                }
            }
        }
        // The guide's auto-solve lesson outlines the label and the combo.
        if GuideModel.highlight_target == "auto_solve": Rectangle {
            border-width: 2px;
            border-color: Theme.accent-cyan;
            border-radius: Theme.radius-sm;
        }
        GuideLockTip { locked: !GuideModel.allows_solve(); }
    }

}

// Add / Duplicate / Delete / Move -- a command-bar-level way to manage the
// currently selected tier. `EditorTierTable` exposes every one of these as a
// per-row action too (and "+ Add Tier" as its own header button), but a
// first-time user scanning the command bar for "how do I add a facet" needs to
// find them here. Add is always enabled (it only switches the inspector to the
// Tier tab in add mode, mirroring the tier table's own "+ Add Tier" button);
// Duplicate/Delete/Move act on `EditorModel.selected_tier_index` and are
// disabled with nothing selected, the same convention `AnalysisGroup`'s Deep
// Solve/Optimize use for "not applicable right now" rather than hiding the
// button outright.
component TierGroup inherits HorizontalLayout {
    height: 34px;
    spacing: 8px;

    function set_hint(text: string) {
        EditorModel.hover_hint = text;
    }
    function clear_hint(text: string) {
        if EditorModel.hover_hint == text {
            EditorModel.hover_hint = "";
        }
    }

    property <bool> has_selection: EditorModel.selected_tier_index >= 0;

    TouchArea {
        width: add_tier_btn.preferred-width;
        height: add_tier_btn.preferred-height;
        changed has-hover => { if self.has-hover { root.set_hint("Open the Tier tab in Add mode to author a new tier."); } else { root.clear_hint("Open the Tier tab in Add mode to author a new tier."); } }
        add_tier_btn := Button {
            text: "+ Add Tier";
            accessible-description: "Open the Tier tab to write a new tier: its angle, what it meets and its index positions.";
            enabled: GuideModel.allows_tier_form();
            clicked => {
                EditorModel.selected_tier_index = -1;
                EditorModel.inspector_tab = 0;
                EditorModel.inspector_collapsed = false;
            }
        }
        GuideLockTip { locked: !GuideModel.allows_tier_form(); }
    }
    // Concave tiers are an advanced feature: the Simple interface leaves the button out (the
    // Tier tab still opens a concave tier that is already in the design).
    if GuideModel.shows_advanced(): TouchArea {
        width: add_concave_btn.preferred-width;
        height: add_concave_btn.preferred-height;
        changed has-hover => { if self.has-hover { root.set_hint("Open the Tier tab to write a concave tier: a curved facet cut with a rounded tool instead of a flat lap."); } else { root.clear_hint("Open the Tier tab to write a concave tier: a curved facet cut with a rounded tool instead of a flat lap."); } }
        add_concave_btn := Button {
            text: "+ Concave";
            accessible-description: "Open the Tier tab to write a concave tier: a curved facet cut with a rounded tool instead of a flat lap.";
            enabled: GuideModel.allows_concave_tier();
            clicked => { EditorModel.add_concave_tier(); }
        }
        GuideLockTip { locked: !GuideModel.allows_concave_tier(); }
    }
    TouchArea {
        width: duplicate_tier_btn.preferred-width;
        height: duplicate_tier_btn.preferred-height;
        changed has-hover => { if self.has-hover { root.set_hint("Duplicate the selected tier, inserted right after it (Ctrl+D)."); } else { root.clear_hint("Duplicate the selected tier, inserted right after it (Ctrl+D)."); } }
        duplicate_tier_btn := Button {
            text: "Duplicate";
            accessible-description: "Copy the selected tier and insert the copy right after it. Select a tier first.";
            enabled: root.has_selection && GuideModel.allows_tier_table();
            clicked => { EditorModel.duplicate_tier(EditorModel.selected_tier_index); }
        }
        GuideLockTip { locked: !GuideModel.allows_tier_table(); }
    }
    TouchArea {
        width: delete_tier_btn.preferred-width;
        height: delete_tier_btn.preferred-height;
        changed has-hover => { if self.has-hover { root.set_hint("Remove the selected tier (Delete)."); } else { root.clear_hint("Remove the selected tier (Delete)."); } }
        delete_tier_btn := Button {
            text: "Delete";
            accessible-description: "Remove the selected tier from the design. You can undo it. Select a tier first.";
            enabled: root.has_selection && GuideModel.allows_tier_table();
            clicked => { EditorModel.remove_tier(EditorModel.selected_tier_index); }
        }
        GuideLockTip { locked: !GuideModel.allows_tier_table(); }
    }
    TouchArea {
        width: move_up_btn.preferred-width;
        height: move_up_btn.preferred-height;
        changed has-hover => { if self.has-hover { root.set_hint("Move the selected tier earlier in cutting order (Alt+Up)."); } else { root.clear_hint("Move the selected tier earlier in cutting order (Alt+Up)."); } }
        move_up_btn := Button {
            // Icon-only; the hover hint above says what it does.
            icon: @image-url("../icons/chevron-up.svg");
            colorize-icon: true;
            accessible-label: "Move tier up";
            accessible-description: "Move the selected tier earlier in the cutting order. Select a tier first.";
            enabled: root.has_selection && GuideModel.allows_tier_table();
            clicked => { EditorModel.move_tier(EditorModel.selected_tier_index, -1); }
        }
        GuideLockTip { locked: !GuideModel.allows_tier_table(); }
    }
    TouchArea {
        width: move_down_btn.preferred-width;
        height: move_down_btn.preferred-height;
        changed has-hover => { if self.has-hover { root.set_hint("Move the selected tier later in cutting order (Alt+Down)."); } else { root.clear_hint("Move the selected tier later in cutting order (Alt+Down)."); } }
        move_down_btn := Button {
            // Icon-only; the hover hint above says what it does.
            icon: @image-url("../icons/chevron-down.svg");
            colorize-icon: true;
            accessible-label: "Move tier down";
            accessible-description: "Move the selected tier later in the cutting order. Select a tier first.";
            enabled: root.has_selection && GuideModel.allows_tier_table();
            clicked => { EditorModel.move_tier(EditorModel.selected_tier_index, 1); }
        }
        GuideLockTip { locked: !GuideModel.allows_tier_table(); }
    }
}

// Deep Solve / Optimize / Retarget -- the slower analyses, on the command bar's
// second row (see `EditorCommandBar` below).
component AnalysisGroup inherits HorizontalLayout {
    height: 34px;
    spacing: 6px;

    function set_hint(text: string) {
        EditorModel.hover_hint = text;
    }
    function clear_hint(text: string) {
        if EditorModel.hover_hint == text {
            EditorModel.hover_hint = "";
        }
    }

    // A purely local latch so a second click on "Cancel Optimize" while a cancel
    // is already in flight cannot re-fire `EditorModel.optimize_cancel()`.
    // Mirrors `EditorModel.optimize_running` in a local property purely so a
    // `changed` handler can watch it (`self.foo`, not `EditorModel.foo`, is what
    // `changed` can rely on here); reset the moment a run stops being active,
    // which covers both this run's completion AND the state a new run starts in.
    property <bool> optimize_running_mirror: EditorModel.optimize_running;
    property <bool> optimize_cancel_requested: false;
    changed optimize_running_mirror => {
        if !self.optimize_running_mirror {
            self.optimize_cancel_requested = false;
        }
    }

    // Appended to each button's own tooltip/hint text below whenever some OTHER
    // action (not `own_action`) is the reason it is currently disabled --
    // `EditorModel.busy_action` names Solve, Deep Solve or Optimize, so this is
    // "" whenever nothing is running or `own_action` itself is the one running
    // (that case already has its own "Cancel ..." button/text, nothing more to
    // explain). A named function rather than an inline ternary: `@markdown`'s
    // dynamic text must be a plain expression, never a nested ternary -- see
    // the two `Tooltip`s below.
    function busy_suffix(own_action: string) -> string {
        return (EditorModel.busy_action != "" && EditorModel.busy_action != own_action)
            ? ("\n\nDisabled while " + EditorModel.busy_action + " is running.")
            : "";
    }

    // A separate, slower, externally-verified action from "Solve".
    // Disabled (with the reason surfaced in `EditorStatusStrip`'s log)
    // rather than hidden, so a design with nothing to verify against reads
    // as "not applicable right now," not "missing."
    // Advanced: the Simple interface leaves it out (a running Deep Solve keeps its Cancel button).
    if !EditorModel.deep_solve_running && GuideModel.shows_advanced(): TouchArea {
        width: deep_solve_btn.preferred-width;
        height: deep_solve_btn.preferred-height;
        changed has-hover => { if self.has-hover { root.set_hint("Deep Solve: a slow check of the solved stone against the proportions printed for this design. It never changes the design. See the glossary."); } else { root.clear_hint("Deep Solve: a slow check of the solved stone against the proportions printed for this design. It never changes the design. See the glossary."); } }
        // The always-present explanation of why Deep Solve is (or isn't) available
        // right now (`view::deep_solve_hint`) lives here, on hover, rather than
        // in `EditorStatusStrip`, so it never occupies that strip's one message
        // slot ahead of the design's own solved/stale/failed state. Also names
        // Solve/Optimize as the reason when either is the one keeping this button
        // disabled. A plain property -- see `busy_suffix`'s own doc comment for
        // why this can't be inlined into the `@markdown` below.
        property <string> deep_solve_tooltip_text: GuideModel.allows_advanced() ? EditorModel.deep_solve_hint + root.busy_suffix("Deep Solve") : GuideModel.locked_hint;
        Tooltip { text: @markdown("\{deep_solve_tooltip_text}"); }
        deep_solve_btn := Button {
            text: "Deep Solve";
            accessible-description: parent.deep_solve_tooltip_text;
            // Cross-disabled on `busy_action`, not only `deep_solve_available`
            // -- see the Solve button's own doc comment on `busy_action`.
            enabled: EditorModel.deep_solve_available && EditorModel.busy_action == "" && GuideModel.allows_advanced();
            clicked => { EditorModel.deep_solve(); }
        }
        // The guide's Deep Solve lesson outlines this button.
        if GuideModel.highlight_target == "deep_solve_button": Rectangle {
            border-width: 2px;
            border-color: Theme.accent-cyan;
            border-radius: Theme.radius-sm;
        }
    }
    if EditorModel.deep_solve_running: Button {
        text: "Cancel Deep Solve";
        accessible-description: "Stop the running Deep Solve. The design is not changed.";
        clicked => { EditorModel.deep_solve_cancel(); }
    }

    // Same disabled-with-a-hint treatment as Deep Solve, except genuinely
    // DISABLED when there is nothing free to move.
    if !EditorModel.optimize_running: TouchArea {
        width: optimize_btn.preferred-width;
        height: optimize_btn.preferred-height;
        changed has-hover => { if self.has-hover { root.set_hint("Optimize: search the angles of the tiers that are free to move for a brighter stone, then preview the best results before applying one. See the glossary."); } else { root.clear_hint("Optimize: search the angles of the tiers that are free to move for a brighter stone, then preview the best results before applying one. See the glossary."); } }
        // Same reasoning as the Deep Solve button's own `Tooltip` above --
        // `view::optimize_hint`'s always-present explanation lives here instead of
        // permanently occupying a shared status line; see the Deep Solve button's
        // own `deep_solve_tooltip_text` doc comment.
        property <string> optimize_tooltip_text: GuideModel.allows_advanced() ? EditorModel.optimize_hint + root.busy_suffix("Optimize") : GuideModel.locked_hint;
        Tooltip { text: @markdown("\{optimize_tooltip_text}"); }
        optimize_btn := Button {
            text: "Optimize";
            accessible-description: parent.optimize_tooltip_text;
            // See the Deep Solve button's own comment above.
            enabled: EditorModel.optimize_available && EditorModel.busy_action == "" && GuideModel.allows_advanced();
            clicked => {
                EditorModel.optimize(EditorModel.optimize_weight_windowing, EditorModel.optimize_weight_extinction, EditorModel.optimize_weight_tilt_brilliance, EditorModel.optimize_weight_yield, EditorModel.optimize_weight_tone);
            }
        }
    }
    // Labelled "Cancelling..." and disabled the instant it's clicked (see
    // `optimize_cancel_requested` above): `optimize_status` takes several
    // seconds to read back "Cancelling -- finishing the current evaluation...",
    // and a cutter who sees no reaction clicks again.
    if EditorModel.optimize_running: Button {
        text: root.optimize_cancel_requested ? "Cancelling..." : "Cancel Optimize";
        accessible-description: "Stop the running search. It finishes the step it is on first.";
        enabled: !root.optimize_cancel_requested;
        clicked => {
            root.optimize_cancel_requested = true;
            EditorModel.optimize_cancel();
        }
    }

    // Proposes new facet angles for a different material, reviewed in a
    // modal dialog before anything is applied.
    TouchArea {
        width: retarget_btn.preferred-width;
        height: retarget_btn.preferred-height;
        changed has-hover => { if self.has-hover { root.set_hint("Retarget: propose new facet angles so the design works in a different material, and review them before anything changes. See the glossary."); } else { root.clear_hint("Retarget: propose new facet angles so the design works in a different material, and review them before anything changes. See the glossary."); } }
        retarget_btn := Button {
            text: "Retarget...";
            accessible-description: "Propose new facet angles so the design works in a different material. You review them before anything changes.";
            enabled: GuideModel.allows_advanced();
            clicked => { RetargetModel.open(); }
        }
        // The guide's Retarget lessons outline this button.
        if GuideModel.highlight_target == "retarget_button": Rectangle {
            border-width: 2px;
            border-color: Theme.accent-cyan;
            border-radius: Theme.radius-sm;
        }
        GuideLockTip { locked: !GuideModel.allows_advanced(); }
    }

    // "Snapshot Design"/"Compare to Snapshot", handled by
    // `callbacks::retarget_actions::setup_snapshot_callbacks`. Placed next to
    // Retarget since both reuse the same comparison-table dialog shell
    // (`retarget_dialog.slint`'s `RetargetModel.compare_open` branch).
    // Snapshot, Compare and Tilt Curves are advanced: the Simple interface leaves them out.
    if GuideModel.shows_advanced(): TouchArea {
        width: snapshot_btn.preferred-width;
        height: snapshot_btn.preferred-height;
        changed has-hover => { if self.has-hover { root.set_hint("Snapshot: keep a copy of the design as it is now, to compare with a later version. The copy lives only in this session and is not saved to disk. See the glossary."); } else { root.clear_hint("Snapshot: keep a copy of the design as it is now, to compare with a later version. The copy lives only in this session and is not saved to disk. See the glossary."); } }
        snapshot_btn := Button {
            text: "Snapshot";
            accessible-description: "Keep a copy of the design as it is now, to compare with a later version. Not saved to disk.";
            enabled: GuideModel.allows_advanced();
            clicked => { EditorModel.snapshot_design(); }
        }
        // The guide's Snapshot lessons outline this button.
        if GuideModel.highlight_target == "snapshot_button": Rectangle {
            border-width: 2px;
            border-color: Theme.accent-cyan;
            border-radius: Theme.radius-sm;
        }
        GuideLockTip { locked: !GuideModel.allows_advanced(); }
    }
    // Gated on a snapshot existing: `EditorModel.has_snapshot` is pushed `true`
    // by `callbacks::retarget_actions::setup_snapshot_callbacks` the moment a
    // snapshot is taken; the hover hint explains the greyed state before that.
    if GuideModel.shows_advanced(): TouchArea {
        width: compare_snapshot_btn.preferred-width;
        height: compare_snapshot_btn.preferred-height;
        changed has-hover => {
            if self.has-hover {
                root.set_hint(EditorModel.has_snapshot
                    ? "Compare the current design with the last snapshot, side by side."
                    : "Compare the current design with the last snapshot. Press Snapshot first: no snapshot has been taken this session.");
            } else {
                root.clear_hint("Compare the current design with the last snapshot, side by side.");
            }
        }
        compare_snapshot_btn := Button {
            text: "Compare";
            accessible-description: EditorModel.has_snapshot
                ? "Compare the current design with the last snapshot, side by side."
                : "Compare the current design with the last snapshot. Not available until you take a snapshot.";
            enabled: EditorModel.has_snapshot && GuideModel.allows_advanced();
            clicked => { EditorModel.compare_to_snapshot(); }
        }
        // The guide's Snapshot and Compare lesson outlines this button.
        if GuideModel.highlight_target == "compare_button": Rectangle {
            border-width: 2px;
            border-color: Theme.accent-cyan;
            border-radius: Theme.radius-sm;
        }
        GuideLockTip { locked: !GuideModel.allows_advanced(); }
    }

    // Runs the full 4-axis tilt-performance sweep for the design currently
    // open in the editor -- see `EditorModel.
    // compute_tilt_curves_for_open_design`'s own doc comment for what happens
    // once it starts (roughly 1.36s, off the UI thread; only saved once this
    // design has already been saved to the catalogue).
    if GuideModel.shows_advanced(): TouchArea {
        width: compute_tilt_btn.preferred-width;
        height: compute_tilt_btn.preferred-height;
        changed has-hover => { if self.has-hover { root.set_hint("Tilt Curves: work out how bright, dark or see-through this stone looks as it is tilted, from table-up to a steep angle. Takes a few seconds. See the glossary."); } else { root.clear_hint("Tilt Curves: work out how bright, dark or see-through this stone looks as it is tilted, from table-up to a steep angle. Takes a few seconds. See the glossary."); } }
        compute_tilt_btn := Button {
            text: "Tilt Curves";
            accessible-description: "Work out how bright, dark or see-through this stone looks as it is tilted. Takes a few seconds.";
            enabled: GuideModel.allows_advanced();
            clicked => { EditorModel.compute_tilt_curves_for_open_design(); }
        }
        GuideLockTip { locked: !GuideModel.allows_advanced(); }
    }

    // Cutting mode (`models/cutting_mode.slint`, `gui::editor::cutting_mode`): the cutting
    // steps one page at a time over the whole window. Dim, with the reason in the hint, while
    // there is nothing to cut (no design, no tiers, a design that does not solve). The same
    // hover-hint and tooltip treatment as Deep Solve above.
    TouchArea {
        width: cut_mode_btn.preferred-width;
        height: cut_mode_btn.preferred-height;
        property <string> cut_mode_hint: CuttingModeModel.unavailable_reason() == ""
            ? "Walk through the cutting steps one page at a time, with done marks that are kept for this design (Edit menu, Cutting Mode...)."
            : CuttingModeModel.unavailable_reason();
        property <string> cut_mode_tooltip_text: GuideModel.allows_advanced() ? self.cut_mode_hint : GuideModel.locked_hint;
        changed has-hover => { if self.has-hover { root.set_hint(self.cut_mode_tooltip_text); } else { root.clear_hint(self.cut_mode_tooltip_text); } }
        Tooltip { text: @markdown("\{cut_mode_tooltip_text}"); }
        cut_mode_btn := Button {
            text: "Cut Mode";
            accessible-description: parent.cut_mode_tooltip_text;
            enabled: GuideModel.allows_advanced() && !CuttingModeModel.open && CuttingModeModel.unavailable_reason() == "";
            clicked => { CuttingModeModel.open_cutting_mode(); }
        }
        // The cutting-mode tutorial outlines this button.
        if GuideModel.highlight_target == "cutting_mode_button": Rectangle {
            border-width: 2px;
            border-color: Theme.accent-cyan;
            border-radius: Theme.radius-sm;
        }
    }
}

// Export Edited .asc / Save / Open -- see `NewLoadUndoRedoGroup`'s
// own doc comment above for why these travel together as one sub-component.
component FileActionsGroup inherits HorizontalLayout {
    height: 34px;
    spacing: 8px;

    function set_hint(text: string) {
        EditorModel.hover_hint = text;
    }
    function clear_hint(text: string) {
        if EditorModel.hover_hint == text {
            EditorModel.hover_hint = "";
        }
    }

    // "Save" writes the self-contained `.indicatrix` design file: the whole design
    // lives in that one file and nothing is written beside it. "Export Edited .asc" exports the design AS EDITED in this tab,
    // distinct from `detail_header.slint`'s catalogue-original "Export .asc"
    // (see that file's own doc comment); the label names the `.asc` in full to
    // match `app.slint`'s File-menu entry for the identical action and the
    // manual's description.
    TouchArea {
        width: export_btn.preferred-width;
        height: export_btn.preferred-height;
        // "...to disk; your library is not updated": Export Edited never
        // registers anything in, or changes anything about, the catalogue --
        // the mirror image of `detail_header.slint`'s own catalogue-side
        // "Save the original file... not your edits" warning.
        changed has-hover => { if self.has-hover { root.set_hint("Export the design as edited in this tab to disk; your library is not updated."); } else { root.clear_hint("Export the design as edited in this tab to disk; your library is not updated."); } }
        export_btn := Button {
            text: "Export .asc";
            accessible-description: "Write the design as edited in this tab to an .asc file on disk. Your library is not updated.";
            enabled: GuideModel.allows_file_ops();
            clicked => { EditorModel.export_asc(); }
        }
        // The output and library tutorials outline this button.
        if GuideModel.highlight_target == "export_asc_button": Rectangle {
            border-width: 2px;
            border-color: Theme.accent-cyan;
            border-radius: Theme.radius-sm;
        }
        GuideLockTip { locked: !GuideModel.allows_file_ops(); }
    }
    TouchArea {
        width: save_native_btn.preferred-width;
        height: save_native_btn.preferred-height;
        // Unlike "Export Edited .asc" above, Save DOES update your
        // library -- it writes or updates this design's own catalogue row
        // (`native_io::write_back_to_catalogue`), not just the files on disk,
        // and the hint must say so.
        changed has-hover => { if self.has-hover { root.set_hint("Save the whole design to its .indicatrix file, and update this design's catalogue entry."); } else { root.clear_hint("Save the whole design to its .indicatrix file, and update this design's catalogue entry."); } }
        save_native_btn := Button {
            text: "Save";
            accessible-description: "Save the whole design to its .indicatrix file and update this design's library entry (Ctrl+S).";
            enabled: GuideModel.allows_file_ops();
            clicked => { EditorModel.save_native(); }
        }
        // The Save and Open tutorials outline this button.
        if GuideModel.highlight_target == "save_button": Rectangle {
            border-width: 2px;
            border-color: Theme.accent-cyan;
            border-radius: Theme.radius-sm;
        }
        GuideLockTip { locked: !GuideModel.allows_file_ops(); }
    }
    // Makes the "not a closed solid" (or any other solve-problem) verdict
    // visible IN the save area itself, small and non-blocking, rather than only
    // as a Yes/No prompt the cutter sees for the first time at the exact moment
    // they click Save. `EditorModel.status_is_problem` is the same flag
    // `EditorStatusStrip` colors ruby for -- this does not duplicate the
    // strip's own message, only flags that clicking Save/Export will ask for
    // confirmation.
    if EditorModel.status_is_problem && EditorModel.status_text != "": Rectangle {
        width: save_warning_text.preferred-width;
        height: 34px;
        accessible-role: AccessibleRole.text;
        accessible-label: "Will ask before saving";
        accessible-description: EditorModel.status_text + ". Saving or exporting still works, but you are asked to confirm first.";
        save_warning_text := WarningLine {
            text: "Will ask before saving";
            font_weight: 600;
            wrap_text: false;
            centered: true;
        }
        Tooltip { text: @markdown("**\{EditorModel.status_text}**\n\nSaving or exporting will still work -- you'll be asked to confirm first (\"Save as draft\"), and the written file notes this in its own header."); }
    }
    // "Export..." split button: the single home of the cutting-sheet (HTML) and
    // diagram (PNG) exports, so the File menu does not need entries for them.
    ExportSplitButton { enabled: GuideModel.allows_file_ops(); }
    TouchArea {
        width: open_native_btn.preferred-width;
        height: open_native_btn.preferred-height;
        changed has-hover => { if self.has-hover { root.set_hint("Open a .indicatrix design file, or a .asc, .gem or .gcs file."); } else { root.clear_hint("Open a .indicatrix design file, or a .asc, .gem or .gcs file."); } }
        open_native_btn := Button {
            text: "Open";
            accessible-description: "Open a .indicatrix design file, or an .asc, .gem or .gcs file (Ctrl+O).";
            enabled: GuideModel.allows_file_ops();
            clicked => { EditorModel.open_native(); }
        }
        // The Open tutorial outlines this button.
        if GuideModel.highlight_target == "open_button": Rectangle {
            border-width: 2px;
            border-color: Theme.accent-cyan;
            border-radius: Theme.radius-sm;
        }
        GuideLockTip { locked: !GuideModel.allows_file_ops(); }
    }
}

// The Edit sub-tab's command bar, three or four fixed rows sized for the dock's
// 600-1000px clamp (`app.slint`'s `dock_width` clamp; content is at most 976px):
// row 1 is always the editing group (New Design.../Load Selected/Undo/Redo) plus
// Solve and its auto-solve budget. Then, in a wide dock, one row with
// [Tier | divider | FileActions] (Add/Duplicate/Delete/Move plus the file
// actions); in a narrow dock (`narrow_dock`, below 930px) [Tier] and
// [FileActions] each take their own row. The last row is always [Analysis] (the
// slower analyses: Deep Solve/Optimize/Retarget/Snapshot/Compare/Tilt Curves),
// mounted once outside any `if`. Each row ends in a
// stretch spacer so a wider dock leaves the buttons left-aligned instead of
// spreading them. (`FlexboxLayout`, which would wrap automatically, is not
// enabled in this Slint build.)
//
// No caption text lives under any one button: hovering any control in any
// group sets `EditorModel.hover_hint`, shown as a single line below the row(s)
// instead -- see `hover_hint`'s own doc comment on `EditorModel`.
//
// The auto-solve combo (`SolveGroup`) shrinks below a narrow dock, keyed off
// `EditorModel.dock_width` -- a value set externally (the drag handle in
// `app.slint`), never derived from this bar's own content, so reading it here
// carries none of the "one fixed dimension pins the whole window" risk a width
// derived from THIS layout pass would. Reading `self.width` on this component
// and feeding it back into a child's `width` is a
// `layoutinfo-h -> layout-cache -> width -> ... -> narrow` binding loop the
// `.slint` compiler rejects outright.
export component EditorCommandBar inherits Rectangle {
    // Keyed off `EditorModel.dock_width` (external), never this bar's own width.
    property <bool> narrow_dock: EditorModel.dock_width < 930px;

    VerticalLayout {
        spacing: 2px;

        HorizontalLayout {
            height: 34px;
            spacing: 8px;
            NewLoadUndoRedoGroup {}
            Rectangle { width: 1px; background: Theme.border-subtle; }
            SolveGroup {}
            Rectangle { horizontal-stretch: 1; }
        }
        // Wide dock: tier group | file actions share one row.
        if !root.narrow_dock: HorizontalLayout {
            height: 34px;
            spacing: 8px;
            TierGroup {}
            Rectangle { width: 1px; background: Theme.border-subtle; }
            FileActionsGroup {}
            Rectangle { horizontal-stretch: 1; }
        }
        // Narrow dock: tier group and file actions each on their own row.
        if root.narrow_dock: HorizontalLayout {
            height: 34px;
            spacing: 8px;
            TierGroup {}
            Rectangle { horizontal-stretch: 1; }
        }
        if root.narrow_dock: HorizontalLayout {
            height: 34px;
            spacing: 8px;
            FileActionsGroup {}
            Rectangle { horizontal-stretch: 1; }
        }
        // Analyses: mounted once, outside any `if`, so AnalysisGroup's local
        // `optimize_cancel_requested` latch survives the dock crossing the breakpoint.
        HorizontalLayout {
            height: 34px;
            spacing: 8px;
            AnalysisGroup { }
            Rectangle { horizontal-stretch: 1; }
        }

        // Wraps instead of eliding a single line, so a long hint ("After an
        // edit, automatically re-solve (debounced)...") reads in full instead
        // of teaching nothing past the cutoff. Capped at two lines' worth of
        // height so a very long hint still cannot push the tier table below it
        // around -- `overflow: clip` on the rare hint long enough to need a
        // third line, rather than `elide`, which only ever elides a single line
        // and would leave the wrapped second line's tail truncated mid-word.
        // The "?" sits at the right end of this line, so it takes no room from the buttons above.
        HorizontalLayout {
            height: 28px;
            spacing: 6px;
            Text {
                horizontal-stretch: 1;
                text: EditorModel.hover_hint;
                font-size: 11px;
                color: Theme.text-muted;
                wrap: word-wrap;
                overflow: clip;
                // The hint is a tooltip for the buttons (they are plain buttons, which have none
                // of their own); a screen reader gets the same words from each button's
                // description, so this line is not read twice.
                accessible-role: AccessibleRole.none;
            }
            VerticalLayout {
                alignment: start;
                padding-top: 2px;
                HelpButton {
                    topic: HelpTopics.command-bar;
                    hint: "Open the manual page on the command bar";
                }
            }
        }
    }
}
