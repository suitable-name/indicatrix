import { Theme } from "../theme.slint";
import { EditorModel } from "../models/editor.slint";
import { GuideModel } from "../models/guide.slint";
import { UndoRedoGroup, SolveGroup } from "editor_command_bar/edit_groups.slint";
import { AnalysisGroup, SnapshotGroup } from "editor_command_bar/analysis_groups.slint";
import { FileMenu } from "editor_command_bar/file_menu.slint";
// The "?" at the right end of the hint line opens the manual page on this bar.
import { HelpButton } from "help_button.slint";
import { HelpTopics } from "../models/help.slint";

// `ui/app.slint`'s Edit menu imports `UndoRedoLabels` from this file; it is declared with
// the Undo/Redo group that shows the same text.
export { UndoRedoLabels } from "editor_command_bar/edit_groups.slint";

// `EditorModel.solve_state` (not `status_is_problem`) is the signal the Solve button
// (`SolveGroup`) and `EditorStatusStrip`'s persistent state segment key off:
// `status_is_problem` is set `true` by every edit's stale-marker refresh and cannot tell
// "needs a Solve" apart from "solved, but genuinely failed". `solve_state`/
// `last_solve_duration_ms` are pushed from `gui/editor/view.rs` and
// `gui/editor/auto_solve.rs`.

// The Edit sub-tab's command bar: ONE grouped row,
//
//   [Undo][Redo] | [Solve][Auto-Solve][Deep Solve] | [Retarget...][Tilt Curves][Cut Mode]
//                | [Snapshot][Compare] |                                       [File v]
//
// Everything the tier table (+ Add Tier / + Add Concave Tier, Duplicate, Delete, Move
// Up/Down per row) or the inspector (the Optimize tab's own Run and Cancel) already offers
// is deliberately NOT repeated here. Each group is its own component, so the two
// arrangements below share every button's hover/TouchArea/callback wiring.
//
// Wide dock (`EditorModel.dock_width` of `wide_dock` or more): one row. Narrower: two rows,
// [Undo/Redo | Solve group ... File] over [Retarget group | Snapshot group]. The dock is
// clamped to 600-1000px (`app.slint`), so there is no horizontal overflow at either end;
// `FlexboxLayout`, which would wrap by itself, is not enabled in this Slint build.
//
// No caption text lives under any one button: hovering any control sets
// `EditorModel.hover_hint`, shown as a single line below the row(s) -- see `hover_hint`'s
// own doc comment on `EditorModel`.
//
// The wide/narrow choice and the auto-solve combo's width are keyed off
// `EditorModel.dock_width`, a value set externally (the drag handle in `app.slint`), never
// off this bar's own width: reading `self.width` and feeding it back into a child's `width`
// is a `layoutinfo-h -> layout-cache -> width -> ... -> narrow` binding loop the `.slint`
// compiler rejects.
export component EditorCommandBar inherits Rectangle {
    // Keyed off `EditorModel.dock_width` (external), never this bar's own width.
    property <bool> wide_dock: EditorModel.dock_width >= 990px;

    VerticalLayout {
        spacing: 2px;

        // Wide dock: everything on one row.
        if root.wide_dock: HorizontalLayout {
            height: 34px;
            spacing: 8px;
            UndoRedoGroup {}
            Rectangle { width: 1px; background: Theme.border-subtle; }
            SolveGroup {}
            Rectangle { width: 1px; background: Theme.border-subtle; }
            AnalysisGroup {}
            if GuideModel.shows_advanced(): Rectangle { width: 1px; background: Theme.border-subtle; }
            SnapshotGroup {}
            Rectangle { horizontal-stretch: 1; }
            FileMenu {}
        }
        // Narrower dock: editing and solving with the File menu at the right end ...
        if !root.wide_dock: HorizontalLayout {
            height: 34px;
            spacing: 8px;
            UndoRedoGroup {}
            Rectangle { width: 1px; background: Theme.border-subtle; }
            SolveGroup {}
            Rectangle { horizontal-stretch: 1; }
            FileMenu {}
        }
        // ... and the design actions on a second row.
        if !root.wide_dock: HorizontalLayout {
            height: 34px;
            spacing: 8px;
            AnalysisGroup {}
            if GuideModel.shows_advanced(): Rectangle { width: 1px; background: Theme.border-subtle; }
            SnapshotGroup {}
            Rectangle { horizontal-stretch: 1; }
        }

        // Wraps instead of eliding a single line, so a long hint reads in full. Capped at
        // two lines' worth of height so a very long hint cannot push the tier table below
        // it around -- `overflow: clip` on the rare hint long enough to need a third line.
        // The "?" sits at the right end of this line, so it takes no room from the buttons.
        HorizontalLayout {
            height: 28px;
            spacing: 6px;
            Text {
                horizontal-stretch: 1;
                text: EditorModel.hover_hint;
                font-size: 11px;
                color: Theme.text-muted;
                wrap: word-wrap;
                overflow: clip;
                // The hint is a tooltip for the buttons (they are plain buttons, which have none
                // of their own); a screen reader gets the same words from each button's
                // description, so this line is not read twice.
                accessible-role: AccessibleRole.none;
            }
            VerticalLayout {
                alignment: start;
                padding-top: 2px;
                HelpButton {
                    topic: HelpTopics.command-bar;
                    hint: "Open the manual page on the command bar";
                }
            }
        }
    }
}
