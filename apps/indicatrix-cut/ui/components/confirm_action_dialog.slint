import { CheckBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { IconButton } from "icon_button.slint";
import { TipButton } from "compact_controls.slint";
import { TipBox } from "tip_box.slint";

// A generic modal Save/Discard/Cancel-shaped confirmation, reused by every
// destructive-action guard this app needs a blocking choice for -- the
// unsaved-changes guard in front of New/Load Selected/Open
// (`EditorModel.unsaved_dialog_*`) and Close (`MainWindow.close_confirm_*`), and the
// native-load fingerprint-mismatch choice (`EditorModel.mismatch_dialog_*`). Deliberately
// bound to NOTHING but its own properties/callbacks -- not `EditorModel` or any other
// global -- so every call site can drive it from whichever model actually owns that
// particular decision, without this component needing to know which one that is.
//
// Full-viewport backdrop + centered content-sized card, the same modal idiom
// `metadata_editor_dialog.slint`/`material_editor_dialog.slint` already use. Clicking
// the backdrop counts as Cancel -- these are all "stop and ask" dialogs a stray click
// outside them should never silently escalate into the destructive option.
//
// `primary_label`/`secondary_label` empty ("") hides that button entirely -- the
// fingerprint-mismatch dialog uses this to withhold "Apply Anyway" when the native
// file's own tier count no longer agrees with the freshly imported `.asc` (see
// `EditorModel.mismatch_dialog_can_apply`'s own doc comment).
export component ConfirmActionDialog inherits Rectangle {
    in property <string> heading: "Unsaved Changes";
    in property <string> message: "";
    in property <string> primary_label: "Save";
    in property <string> secondary_label: "Discard";
    // A third, optional action alongside primary/secondary -- "" (the default)
    // hides it entirely, same convention as `secondary_label`/`primary_label`
    // above. Every existing call site (the unsaved-changes/close/fingerprint-
    // mismatch guards) leaves this at "", so adding it here does not change
    // their own layout at all; the startup-restore prompt's "Delete" action
    // (only ever shown for a leftover autosave, never an ordinary recent file)
    // is the first caller.
    in property <string> tertiary_label: "";
    // What each button does, in one plain sentence (the tooltip, read after the label by a
    // screen reader). Empty: "Choose <label>." A call site that knows better says so.
    in property <string> primary_hint: "";
    in property <string> secondary_hint: "";
    in property <string> tertiary_hint: "";
    // An optional "Don't ask
    // again" checkbox for a confirmation the cutter may want to silence once
    // they've seen it -- hidden (`false`, the default) for dialogs like the
    // unsaved-changes/fingerprint-mismatch guards above, where the decision is
    // genuinely different every time and suppressing it would risk real data
    // loss. `dont_ask` reflects the checkbox's OWN on-screen state at the moment
    // `primary`/`secondary` fires (never for `cancel`, which the caller should
    // treat as "asked nothing, decided nothing") -- the caller decides what
    // persisting it means (`gui::editor::native_io`'s `write_confirm_*` call
    // sites are the first to use this).
    in property <bool> show_dont_ask: false;
    // `in-out`, not `out`: the checkbox below sets it internally (`checked <=>
    // root.dont_ask`), and a caller that wants to read it back after the dialog
    // closes needs a two-way `<=>` binding at its own mount site (`app.slint`'s
    // `write_confirm_open` mount), which Slint refuses on a plain `out` property.
    in-out property <bool> dont_ask: false;

    callback primary();
    callback secondary();
    callback cancel();
    callback tertiary();

    background: Theme.overlay-backdrop;

    // Takes focus the moment this dialog is mounted so Escape/
    // Return work without a prior click, and -- since every key not explicitly
    // handled below is still swallowed (`return accept`) -- so `app.slint`'s global
    // shortcuts (Ctrl+S/Z/Y/F5/...) cannot fire on the design underneath while this
    // is the modal on screen. `Key.Tab` is deliberately let through unhandled
    // (`return reject`) so the window's own built-in Tab/Shift+Tab focus-cycling
    // (there is nothing else in this dialog to Tab between besides its buttons)
    // still works -- swallowing it here would silently break that.
    FocusScope {
        width: 100%;
        height: 100%;
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancel();
            } else if event.text == Key.Return && root.primary_label != "" {
                root.primary();
            } else if event.text == Key.Tab {
                return reject;
            }
            return accept;
        }

        TouchArea {
            clicked => { root.cancel(); }
        }

        Rectangle {
            width: 420px;
            height: content.preferred-height;
            background: Theme.surface-dialog;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border-dialog;
            drop-shadow-blur: 24px;
            drop-shadow-color: Theme.modal-shadow;
            clip: true;

            // Swallows clicks so they never fall through to the backdrop's TouchArea
            // above (same idiom `metadata_editor_dialog.slint` uses for its own card).
            TouchArea {}

            content := VerticalLayout {
                padding: 16px;
                spacing: 12px;

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: root.heading;
                        font-size: 14px;
                        font-weight: 700;
                        color: Theme.text-primary;
                        accessible-role: AccessibleRole.text;
                    }
                    IconButton {
                        icon: @image-url("../icons/close.svg");
                        hint: "Close this question and change nothing";
                        width: 26px;
                        height: 26px;
                        clicked => { root.cancel(); }
                    }
                }

                Text {
                    text: root.message;
                    font-size: 12px;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                    accessible-role: AccessibleRole.text;
                }

                if root.show_dont_ask: TipBox {
                    hint: "Tick to stop asking this question. Your answer is remembered.";
                    CheckBox {
                        text: "Don't ask again";
                        checked <=> root.dont_ask;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    if root.tertiary_label != "": TipButton {
                        text: root.tertiary_label;
                        hint: root.tertiary_hint != "" ? root.tertiary_hint : "Choose \"" + root.tertiary_label + "\".";
                        clicked => { root.tertiary(); }
                    }
                    TipButton {
                        text: "Cancel";
                        hint: "Close this question and change nothing.";
                        clicked => { root.cancel(); }
                    }
                    if root.secondary_label != "": TipButton {
                        text: root.secondary_label;
                        hint: root.secondary_hint != "" ? root.secondary_hint : "Choose \"" + root.secondary_label + "\".";
                        clicked => { root.secondary(); }
                    }
                    if root.primary_label != "": TipButton {
                        text: root.primary_label;
                        hint: root.primary_hint != "" ? root.primary_hint : "Choose \"" + root.primary_label + "\". Enter does the same.";
                        primary: true;
                        clicked => { root.primary(); }
                    }
                }
            }
        }
    }
}
