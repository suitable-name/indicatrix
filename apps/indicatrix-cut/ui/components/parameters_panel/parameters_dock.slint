import { Theme } from "../../theme.slint";
import { ParametersModel } from "../../models/parameters.slint";
import { IconButton } from "../icon_button.slint";
import { ParametersPanel } from "parameters_panel.slint";

// The width of the open Parameters panel, and of the thin rail it folds into. `app.slint` reads
// them to keep the Edit view's inspector dock and viewport clear of the panel.
export global ParametersDockMetrics {
    out property <length> open_width: 360px;
    out property <length> rail_width: 40px;
}

// The folded-away Parameters dock: a thin rail with one button per tab. A press shows that tab
// and expands the panel (`ParametersModel.show_tab`). Same look as the library's collapsed rail.
component ParametersRail inherits Rectangle {
    background: Theme.bg-card;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-subtle;

    VerticalLayout {
        padding-top: 10px;
        // `start`, not the default `stretch`: a stretch layout's maximum height is the sum of its
        // children's, so these three buttons would otherwise cap the whole row at their height
        // -- see `app.slint`'s "Sizing notes".
        alignment: start;
        spacing: 6px;

        HorizontalLayout {
            alignment: center;
            IconButton {
                width: 28px;
                height: 28px;
                icon: @image-url("../../icons/gem.svg");
                glyph: 14px;
                hint: "Show the stone properties";
                hover_fill: Theme.bg-elevated;
                clicked => { ParametersModel.show_tab(0); }
            }
        }
        HorizontalLayout {
            alignment: center;
            IconButton {
                width: 28px;
                height: 28px;
                icon: @image-url("../../icons/lightbulb.svg");
                glyph: 14px;
                hint: "Show the lighting and environment";
                hover_fill: Theme.bg-elevated;
                clicked => { ParametersModel.show_tab(1); }
            }
        }
        HorizontalLayout {
            alignment: center;
            IconButton {
                width: 28px;
                height: 28px;
                icon: @image-url("../../icons/gear.svg");
                glyph: 14px;
                hint: "Show the render and output settings";
                hover_fill: Theme.bg-elevated;
                clicked => { ParametersModel.show_tab(2); }
            }
        }
    }
}

// The Parameters dock beside a viewport: the full panel while `ParametersModel.open`, otherwise
// the thin rail. It has a fixed width either way (no animation: a width change re-lays the
// viewport, which would re-render it every frame). Sits to the right of the Live Render
// viewport, and to the right of the Edit view's inspector dock.
//
// Its children are all sized explicitly (`100%`), so no layout constraint of the panel reaches
// the row it sits in -- see `app.slint`'s "Sizing notes".
export component ParametersDock inherits Rectangle {
    horizontal-stretch: 0;
    width: ParametersModel.open ? ParametersDockMetrics.open_width : ParametersDockMetrics.rail_width;

    if ParametersModel.open: ParametersPanel {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
    }
    if !ParametersModel.open: ParametersRail {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
    }
}
