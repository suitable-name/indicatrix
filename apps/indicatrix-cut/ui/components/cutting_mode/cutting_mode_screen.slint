import { ScrollView } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { CuttingModeModel } from "../../models/cutting_mode.slint";
import { SolidPreviewModel } from "../../models/solid_preview.slint";
import { HelpTopics } from "../../models/help.slint";
import { HelpButton } from "../help_button.slint";
import { CmButton } from "cm_button.slint";
import { CmChips } from "index_chips.slint";
import { CmIndexWheel } from "index_wheel.slint";

// A heading over a value: one line of the step's details (the meet, the depth, the tool...).
component CmFact inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <color> ink: Theme.text-primary;
    spacing: 2px;

    Text {
        text: root.label;
        font-size: 12px;
        font-weight: 600;
        color: Theme.text-muted;
    }
    Text {
        text: root.value;
        font-size: 18px;
        color: root.ink;
        wrap: word-wrap;
    }
}

// A rounded panel on the page.
component CmCard inherits Rectangle {
    background: Theme.bg-card;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.border-subtle;
}

// A small rounded label (the step's state, its side of the stone).
component CmBadge inherits Rectangle {
    in property <string> text;
    in property <color> ink: Theme.text-primary;
    in property <color> fill: Theme.tint-neutral;

    width: badge_text.preferred-width + 28px;
    height: 32px;
    border-radius: 16px;
    background: root.fill;

    badge_text := Text {
        text: root.text;
        color: root.ink;
        font-size: 15px;
        font-weight: 700;
        vertical-alignment: center;
        x: 14px;
        y: 0px;
        height: root.height;
    }
}

// The step itself: which step and which side of the stone, the code and the angle in large type,
// the indices to tick off, and the meet, depth, cheater offset, tool and note. `avail_w` is the
// width the panel is given; the angle's size follows it so it never runs out of the card.
component CmStepPanel inherits VerticalLayout {
    in property <length> avail_w;
    property <length> angle_size: Math.min(96px, Math.max(36px, (root.avail_w - 150px) / 4.0));
    spacing: 14px;

    HorizontalLayout {
        height: 32px;
        spacing: 12px;
        alignment: start;
        Text {
            text: CuttingModeModel.heading;
            font-size: 18px;
            font-weight: 600;
            color: Theme.text-secondary;
            vertical-alignment: center;
        }
        Rectangle {
            width: side_badge.width;
            horizontal-stretch: 0;
            side_badge := CmBadge {
                y: (parent.height - self.height) / 2;
                text: CuttingModeModel.side_label;
                ink: CuttingModeModel.side_label == "Crown" ? Theme.accent-cyan
                    : CuttingModeModel.side_label == "Pavilion" ? Theme.accent-purple
                    : Theme.text-secondary;
                fill: CuttingModeModel.side_label == "Crown" ? Theme.tint-cyan
                    : CuttingModeModel.side_label == "Pavilion" ? Theme.tint-purple
                    : Theme.tint-neutral;
            }
        }
    }

    // The tier's code and its angle on one line.
    HorizontalLayout {
        spacing: 20px;
        alignment: start;
        Text {
            text: CuttingModeModel.tier_name;
            font-size: 52px;
            font-weight: 700;
            color: Theme.text-primary;
            vertical-alignment: center;
        }
        Text {
            text: CuttingModeModel.angle_text;
            font-size: root.angle_size;
            font-weight: 800;
            color: Theme.accent-cyan;
            vertical-alignment: center;
        }
    }

    if CuttingModeModel.step_state == 2: Rectangle {
        height: changed_note.preferred-height + 24px;
        border-radius: Theme.radius-md;
        background: Theme.surface-warning;
        border-width: 1px;
        border-color: Theme.accent-amber;
        changed_note := Text {
            text: "Changed since you marked it. The cutting values of this step are not the ones you ticked off. Mark it done again once you have cut it as it reads now.";
            font-size: 14px;
            color: Theme.accent-amber;
            wrap: word-wrap;
            x: 12px;
            y: 12px;
            width: parent.width - 24px;
        }
    }

    Text {
        text: "Indices (click one to tick it off)";
        font-size: 13px;
        font-weight: 600;
        color: Theme.text-muted;
    }
    CmChips {
        chips: CuttingModeModel.chips;
        toggled(index) => { CuttingModeModel.chip_clicked(index); }
    }

    // The facts, in two columns. The tier's own name, then what it meets: `Crown Main: Meet P1, P2`.
    HorizontalLayout {
        spacing: 24px;
        VerticalLayout {
            spacing: 12px;
            alignment: start;
            CmFact {
                label: "Instruction";
                value: CuttingModeModel.meet_text;
            }
            if CuttingModeModel.depth_text != "": CmFact {
                label: "Depth";
                value: CuttingModeModel.depth_text;
            }
            if CuttingModeModel.tool_text != "": CmFact {
                label: "Tool";
                value: CuttingModeModel.tool_text;
            }
        }
        if CuttingModeModel.cheater_text != "" || CuttingModeModel.notes_text != "": VerticalLayout {
            spacing: 12px;
            alignment: start;
            if CuttingModeModel.cheater_text != "": CmFact {
                label: "Cheater";
                value: CuttingModeModel.cheater_text;
                ink: Theme.accent-amber;
            }
            if CuttingModeModel.notes_text != "": CmFact {
                label: "Your note";
                value: CuttingModeModel.notes_text;
                ink: Theme.accent-amber;
            }
        }
    }
}

// The whole schedule, one row per step: code, angle, indices and a done tick. The current row is
// highlighted, done rows are dimmed, a click on a row shows that step, and the list scrolls to
// keep the current row in view.
component CmSchedule inherits Rectangle {
    property <length> row_h: 40px;
    property <int> current: CuttingModeModel.step_index;
    property <int> count: CuttingModeModel.schedule.length;

    function reveal() {
        sv.content-y = -Math.min(
            Math.max(0px, (root.current + 0.5) * root.row_h - sv.height / 2),
            Math.max(0px, root.count * root.row_h - sv.height));
    }
    changed current => { root.reveal(); }
    changed count => { root.reveal(); }
    changed height => { root.reveal(); }
    init => { root.reveal(); }

    sv := ScrollView {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        content-width: self.width;
        content-height: root.count * root.row_h;

        for row[i] in CuttingModeModel.schedule: Rectangle {
            x: 0px;
            y: i * root.row_h;
            width: sv.content-width;
            height: root.row_h;
            border-radius: Theme.radius-sm;
            background: i == root.current ? Theme.bg-card-hover : (row_touch.has-hover ? Theme.surface-chip : transparent);
            opacity: row.state == 1 && i != root.current ? 0.6 : 1.0;

            accessible-role: AccessibleRole.button;
            accessible-label: "Step " + (i + 1) + ", " + row.code + ", " + row.angle;
            accessible-description: row.indices;
            accessible-action-default => { CuttingModeModel.jump_to(i); }

            row_touch := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { CuttingModeModel.jump_to(i); }
            }
            if i == root.current: Rectangle {
                x: 0px;
                y: 6px;
                width: 4px;
                height: parent.height - 12px;
                border-radius: 2px;
                background: Theme.accent-cyan;
            }
            Text {
                text: row.code;
                x: 14px;
                width: 64px;
                height: parent.height;
                font-size: 17px;
                font-weight: 700;
                color: Theme.text-primary;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                text: row.angle;
                x: 82px;
                width: 96px;
                height: parent.height;
                font-size: 17px;
                font-weight: 600;
                color: Theme.accent-cyan;
                vertical-alignment: center;
            }
            Text {
                text: row.indices;
                x: 184px;
                width: max(0px, parent.width - 184px - 40px);
                height: parent.height;
                font-size: 14px;
                color: Theme.text-secondary;
                vertical-alignment: center;
                overflow: elide;
            }
            if row.state == 1: Image {
                source: @image-url("../../icons/check.svg");
                colorize: Theme.success;
                x: parent.width - 30px;
                y: (parent.height - self.height) / 2;
                width: 18px;
                height: 18px;
            }
            if row.state == 2: Text {
                text: "!";
                x: parent.width - 34px;
                width: 24px;
                height: parent.height;
                font-size: 18px;
                font-weight: 800;
                color: Theme.accent-amber;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

// The stone after this step, as big as the room allows. The render follows the size shown: the
// picture the Cut slider draws is made for `SolidPreviewModel.viewport_width/height`, which the
// editor's own viewport keeps at its size, so while this picture is up it writes its own size
// there (debounced by the timer, then the same `viewport_resized` the editor viewport raises).
// Rust puts the editor's size back when the screen closes (`cutting_mode/viewport.rs`).
component CmStonePicture inherits Rectangle {
    background: Theme.viewport-bg;
    border-radius: Theme.radius-md;
    clip: true;

    Image {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        source: SolidPreviewModel.image;
        image-fit: contain;
        accessible-role: AccessibleRole.image;
        accessible-label: "The stone after this step";
        accessible-description: CuttingModeModel.stone_caption;
    }
    if !SolidPreviewModel.has_solid: Text {
        text: "The picture of the stone is still being drawn...";
        font-size: 15px;
        color: Theme.text-muted;
        wrap: word-wrap;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }

    Timer {
        interval: 60ms;
        running: root.width > 8px && root.height > 8px;
        triggered => {
            if (Math.abs(SolidPreviewModel.viewport_width - root.width) > 1px
                || Math.abs(SolidPreviewModel.viewport_height - root.height) > 1px) {
                SolidPreviewModel.viewport_width = root.width;
                SolidPreviewModel.viewport_height = root.height;
                SolidPreviewModel.viewport_resized();
            }
        }
    }
}

// The index wheel with its caption, in a card.
component CmWheelCard inherits CmCard {
    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        CmIndexWheel {
            vertical-stretch: 1;
            min-height: 0px;
            description: CuttingModeModel.wheel_caption;
            minor_ticks: CuttingModeModel.wheel_minor;
            major_ticks: CuttingModeModel.wheel_major;
            spokes: CuttingModeModel.wheel_spokes;
            marks: CuttingModeModel.wheel_marks;
            numbers: CuttingModeModel.wheel_scale;
        }
        Text {
            text: CuttingModeModel.wheel_caption;
            font-size: 13px;
            color: Theme.text-secondary;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
    }
}

// The stone and its caption, in a card.
component CmStoneCard inherits CmCard {
    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        CmStonePicture {
            vertical-stretch: 1;
            min-height: 0px;
        }
        Text {
            text: CuttingModeModel.stone_caption;
            font-size: 13px;
            color: Theme.text-secondary;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
    }
}

// Cutting mode: the cutting instructions one step per page, filling the window. See
// `CuttingModeModel` (`models/cutting_mode.slint`) for what each property is and who writes it.
//
// Every block is placed by hand from the window's size instead of through stretch factors: a
// Rectangle in a layout takes a share of the free room by default, which is what squashed the old
// page into a band at the top and blew the buttons up. The window's own minimum size comes from
// the main window, not from this screen.
//
// From the top: the header (title, state, help, close), the step strip (one segment per step,
// done / current / to do, a click jumps there), the body, and the footer (Previous, Mark step
// done, Next; Reset progress at the right).
//
// Body, width >= 1100 px: left the step card over the whole schedule, right the stone with the
// index wheel beside it (below it when the column is narrow). Narrower than that the blocks are
// stacked in one scrolling column. The keys are handled by `CuttingModeModel.handle_key`, called
// from the main window's key handler, not from here.
export component CuttingModeScreen inherits Rectangle {
    background: Theme.bg-darkest;

    property <length> pad: 20px;
    property <length> gap: 16px;
    property <length> head_h: 52px;
    property <length> strip_h: 28px;
    property <length> foot_h: 68px;
    property <bool> wide: root.width >= 1100px;
    property <bool> ready: !CuttingModeModel.busy && CuttingModeModel.error == "";
    property <length> body_w: max(0px, root.width - 2 * root.pad);
    property <length> body_y: root.pad + root.head_h + (root.ready ? root.strip_h + 4px : 0px) + root.gap;
    property <length> body_h: max(0px, root.height - root.body_y - (root.ready ? root.foot_h + root.gap : 0px) - root.pad);

    // Takes every click and wheel turn, so none reaches the editor underneath.
    TouchArea {
        scroll-event(event) => { return accept; }
    }

    // --- Header: what this is, which design, the step's state, the way out. ---
    HorizontalLayout {
        x: root.pad;
        y: root.pad;
        width: root.body_w;
        height: root.head_h;
        spacing: 16px;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: "Cutting mode";
                font-size: 13px;
                font-weight: 600;
                color: Theme.text-muted;
            }
            Text {
                text: CuttingModeModel.design_name != "" ? CuttingModeModel.design_name : "Untitled design";
                font-size: 20px;
                font-weight: 600;
                color: Theme.text-secondary;
                overflow: elide;
            }
        }
        if CuttingModeModel.step_state != 0 && root.ready: Rectangle {
            width: state_badge.width;
            horizontal-stretch: 0;
            state_badge := CmBadge {
                y: (parent.height - self.height) / 2;
                text: CuttingModeModel.state_text;
                ink: CuttingModeModel.step_state == 1 ? Theme.success : Theme.accent-amber;
                fill: CuttingModeModel.step_state == 1 ? Theme.badge-emerald-bg : Theme.badge-amber-bg;
            }
        }
        VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;
            HelpButton {
                topic: HelpTopics.cutting-mode;
                hint: "Open the manual page on cutting mode";
                diameter: 28px;
            }
        }
        VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;
            CmButton {
                text: "Close";
                hint: "Leave cutting mode and go back to the editor. Esc does the same. Your marks are kept.";
                icon: @image-url("../../icons/close.svg");
                clicked => { CuttingModeModel.close(); }
            }
        }
    }

    // --- Step strip: the progress line and one segment per step. ---
    if root.ready: Rectangle {
        x: root.pad;
        y: root.pad + root.head_h + 4px;
        width: root.body_w;
        height: root.strip_h;

        property <length> text_w: 230px;
        property <length> strip_w: max(0px, self.width - self.text_w - 12px);
        property <int> n: max(1, CuttingModeModel.schedule.length);
        property <length> seg_w: Math.clamp((self.strip_w - (self.n - 1) * 3px) / self.n, 4px, 44px);

        Text {
            x: 0px;
            width: parent.text_w;
            height: parent.height;
            text: CuttingModeModel.progress_text;
            font-size: 15px;
            font-weight: 600;
            color: CuttingModeModel.done_count >= CuttingModeModel.step_count && CuttingModeModel.step_count > 0 ? Theme.success : Theme.text-primary;
            vertical-alignment: center;
            overflow: elide;
        }
        for row[i] in CuttingModeModel.schedule: Rectangle {
            x: parent.text_w + 12px + i * (parent.seg_w + 3px);
            y: i == CuttingModeModel.step_index ? 3px : 7px;
            width: parent.seg_w;
            height: i == CuttingModeModel.step_index ? 22px : 14px;
            border-radius: 3px;
            background: row.state == 1 ? Theme.success : row.state == 2 ? Theme.accent-amber : Theme.border-medium;
            border-width: i == CuttingModeModel.step_index ? 2px : 0px;
            border-color: Theme.accent-cyan;

            accessible-role: AccessibleRole.button;
            accessible-label: "Go to step " + (i + 1) + ", " + row.code;
            accessible-action-default => { CuttingModeModel.jump_to(i); }

            TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { CuttingModeModel.jump_to(i); }
            }
        }
    }

    // --- Body: busy, the reason there is nothing to cut, or the step. ---
    if CuttingModeModel.busy: Text {
        x: root.pad;
        y: root.body_y;
        width: root.body_w;
        height: root.body_h;
        text: "Getting the cutting steps ready...";
        font-size: 22px;
        color: Theme.text-secondary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if !CuttingModeModel.busy && CuttingModeModel.error != "": Text {
        x: root.pad;
        y: root.body_y;
        width: root.body_w;
        height: root.body_h;
        text: CuttingModeModel.error;
        font-size: 22px;
        color: Theme.accent-amber;
        wrap: word-wrap;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // Wide: the step card over the schedule on the left (about 42%), the stone and the wheel on
    // the right.
    if root.ready && root.wide: wide_body := Rectangle {
        x: root.pad;
        y: root.body_y;
        width: root.body_w;
        height: root.body_h;

        property <length> lw: Math.max(480px, (self.width - root.gap) * 0.42);
        property <length> rw: self.width - root.gap - self.lw;
        // The wheel sits beside the stone when the right column is wide enough, else below it.
        property <bool> beside: self.rw >= 780px;
        property <length> wheel_w: 340px;
        property <length> wheel_h: 300px;
        property <length> sched_h: Math.max(150px, self.height * 0.36);

        CmCard {
            x: 0px;
            y: 0px;
            width: parent.lw;
            height: parent.height;

            // The step, scrolling when the window is too short for all of it.
            ScrollView {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height - wide_body.sched_h - 24px;
                content-width: self.width;
                content-height: step_panel.preferred-height + 32px;

                step_panel := CmStepPanel {
                    x: 20px;
                    y: 16px;
                    width: parent.width - 40px - 12px;
                    height: self.preferred-height;
                    avail_w: self.width;
                }
            }
            Text {
                x: 20px;
                y: parent.height - wide_body.sched_h - 20px;
                height: 20px;
                text: "Schedule";
                font-size: 13px;
                font-weight: 600;
                color: Theme.text-muted;
                vertical-alignment: center;
            }
            CmSchedule {
                x: 8px;
                y: parent.height - wide_body.sched_h;
                width: parent.width - 16px;
                height: wide_body.sched_h - 8px;
            }
        }

        CmStoneCard {
            x: parent.lw + root.gap;
            y: 0px;
            width: parent.beside ? parent.rw - parent.wheel_w - root.gap : parent.rw;
            height: parent.beside ? parent.height : parent.height - parent.wheel_h - root.gap;
        }
        CmWheelCard {
            x: parent.beside ? parent.lw + root.gap + parent.rw - parent.wheel_w : parent.lw + root.gap;
            y: parent.beside ? 0px : parent.height - parent.wheel_h;
            width: parent.beside ? parent.wheel_w : parent.rw;
            height: parent.beside ? parent.height : parent.wheel_h;
        }
    }

    // Narrow: everything stacked in one scrolling column.
    if root.ready && !root.wide: narrow_body := ScrollView {
        x: root.pad;
        y: root.body_y;
        width: root.body_w;
        height: root.body_h;
        content-width: self.width;
        content-height: narrow_step.height + root.gap + narrow_body.stone_h + root.gap + 300px + root.gap + 360px;

        property <length> col_w: self.width - 12px;
        property <length> stone_h: Math.clamp(self.col_w * 0.75, 260px, 460px);

        narrow_step := CmCard {
            x: 0px;
            y: 0px;
            width: narrow_body.col_w;
            height: narrow_panel.preferred-height + 32px;

            narrow_panel := CmStepPanel {
                x: 20px;
                y: 16px;
                width: parent.width - 40px;
                height: self.preferred-height;
                avail_w: self.width;
            }
        }
        CmStoneCard {
            x: 0px;
            y: narrow_step.height + root.gap;
            width: narrow_body.col_w;
            height: narrow_body.stone_h;
        }
        CmWheelCard {
            x: 0px;
            y: narrow_step.height + root.gap + narrow_body.stone_h + root.gap;
            width: narrow_body.col_w;
            height: 300px;
        }
        CmCard {
            x: 0px;
            y: narrow_step.height + root.gap + narrow_body.stone_h + root.gap + 300px + root.gap;
            width: narrow_body.col_w;
            height: 360px;

            CmSchedule {
                x: 8px;
                y: 8px;
                width: parent.width - 16px;
                height: parent.height - 16px;
            }
        }
    }

    // --- Footer: the three buttons in the middle, reset at the right, the keys under them. ---
    if root.ready: Rectangle {
        x: root.pad;
        y: root.height - root.pad - root.foot_h;
        width: root.body_w;
        height: root.foot_h;

        HorizontalLayout {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: 44px;
            spacing: 12px;

            Rectangle {
                horizontal-stretch: 1;
                min-width: 0px;
            }
            if !CuttingModeModel.confirm_reset: HorizontalLayout {
                horizontal-stretch: 0;
                spacing: 12px;
                CmButton {
                    text: "Previous";
                    hint: CuttingModeModel.has_previous
                        ? "Go back to the previous step. The Left arrow or Page Up does the same."
                        : "This is the first step.";
                    icon: @image-url("../../icons/chevron-right.svg");
                    icon_rotation: 180deg;
                    enabled: CuttingModeModel.has_previous;
                    clicked => { CuttingModeModel.previous(); }
                }
                CmButton {
                    text: CuttingModeModel.step_state == 1 ? "Mark not done" : "Mark step done";
                    hint: CuttingModeModel.step_state == 1
                        ? "Take the done mark back from this step, for example when you have to cut it again."
                        : "Mark this step as cut and remember it. Space or D marks it and goes on to the next step.";
                    icon: @image-url("../../icons/check.svg");
                    primary: CuttingModeModel.step_state != 1;
                    clicked => { CuttingModeModel.toggle_done(); }
                }
                CmButton {
                    text: "Next";
                    hint: CuttingModeModel.has_next
                        ? "Go on to the next step without marking this one. The Right arrow or Page Down does the same."
                        : "This is the last step.";
                    icon: @image-url("../../icons/chevron-right.svg");
                    icon_after: true;
                    enabled: CuttingModeModel.has_next;
                    clicked => { CuttingModeModel.next(); }
                }
            }
            if CuttingModeModel.confirm_reset: HorizontalLayout {
                horizontal-stretch: 0;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "Remove every mark for this design?";
                        font-size: 16px;
                        font-weight: 600;
                        color: Theme.danger;
                        vertical-alignment: center;
                    }
                }
                CmButton {
                    text: "Reset";
                    hint: "Yes, remove every done mark of this design.";
                    danger: true;
                    clicked => {
                        CuttingModeModel.confirm_reset = false;
                        CuttingModeModel.reset_confirmed();
                    }
                }
                CmButton {
                    text: "Keep my marks";
                    hint: "Do not reset. Esc does the same.";
                    clicked => { CuttingModeModel.confirm_reset = false; }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                min-width: 0px;

                if !CuttingModeModel.confirm_reset: CmButton {
                    x: parent.width - self.width;
                    y: 0px;
                    text: "Reset progress";
                    hint: "Remove every done mark of this design. You are asked to confirm first.";
                    icon: @image-url("../../icons/rotate-ccw.svg");
                    clicked => { CuttingModeModel.confirm_reset = true; }
                }
            }
        }

        Text {
            x: 0px;
            y: 50px;
            width: parent.width;
            height: 16px;
            text: "Left and Right arrows: previous and next step  ·  Space or D: mark done and go on  ·  Esc: leave";
            font-size: 12px;
            color: Theme.text-muted;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}
