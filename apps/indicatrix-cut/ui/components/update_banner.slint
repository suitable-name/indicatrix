import { Theme } from "../theme.slint";
import { UpdateModel } from "../models/update.slint";
import { TipButton } from "compact_controls.slint";

// The slim, non-modal notice under the header: a newer release exists. Mounted by `app.slint`
// while `UpdateModel.notice_visible`; the three buttons call the `UpdateModel` callbacks that
// `gui::update_check` handles.
export component UpdateBanner inherits Rectangle {
    height: 36px;
    background: Theme.surface-dialog;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Theme.accent-cyan;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 8px;

        Text {
            horizontal-stretch: 1;
            text: UpdateModel.notice_text;
            font-size: 12px;
            color: Theme.text-primary;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: AccessibleRole.text;
        }
        TipButton {
            text: "View Release";
            hint: "Open the release page in your browser. Nothing is downloaded or installed.";
            primary: true;
            clicked => { UpdateModel.view_release(); }
        }
        TipButton {
            text: "Skip This Version";
            hint: "Do not announce this version again. A newer one is still announced.";
            clicked => { UpdateModel.skip_release(); }
        }
        TipButton {
            text: "Later";
            hint: "Hide this notice until the next check.";
            clicked => { UpdateModel.later(); }
        }
    }
}
