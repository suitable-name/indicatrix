import { ComboBox, LineEdit } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { ExportModel } from "../../models/export.slint";
import { ExportRunModel } from "../../models/export_run.slint";
import { ViewportModel } from "../../models/viewport.slint";
import { SettingsModel } from "../../models/settings.slint";
import { TiltModel } from "../../models/tilt.slint";
import { EditorModel } from "../../models/editor.slint";
import { GuideModel } from "../../models/guide.slint";
import { PhysicscolorModel } from "../../models/physics_color.slint";
import { StaleBadge } from "../stale_badge.slint";
import { IconButton } from "../icon_button.slint";
import { RenderColorControl } from "render_color_picker.slint";
// A running catalogue-wide batch (tilt sweep or preview render) sets
// `ctx.export_active`, which suspends the live tracer exactly like an explicit
// pause -- read here to fold the same suspended-display treatment into the
// pause pill below, so a frozen Path-traced image during a batch still reads
// as paused rather than "Live". Mirrors `solid_viewport.slint`'s identical
// `batch_suspends_tracer` property.
import { BatchModel } from "../../models/batch.slint";

// One button of the Live Render toolbar: 32 px tall, an icon and/or a label. With a label it
// is as wide as its content, without one (or with `show_text` off, on a narrow window) it is a
// 32 px square. Tab reaches it, Space or Enter presses it, a screen reader reads `text` (or
// `name` for an icon-only button) and `hint`. `lit` is the "on" look in `lit_fill`.
component ToolbarButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    // The accessible name of an icon-only button.
    in property <string> name;
    // One plain sentence: what the button does. Shown as the tooltip.
    in property <string> hint;
    in property <bool> lit: false;
    in property <color> lit_fill: Theme.accent-cyan;
    in property <color> lit_ink: Theme.text-on-accent;
    // A toggle: a screen reader says whether it is on.
    in property <bool> checkable: false;
    in property <bool> enabled: true;
    // Off on a narrow window: only the icon is drawn.
    in property <bool> show_text: true;
    in property <length> icon_size: 14px;
    callback clicked();

    property <bool> has_text: root.text != "" && root.show_text;
    property <bool> has_icon: root.icon.width > 0;
    property <color> ink: root.lit ? root.lit_ink : (root.has_text ? Theme.text-primary : Theme.text-secondary);

    height: 32px;
    // Sized to its content, never stretched: a Rectangle in a HorizontalLayout has
    // horizontal-stretch 1 by default and would otherwise absorb the width the capped
    // ComboBoxes no longer take.
    width: root.has_text ? tb_row.preferred-width : 32px;
    background: root.lit ? root.lit_fill : (tb_touch.has-hover && root.enabled ? Theme.bg-elevated : Theme.hint-surface);
    border-radius: Theme.radius-sm;
    border-width: tb_focus.has-focus ? 2px : 1px;
    border-color: tb_focus.has-focus ? Theme.accent-cyan-hover : (root.lit ? root.lit_fill : Theme.border-medium);
    opacity: root.enabled ? 1.0 : 0.45;

    accessible-role: AccessibleRole.button;
    accessible-label: root.text != "" ? root.text : root.name;
    accessible-description: root.hint;
    accessible-checkable: root.checkable;
    accessible-checked: root.lit;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    Tooltip { text: @markdown("\{root.hint}"); }

    tb_focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    tb_row := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 5px;
        alignment: center;
        if root.has_icon: Image {
            source: root.icon;
            colorize: root.ink;
            width: root.icon_size;
            height: root.icon_size;
            vertical-alignment: center;
        }
        if root.has_text: Text {
            text: root.text;
            font-size: 11px;
            font-weight: 600;
            color: root.ink;
            vertical-alignment: center;
        }
    }

    tb_touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }
}

// "Linked to design": the whole chip is the switch (a wide target), with the label beside the
// track unless the window is narrow. While on, the Render Material dropdown follows the Edit
// tab's own material instead of an independent choice -- see `viewport_material_linked`'s own
// doc comment in `models/viewport.slint`. Tab reaches it, Space or Enter flips it, a screen
// reader reads it as a checkbox.
component LinkedToggle inherits Rectangle {
    // Drops the label; the track stays.
    in property <bool> compact: false;

    function flip() {
        ViewportModel.viewport_material_linked = !ViewportModel.viewport_material_linked;
        ViewportModel.viewport_material_linked_changed(ViewportModel.viewport_material_linked);
    }

    width: root.compact ? 44px : link_txt.preferred-width + 44px;
    height: 32px;
    background: link_touch.has-hover ? Theme.bg-elevated : Theme.hint-surface;
    border-radius: Theme.radius-sm;
    border-width: link_focus.has-focus ? 2px : 1px;
    border-color: link_focus.has-focus ? Theme.accent-cyan-hover : Theme.border-medium;

    accessible-role: AccessibleRole.checkbox;
    accessible-label: "Linked to design";
    accessible-description: "While on, the render material follows the design open in the Edit tab.";
    accessible-checked: ViewportModel.viewport_material_linked;
    accessible-action-default => { root.flip(); }

    Tooltip { text: @markdown("Linked to design: while on, the material follows the design open in the Edit tab instead of an independent choice."); }

    link_focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.flip();
                return accept;
            }
            return reject;
        }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        Rectangle {
            width: 28px;
            height: 16px;
            border-radius: 8px;
            background: ViewportModel.viewport_material_linked ? Theme.accent-cyan : Theme.border-dialog;
            Rectangle {
                width: 12px;
                height: 12px;
                border-radius: 6px;
                background: Theme.toggle-knob;
                x: ViewportModel.viewport_material_linked ? parent.width - self.width - 2px : 2px;
                y: 2px;
                animate x { duration: 120ms; }
            }
        }
        link_txt := Text {
            visible: !root.compact;
            text: "Linked to design";
            font-size: 10px;
            color: Theme.text-secondary;
            vertical-alignment: center;
        }
    }

    link_touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.flip(); }
    }
}

// The Live Render viewport's Material/Lighting selectors and action-button row
// (Edit Material, Tilt Curve, Reset Camera, Front/Top, Save View Preset,
// Pause/Resume, GPU status, Settings, Export) -- split out of
// `gem_viewport.slint` to keep that file under its line budget. Every
// property here (`saving_view_preset`/`new_view_preset_name`/
// `batch_suspends_tracer`) is local to this row alone -- nothing outside it
// in `gem_viewport.slint` ever reads them -- so none of it needs to be
// threaded through as a property.
//
// Simple mode hides the Tilt Curve button and Save View Preset (`GuideModel.shows_advanced()`).
// A hidden control keeps its state; the settings dialog says when advanced settings are in use.
export component GemViewportToolbarActions inherits HorizontalLayout {
    spacing: 8px;

    // Set by `gem_viewport.slint` from the viewport width: drops the color readout,
    // the "Tilt Curve" and "Linked to design" labels (their icons/toggle stay), so the
    // row fits a narrower window.
    in property <bool> compact: false;

    property <bool> saving_view_preset: false;
    property <string> new_view_preset_name: "";
    property <bool> batch_suspends_tracer: BatchModel.tilt_batch_running || BatchModel.preview_batch_running;
    // The tracer is held still by something other than the user's own pause.
    property <bool> pause_displayed: ViewportModel.render_paused || ExportModel.is_exporting || root.batch_suspends_tracer;

    function save_view_preset() {
        if (root.new_view_preset_name != "") {
            ViewportModel.save_view_preset(root.new_view_preset_name);
            root.saving_view_preset = false;
            root.new_view_preset_name = "";
        }
    }

    // Render Material Dropdown -- labelled "Render Material", not a
    // bare "Material", so it cannot be confused with
    // `editor_view.slint`'s unrelated Yield Material/SG-override
    // control. This one picks what's simulated for
    // color/dispersion/birefringence in the render; it never
    // touches the cut itself.
    // A stretch item (96px up to its share of the free width) rather than a fixed
    // 140px: the fluent ComboBox has its own 160px minimum, so it is zeroed and
    // filled to the box instead.
    Rectangle {
        min-width: 96px;
        preferred-width: 140px;
        max-width: 160px;
        horizontal-stretch: 1;
        height: 32px;
        background: Theme.hint-surface;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: Theme.border-medium;

        Tooltip { text: @markdown("Render Material: the material the picture shows -- its colour, its fire (dispersion) and its double refraction (birefringence). It does not change the cut. See the glossary."); }

        ComboBox {
            width: 100%;
            height: 100%;
            model: ViewportModel.material_options;
            current-index <=> ViewportModel.selected_material_index;
            selected(val) => { ViewportModel.material_changed(val); }
        }
    }

    // Quick color change: the open design's own color while the view shows the linked
    // design, a view-only color otherwise -- no custom material needed. See
    // `render_color_picker.slint`.
    RenderColorControl {
        compact: root.compact;
    }

    // "color data updated": the selected custom material's physics recipe was built with
    // older catalogue data than this build has. It still renders from its stored bands --
    // nothing is recolored silently; the Material Editor offers "Update to current data".
    // Only in a build with the physics color editor (`physical-color`): without it there is
    // nowhere to update the recipe, so the badge would only be a dead end.
    if PhysicscolorModel.ui_enabled && ViewportModel.selected_material_color_outdated && !root.compact: Rectangle {
        height: 32px;
        background: Theme.surface-info;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: Theme.accent-cyan;
        accessible-role: AccessibleRole.text;
        accessible-label: "Color data updated. This material's physics color recipe uses older color data.";
        Tooltip { text: @markdown("This material's physics color recipe uses older color data. It still renders from its stored color; open the Material Editor to update it."); }
        badge_layout := HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            Text {
                text: "Color data updated";
                font-size: 11px;
                color: Theme.text-primary;
                vertical-alignment: center;
            }
        }
        width: badge_layout.preferred-width;
    }

    // The design's body-color variant, beside the dropdown that names only the
    // species: while linked, a yellow-sapphire design traces as `Sapphire (Yellow)`
    // even though the dropdown itself says `Sapphire`.
    if ViewportModel.viewport_material_linked && EditorModel.body_color_readout != "" && !root.compact: Rectangle {
        height: 32px;
        background: Theme.hint-surface;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: Theme.border-medium;
        accessible-role: AccessibleRole.text;
        accessible-label: "Body color: " + EditorModel.body_color_readout;
        Tooltip { text: @markdown("Rendered in this design's own body color -- set with color in the Edit tab's Design settings."); }
        color_readout_layout := HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            Text {
                text: EditorModel.body_color_readout;
                font-size: 11px;
                color: Theme.text-primary;
                vertical-alignment: center;
            }
        }
        width: color_readout_layout.preferred-width;
    }

    // "Linked to design" -- see `viewport_material_linked`'s own doc
    // comment above. Only shown on an `editor` build; a build with no
    // Edit tab has nothing for this dropdown to link to.
    if EditorModel.enabled: LinkedToggle {
        compact: root.compact;
    }

    // Edit / Custom Material Button (pencil)
    ToolbarButton {
        icon: @image-url("../../icons/pencil.svg");
        icon_size: 15px;
        name: "Custom material";
        hint: "Define a custom material: refractive index (R.I.), dispersion, double refraction (birefringence) and color. See the glossary.";
        lit: ViewportModel.material_editor_open;
        lit_fill: Theme.accent-purple;
        lit_ink: Theme.text-on-primary;
        checkable: true;
        clicked => { ViewportModel.material_editor_open = !ViewportModel.material_editor_open; }
    }

    // Lighting Dropdown
    Rectangle {
        min-width: 110px;
        preferred-width: 190px;
        max-width: 220px;
        horizontal-stretch: 1;
        height: 32px;
        background: Theme.hint-surface;
        border-radius: Theme.radius-sm;
        // The open tutorial step may outline this drop-down (a cyan, 2px border).
        border-width: GuideModel.highlight_target == "lighting_combo" ? 2px : 1px;
        border-color: GuideModel.highlight_target == "lighting_combo" ? Theme.accent-cyan : Theme.border-medium;

        // The UV lamps are part of the `physical-color` build only (`PhysicscolorModel.ui_enabled`).
        Tooltip { text: PhysicscolorModel.ui_enabled
            ? @markdown("Lighting: the four studio rigs, or the lit models -- the grading tray (D65 hemisphere + head shadow), light tent with black cards, daylight sky with sun -- the contrast view (ASET-style: red 45-75 deg, green 0-45 deg, blue 75-90 deg overhead, black below the horizon; not scored by the metrics) -- or a 365 nm or 395 nm UV lamp (CPU only, lights fluorescent materials).")
            : @markdown("Lighting: the four studio rigs, or the lit models -- the grading tray (D65 hemisphere + head shadow), light tent with black cards, daylight sky with sun, and the ASET-style contrast view (red 45-75 deg, green 0-45 deg, blue 75-90 deg overhead; not scored by the metrics)."); }

        ComboBox {
            width: 100%;
            height: 100%;
            model: ViewportModel.lighting_options;
            current-index <=> ViewportModel.selected_lighting_index;
            // Emits the INDEX (already synced into
            // `selected_lighting_index` via the two-way binding above by
            // the time `selected` fires), not the display string `val`.
            selected(val) => { ViewportModel.lighting_changed(ViewportModel.selected_lighting_index); }
        }
    }

    // Performance Curve Graph Trigger Button (bar chart, Tilt Curve). An advanced tool:
    // hidden in Simple mode, and locked with the other advanced actions while a guide runs.
    // Icon only (32px) when compact.
    if GuideModel.shows_advanced(): ToolbarButton {
        text: "Tilt Curve";
        icon: @image-url("../../icons/bar-chart.svg");
        icon_size: 13px;
        show_text: !root.compact;
        name: "Tilt Curve";
        // Lives on `TiltModel` itself (`ui/models/tilt.slint`) so `SolidViewportView`'s own
        // Tilt Curve pill can share the exact same open/close + stale-cache-check sequence
        // instead of a second copy.
        hint: GuideModel.allows_advanced()
            ? "Open the tilt-performance chart: brilliance, windowing and extinction as the stone tilts. See the glossary."
            : GuideModel.locked_hint;
        enabled: GuideModel.allows_advanced();
        lit: TiltModel.dialog_open;
        checkable: true;
        clicked => { TiltModel.toggle_dialog(); }
    }

    // Reset Camera Button
    ToolbarButton {
        icon: @image-url("../../icons/reset.svg");
        icon_size: 16px;
        name: "Reset camera";
        hint: "Return the camera to its default orbit and distance.";
        clicked => { ViewportModel.reset_camera(); }
    }

    // Front / Top view buttons -- canonical poses for the shared camera.
    ToolbarButton {
        text: "Front";
        width: 52px;
        hint: "Look at the stone from the front: girdle edge-on, index 0 towards you.";
        clicked => { ViewportModel.set_view(0); }
    }
    ToolbarButton {
        text: "Top";
        width: 44px;
        hint: "Look straight down onto the table.";
        clicked => { ViewportModel.set_view(1); }
    }

    // "Save as preset" button -- captures the FULL current view (lighting
    // AND camera pose) as a new named preset, unlike the settings dialog's
    // own lighting-only save button. See `app.slint`'s `save_view_preset`
    // doc comment, and `settings::model::LightingPreset`'s for why the
    // camera is captured here specifically. Advanced: hidden in Simple mode.
    if GuideModel.shows_advanced(): ToolbarButton {
        icon: @image-url("../../icons/save.svg");
        icon_size: 14px;
        name: "Save view as preset";
        hint: "Save the current lighting and camera pose as a named preset.";
        lit: root.saving_view_preset;
        checkable: true;
        clicked => {
            root.saving_view_preset = !root.saving_view_preset;
            root.new_view_preset_name = "";
        }
    }

    // Inline "name this view" popup for the button above -- same
    // click-to-open, type-and-confirm idiom `SettingsDialog`'s own
    // "add lighting preset" row uses, just living in the viewport toolbar
    // instead of the settings dialog.
    if root.saving_view_preset && GuideModel.shows_advanced(): Rectangle {
        width: 160px;
        height: 32px;
        background: Theme.hint-surface;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: Theme.accent-cyan;

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 4px;
            spacing: 4px;

            LineEdit {
                text <=> root.new_view_preset_name;
                placeholder-text: "Name this view...";
                accepted => { root.save_view_preset(); }
            }

            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: @image-url("../../icons/check.svg");
                    glyph: 11px;
                    hint: "Save the view under this name";
                    lit: true;
                    clicked => { root.save_view_preset(); }
                }
            }
        }
    }

    // Pause / Resume Render Button -- explicit user pause control (Task: render pause/stop).
    // Also reflects `is_exporting` for DISPLAY purposes only, the same amber
    // "suspended" treatment `render_paused` already gets -- see
    // `RenderContext::export_active`'s own doc comment for why an export
    // suspends local tracing without touching `render_paused` itself. The
    // touch area is disabled while exporting so a click can't flip the
    // user's real pause state out from under them while its displayed state
    // is showing something else (it would otherwise toggle `render_paused`
    // from whatever the user actually left it at, not from what's on screen).
    //
    // Belongs to the tracer -- only shown in Path-traced mode
    // (`live_view_mode == 1`); Solid mode has nothing of the tracer's to
    // pause.
    // The traced image is only re-rendered on a solve, so after an
    // ordinary tier edit it still shows the design as it was -- said
    // plainly here rather than left to be noticed.
    // Sits beside the pause pill, in the tracer's own mode only, for
    // the same reason that pill does: it is a fact about the trace.
    // Uses the shared `StaleBadge` (every other analysis panel's
    // own "stale" marker) for the same condition, with a one-click
    // "Recompute" (`EditorModel.solve()`) instead of only a hint to
    // solve manually.
    if ViewportModel.live_view_mode == 1 && ViewportModel.trace_stale: StaleBadge {
        // A Solve like any other: locked with the Solve button while the
        // worked-example guide runs.
        enabled: GuideModel.allows_solve();
        recompute => { EditorModel.solve(); }
    }

    if ViewportModel.live_view_mode == 1: ToolbarButton {
        icon: ViewportModel.render_paused ? @image-url("../../icons/play.svg") : @image-url("../../icons/pause.svg");
        icon_size: 13px;
        text: ViewportModel.render_paused ? "Paused" : (ExportModel.is_exporting ? "Exporting" : (root.batch_suspends_tracer ? "Paused (batch)" : "Live"));
        hint: root.pause_displayed && !ViewportModel.render_paused
            ? "The live render is held still while an export or a catalogue batch runs."
            : "Pause or resume the live render. While paused the picture stops improving, which frees the processor.";
        lit: root.pause_displayed;
        lit_fill: Theme.accent-amber;
        // Disabled during an export or a batch too -- a click must not flip the user's real
        // pause state out from under them while the button is showing a state that isn't
        // `render_paused`.
        enabled: !ExportModel.is_exporting && !root.batch_suspends_tracer;
        clicked => {
            ViewportModel.render_paused = !ViewportModel.render_paused;
            ViewportModel.pause_toggled(ViewportModel.render_paused);
        }
    }

    // GPU status pill -- surfaces a lost GPU device instead of
    // leaving the viewport silently stuck with nothing on screen
    // saying why it stopped updating. `ViewportModel.
    // gpu_status_text`'s own doc comment (models/viewport.slint) has
    // the exact sequence this reflects: empty while healthy (hidden),
    // "reacquiring" text during the brief self-heal attempt, or a
    // "CPU fallback: <reason>" message once that attempt has also
    // failed. Same amber-pill styling as the "Trace is from an
    // earlier edit" pill above -- both are "something's not showing
    // what Live normally means" facts about the trace.
    if ViewportModel.live_view_mode == 1 && ViewportModel.gpu_status_text != "": Rectangle {
        height: 32px;
        border-radius: Theme.radius-sm;
        background: Theme.accent-amber;
        accessible-role: AccessibleRole.text;
        accessible-label: "Graphics status: " + ViewportModel.gpu_status_text;
        Tooltip { text: @markdown("The graphics card renderer is not running normally; the status says what the program is doing about it."); }
        gpu_status_layout := HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            Text {
                text: ViewportModel.gpu_status_text;
                font-size: 11px;
                font-weight: 700;
                color: Theme.text-on-amber;
                vertical-alignment: center;
            }
        }
        width: gpu_status_layout.preferred-width;
    }

    // Settings Dialog Trigger Button (gear)
    ToolbarButton {
        icon: @image-url("../../icons/gear.svg");
        icon_size: 15px;
        name: "Rendering settings";
        hint: "Rendering quality, resolution, lighting and scene settings.";
        lit: SettingsModel.is_open;
        checkable: true;
        clicked => { SettingsModel.is_open = !SettingsModel.is_open; }
    }

    // High-Resolution Export Trigger Button
    ToolbarButton {
        icon: @image-url("../../icons/save.svg");
        icon_size: 13px;
        text: ExportModel.is_exporting ? "Exporting..." : "Export";
        hint: ExportModel.is_exporting
            ? "An export is running. Show its progress window again."
            : (ExportRunModel.running
                ? ExportRunModel.busy_hint
                : "Render the stone at high resolution and save it as a picture. Exports always show the finished stone.");
        // Another kind of export running (a video, a queue job) blocks starting this one; this
        // export's own button stays on, to bring its popup back after "Run in Background".
        enabled: !ExportRunModel.running || ExportModel.is_exporting;
        lit: ExportModel.is_open || ExportModel.is_exporting;
        lit_fill: Theme.accent-emerald;
        checkable: true;
        clicked => { ExportModel.is_open = !ExportModel.is_open; }
    }
}
