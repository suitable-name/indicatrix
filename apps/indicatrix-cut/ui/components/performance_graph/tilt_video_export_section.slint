import { ComboBox, LineEdit, SpinBox, Slider } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { TiltVideoExportModel } from "../../models/tilt.slint";
import { GuideModel } from "../../models/guide.slint";
import { SegmentPill } from "../pill_button.slint";
import { ToggleRow } from "../toggle_switch.slint";
import { ChipToggle, ActionButton } from "../chip_toggle.slint";
// Read-only reuse of the still-image export's own output folder (`ExportModel.directory`)
// -- see `video_export::resolve_export_directory`'s own doc comment on why the video
// export shares that folder rather than keeping a second, independent one.
import { ExportModel } from "../../models/export.slint";
// "Add to Queue" saves the video as a render job -- see `models/render_jobs.slint`.
import { RenderJobsModel } from "../../models/render_jobs.slint";

// "Export tilt video" collapsible section, shown near the bottom of
// `PerformanceGraphDialog`, below the tilt performance chart. Renders one
// high-quality frame per swept angle (posed exactly like that dialog's own
// curve/hover-preview -- `gui::tilt::video_export`), optionally overlaying the
// tilt performance values, then muxes an MP4/GIF. Every setting below lives on
// `TiltVideoExportModel` (persists across re-opens) except this section's own
// expanded state and its large-run confirmation guard, which are owned by
// `PerformanceGraphDialog` (`video_export_expanded`/`confirmed_large_run`,
// both reset fresh every re-open of that dialog) and passed through here two-way,
// matching the task's own "collapsed on popup open, not persisted" requirement.
//
// Simple mode (`GuideModel.shows_advanced()`) hides the ray-bounce cap, the colour space, the
// remote transfer choice and the folder-name template. They keep their saved values and still
// apply; "Resolves to" below the folder shows the name they produce.
export component TiltVideoExportSection inherits Rectangle {
    in-out property <bool> video_export_expanded: false;
    in-out property <bool> confirmed_large_run: false;
    // Which of the four camera azimuths the export renders -- owned by
    // `PerformanceGraphDialog` (shared with the chart/axis switcher/badges
    // there), passed straight through to `TiltVideoExportModel.start_video_export`.
    in property <int> selected_axis_index: 0;
    in property <string> selected_axis_label: "";

    // The three frame-rate pills' actual fps values, by index -- shared by this
    // section's clip-length/estimate readout and its fps pill row.
    property <[int]> video_fps_choices: [24, 30, 60];

    border-radius: Theme.radius-md;
    background: Theme.surface-sunken;
    border-width: 1px;
    border-color: Theme.surface-raised;
    clip: true;

    VerticalLayout {
        Rectangle {
            height: 36px;
            background: video_header_touch.has-hover ? Theme.surface-raised : transparent;
            border-width: video_header_focus.has-focus ? 2px : 0px;
            border-color: Theme.accent-cyan-hover;

            accessible-role: AccessibleRole.button;
            accessible-label: "Export Tilt Video";
            accessible-description: root.video_export_expanded
                ? "Open. Press to hide the video export settings."
                : "Closed. Press to show the video export settings.";
            accessible-action-default => { root.video_export_expanded = !root.video_export_expanded; }

            Tooltip { text: @markdown("Show or hide the settings for saving the tilt sweep as a video."); }

            video_header_focus := FocusScope {
                key-pressed(event) => {
                    if event.text == Key.Space || event.text == Key.Return {
                        root.video_export_expanded = !root.video_export_expanded;
                        return accept;
                    }
                    return reject;
                }
            }

            video_header_touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.video_export_expanded = !root.video_export_expanded; }
            }

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 8px;
                    // Chevron drawn as a `Path` (the `section_header.slint` idiom):
                    // the UI font has no "▸"/"▾" glyph and showed an empty box.
                    VerticalLayout {
                        alignment: center;
                        Path {
                            width: 8px;
                            height: 8px;
                            viewbox-width: 8;
                            viewbox-height: 8;
                            stroke: Theme.text-secondary;
                            stroke-width: 1.5px;
                            commands: root.video_export_expanded
                                ? "M 1.5 2.5 L 4 6.5 L 6.5 2.5"
                                : "M 2 1.5 L 6 4 L 2 6.5";
                        }
                    }
                    // Wrapped so the fixed-size icon is centred in the 36px row.
                    VerticalLayout {
                        alignment: center;
                        Image { source: @image-url("../../icons/save.svg"); colorize: Theme.text-primary; width: 13px; height: 13px; }
                    }
                    Text { text: "Export Tilt Video"; font-size: 12px; font-weight: 700; color: Theme.text-primary; vertical-alignment: center; }
                }

                Text {
                    text: "Axis: " + root.selected_axis_label;
                    font-size: 11px;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
            }
        }

        if root.video_export_expanded: video_content := VerticalLayout {
            padding: 12px;
            spacing: 12px;

            // Pure derived state for this section's own estimate/confirm
            // logic -- `computed_frame_count` calls into Rust
            // (`gui::tilt::video_export::params::frame_count`) rather than
            // re-deriving the floor/epsilon math in Slint, so this number
            // can never disagree with how many frames the export actually
            // renders.
            property <int> computed_frame_count: TiltVideoExportModel.frame_count(TiltVideoExportModel.start_angle_deg, TiltVideoExportModel.end_angle_deg, TiltVideoExportModel.step_deg);
            property <float> estimated_seconds: video_content.computed_frame_count * TiltVideoExportModel.last_frame_seconds;
            property <bool> needs_confirmation: video_content.computed_frame_count > 2000 && !root.confirmed_large_run;

            // Sweep
            VerticalLayout {
                spacing: 6px;
                // Plain `&`, not `&&`: Slint `Text.text` has no mnemonic
                // syntax that would need escaping (that's a Qt/GTK
                // convention this doesn't share), so a doubled
                // ampersand would render literally as "Angle Range &&
                // Step" instead of "Angle Range & Step".
                Text { text: "Angle Range & Step"; font-size: 11px; font-weight: 600; color: Theme.text-secondary; }
                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        spacing: 2px;
                        Text { text: "Start (°)"; font-size: 10px; color: Theme.text-muted; }
                        SpinBox {
                            minimum: -90;
                            maximum: 90;
                            accessible-label: "Start angle in degrees";
                            value <=> TiltVideoExportModel.start_angle_deg;
                        }
                    }
                    VerticalLayout {
                        spacing: 2px;
                        Text { text: "End (°)"; font-size: 10px; color: Theme.text-muted; }
                        SpinBox {
                            minimum: -90;
                            maximum: 90;
                            accessible-label: "End angle in degrees";
                            value <=> TiltVideoExportModel.end_angle_deg;
                        }
                    }
                    VerticalLayout {
                        spacing: 2px;
                        Text { text: "Step (°, 0.01-5.0)"; font-size: 10px; color: Theme.text-muted; }
                        Rectangle {
                            height: 26px;
                            width: 84px;
                            background: Theme.surface-chip;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: Theme.border-dialog;
                            LineEdit {
                                width: 100%;
                                height: 100%;
                                accessible-label: "Step between frames in degrees";
                                text: "" + TiltVideoExportModel.step_deg;
                                edited(text) => { TiltVideoExportModel.step_deg = TiltVideoExportModel.parse_step_deg(text); }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    for chip in [0.05, 0.1, 0.25, 0.5, 1.0]: SegmentPill {
                        height: 24px;
                        text: "" + chip;
                        hint: "Step by " + chip + " degrees between frames.";
                        selected: Math.abs(TiltVideoExportModel.step_deg - chip) < 0.001;
                        picked => { TiltVideoExportModel.step_deg = chip; }
                    }
                }
                Text {
                    text: "Frames: " + video_content.computed_frame_count
                        + "  ·  Clip: " + Math.round((video_content.computed_frame_count / Math.max(1, root.video_fps_choices[TiltVideoExportModel.fps_index])) * 10.0) / 10.0
                        + "s @ " + root.video_fps_choices[TiltVideoExportModel.fps_index] + " fps"
                        + (TiltVideoExportModel.last_frame_seconds > 0.0
                            ? "  ·  Est. render: ~" + Math.round(video_content.estimated_seconds / 60.0 * 10.0) / 10.0 + " min"
                            : "  ·  Est. render: available once rendering starts");
                    font-size: 11px;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
            }

            Rectangle { height: 1px; background: Theme.surface-raised; }

            // Frame rate
            VerticalLayout {
                spacing: 6px;
                Text { text: "Frame Rate"; font-size: 11px; font-weight: 600; color: Theme.text-secondary; }
                HorizontalLayout {
                    spacing: 4px;
                    for label[idx] in ["24 fps", "30 fps", "60 fps"]: SegmentPill {
                        height: 26px;
                        text: label;
                        hint: idx == 0
                            ? "Make the video at 24 frames a second, the look of film."
                            : (idx == 1
                                ? "Make the video at 30 frames a second."
                                : "Make the video at 60 frames a second, the smoothest, with a longer render.");
                        selected: TiltVideoExportModel.fps_index == idx;
                        picked => { TiltVideoExportModel.fps_index = idx; }
                    }
                }
            }

            Rectangle { height: 1px; background: Theme.surface-raised; }

            // Resolution -- square and 16:9 presets,
            // plus Custom (clamped to [128, 8192] per axis in Rust).
            VerticalLayout {
                spacing: 6px;
                Text { text: "Resolution"; font-size: 11px; font-weight: 600; color: Theme.text-secondary; }
                ComboBox {
                    accessible-label: "Video resolution";
                    model: [
                        "128 x 128", "256 x 256", "512 x 512", "1024 x 1024", "2048 x 2048", "4096 x 4096", "8192 x 8192",
                        "1280 x 720 (720p)", "1920 x 1080 (1080p)", "2560 x 1440 (1440p)", "3840 x 2160 (4K)", "7680 x 4320 (8K)",
                        "Custom"
                    ];
                    current-index <=> TiltVideoExportModel.resolution_preset;
                }
                if TiltVideoExportModel.resolution_preset == TiltVideoExportModel.custom_resolution_index(): HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        spacing: 2px;
                        Text { text: "Width (px)"; font-size: 10px; color: Theme.text-muted; }
                        SpinBox {
                            minimum: 128;
                            maximum: 8192;
                            step-size: 8;
                            accessible-label: "Video width in pixels";
                            value <=> TiltVideoExportModel.custom_width;
                        }
                    }
                    VerticalLayout {
                        spacing: 2px;
                        Text { text: "Height (px)"; font-size: 10px; color: Theme.text-muted; }
                        SpinBox {
                            minimum: 128;
                            maximum: 8192;
                            step-size: 8;
                            accessible-label: "Video height in pixels";
                            value <=> TiltVideoExportModel.custom_height;
                        }
                    }
                }
            }

            Rectangle { height: 1px; background: Theme.surface-raised; }

            // Quality -- same shape as the still-image export dialog's own
            // controls (power-of-two sample slider, bounce ladder, color
            // space), kept as this section's OWN state (see
            // `TiltVideoExportModel`'s own doc comment on why).
            VerticalLayout {
                spacing: 6px;
                Text { text: "Quality"; font-size: 11px; font-weight: 600; color: Theme.text-secondary; }
                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "Samples per pixel:"; font-size: 10px; color: Theme.text-muted; vertical-alignment: center; }
                    Text { text: Math.round(Math.pow(2.0, Math.round(TiltVideoExportModel.sample_exponent_raw))); font-size: 12px; font-weight: 700; color: Theme.accent-cyan; }
                }
                Slider {
                    minimum: 3;
                    maximum: 15;
                    step: 1;
                    accessible-label: "Samples per pixel, as a power of two";
                    value <=> TiltVideoExportModel.sample_exponent_raw;
                }

                // Advanced: the ray-bounce cap.
                if GuideModel.shows_advanced(): Text { text: "Max Ray Bounces"; font-size: 10px; color: Theme.text-muted; }
                if GuideModel.shows_advanced(): HorizontalLayout {
                    spacing: 4px;
                    for label[idx] in ["4", "8", "12", "24", "64", "128"]: SegmentPill {
                        height: 24px;
                        text: label;
                        hint: "Stop a light path after " + label + " bounces.";
                        selected: TiltVideoExportModel.selected_bounce_index == idx;
                        picked => { TiltVideoExportModel.selected_bounce_index = idx; }
                    }
                }

                // Advanced: the colour space.
                if GuideModel.shows_advanced(): Text { text: "Color Space"; font-size: 10px; color: Theme.text-muted; }
                if GuideModel.shows_advanced(): HorizontalLayout {
                    spacing: 4px;
                    for label[idx] in ["sRGB", "Display P3", "Rec.2020"]: SegmentPill {
                        height: 24px;
                        text: label;
                        hint: idx == 0
                            ? "Standard screen colours. The safe choice."
                            : (idx == 1
                                ? "Wider colours, for modern screens and phones."
                                : "Very wide colours for HDR video. Only some screens show them.");
                        selected: TiltVideoExportModel.selected_color_space_index == idx;
                        picked => { TiltVideoExportModel.selected_color_space_index = idx; }
                    }
                }

                // Transfer -- only with a remote configured; a
                // video always offers the remote its share (Compute is always Local +
                // Remote here), so no compute gate is needed. Advanced.
                if TiltVideoExportModel.remote_configured && GuideModel.shows_advanced(): Text { text: "Transfer"; font-size: 10px; color: Theme.text-muted; }
                if TiltVideoExportModel.remote_configured && GuideModel.shows_advanced(): HorizontalLayout {
                    spacing: 4px;
                    for label[idx] in ["Full data", "Final picture only"]: SegmentPill {
                        height: 24px;
                        text: label;
                        hint: idx == 0
                            ? "The remote sends its raw samples, so they combine with the ones traced here."
                            : "The remote sends one finished picture per frame. Much less data travels, but this computer does not help trace.";
                        selected: TiltVideoExportModel.transfer_index == idx;
                        picked => { TiltVideoExportModel.transfer_index = idx; }
                    }
                }
                if TiltVideoExportModel.remote_configured && GuideModel.shows_advanced() && TiltVideoExportModel.transfer_index == 1: Text {
                    text: "One finished PNG per frame from the remote -- far less data, but your own CPU/GPU do not help. A plain worker falls back to full data.";
                    font-size: 10px;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
            }

            Rectangle { height: 1px; background: Theme.surface-raised; }

            // Output -- shares the still-image export's own remembered
            // folder (`ExportModel.directory`); its OWN filename template,
            // which names a FOLDER (holding the numbered frames plus the
            // muxed video), not a single file.
            VerticalLayout {
                spacing: 6px;
                Text { text: "Output"; font-size: 11px; font-weight: 600; color: Theme.text-secondary; }
                Text {
                    text: "Folder: " + (ExportModel.directory == "" ? "chosen on first export..." : ExportModel.directory);
                    font-size: 10px;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
                // Advanced: the folder-name template and its field list.
                if GuideModel.shows_advanced(): Text { text: "Folder name template:"; font-size: 10px; color: Theme.text-muted; }
                if GuideModel.shows_advanced(): Rectangle {
                    height: 26px;
                    background: Theme.surface-chip;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: Theme.border-dialog;
                    LineEdit {
                        width: 100%;
                        height: 100%;
                        accessible-label: "Video folder name template";
                        text <=> TiltVideoExportModel.filename_template;
                    }
                }
                if GuideModel.shows_advanced(): Text {
                    text: "{design} {designer} {shape} {material} {ri} {width} {height} {spp} {bounces} {colorspace} {axis} {fps} {step} {start} {end} {frames} {date} {time} {timestamp}";
                    font-size: 11px;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
                Text {
                    text: "Resolves to: " + TiltVideoExportModel.preview_video_folder_name(TiltVideoExportModel.filename_template, root.selected_axis_index);
                    font-size: 11px;
                    font-weight: 600;
                    color: Theme.accent-cyan;
                    wrap: word-wrap;
                }
            }

            Rectangle { height: 1px; background: Theme.surface-raised; }

            // Overlay -- which tilt-performance values (if any) get drawn
            // into every frame; the display type (numbers-only / short
            // labels / full labels) is chosen automatically from how many
            // are selected and the frame's own width -- see
            // `gui::tilt::video_export::overlay::select_overlay_layout`.
            VerticalLayout {
                spacing: 6px;
                ToggleRow {
                    text: "Show Performance Values";
                    hint: "Write the brilliance, windowing and extinction numbers of the current angle onto every frame of the video.";
                    label_color: Theme.text-secondary;
                    checked: TiltVideoExportModel.show_values;
                    toggled => { TiltVideoExportModel.show_values = !TiltVideoExportModel.show_values; }
                }

                if TiltVideoExportModel.show_values: HorizontalLayout {
                    spacing: 6px;

                    ChipToggle {
                        text: "Brilliance";
                        hint: "Write the brilliance value on each frame.";
                        height: 22px;
                        active: TiltVideoExportModel.metric_brilliance;
                        accent: Theme.accent-cyan;
                        fill: Theme.tint-cyan;
                        toggled => { TiltVideoExportModel.metric_brilliance = !TiltVideoExportModel.metric_brilliance; }
                    }
                    ChipToggle {
                        text: "Windowing";
                        hint: "Write the windowing value on each frame.";
                        height: 22px;
                        active: TiltVideoExportModel.metric_windowing;
                        accent: Theme.accent-amber;
                        fill: Theme.tint-amber;
                        toggled => { TiltVideoExportModel.metric_windowing = !TiltVideoExportModel.metric_windowing; }
                    }
                    ChipToggle {
                        text: "Extinction";
                        hint: "Write the extinction value on each frame.";
                        height: 22px;
                        active: TiltVideoExportModel.metric_extinction;
                        accent: Theme.chart-extinction;
                        fill: Theme.tint-red;
                        toggled => { TiltVideoExportModel.metric_extinction = !TiltVideoExportModel.metric_extinction; }
                    }
                    ChipToggle {
                        text: "Tilt Brilliance";
                        hint: "Write the tilt brilliance score of the whole sweep on each frame.";
                        height: 22px;
                        active: TiltVideoExportModel.metric_tilt_brilliance;
                        accent: Theme.accent-purple;
                        fill: Theme.tint-purple;
                        toggled => { TiltVideoExportModel.metric_tilt_brilliance = !TiltVideoExportModel.metric_tilt_brilliance; }
                    }
                    ChipToggle {
                        text: "Angle";
                        hint: "Write the tilt angle on each frame.";
                        height: 22px;
                        active: TiltVideoExportModel.metric_angle;
                        accent: Theme.text-primary;
                        fill: Theme.tint-neutral;
                        toggled => { TiltVideoExportModel.metric_angle = !TiltVideoExportModel.metric_angle; }
                    }
                }

                ToggleRow {
                    text: "Keep PNG Frames After Muxing";
                    hint: "Keep the numbered picture files in the video's folder after the video is made. Off deletes them and keeps only the video.";
                    label_color: Theme.text-secondary;
                    checked: TiltVideoExportModel.keep_frames;
                    toggled => { TiltVideoExportModel.keep_frames = !TiltVideoExportModel.keep_frames; }
                }
            }

            // Large-run confirmation banner: appears once, after the first
            // Start click on a >2000-frame run; the Start button's own
            // label changes to prompt a second click (see below).
            if video_content.needs_confirmation && !TiltVideoExportModel.is_exporting: Rectangle {
                height: 40px;
                background: Theme.notice-surface;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.notice-accent;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    alignment: center;
                    Text {
                        text: "This will render " + video_content.computed_frame_count + " frames -- click Start again to confirm.";
                        font-size: 10px;
                        font-weight: 600;
                        color: Theme.notice-text;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            if TiltVideoExportModel.is_exporting: VerticalLayout {
                spacing: 4px;
                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "Frame " + TiltVideoExportModel.current_frame + " / " + TiltVideoExportModel.total_frames; font-size: 11px; color: Theme.text-secondary; }
                    Text { text: Math.round(TiltVideoExportModel.progress * 100) + "%"; font-size: 11px; font-weight: 700; color: Theme.accent-cyan; }
                }
                if TiltVideoExportModel.eta_text != "": Text {
                    text: TiltVideoExportModel.eta_text;
                    font-size: 10px;
                    color: Theme.text-muted;
                    horizontal-alignment: right;
                }
                Rectangle {
                    height: 8px;
                    border-radius: 4px;
                    background: Theme.surface-chip;
                    border-width: 1px;
                    border-color: Theme.border-dialog;
                    clip: true;
                    accessible-role: AccessibleRole.progress-indicator;
                    accessible-label: "Video export progress";
                    accessible-value: Math.round(TiltVideoExportModel.progress * 100) + " percent";
                    Rectangle {
                        x: 0;
                        y: 0;
                        width: parent.width * TiltVideoExportModel.progress;
                        height: 100%;
                        background: Theme.accent-cyan;
                        animate width { duration: 150ms; }
                    }
                }
            }

            if TiltVideoExportModel.status_message != "": Text {
                text: TiltVideoExportModel.status_message;
                font-size: 10px;
                color: TiltVideoExportModel.has_error ? Theme.danger : Theme.accent-emerald;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 8px;

                if TiltVideoExportModel.is_exporting: ActionButton {
                    horizontal-stretch: 1;
                    text: "Cancel";
                    hint: "Stop the video export.";
                    fill: Theme.danger-surface;
                    hover_fill: Theme.danger-surface-hover;
                    edge: Theme.danger-border;
                    ink: Theme.danger;
                    clicked => { TiltVideoExportModel.cancel_video_export(); }
                }

                // Saves this video as a render job (`gui::render_jobs`), with the same
                // large-run confirmation as Start Video Export below.
                if !TiltVideoExportModel.is_exporting: ActionButton {
                    width: 130px;
                    text: "Add to Queue";
                    hint: "Save this video as a render job instead of rendering now.";
                    ink: Theme.text-secondary;
                    clicked => {
                        if video_content.needs_confirmation {
                            root.confirmed_large_run = true;
                        } else {
                            RenderJobsModel.add_tilt_video_job(root.selected_axis_index);
                        }
                    }
                }

                if !TiltVideoExportModel.is_exporting: ActionButton {
                    horizontal-stretch: 1;
                    text: video_content.needs_confirmation ? "Review " + video_content.computed_frame_count + " Frames" : "Start Video Export";
                    hint: video_content.needs_confirmation
                        ? "This is a long run. Press once to confirm the number of frames, then press again to start."
                        : "Render every frame of the sweep and join them into a video.";
                    fill: Theme.accent-cyan;
                    hover_fill: Theme.accent-cyan-hover;
                    edge: Theme.accent-cyan;
                    ink: Theme.text-on-accent;
                    weight: 700;
                    clicked => {
                        if video_content.needs_confirmation {
                            root.confirmed_large_run = true;
                        } else {
                            TiltVideoExportModel.start_video_export(root.selected_axis_index);
                        }
                    }
                }
            }
        }
    }
}
