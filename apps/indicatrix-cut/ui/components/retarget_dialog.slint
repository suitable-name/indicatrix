import { ComboBox, LineEdit, ScrollView, Slider } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { RetargetRowItem } from "../types.slint";
import { RetargetModel } from "../models/retarget.slint";
import { StaleBadge } from "stale_badge.slint";

export { RetargetRowItem }

export component RetargetDialog inherits Rectangle {
    callback close();
    close => { RetargetModel.is_open = false; RetargetModel.close(); }

    property <bool> can_apply: RetargetModel.rows.length > 0 && RetargetModel.anchored_tier_errors.length == 0 && RetargetModel.solve_error == "" && !RetargetModel.is_busy;

    // This same modal shell is reused for the "Compare to Snapshot" panel
    // (`compare_panel` below) -- there is no `app.slint` export to wire up a
    // second dialog component, and Compare needs no target-material machinery
    // of its own, so it piggybacks on this one rather than inventing a second
    // mechanism.
    visible: RetargetModel.is_open || RetargetModel.compare_open;
    background: Theme.overlay-backdrop;

    TouchArea {
        clicked => {
            if (RetargetModel.compare_open) {
                RetargetModel.compare_close();
            } else if (!RetargetModel.is_busy) {
                root.close();
            }
        }
    }

    // This component stays instantiated the whole time (`visible: RetargetModel.
    // is_open`, never wrapped in an `if`), so `init => { self.focus(); }` alone
    // (the idiom `new_design_dialog.slint`/`material_editor_dialog.slint` use)
    // would only ever fire once, the first time the dialog is ever opened. Mirrors
    // `RetargetModel.is_open` into a local property instead and watches THAT with
    // `changed`, so this re-focuses every time the dialog reopens -- `self.…`,
    // not `root.…`, in the handler, matching this codebase's own
    // `changed`-handler trap (a global's own property can't be watched directly).
    // Escape closes (unless a search is running, matching the header X/backdrop's
    // own busy guard); Return applies when the proposal is ready. Every other key
    // is swallowed (`accept`) so it cannot bubble to `global_shortcuts` and fire a
    // shortcut on the design underneath.
    key_scope := FocusScope {
        property <bool> open_mirror: RetargetModel.is_open || RetargetModel.compare_open;
        changed open_mirror => {
            if (self.open_mirror) {
                self.focus();
            }
        }
        key-pressed(event) => {
            if event.text == Key.Escape {
                if (RetargetModel.compare_open) {
                    RetargetModel.compare_close();
                } else if (!RetargetModel.is_busy) {
                    root.close();
                }
                return accept;
            } else if event.text == Key.Return {
                if (!RetargetModel.compare_open && root.can_apply) {
                    RetargetModel.apply();
                }
                return accept;
            }
            accept
        }
    }

    Rectangle {
        width: 560px;
        height: min(680px, root.height - 40px);
        background: Theme.surface-dialog;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: Theme.border-dialog;
        drop-shadow-blur: 24px;
        drop-shadow-color: Theme.modal-shadow;
        clip: true;

        TouchArea {} // Isolate clicks inside the modal.

        if RetargetModel.compare_open: VerticalLayout {
            padding: 16px;
            spacing: 12px;

            // "Compare to Snapshot" -- reuses this same dialog shell (see
            // `visible`'s own doc comment above) rather than a second dialog
            // component, and this table's row shape rather than a new struct:
            // `compare_rows` is a `[RetargetRowItem]` like `rows` above, with
            // `block` blank, `margin` repurposed to the signed mast delta, and
            // `risk_label`/`risk_color` repurposed as a plain Same/Changed/Added/
            // Removed status badge instead of a windowing risk (see
            // `callbacks::retarget_actions::diff_rows_from_deltas`'s own doc
            // comment for exactly why each field means what it does here).
            HorizontalLayout {
                alignment: space-between;
                HorizontalLayout {
                    spacing: 8px;
                    Image { source: @image-url("../icons/gem.svg"); colorize: Theme.text-primary; width: 15px; height: 15px; vertical-alignment: center; }
                    Text { text: "Compare to Snapshot"; font-size: 14px; font-weight: 700; color: Theme.text-primary; vertical-alignment: center; }
                }
                Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: Theme.radius-sm;
                    background: compare_close_touch.has-hover ? Theme.surface-control-hover : Theme.surface-control;
                    compare_close_touch := TouchArea {
                        clicked => { RetargetModel.compare_close(); }
                    }
                    Image { source: @image-url("../icons/close.svg"); colorize: Theme.text-muted; width: 12px; height: 12px; horizontal-alignment: center; vertical-alignment: center; }
                }
            }

            Rectangle { height: 1px; background: Theme.surface-raised; }

            Text {
                text: RetargetModel.compare_label;
                font-size: 11px;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }

            HorizontalLayout {
                padding-right: 10px;
                spacing: 6px;
                Text { text: "Tier"; font-size: 10px; font-weight: 700; color: Theme.text-muted; horizontal-stretch: 1; }
                Text { text: "Before"; font-size: 10px; font-weight: 700; color: Theme.text-muted; width: 60px; horizontal-alignment: right; }
                Text { text: "After"; font-size: 10px; font-weight: 700; color: Theme.text-muted; width: 60px; horizontal-alignment: right; }
                Text { text: "Mast \u{394}"; font-size: 10px; font-weight: 700; color: Theme.text-muted; width: 60px; horizontal-alignment: right; }
                Text { text: "Status"; font-size: 10px; font-weight: 700; color: Theme.text-muted; width: 64px; horizontal-alignment: right; }
            }

            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 2px;
                    for row in RetargetModel.compare_rows: Rectangle {
                        height: 24px;
                        border-radius: Theme.radius-sm;
                        background: Theme.surface-sunken;

                        Tooltip { text: @markdown("Tier #\{row.tier_index} \"\{row.name}\""); }

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 10px;
                            spacing: 6px;
                            Text { text: row.name; font-size: 11px; color: Theme.text-primary; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
                            Text { text: row.old_angle; font-size: 11px; color: Theme.text-secondary; width: 60px; horizontal-alignment: right; vertical-alignment: center; }
                            Text { text: row.new_angle; font-size: 11px; font-weight: 700; color: Theme.accent-cyan; width: 60px; horizontal-alignment: right; vertical-alignment: center; }
                            Text { text: row.margin; font-size: 11px; color: Theme.text-secondary; width: 60px; horizontal-alignment: right; vertical-alignment: center; }
                            Text { text: row.risk_label; font-size: 11px; font-weight: 700; color: row.risk_color; width: 64px; horizontal-alignment: right; vertical-alignment: center; }
                        }
                    }
                }
            }

            Rectangle { height: 1px; background: Theme.surface-raised; }

            Rectangle {
                height: 32px;
                border-radius: Theme.radius-sm;
                background: compare_done_touch.has-hover ? Theme.surface-control-hover : Theme.surface-control;
                border-width: 1px;
                border-color: Theme.border-dialog;
                compare_done_touch := TouchArea {
                    clicked => { RetargetModel.compare_close(); }
                }
                Text { text: "Close"; font-size: 12px; font-weight: 700; color: Theme.text-primary; horizontal-alignment: center; vertical-alignment: center; }
            }
        }

        if !RetargetModel.compare_open: VerticalLayout {
            padding: 16px;
            spacing: 12px;

            // 1. Header
            HorizontalLayout {
                alignment: space-between;
                HorizontalLayout {
                    spacing: 8px;
                    // Uses the gem icon, not a save icon, since Retarget previews a
                    // material swap that is applied only via the footer's own
                    // explicit "Apply" button below.
                    Image { source: @image-url("../icons/gem.svg"); colorize: Theme.text-primary; width: 15px; height: 15px; vertical-alignment: center; }
                    Text { text: "Retarget for Material"; font-size: 14px; font-weight: 700; color: Theme.text-primary; vertical-alignment: center; }
                }
                Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: Theme.radius-sm;
                    background: close_touch.has-hover ? Theme.surface-control-hover : Theme.surface-control;
                    close_touch := TouchArea {
                        clicked => { if (!RetargetModel.is_busy) { root.close(); } }
                    }
                    Image { source: @image-url("../icons/close.svg"); colorize: Theme.text-muted; width: 12px; height: 12px; horizontal-alignment: center; vertical-alignment: center; }
                }
            }

            Rectangle { height: 1px; background: Theme.surface-raised; }

            // 2. Target material picker -- owned by this dialog (see
            // `RetargetModel.target_material_index`'s own doc comment), not the
            // design settings panel's combo.
            VerticalLayout {
                spacing: 6px;
                Rectangle {
                    height: target_picker_lbl.preferred-height;
                    Tooltip { text: @markdown("The material this proposal retargets TO. Starts at the design's own current material when the dialog opens; pick another to preview retargeting onto it."); }
                    target_picker_lbl := Text { text: "Target Material"; font-size: 11px; font-weight: 600; color: Theme.text-secondary; }
                }
                HorizontalLayout {
                    spacing: 6px;
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 30px;
                        background: Theme.surface-raised;
                        border-radius: Theme.radius-sm;
                        border-width: 1px;
                        border-color: Theme.border-dialog;
                        ComboBox {
                            model: RetargetModel.material_options;
                            current-index <=> RetargetModel.target_material_index;
                            enabled: !RetargetModel.is_busy;
                            selected(val) => { RetargetModel.proposal_changed(); }
                        }
                    }
                    Rectangle {
                        width: 96px;
                        height: 30px;
                        background: Theme.surface-raised;
                        border-radius: Theme.radius-sm;
                        border-width: 1px;
                        border-color: Theme.border-dialog;
                        LineEdit {
                            text <=> RetargetModel.target_ri_override_text;
                            placeholder-text: "Custom n_D";
                            enabled: !RetargetModel.is_busy;
                            edited => { RetargetModel.proposal_changed(); }
                        }
                    }
                }
            }

            // 3. Target material readout -- the RESOLVED result of the picker above.
            // The name shown is derived from the picker's own `MaterialSelection`
            // (Rust side, `retarget_actions::target_display_name`), not the resolved
            // `GemMaterial`, so "(none)"/a typed custom RI never show as "Diamond".
            // An RI override that fails to parse is surfaced below as its own error
            // line rather than silently falling back to the design's OLD material
            // with no sign anything was typed wrong.
            Rectangle {
                height: target_row.preferred-height + 12px;
                border-radius: Theme.radius-sm;
                background: Theme.surface-sunken;
                border-width: 1px;
                border-color: Theme.border-dialog;

                Tooltip { text: @markdown("The material the picker above resolves to -- what this proposal actually retargets TO."); }

                target_row := HorizontalLayout {
                    padding: 8px;
                    spacing: 14px;
                    Text { text: "Target:"; font-size: 11px; color: Theme.text-muted; vertical-alignment: center; }
                    Text { text: RetargetModel.target_material_name; font-size: 12px; font-weight: 700; color: Theme.text-primary; vertical-alignment: center; horizontal-stretch: 1; }
                    Text { text: "n_D " + RetargetModel.target_material_ri; font-size: 11px; color: Theme.text-secondary; vertical-alignment: center; }
                    Text { text: "critical " + RetargetModel.target_critical_angle; font-size: 11px; color: Theme.text-secondary; vertical-alignment: center; }
                }
            }

            if RetargetModel.target_material_error != "": Text {
                text: "\u{26a0} " + RetargetModel.target_material_error + " Showing the last valid target; nothing below reflects this text.";
                font-size: 10px;
                font-weight: 600;
                color: Theme.accent-ruby;
                wrap: word-wrap;
            }

            // 4. Mode selector
            VerticalLayout {
                spacing: 6px;
                Rectangle {
                    height: mode_lbl.preferred-height;
                    Tooltip { text: @markdown("Shift keeps every pavilion tier's own margin over the critical angle fixed -- deterministic, always available. Optimize seeds from that same shift, then searches free (non-anchored) tiers for the target material's own best score."); }
                    mode_lbl := Text { text: "Mode"; font-size: 11px; font-weight: 600; color: Theme.text-secondary; }
                }

                HorizontalLayout {
                    spacing: 4px;

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 28px;
                        border-radius: Theme.radius-sm;
                        background: RetargetModel.mode_index == 0 ? Theme.accent-cyan : (shift_touch.has-hover ? Theme.surface-raised : Theme.surface-sunken);
                        border-width: 1px;
                        border-color: RetargetModel.mode_index == 0 ? Theme.accent-cyan : Theme.border-dialog;

                        shift_touch := TouchArea {
                            enabled: !RetargetModel.is_busy;
                            clicked => { RetargetModel.mode_index = 0; RetargetModel.proposal_changed(); }
                        }

                        Text { text: "Shift"; font-size: 11px; font-weight: 600; color: RetargetModel.mode_index == 0 ? Theme.text-on-accent : Theme.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 28px;
                        border-radius: Theme.radius-sm;
                        background: RetargetModel.mode_index == 1 ? Theme.accent-cyan : (optimize_touch.has-hover ? Theme.surface-raised : Theme.surface-sunken);
                        border-width: 1px;
                        border-color: RetargetModel.mode_index == 1 ? Theme.accent-cyan : Theme.border-dialog;

                        optimize_touch := TouchArea {
                            enabled: !RetargetModel.is_busy;
                            clicked => { RetargetModel.mode_index = 1; RetargetModel.proposal_changed(); }
                        }

                        Text { text: "Optimize"; font-size: 11px; font-weight: 600; color: RetargetModel.mode_index == 1 ? Theme.text-on-accent : Theme.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }

            // While on, the shared solid viewport shows THIS proposal's own
            // candidate geometry instead of the live design, so a cutter can see
            // whether the retargeted pavilion still closes before ever clicking
            // Apply -- reverted the instant this is switched back off
            // (`callbacks::retarget_actions::apply_ghost_preview_or_revert`).
            Rectangle {
                height: 22px;
                Tooltip { text: @markdown("Show this proposal's candidate geometry live in the viewport instead of the current design."); }

                HorizontalLayout {
                    spacing: 6px;
                    Rectangle {
                        width: 14px;
                        height: 14px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 3px;
                        background: RetargetModel.preview_enabled ? Theme.accent-cyan : transparent;
                        border-width: 1px;
                        border-color: RetargetModel.preview_enabled ? Theme.accent-cyan : Theme.border-control;

                        if RetargetModel.preview_enabled: Image {
                            source: @image-url("../icons/check.svg");
                            colorize: Theme.text-on-accent;
                            width: 9px;
                            height: 9px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        preview_touch := TouchArea {
                            clicked => {
                                RetargetModel.preview_enabled = !RetargetModel.preview_enabled;
                                RetargetModel.proposal_changed();
                            }
                        }
                    }
                    Text { text: "Preview in viewport"; font-size: 11px; color: Theme.text-secondary; vertical-alignment: center; }
                }
            }

            // 5. Crown handling
            VerticalLayout {
                spacing: 6px;
                Rectangle {
                    height: crown_lbl.preferred-height;
                    Tooltip { text: @markdown("How crown tiers follow the pavilion's critical-angle move. Default (0%) leaves the crown untouched, matching common faceting practice."); }
                    crown_lbl := Text { text: "Crown Handling"; font-size: 11px; font-weight: 600; color: Theme.text-secondary; }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "Fraction of shift:"; font-size: 10px; color: Theme.text-muted; vertical-alignment: center; }
                    // A std-widgets `Slider` gets keyboard/drag/click support for
                    // free, and `step` lands on round 5% increments without the
                    // pixel-hunting a hand-rolled mouse-x/width drag bar would need.
                    crown_slider := Slider {
                        horizontal-stretch: 1;
                        minimum: 0.0;
                        maximum: 1.0;
                        step: 0.05;
                        value <=> RetargetModel.crown_fraction;
                        enabled: !RetargetModel.is_busy && !RetargetModel.scale_crown_by_ratio;
                        changed(val) => { RetargetModel.proposal_changed(); }
                    }
                    Rectangle {
                        width: 40px;
                        height: 22px;
                        y: (parent.height - self.height) / 2;
                        border-radius: Theme.radius-sm;
                        background: Theme.surface-sunken;
                        border-width: 1px;
                        border-color: Theme.border-dialog;
                        crown_pct_edit := LineEdit {
                            enabled: !RetargetModel.is_busy && !RetargetModel.scale_crown_by_ratio;
                            horizontal-alignment: center;
                            // Bare digits, no "%" -- `to-float()` below needs the
                            // whole string to be a number. Reflects the slider/model
                            // whenever this field isn't the one being typed into --
                            // `accepted` is the only path that writes the model, so
                            // there is no binding fight while a cutter is mid-edit.
                            text: Math.round(RetargetModel.crown_fraction * 100);
                            accepted => {
                                RetargetModel.crown_fraction = max(0.0, min(1.0, self.text.to-float() / 100));
                                RetargetModel.proposal_changed();
                            }
                        }
                    }
                    Text { text: "%"; font-size: 11px; font-weight: 700; color: Theme.accent-cyan; vertical-alignment: center; }
                }

                Rectangle {
                    height: 22px;
                    Tooltip { text: @markdown("Instead of a fraction of the pavilion's shift, scale every crown tier's own raw angle by the ratio of the two materials' critical angles."); }

                    HorizontalLayout {
                        spacing: 6px;
                        Rectangle {
                            width: 14px;
                            height: 14px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 3px;
                            background: RetargetModel.scale_crown_by_ratio ? Theme.accent-cyan : transparent;
                            border-width: 1px;
                            border-color: RetargetModel.scale_crown_by_ratio ? Theme.accent-cyan : Theme.border-control;

                            if RetargetModel.scale_crown_by_ratio: Image {
                                source: @image-url("../icons/check.svg");
                                colorize: Theme.text-on-accent;
                                width: 9px;
                                height: 9px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            ratio_touch := TouchArea {
                                enabled: !RetargetModel.is_busy;
                                clicked => {
                                    RetargetModel.scale_crown_by_ratio = !RetargetModel.scale_crown_by_ratio;
                                    RetargetModel.proposal_changed();
                                }
                            }
                        }
                        Text { text: "Scale crown by ratio instead"; font-size: 11px; color: Theme.text-secondary; vertical-alignment: center; }
                    }
                }
            }

            Rectangle { height: 1px; background: Theme.surface-raised; }

            // 6. Errors: shown instead of the table whenever the current mode/crown
            // combination cannot produce a valid proposal.
            if RetargetModel.solve_error != "": Text {
                text: "Design does not solve: " + RetargetModel.solve_error;
                font-size: 11px;
                font-weight: 600;
                color: Theme.danger;
                wrap: word-wrap;
            }
            if RetargetModel.anchored_tier_errors.length > 0: VerticalLayout {
                spacing: 4px;
                Text {
                    text: "Adopt these tiers' meet constraint before optimizing (Edit tab -> tier list -> Adopt Meet):";
                    font-size: 11px;
                    font-weight: 600;
                    color: Theme.accent-amber;
                    wrap: word-wrap;
                }
                for line in RetargetModel.anchored_tier_errors: Text {
                    text: "• " + line;
                    font-size: 11px;
                    color: Theme.text-secondary;
                }
            }

            // 7. The proposal table -- one row per pavilion/crown tier.
            if RetargetModel.solve_error == "" && RetargetModel.anchored_tier_errors.length == 0: VerticalLayout {
                vertical-stretch: 1;
                spacing: 4px;

                // Shown when this proposal was computed against a design generation
                // that has since moved on (`RetargetModel.stale`, `gui::editor::stale`'s
                // own doc comment) -- "Recompute" rebuilds against the live
                // design/current controls, exactly what changing any control here
                // already does.
                if RetargetModel.stale && !RetargetModel.is_busy: StaleBadge {
                    recompute => { RetargetModel.proposal_changed(); }
                }

                HorizontalLayout {
                    padding-right: 10px;
                    spacing: 6px;
                    Text { text: "Block"; font-size: 10px; font-weight: 700; color: Theme.text-muted; width: 56px; }
                    Text { text: "Tier"; font-size: 10px; font-weight: 700; color: Theme.text-muted; horizontal-stretch: 1; }
                    Text { text: "Old"; font-size: 10px; font-weight: 700; color: Theme.text-muted; width: 60px; horizontal-alignment: right; }
                    Text { text: "New"; font-size: 10px; font-weight: 700; color: Theme.text-muted; width: 60px; horizontal-alignment: right; }
                    Text { text: "Margin"; font-size: 10px; font-weight: 700; color: Theme.text-muted; width: 60px; horizontal-alignment: right; }
                    Text { text: "Risk"; font-size: 10px; font-weight: 700; color: Theme.text-muted; width: 64px; horizontal-alignment: right; }
                }

                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 2px;
                        for row in RetargetModel.rows: Rectangle {
                            height: 24px;
                            border-radius: Theme.radius-sm;
                            background: Theme.surface-sunken;

                            Tooltip { text: @markdown("Tier #\{row.tier_index} \"\{row.name}\" (\{row.block})"); }

                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 10px;
                                spacing: 6px;
                                Text { text: row.block; font-size: 10px; color: Theme.text-muted; width: 56px; vertical-alignment: center; }
                                Text { text: row.name; font-size: 11px; color: Theme.text-primary; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
                                Text { text: row.old_angle; font-size: 11px; color: Theme.text-secondary; width: 60px; horizontal-alignment: right; vertical-alignment: center; }
                                Text { text: row.new_angle; font-size: 11px; font-weight: 700; color: Theme.accent-cyan; width: 60px; horizontal-alignment: right; vertical-alignment: center; }
                                Text { text: row.margin; font-size: 11px; color: Theme.text-secondary; width: 60px; horizontal-alignment: right; vertical-alignment: center; }
                                Text { text: row.risk_label; font-size: 11px; font-weight: 700; color: row.risk_color; width: 64px; horizontal-alignment: right; vertical-alignment: center; }
                            }
                        }
                    }
                }
            }

            // 8. Notes
            if RetargetModel.notes.length > 0: VerticalLayout {
                spacing: 2px;
                for line in RetargetModel.notes: Text {
                    text: line;
                    font-size: 10px;
                    font-italic: true;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
            }

            if RetargetModel.is_busy: Text {
                text: RetargetModel.optimize_max_evaluations > 0
                    ? "Optimizing... " + RetargetModel.optimize_evaluations + " / " + RetargetModel.optimize_max_evaluations + " evaluations"
                    : "Optimizing...";
                font-size: 11px;
                font-weight: 600;
                color: Theme.accent-cyan;
            }

            Rectangle { height: 1px; background: Theme.surface-raised; }

            // 9. Footer
            HorizontalLayout {
                spacing: 8px;

                Rectangle {
                    width: 90px;
                    height: 32px;
                    border-radius: Theme.radius-sm;
                    background: cancel_touch.has-hover ? Theme.surface-raised : Theme.surface-sunken;
                    border-width: 1px;
                    border-color: Theme.border-dialog;

                    // While busy this cancels the running Optimize search instead of
                    // closing the dialog -- see `RetargetModel.cancel_optimize`'s own
                    // doc comment. Always enabled (unlike the header's X and the
                    // backdrop click, which stay disabled while busy): this is the
                    // one control that can actually stop a running search.
                    cancel_touch := TouchArea {
                        clicked => {
                            if (RetargetModel.is_busy) {
                                RetargetModel.cancel_optimize();
                            } else {
                                root.close();
                            }
                        }
                    }

                    Text { text: "Cancel"; font-size: 11px; font-weight: 600; color: Theme.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    height: 32px;
                    border-radius: Theme.radius-sm;
                    opacity: root.can_apply ? 1.0 : 0.45;
                    background: apply_touch.has-hover && root.can_apply ? Theme.accent-cyan-hover : Theme.accent-cyan;

                    Tooltip { text: @markdown("Pushes one undoable edit retargeting every listed tier, then re-solves the design."); }

                    apply_touch := TouchArea {
                        enabled: root.can_apply;
                        clicked => { RetargetModel.apply(); }
                    }

                    Text { text: "Apply"; font-size: 12px; font-weight: 700; color: Theme.text-on-accent; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }
    }
}
