import { Theme } from "../theme.slint";
import { CheckBox, ScrollView } from "std-widgets.slint";
import { BatchModel } from "../models/batch.slint";
import { HelpTopics } from "../models/help.slint";
import { HelpButton } from "help_button.slint";
import { TipButton } from "compact_controls.slint";
import { TipBox } from "tip_box.slint";
import { SegmentPill } from "pill_button.slint";
import { SettingsModel } from "../models/settings.slint";
import { SliderRow } from "parameters_panel/parts.slint";

// Batch design-preview generation (Task: rendered design previews, batch generation
// with two-level progress). One component, two states:
//
// - `confirming: true` -- the "N designs -- Generate previews now?" confirm step
//   opened by `gui::batch::preview::offer_batch_confirmation` for BOTH triggers #1
//   (post-import) and #2 (missing-previews library scan); see that function's own doc
//   comment for why both share this one code path.
// - `confirming: false` -- the running/done progress view: two progress bars (overall
//   design `i`/`N`, and within-design image `j`/2 -- front then top), a Cancel button
//   while `running`, and a summary + Close button once `done`.
//
// Follows this app's existing full-viewport-backdrop modal convention
// (`metadata_editor_dialog.slint`/`material_editor_dialog.slint`), content-sized rather
// than a fixed height (same "wrap the card around whatever state is showing" idiom
// those two already use) -- EXCEPT it deliberately has no backdrop-click-to-dismiss:
// this dialog can represent an ACTIVE background batch job, and losing that state to a
// stray click outside it would be a worse mistake than the minor inconvenience of
// requiring an explicit button.
// `LiveComputeTarget::Both` runs `batch_queue::local_lane_count` local lanes plus a
// remote dispatcher concurrently (`gui::batch::preview`'s module doc comment, "Local +
// remote" section), pulling ONE-VIEW items off one shared queue -- so `design_index` is
// a COMPLETED count, not a current-item cursor. With N local lanes each possibly
// mid-item at once, no single title/image-index pair can describe "the" local lane's
// progress any more, so `local_active`/`local_lane_total` report a plain busy-count
// instead (see `gui::batch::preview`'s module doc comment's "Progress with N local lanes
// (plus remote) in flight" section). `remote_active`/`remote_in_flight`/`remote_title`
// describe the REMOTE side: `remote_batch_lanes` dispatchers each keep one item in
// flight, so the row shows how many items are on the remote right now and the item a
// dispatcher started most recently (same module's own doc comment).
export component PreviewBatchDialog inherits Rectangle {
    in property <bool> confirming: BatchModel.preview_confirming;
    in property <int> offer_count: BatchModel.preview_offer_count;
    in property <bool> running: BatchModel.preview_batch_running;
    in property <int> design_index: BatchModel.preview_design_index;
    in property <int> design_total: BatchModel.preview_design_total;
    in property <string> eta: BatchModel.preview_eta;
    in property <int> local_active: BatchModel.preview_local_active;
    in property <int> local_lane_total: BatchModel.preview_local_lane_total;
    in property <string> remote_title: BatchModel.preview_remote_title;
    in property <bool> remote_active: BatchModel.preview_remote_active;
    in property <int> remote_in_flight: BatchModel.preview_remote_in_flight;
    in property <bool> done: BatchModel.preview_done;
    in property <string> summary: BatchModel.preview_summary;
    in property <bool> offer_regenerate: BatchModel.preview_offer_regenerate;
    in property <bool> from_import: BatchModel.preview_offer_from_import;

    callback generate_confirmed();
    generate_confirmed => { BatchModel.preview_generate_confirmed(); }
    callback generate_ray_confirmed();
    generate_ray_confirmed => { BatchModel.preview_generate_ray_confirmed(); }
    callback generate_solid_confirmed();
    generate_solid_confirmed => { BatchModel.preview_generate_solid_confirmed(); }
    callback dismiss_offer();
    dismiss_offer => { BatchModel.preview_dismiss_offer(); }
    callback cancel();
    cancel => { BatchModel.preview_cancel(); }
    callback close();
    close => { BatchModel.preview_close(); }

    // The regenerate confirm step offers "missing or outdated only" or "all"; the first has
    // nothing to start while its scan is still counting (-1) or found nothing (0).
    //
    // Changing a picture-quality slider below re-counts the designs for the new values
    // (`gui::batch::preview::offer_quality`): `counting` is true from the change until the new
    // list lands, and Generate stays off meanwhile so it can never start the old list. A startup
    // offer whose re-count finds nothing (`nothing_to_offer`) keeps only Not Now.
    property <bool> counting: BatchModel.preview_offer_counting;
    property <bool> nothing_to_offer: root.confirming
        && !root.offer_regenerate
        && !root.from_import
        && !root.counting
        && root.offer_count <= 0;
    property <bool> can_start: !root.counting
        && !root.nothing_to_offer
        && !(root.offer_regenerate
            && (root.running
                || (BatchModel.preview_offer_missing_only && BatchModel.preview_offer_missing_count <= 0)));

    property <float> design_fraction: root.design_total > 0
        ? (root.design_index * 1.0) / root.design_total
        : 0.0;
    // `* 1.0` forces float division rather than Slint's integer division truncating.
    property <float> local_fraction: root.local_lane_total > 0
        ? (root.local_active * 1.0) / root.local_lane_total
        : 0.0;

    background: Theme.overlay-backdrop;

    // The card is wrapped in centering layouts rather than being a bare child with an
    // explicit `height`. That is load-bearing, not cosmetic:
    //
    // A child of a plain `Rectangle` is not laid out -- it defaults to filling its
    // parent -- so the card previously carried `height: card.preferred-height` to size
    // itself to its content. That silently under-measures: the card's `Text` elements
    // use `wrap: word-wrap`, and a wrapped text's preferred height is only meaningful
    // once its WIDTH is known. Queried that way it resolved against an unconstrained
    // width (as if each paragraph were one long line), so the card came out far shorter
    // than its content, and `clip: true` cut the overflow away -- taking the buttons at
    // the bottom with it. The dialog rendered as truncated text with nothing clickable.
    //
    // Centring alone did NOT fix it, though -- that was the first attempt. Slint
    // measures a wrapped Text's preferred height as one unwrapped line whether it is
    // asked directly or via a layout, so the card stayed too short either way. The
    // actual fix is on the card itself: a stated height plus a scrollable body between
    // a fixed title and fixed buttons. See the `height` binding below.
    //
    // The keyboard stays inside the card: Tab moves between its buttons, Enter takes the
    // main button, Escape declines the offer (or closes the finished summary), and every
    // other key is swallowed so a shortcut cannot fire on the design behind. A batch that is
    // running ignores Escape: stopping it is the Cancel button's job.
    // A full-window backdrop: clicks beside the card must not reach the design behind it.
    TouchArea {
        width: 100%;
        height: 100%;
    }

    FocusScope {
        width: 100%;
        height: 100%;
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Tab {
                return reject;
            }
            if event.text == Key.Escape {
                if root.confirming {
                    root.dismiss_offer();
                } else if root.done {
                    root.close();
                }
            } else if event.text == Key.Return {
                if root.confirming {
                    if root.can_start {
                        root.generate_confirmed();
                    }
                } else if root.done {
                    root.close();
                }
            }
            return accept;
        }

    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: 380px;
                // Explicit, and deliberately NOT derived from the content -- see
                // `tilt_batch_dialog.slint`'s identical comment for the full reasoning.
                // Short version: Slint measures a `wrap: word-wrap` Text's preferred
                // height as one unwrapped line, so any content-derived height
                // under-measures and `clip: true` then cuts the buttons off. Stating the
                // height and scrolling the body between a fixed title and fixed buttons
                // makes them structurally impossible to clip.
                // The confirm step holds the fixed "Picture Quality" block (heading,
                // renderer and backdrop pills, two sliders, a two-line note) between the scrolling body
                // and the buttons. Its height follows what the offer shows: the plain
                // offer, plus the scope pills and warning of a regenerate offer, plus the
                // note, checkbox and quick buttons of an import offer. A flat 680px left the
                // plain offer's two short paragraphs stretched apart; a body that needs
                // more than its share still scrolls, so the buttons can never be clipped.
                height: root.confirming
                    ? Math.min(
                        root.height - 96px,
                        520px + (root.offer_regenerate ? 110px : 0px) + (root.from_import ? 150px : 0px))
                    : Math.min(root.height - 96px, root.done ? 240px : 340px);
                background: Theme.surface-dialog;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border-dialog;
                drop-shadow-blur: 24px;
                drop-shadow-color: Theme.modal-shadow;
                clip: true;

                // Swallows clicks so they never reach anything behind this dialog -- same
                // idiom `metadata_editor_dialog.slint`'s own inner card uses.
                TouchArea {}

                card := VerticalLayout {
                    padding: 18px;
                    spacing: 12px;

                    if root.confirming: VerticalLayout {
                        spacing: 12px;

                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                horizontal-stretch: 1;
                                text: "Generate Preview Images?";
                                font-size: 14px;
                                font-weight: 700;
                                color: Theme.text-primary;
                                vertical-alignment: center;
                                accessible-role: AccessibleRole.text;
                            }
                            VerticalLayout {
                                alignment: center;
                                HelpButton {
                                    topic: HelpTopics.library-details;
                                    hint: "Open the manual page on previews and tilt curves";
                                }
                            }
                        }
                        // Body between the fixed title above and the fixed buttons
                        // below -- see the card's `height` comment for why the buttons
                        // must live OUTSIDE this scrollable region.
                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                // Top-aligned: the body's spare height stays below the text
                                // instead of being spread between the paragraphs.
                                alignment: start;
                                spacing: 10px;
                                Text {
                                    text: root.offer_regenerate
                                        ? "Which designs should get fresh front and top views? Previews a chosen design already has are replaced."
                                        : (root.counting
                                            ? "Counting..."
                                            : (root.nothing_to_offer
                                                ? "All designs already have pictures at these settings."
                                                : (root.offer_count == 1
                                                    ? "1 design has no rendered preview yet. Generate a front and top view for it now?"
                                                    : root.offer_count + " designs have no rendered preview yet. Generate front and top views for them now?")));
                                    font-size: 12px;
                                    color: Theme.text-secondary;
                                    wrap: word-wrap;
                                }
                                // The scope choice: only the regenerate commands show it. The
                                // startup and import offers already hold exactly the missing set.
                                if root.offer_regenerate: VerticalLayout {
                                    spacing: 6px;
                                    SegmentPill {
                                        text: BatchModel.preview_offer_missing_label;
                                        hint: "Render only the designs with no preview, a missing view, or a preview made with other render settings.";
                                        selected: BatchModel.preview_offer_missing_only;
                                        picked => { BatchModel.preview_offer_missing_only = true; }
                                    }
                                    SegmentPill {
                                        text: BatchModel.preview_offer_all_label;
                                        hint: "Render every design again, replacing the previews it has.";
                                        selected: !BatchModel.preview_offer_missing_only;
                                        picked => { BatchModel.preview_offer_missing_only = false; }
                                    }
                                }
                                if root.offer_regenerate && root.running: Text {
                                    text: "A preview batch is already running -- wait for it to finish or cancel it first.";
                                    font-size: 11px;
                                    color: Theme.accent-amber;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: "This renders in the background -- you can keep browsing while it runs, and cancel at any time without losing what's already been generated.";
                                    font-size: 11px;
                                    color: Theme.text-muted;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        // The two settings that decide how the pictures look, shown for every trigger in
                        // both interfaces: the same sliders, ranges, steps and callbacks as the Render &
                        // Output tab's "Library Thumbnails" group, so a change persists exactly as there. A
                        // change re-counts the offer (`gui::batch::preview::offer_quality`). Fixed, outside
                        // the scroll body, so it is always reachable. The note has a stated height for the
                        // same wrapped-Text reason as the card's.
                        VerticalLayout {
                            spacing: 6px;
                            Text {
                                text: "Picture Quality";
                                font-size: 12px;
                                font-weight: 700;
                                color: Theme.text-primary;
                                accessible-role: AccessibleRole.text;
                            }
                            Text { text: "Thumbnail Renderer"; font-size: 11px; font-weight: 600; color: Theme.text-secondary; }
                            HorizontalLayout {
                                spacing: 4px;
                                for label[index] in ["Path-Traced", "Ray-Traced"]: SegmentPill {
                                    text: label;
                                    hint: "Changing the thumbnail renderer marks existing pictures outdated once; regenerate them to use this choice. Ray-Traced uses eight fixed taps with Fire.";
                                    selected: SettingsModel.thumbnail_renderer_index == index;
                                    picked => { SettingsModel.thumbnail_renderer_selected(index); }
                                }
                            }
                            Text { text: "Thumbnail Backdrop"; font-size: 11px; font-weight: 600; color: Theme.text-secondary; }
                            HorizontalLayout {
                                spacing: 4px;
                                // Backdrop indices: White 2, Grey 1, Black 3.
                                for choice[index] in [{ label: "White", value: 2 }, { label: "Grey", value: 1 }, { label: "Black", value: 3 }]: SegmentPill {
                                    text: choice.label;
                                    hint: "The tray the catalogue pictures are drawn on. Grey sets colorless stones apart from their background; changing it marks existing pictures outdated once.";
                                    selected: SettingsModel.thumbnail_backdrop_index == choice.value;
                                    picked => { SettingsModel.thumbnail_backdrop_selected(choice.value); }
                                }
                            }
                            SliderRow {
                                text: "Preview Image Size";
                                hint: "Preview Image Size: the width of the small pictures the catalogue draws for each design, in pixels. Larger pictures are sharper and take longer to draw.";
                                value_text: Math.round(SettingsModel.preview_size_val) + "px";
                                minimum: SettingsModel.preview_size_min;
                                maximum: SettingsModel.preview_size_max;
                                step: 16;
                                value <=> SettingsModel.preview_size_val;
                                edited(val) => { SettingsModel.preview_size_changed(Math.round(val)); }
                            }
                            if SettingsModel.thumbnail_renderer_index == 0: SliderRow {
                                text: "Preview Samples";
                                hint: "Preview Samples: how many light paths are traced for each pixel of a catalogue picture. More samples mean less grain and a slower batch.";
                                value_text: Math.round(SettingsModel.preview_spp_val) + "";
                                minimum: SettingsModel.preview_samples_min;
                                maximum: SettingsModel.preview_samples_max;
                                step: 32;
                                value <=> SettingsModel.preview_spp_val;
                                edited(val) => { SettingsModel.preview_spp_changed(Math.round(val)); }
                            }
                            Text {
                                height: 30px;
                                text: "You can change these later in the Advanced interface, under Render & Output > Library Thumbnails.";
                                font-size: 11px;
                                color: Theme.text-muted;
                                wrap: word-wrap;
                            }
                        }

                        if root.from_import: Text {
                            text: "Quick draws a fast solid picture of each design in moments; the fully rendered ones can follow later, in one batch or one by one from a design's menu.";
                            font-size: 11px;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                        if root.from_import: TipBox {
                            hint: "Tick to skip this question after future imports and use the button you press now.";
                            CheckBox {
                                text: "Remember My Choice";
                                checked <=> BatchModel.preview_remember_choice;
                            }
                        }

                        if root.from_import: HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            if root.from_import: TipButton {
                                text: "Quick (Solid)";
                                hint: "Draw a fast solid picture of each design in moments. Fully rendered ones can follow later.";
                                clicked => { root.generate_solid_confirmed(); }
                            }
                            TipButton {
                                text: "Quick (Ray-Traced)";
                                hint: "Draw deterministic draft pictures locally; these do not replace the persistent thumbnail renderer choice.";
                                enabled: root.can_start;
                                clicked => { root.generate_ray_confirmed(); }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;

                            tip-button-from-import := TipButton {
                                text: root.from_import ? "Skip" : "Not Now";
                                hint: root.from_import
                                    ? "Import without pictures. You can make them later from the library."
                                    : "Do not make previews now.";
                                clicked => { root.dismiss_offer(); }
                            }
                            tip-button-from-import-2 := TipButton {
                                text: root.from_import ? "Full Render" : "Generate";
                                hint: SettingsModel.thumbnail_renderer_index == 1 ? "Save deterministic Ray Traced front and top thumbnails using approximate RGB base glass. Enter does the same." : "Render a front and a top picture of each design. This takes longer but looks best. Enter does the same.";
                                primary: true;
                                enabled: root.can_start;
                                clicked => { root.generate_confirmed(); }
                            }
                        }
                    }

                    if !root.confirming: VerticalLayout {
                        spacing: 12px;

                        Text {
                            vertical-stretch: 0;
                            text: root.done ? "Preview generation finished" : "Generating previews...";
                            font-size: 14px;
                            font-weight: 700;
                            color: Theme.text-primary;
                            accessible-role: AccessibleRole.text;
                        }

                        if !root.done: VerticalLayout {
                            vertical-stretch: 0;
                            spacing: 10px;

                            // Local runs `local_lane_total` lanes concurrently (Task:
                            // saturate cores, not pin one) -- with N lanes each possibly
                            // mid-item at once, no single title is meaningful any more,
                            // so this reports a plain busy-count instead. Hidden
                            // entirely under `RemoteOnly`, where no local lane runs at
                            // all.
                            if root.local_lane_total > 0: Text {
                                text: "Local: " + root.local_active + " / " + root.local_lane_total + " lane(s) busy";
                                font-size: 12px;
                                color: Theme.text-secondary;
                                overflow: elide;
                            }

                            // The remote dispatchers' in-flight count and the item one
                            // of them started most recently -- only shown at
                            // all while remote dispatchers are running (`LocalOnly`
                            // never sets `remote_active`, and `RemoteOnly` shows only
                            // this row, no "Local:" row above, since no local lane
                            // runs in that mode).
                            if root.remote_active: Text {
                                text: "Remote: " + (root.remote_in_flight > 0
                                ? root.remote_in_flight + " on remote"
                                    + (root.remote_title == "" ? "" : " -- " + root.remote_title)
                                : (root.remote_title == "" ? "Starting..." : root.remote_title));
                                font-size: 12px;
                                color: Theme.text-secondary;
                                overflow: elide;
                            }

                            // Overall progress: designs completed so far, out of `N` --
                            // NOT a current-item cursor (see this component's own doc
                            // comment): with local and remote both possibly in flight,
                            // there is no single "current" design left to point at.
                            VerticalLayout {
                                spacing: 4px;
                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: "Completed " + root.design_index + " / " + root.design_total
                                            + (root.eta == "" ? "" : " · " + root.eta);
                                        font-size: 10px;
                                        color: Theme.text-muted;
                                    }
                                    Text {
                                        text: Math.round(root.design_fraction * 100) + "%";
                                        font-size: 10px;
                                        font-weight: 700;
                                        color: Theme.accent-cyan;
                                    }
                                }
                                Rectangle {
                                    height: 8px;
                                    border-radius: 4px;
                                    background: Theme.surface-sunken;
                                    border-width: 1px;
                                    border-color: Theme.border-dialog;
                                    clip: true;
                                    accessible-role: AccessibleRole.progress-indicator;
                                    accessible-label: "Designs Completed";
                                    accessible-value: Math.round(root.design_fraction * 100) + " percent";
                                    Rectangle {
                                        x: 0;
                                        y: 0;
                                        width: parent.width * root.design_fraction;
                                        height: 100%;
                                        background: Theme.accent-cyan;
                                        animate width { duration: 150ms; }
                                    }
                                }
                            }

                            // How busy the local lane pool is right now (not a within-
                            // design fraction any more -- see this component's own doc
                            // comment for why that stopped being meaningful with N local
                            // lanes). Hidden under `RemoteOnly`, same as the "Local:"
                            // row above.
                            if root.local_lane_total > 0: VerticalLayout {
                                spacing: 4px;
                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: "Local lanes " + root.local_active + " / " + root.local_lane_total;
                                        font-size: 10px;
                                        color: Theme.text-muted;
                                    }
                                }
                                Rectangle {
                                    height: 6px;
                                    border-radius: 3px;
                                    background: Theme.surface-sunken;
                                    border-width: 1px;
                                    border-color: Theme.border-dialog;
                                    clip: true;
                                    Rectangle {
                                        x: 0;
                                        y: 0;
                                        width: parent.width * root.local_fraction;
                                        height: 100%;
                                        background: Theme.accent-amber;
                                        animate width { duration: 150ms; }
                                    }
                                }
                            }
                        }

                        if root.done: Text {
                            vertical-stretch: 0;
                            text: root.summary;
                            font-size: 12px;
                            color: Theme.text-secondary;
                            wrap: word-wrap;
                        }

                        // The card's height is fixed (see its comment); the spare height goes
                        // here, so the rows keep their own height and the buttons sit at the bottom.
                        Rectangle { vertical-stretch: 1; }

                        HorizontalLayout {
                            vertical-stretch: 0;
                            spacing: 8px;
                            alignment: end;

                            if !root.done: TipButton {
                                text: "Cancel";
                                hint: "Stop making previews. The ones already made are kept.";
                                clicked => { root.cancel(); }
                            }
                            if root.done: TipButton {
                                text: "Close";
                                hint: "Close this summary.";
                                primary: true;
                                clicked => { root.close(); }
                            }
                        }
                    }
                }
            }
        }
    }
    }
}
