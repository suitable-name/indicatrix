import { Button, ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { EditorModel } from "../models/editor.slint";
import { ActivityModel, ActivityItem } from "../models/activity.slint";
import { StaleBadge } from "stale_badge.slint";
// The Log popup's "Copy" button reuses LibraryModel.copy_text to copy details
// to clipboard and show "Copied!" toast.
import { LibraryModel } from "../models/library.slint";

// The Edit sub-tab's full detail-width status line -- see `app.slint`'s
// Edit-mode layout doc comment. Shows only the single highest-priority
// message as a coloured dot + one line -- the solver's own state
// (solving/stale/failed/solved) always leads, see
// `EditorStatusStrip::strip_text`'s own doc comment for the full order;
// "Details" (a current-state snapshot, not a history a cutter could
// scroll back through) opens `EditorLogPopup` with every message in
// full, so nothing is ever unreachable, only reordered behind one click.
component EditorLogPopup inherits PopupWindow {
    // `close-on-click-outside` gives the popup real click-outside-to-close,
    // making the old backdrop genuinely redundant.
    close-policy: PopupClosePolicy.close-on-click-outside;
    width: 380px;
    height: outer.preferred-height;

    // Popup height is capped so it doesn't grow past the top of the window.
    // Plumbed from EditorStatusStrip.window_height, bound from app.slint's
    // root.height, the same way RetargetDialog/TiltBatchDialog size themselves.
    in property <length> window_height: 900px;

    // Grabs keyboard focus every time the popup opens so Escape works immediately.
    // A monotonic counter (not a flag) so `changed` fires on every open, even
    // when opened twice in a row. A property, not a function, because PopupWindow
    // functions aren't reachable from the enclosing component.
    in property <int> open_pulse: 0;
    changed open_pulse => {
        popup_focus.focus();
    }

    property <bool> has_deep_solve: EditorModel.deep_solve_running || EditorModel.deep_solve_status != "" || !EditorModel.deep_solve_available || EditorModel.deep_solve_hint != "";

    // Deep Solve status hoisted into property so section Text and log_text
    // read the same value without duplicating the logic.
    property <string> deep_solve_line: EditorModel.deep_solve_running
        ? EditorModel.deep_solve_status
        : (EditorModel.deep_solve_status != "" ? EditorModel.deep_solve_status : EditorModel.deep_solve_hint);

    // Everything this popup currently shows, concatenated for the "Copy"
    // button below -- a cutter can paste a solver failure or a Deep Solve
    // verdict to ask for help without retyping it by hand. Mirrors
    // `has_deep_solve`/`deep_solve_line` above section-for-section; the
    // per-tier Deep Solve table and the manufacturability list are
    // summarized by count rather than transcribed line-by-line (Slint's
    // function bodies have no loop construct to walk either array).
    function log_text() -> string {
        return "Editor Details\n\n"
            + (EditorModel.last_saved_path != "" ? ("Last saved to: " + EditorModel.last_saved_path + "\n\n") : "")
            + (EditorModel.status_text != "" ? (EditorModel.status_text + "\n\n") : "")
            + (root.has_deep_solve ? (root.deep_solve_line + "\n\n") : "")
            + (EditorModel.deep_solve_tier_rows.length > 0 ? ("Deep Solve: " + EditorModel.deep_solve_tier_rows.length + " tier(s) disagree with the last solve.\n\n") : "")
            + (EditorModel.manufacturability_warnings.length > 0 ? ("Manufacturability (" + EditorModel.manufacturability_warnings.length + " warning(s))\n\n") : "")
            + (EditorModel.preform_fit_warning != "" ? ("Rough Fit: " + EditorModel.preform_fit_warning + "\n\n") : "")
            + (EditorModel.material_suggestion_text != "" ? EditorModel.material_suggestion_text : "");
    }

    Rectangle {
        // Uses theme tokens for background/border/shadow instead of bare hex.
        background: Theme.popup-surface;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: Theme.border-dialog;
        drop-shadow-blur: 24px;
        drop-shadow-color: Theme.modal-shadow;
        drop-shadow-offset-y: 6px;
        clip: true;

        // Escape closes the popup from the keyboard. The popup takes focus
        // as soon as it opens so Escape works immediately, with no click
        // into the popup needed first.
        popup_focus := FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.close();
                    return accept;
                }
                reject
            }

            outer := VerticalLayout {
                padding: 16px;
                spacing: 10px;

                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "Editor Details"; font-size: 13px; font-weight: 700; color: Theme.text-primary; vertical-alignment: center; }
                    HorizontalLayout {
                        spacing: 6px;
                        // Copies everything this popup shows (`log_text` above)
                        // through the same generic clipboard callback
                        // `performance_graph_dialog.slint`'s own Copy button
                        // uses -- `LibraryModel.copy_text` shows its own
                        // "Copied to clipboard!" toast, so nothing more is
                        // needed here.
                        Rectangle {
                            width: copy_label.preferred-width + 16px;
                            height: 24px;
                            border-radius: Theme.radius-sm;
                            // `Theme.bg-card-hover` matches the hover treatment
                            // this file already uses a few segments below (the
                            // "Saved:" chip's own TouchArea), so the same
                            // hover-affordance role renders consistently
                            // everywhere it appears in this popup.
                            background: copy_touch.has-hover ? Theme.bg-card-hover : transparent;
                            border-width: 1px;
                            border-color: Theme.border-dialog;
                            copy_touch := TouchArea { clicked => { LibraryModel.copy_text(root.log_text()); } }
                            copy_label := Text { text: "Copy"; font-size: 10px; font-weight: 600; color: Theme.accent-cyan; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Rectangle {
                            width: 24px;
                            height: 24px;
                            border-radius: 12px;
                            background: close_touch.has-hover ? Theme.bg-card-hover : transparent;
                            close_touch := TouchArea { clicked => { root.close(); } }
                            Image { source: @image-url("../icons/close.svg"); colorize: Theme.text-secondary; width: 12px; height: 12px; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }

                // The popup's body -- everything below the header -- scrolls
                // once it would exceed roughly 60% of the window, so it never
                // pushes the popup past the top of the window with entries
                // left unreachable.
                body_scroll := ScrollView {
                    height: min(body.preferred-height, root.window_height * 0.6);

                    body := VerticalLayout {
                        spacing: 10px;

                        // Validation status line -- the old green/ruby "Closed solid --
                        // volume …" banner's full text.
                        if EditorModel.status_text != "": HorizontalLayout {
                            spacing: 6px;
                            Rectangle { width: 8px; height: 8px; border-radius: 4px; background: EditorModel.status_is_problem ? Theme.accent-ruby : Theme.accent-emerald; }
                            Text { horizontal-stretch: 1; text: EditorModel.status_text; font-size: 11px; font-weight: 600; color: EditorModel.status_is_problem ? Theme.accent-ruby : Theme.accent-emerald; wrap: word-wrap; }
                        }

                        // Deep Solve status/hint line.
                        if root.has_deep_solve: VerticalLayout {
                            spacing: 4px;
                            HorizontalLayout {
                                spacing: 6px;
                                Rectangle {
                                    width: 8px;
                                    height: 8px;
                                    border-radius: 4px;
                                    background: EditorModel.deep_solve_running ? Theme.accent-amber : (EditorModel.deep_solve_status != "" ? (EditorModel.deep_solve_status_is_problem ? Theme.accent-ruby : Theme.accent-emerald) : Theme.text-muted);
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: root.deep_solve_line;
                                    font-size: 11px;
                                    color: EditorModel.deep_solve_running ? Theme.accent-amber : (EditorModel.deep_solve_status != "" ? (EditorModel.deep_solve_status_is_problem ? Theme.accent-ruby : Theme.accent-emerald) : Theme.text-muted);
                                    wrap: word-wrap;
                                }
                            }
                            // Badges (never clears) a verdict computed for an
                            // OLDER design generation -- see
                            // `EditorModel.deep_solve_stale`'s own doc comment.
                            // Not shown while a run is actively in progress (its
                            // own amber "running" state already says enough).
                            if EditorModel.deep_solve_stale && !EditorModel.deep_solve_running: StaleBadge {
                                recompute => { EditorModel.deep_solve(); }
                            }
                        }

                        // Optimize status line -- same shape as Deep Solve's own,
                        // so the Details popup can badge staleness for it too
                        // (`EditorModel.optimize_stale`). The full per-tier
                        // result/change tables live in `editor_inspector.slint`'s
                        // Optimize tab.
                        if EditorModel.optimize_running || EditorModel.optimize_status != "": VerticalLayout {
                            spacing: 4px;
                            HorizontalLayout {
                                spacing: 6px;
                                Rectangle {
                                    width: 8px;
                                    height: 8px;
                                    border-radius: 4px;
                                    background: EditorModel.optimize_running ? Theme.accent-amber : (EditorModel.optimize_status_is_problem ? Theme.accent-ruby : Theme.accent-emerald);
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: EditorModel.optimize_status;
                                    font-size: 11px;
                                    color: EditorModel.optimize_running ? Theme.accent-amber : (EditorModel.optimize_status_is_problem ? Theme.accent-ruby : Theme.accent-emerald);
                                    wrap: word-wrap;
                                }
                            }
                            if EditorModel.optimize_stale && !EditorModel.optimize_running: StaleBadge {
                                show_recompute: false;
                            }
                        }

                        // The per-tier table behind the aggregate verdict above
                        // -- one row per tier Deep Solve's verified repair
                        // actually disagreed with the plain solve on
                        // (`EditorModel.deep_solve_tier_rows`, additional to --
                        // never replacing -- the status line's own
                        // one-sentence "Disagrees with the last solve on: ..."
                        // suffix). Empty (and so hidden) when there is nothing
                        // to report.
                        if EditorModel.deep_solve_tier_rows.length > 0: VerticalLayout {
                            spacing: 3px;
                            Text { text: "Deep Solve: per-tier mast comparison"; font-size: 11px; font-weight: 700; color: Theme.text-primary; }
                            HorizontalLayout {
                                spacing: 6px;
                                Text { width: 32px; text: "TIER"; font-size: 9px; font-weight: 700; color: Theme.text-muted; }
                                Text { horizontal-stretch: 1; text: "NAME"; font-size: 9px; font-weight: 700; color: Theme.text-muted; }
                                Text { width: 56px; text: "BEFORE"; font-size: 9px; font-weight: 700; color: Theme.text-muted; }
                                Text { width: 56px; text: "AFTER"; font-size: 9px; font-weight: 700; color: Theme.text-muted; }
                                Text { width: 56px; text: "DELTA"; font-size: 9px; font-weight: 700; color: Theme.text-muted; }
                                Text { width: 30px; text: ""; }
                            }
                            for r in EditorModel.deep_solve_tier_rows: HorizontalLayout {
                                spacing: 6px;
                                Text { width: 32px; text: r.tier_number; font-size: 10px; color: Theme.text-secondary; }
                                Text { horizontal-stretch: 1; text: r.name == "" ? "(unnamed)" : r.name; font-size: 10px; color: Theme.text-secondary; overflow: elide; }
                                Text { width: 56px; text: r.before_mast; font-size: 10px; color: Theme.text-muted; }
                                Text { width: 56px; text: r.after_mast; font-size: 10px; color: Theme.text-primary; }
                                Text { width: 56px; text: r.delta; font-size: 10px; font-weight: 700; color: Theme.accent-amber; }
                                // Opt-in "Pin to verified mast" --
                                // `pin_verified_mast` takes the SAME "#N"
                                // tier-number text this row already prints, so
                                // no new field is needed to identify the tier.
                                Rectangle {
                                    width: 30px;
                                    height: pin_text.preferred-height;
                                    pin_touch := TouchArea {
                                        clicked => { EditorModel.pin_verified_mast(r.tier_number); }
                                    }
                                    pin_text := Text {
                                        text: "Pin";
                                        font-size: 9px;
                                        font-weight: 700;
                                        color: pin_touch.has-hover ? Theme.accent-cyan-hover : Theme.accent-cyan;
                                        horizontal-alignment: center;
                                    }
                                    Tooltip { text: @markdown("Pin this tier to Deep Solve's verified mast, as an exact scale-reference constraint. A no-op (with an explanatory toast) once this run is stale."); }
                                }
                            }
                        }

                        // Manufacturability warnings -- every one, in full. Amber, never
                        // ruby: these are never treated as errors that stop anything, only
                        // things the user should look at.
                        if EditorModel.manufacturability_warnings.length > 0: VerticalLayout {
                            spacing: 3px;
                            Text { text: "Manufacturability (" + EditorModel.manufacturability_warnings.length + ")"; font-size: 11px; font-weight: 700; color: Theme.accent-amber; }
                            // Click a line to jump straight to its tier.
                            // `EditorModel.manufacturability_warning_tiers` is
                            // the same length as `manufacturability_warnings`;
                            // `-1` marks a line with no specific tier. If the
                            // two arrays ever disagree in length, this
                            // degrades to a plain-text list rather than
                            // crashing.
                            for w[idx] in EditorModel.manufacturability_warnings: Rectangle {
                                property <int> warn_tier: idx < EditorModel.manufacturability_warning_tiers.length
                                    ? EditorModel.manufacturability_warning_tiers[idx]
                                    : -1;
                                property <bool> warn_clickable: warn_tier >= 0;
                                height: warn_text.preferred-height;
                                warn_touch := TouchArea {
                                    enabled: warn_clickable;
                                    // Fully qualified inside a ternary -- see
                                    // `split_handle.slint`'s own `mouse-cursor`
                                    // ternary for the same convention.
                                    mouse-cursor: warn_clickable ? MouseCursor.pointer : MouseCursor.default;
                                    clicked => {
                                        EditorModel.selected_tier_index = warn_tier;
                                        EditorModel.inspector_tab = 0;
                                        EditorModel.inspector_collapsed = false;
                                        root.close();
                                    }
                                }
                                warn_text := Text {
                                    text: "- " + w;
                                    font-size: 10px;
                                    color: warn_clickable && warn_touch.has-hover ? Theme.accent-cyan : Theme.text-secondary;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        // Does the design fit its rough?
                        if EditorModel.preform_fit_warning != "": VerticalLayout {
                            spacing: 3px;
                            Text { text: "Rough Fit"; font-size: 11px; font-weight: 700; color: Theme.accent-amber; }
                            Text { text: EditorModel.preform_fit_warning; font-size: 10px; color: Theme.text-secondary; wrap: word-wrap; }
                        }

                        // Catalogue-load material suggestion, with its accept/dismiss
                        // actions kept exactly as the old banner offered them.
                        if EditorModel.material_suggestion_text != "": VerticalLayout {
                            spacing: 4px;
                            Text { text: EditorModel.material_suggestion_text; font-size: 11px; color: Theme.accent-cyan; wrap: word-wrap; }
                            HorizontalLayout {
                                spacing: 8px;
                                Button { text: "Set Material"; clicked => { EditorModel.material_suggestion_accept(EditorModel.material_suggestion_name); } }
                                Button { text: "No Thanks"; clicked => { EditorModel.material_suggestion_dismiss(); } }
                            }
                        }

                        // The full path, in the one place that has room for it
                        // -- the strip itself shows only the bare file name.
                        // Deliberately outside the "Nothing to
                        // report." condition below: a saved path is a fact about
                        // the session, not a message competing for the strip's
                        // single slot, so it stays visible even when there is
                        // genuinely nothing else to report.
                        if EditorModel.last_saved_path != "": VerticalLayout {
                            spacing: 3px;
                            Text { text: "Last saved to"; font-size: 11px; font-weight: 700; color: Theme.text-primary; }
                            Text { text: EditorModel.last_saved_path; font-size: 10px; color: Theme.text-secondary; wrap: word-wrap; }
                        }

                        if EditorModel.status_text == "" && !root.has_deep_solve && EditorModel.manufacturability_warnings.length == 0 && EditorModel.preform_fit_warning == "" && EditorModel.material_suggestion_text == "": Text {
                            text: "Nothing to report.";
                            font-size: 11px;
                            color: Theme.text-muted;
                        }
                    }
                }
            }
        }
    }
}

// One compact chip per `ActivityModel` entry -- an indeterminate pulsing dot
// or a thin progress bar, the activity's own label, elapsed seconds (derived
// from `ActivityModel.now_ms`/`ActivityItem.started_ms`, see that property's
// own doc comment), and a Cancel button when `item.cancellable`.
component ActivityChip inherits Rectangle {
    in property <ActivityItem> item;

    width: layout.preferred-width;
    height: layout.preferred-height;
    border-radius: Theme.radius-sm;
    background: Theme.accent-cyan;

    // Pulses an indeterminate activity's own dot roughly twice a second -- a
    // plain component-local `Timer`, the same proven idiom
    // `solid_viewport.slint`'s own resize-pulse timer already uses, rather than a
    // CSS-style looping `animate` block.
    property <bool> pulse_on: true;
    Timer {
        interval: 500ms;
        running: item.progress < 0;
        triggered => { root.pulse_on = !root.pulse_on; }
    }

    layout := HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        padding-top: 3px;
        padding-bottom: 3px;
        spacing: 6px;

        Rectangle {
            width: 6px;
            height: 6px;
            y: (parent.height - self.height) / 2;
            border-radius: 3px;
            background: Theme.bg-darkest;
            opacity: item.progress < 0 ? (root.pulse_on ? 1.0 : 0.3) : 1.0;
        }

        Text {
            text: item.label + " -- " + Math.max(0, (ActivityModel.now_ms - item.started_ms) / 1000) + "s";
            font-size: 10px;
            font-weight: 700;
            color: Theme.bg-darkest;
            vertical-alignment: center;
        }

        // A real completion fraction (Optimize's evaluation count, say) draws as
        // a thin bar instead of the pulsing dot alone. Track and fill are
        // siblings (not nested) so the track's own reduced `opacity` never
        // cascades onto the fill.
        if item.progress >= 0: Rectangle {
            width: 40px;
            height: 4px;
            y: (parent.height - self.height) / 2;
            track := Rectangle {
                width: 100%;
                height: 100%;
                border-radius: 2px;
                background: Theme.bg-darkest;
                opacity: 0.25;
            }
            Rectangle {
                x: 0;
                width: parent.width * Math.max(0.0, Math.min(1.0, item.progress));
                height: 100%;
                border-radius: 2px;
                background: Theme.bg-darkest;
            }
        }

        if item.cancellable: Rectangle {
            width: cancel_label.preferred-width + 4px;
            cancel_touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { ActivityModel.cancel(item.id); }
            }
            cancel_label := Text {
                text: "\u{2715}";
                font-size: 10px;
                font-weight: 700;
                color: cancel_touch.has-hover ? Theme.danger : Theme.bg-darkest;
                vertical-alignment: center;
            }
            Tooltip { text: @markdown("Cancel \{item.label}"); }
        }
    }
}

export component EditorStatusStrip inherits Rectangle {
    height: 26px;
    background: Theme.bg-input;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Theme.border-subtle;

    // Bumped by the "Details" click handler below on every open, bound
    // declaratively into `log_popup.open_pulse` at that instantiation
    // (bottom of this file) -- a `PopupWindow`'s own properties cannot be
    // WRITTEN from an enclosing component's imperative code
    // (`log_popup.open_pulse += 1` inside a `clicked` handler fails to
    // compile with "Cannot access property or callback ... inside of a
    // Window from enclosing component"), only bound to declaratively, the way
    // `log_popup`'s `x`/`y` already are. See `EditorLogPopup.open_pulse`'s own
    // doc comment for why this needs to be a counter, not a plain flag.
    property <int> log_open_pulse: 0;

    // Bound from `app.slint`'s `root.height` at this component's own call site,
    // directly under the window -- forwarded to `log_popup.window_height` below
    // so `EditorLogPopup`'s body can cap itself against the REAL window height
    // instead of the 900px placeholder default (see that property's own doc
    // comment).
    in property <length> window_height: 900px;

    property <bool> has_manuf: EditorModel.manufacturability_warnings.length > 0;
    property <bool> has_preform_warn: EditorModel.preform_fit_warning != "";
    // Deep Solve counts as a strip message only while it is actually doing
    // something -- NOT merely because `deep_solve_hint` (always non-empty, see
    // `view::deep_solve_hint`) or `!deep_solve_available` is set, since that
    // would make this permanently true and starve every other segment below
    // it. The always-present hint text lives in a `Tooltip` on the Deep Solve
    // button itself (`EditorCommandBar`'s `AnalysisGroup`) instead.
    property <bool> has_deep_solve: EditorModel.deep_solve_running || EditorModel.deep_solve_status != "";
    property <bool> has_validation_problem: EditorModel.status_text != "" && EditorModel.status_is_problem;
    property <bool> has_solved_message: EditorModel.status_text != "" && !EditorModel.status_is_problem;
    property <bool> has_material_suggestion: EditorModel.material_suggestion_text != "";

    // Priority order: the solver's own state leads -- a running solve, then any real
    // validation problem (this also covers the "Not solved -- click Solve" stale
    // marker every edit sets via `view::push_stale_content`, so a cutter can never
    // read a stale/unsolvable preview as current just because nothing else is
    // flagged). Advisory findings that never block anything (manufacturability,
    // rough fit) come next, then the plain "solved" confirmation, then Deep Solve's
    // own in-progress/verdict message, and finally the catalogue material
    // suggestion.
    property <string> strip_text: EditorModel.solve_running ? EditorModel.status_text
        : root.has_validation_problem ? EditorModel.status_text
        : root.has_manuf ? (EditorModel.manufacturability_warnings.length + " manufacturability warning(s)")
        : root.has_preform_warn ? EditorModel.preform_fit_warning
        : root.has_solved_message ? EditorModel.status_text
        : root.has_deep_solve ? EditorModel.deep_solve_status
        : root.has_material_suggestion ? EditorModel.material_suggestion_text
        : "Nothing to report.";

    // Labels/colours the persistent solver-state segment above, keyed off
    // `EditorModel.solve_state` (set from `gui::editor::view`/
    // `gui::editor::auto_solve`, per that global's own doc comment).
    property <string> solver_state_label: EditorModel.solve_state == "solving" ? "Solving"
        : EditorModel.solve_state == "stale" ? "Stale"
        : EditorModel.solve_state == "failed" ? "Failed"
        : "Solved";
    property <color> solver_state_color: EditorModel.solve_state == "solving" ? Theme.accent-amber
        : EditorModel.solve_state == "stale" ? Theme.accent-amber
        : EditorModel.solve_state == "failed" ? Theme.accent-ruby
        : Theme.accent-emerald;

    property <color> strip_color: EditorModel.solve_running ? Theme.accent-amber
        : root.has_validation_problem ? Theme.accent-ruby
        : root.has_manuf ? Theme.accent-amber
        : root.has_preform_warn ? Theme.accent-amber
        : root.has_solved_message ? Theme.accent-emerald
        : root.has_deep_solve ? (EditorModel.deep_solve_running ? Theme.accent-amber : (EditorModel.deep_solve_status_is_problem ? Theme.accent-ruby : Theme.accent-emerald))
        : root.has_material_suggestion ? Theme.accent-cyan
        : Theme.text-muted;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;

        // Names the design these readouts describe -- the paired `.asc`'s
        // file name, or "Untitled design" for a brand-new one
        // (`gui::editor::state::design_label_text`). Always shown first, so a
        // cutter never has to guess which design the tier table/status
        // messages to its right belong to.
        Text {
            text: EditorModel.design_label;
            font-size: 11px;
            font-weight: 600;
            color: Theme.text-muted;
            vertical-alignment: center;
            overflow: elide;
            max-width: 160px;
        }

        // A persistent solver-state segment -- state dot +
        // Solved/Stale/Solving/Failed, the tier count, and the last solve's
        // duration -- always visible regardless of the strip's own single-message
        // priority chain below, so a cutter never has to read a sentence to learn
        // whether the table/3D view are current. `EditorModel.tiers.length` is
        // free (an existing array property, no Rust push needed for the count).
        // `EditorModel.solve_state`/`last_solve_duration_ms` are live (pushed
        // from `gui::editor::view`/`gui::editor::auto_solve`); this segment and
        // the Solve button's `primary:` binding (`editor_command_bar.slint`)
        // both compile and render off them already. A per-design FACET count (as
        // opposed to the tier count below) is not included: no existing
        // field carries it (an
        // `EditorTierItem` describes one schedule row, not the facet count that
        // row's orbit expands to), so surfacing it would need its own new Rust
        // computation and property.
        Rectangle {
            width: solver_state_layout.preferred-width;
            height: solver_state_layout.preferred-height;
            solver_state_layout := HorizontalLayout {
                spacing: 5px;
                Rectangle { width: 8px; height: 8px; border-radius: 4px; background: root.solver_state_color; }
                Text { text: root.solver_state_label; font-size: 10px; font-weight: 700; color: root.solver_state_color; vertical-alignment: center; }
                Text {
                    text: EditorModel.tiers.length + (EditorModel.tiers.length == 1 ? " tier" : " tiers");
                    font-size: 10px;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
                // Shown only once something has solved -- a facet count of 0
                // would read as a claim about the design rather than as "not
                // solved yet", which the state dot to the left already says.
                if EditorModel.facet_count > 0: Text {
                    text: "- " + EditorModel.facet_count + " facets";
                    font-size: 10px;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
                if EditorModel.last_solve_duration_ms > 0: Text {
                    text: "· " + EditorModel.last_solve_duration_ms + " ms";
                    font-size: 10px;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle { width: 1px; height: 14px; background: Theme.border-subtle; }

        // Always shown while the design has unsaved edits, regardless of which
        // message above currently has priority -- data loss is worth a permanent
        // marker, not just the window title's leading "* " (`app.slint`), which is
        // easy to miss. See `EditorModel.is_dirty`'s own doc comment.
        if EditorModel.is_dirty: Rectangle {
            // Explicit width/height bound to the named inner layout's own
            // preferred size -- same idiom the "Log" segment below uses
            // (`log_label.preferred-width`/`-height`), needed because a plain
            // `Rectangle` does not size itself to an unnamed child on its own.
            width: unsaved_layout.preferred-width;
            height: unsaved_layout.preferred-height;
            border-radius: Theme.radius-sm;
            background: Theme.accent-amber;
            unsaved_layout := HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                Text {
                    text: "UNSAVED";
                    font-size: 10px;
                    font-weight: 700;
                    color: Theme.bg-darkest;
                    vertical-alignment: center;
                }
            }
        }

        // Solve, Deep Solve and Optimize could all be launched at once --
        // this is the single place a cutter can see which one (if any) is
        // currently running, alongside the cross-disabling on the launchers
        // themselves (`EditorCommandBar`). Same "always shown regardless of
        // the priority chain below" placement as the "UNSAVED" marker above,
        // for the same reason: which action is running should never be
        // pushed out by whatever the strip's own single-message priority
        // chain currently shows.
        //
        // One `ActivityChip` per `ActivityModel` entry -- every long-running
        // action routed through `gui::editor::activity::ActivityRegistry`
        // (background auto-solve, Deep Solve, Optimize) shows up here with
        // its own elapsed time and, where a real handle exists, a Cancel
        // button that reaches the SAME cancellation path as that action's
        // own dedicated Cancel/Abandon button.
        if ActivityModel.busy: HorizontalLayout {
            spacing: 6px;
            for a in ActivityModel.activities: ActivityChip { item: a; }
        }

        // A persistent marker, visible regardless of which single message the
        // strip's own priority chain currently shows, so a stale Deep
        // Solve/Optimize verdict is never silently hidden behind an unrelated
        // "Solved" line -- clicking it opens the same Details popup that
        // shows each one individually.
        if (EditorModel.deep_solve_stale && !EditorModel.deep_solve_running)
            || (EditorModel.optimize_stale && !EditorModel.optimize_running): Rectangle {
            width: stale_marker_layout.preferred-width;
            height: stale_marker_layout.preferred-height;
            stale_marker_touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { log_popup.show(); root.log_open_pulse += 1; }
            }
            stale_marker_layout := StaleBadge { show_recompute: false; }
        }

        // A persistent record of where the last Save/Export wrote,
        // click-to-reveal in the OS file manager. Same "always shown, never
        // subject to the priority chain" placement as the two markers above
        // -- where a file went is a fact, not a message. The bare file name
        // only; the full path is one click away in the Details popup (and is
        // what the reveal itself uses).
        if EditorModel.last_saved_label != "": Rectangle {
            width: saved_layout.preferred-width;
            height: saved_layout.preferred-height;
            border-radius: Theme.radius-sm;
            background: saved_touch.has-hover ? Theme.bg-card-hover : transparent;
            border-width: 1px;
            border-color: Theme.border-subtle;
            saved_touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { EditorModel.reveal_last_saved_path(); }
            }
            saved_layout := HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                Text {
                    text: "Saved: " + EditorModel.last_saved_label;
                    font-size: 10px;
                    font-weight: 600;
                    color: Theme.accent-cyan;
                    vertical-alignment: center;
                    overflow: elide;
                    max-width: 180px;
                }
            }
        }

        Rectangle {
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: root.strip_color;
        }

        // A `Tooltip` (not a child of the enclosing `HorizontalLayout` -- see
        // this file's own Slint-trap notes elsewhere in this app -- hence the
        // wrapping plain `Rectangle`) carries the strip's message in full,
        // and clicking it opens the same "Details" popup the link at the end
        // of the strip does, so the full text is always one click (or one
        // hover) away regardless of how badly it elides.
        Rectangle {
            horizontal-stretch: 1;
            strip_msg_touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { log_popup.show(); root.log_open_pulse += 1; }
            }
            Text {
                text: root.strip_text;
                font-size: 11px;
                color: root.strip_color;
                vertical-alignment: center;
                overflow: elide;
            }
            Tooltip { text: @markdown("\{root.strip_text}"); }
        }

        Rectangle {
            width: log_label.preferred-width;
            height: log_label.preferred-height;
            // "Details" is named for what it actually shows: a snapshot of
            // the CURRENT state (`EditorLogPopup.log_text`'s own doc
            // comment), not a running history a cutter could scroll back
            // through to recover a message the strip's own single-slot
            // priority chain has already replaced.
            log_label := Text { text: "Details \u{25B8}"; font-size: 11px; font-weight: 600; color: Theme.accent-cyan; vertical-alignment: center; }
            // Bumping `log_open_pulse` (bound into `log_popup.open_pulse`
            // below) hands keyboard focus into the popup on every open, not
            // just the first -- see `EditorLogPopup.open_pulse`'s own doc
            // comment for why.
            log_touch := TouchArea { clicked => { log_popup.show(); root.log_open_pulse += 1; } }
        }
    }

    log_popup := EditorLogPopup {
        x: parent.width - self.width - 12px;
        y: -self.height - 6px;
        open_pulse: root.log_open_pulse;
        window_height: root.window_height;
    }
}
