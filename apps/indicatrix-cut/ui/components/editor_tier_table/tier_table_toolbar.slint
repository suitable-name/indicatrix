import { CheckBox, LineEdit } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { EditorModel } from "../../models/editor.slint";
import { GuideModel } from "../../models/guide.slint";
import { RelationModel } from "../../models/relation.slint";
import { TierTableModel } from "../../models/tier_table.slint";
import { HelpTopics } from "../../models/help.slint";
import { HelpButton } from "../help_button.slint";
import { CompactButton } from "../compact_controls.slint";
import { AdvancedNote } from "../advanced_note.slint";

// A small text field of the toolbar with a tooltip and a screen-reader label. Read its text
// through the id (`step_name.text`).
component TipField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    // One plain sentence: what to type here. Shown as the tooltip.
    in property <string> hint;
    // What a screen reader says for the field.
    in property <string> reader_label;
    callback accepted();

    height: 20px;
    Tooltip { text: @markdown("\{root.hint}"); }
    LineEdit {
        width: parent.width;
        height: parent.height;
        font-size: 9px;
        text <=> root.text;
        placeholder-text: root.placeholder;
        accessible-label: root.reader_label;
        accessible-description: root.hint;
        accepted => { root.accepted(); }
        changed has-focus => { EditorModel.text_focus = self.has-focus; }
    }
}

// `EditorTierTable`'s toolbar: the name/index/block/strategy/meets filter
// box, the "+ Add Tier"/"Adopt all"/"Select" row, the quick-add anchor
// buttons plus the "Steps / Mirror" toggle and its inline form, and the
// multi-select batch-action bar (shown only while more than one row is
// selected). Root is a plain `VerticalLayout` (not a `Rectangle`) so it
// slots into `EditorTierTable`'s own `VerticalLayout` exactly like these five
// pieces did before extraction -- same `spacing: 4px` as that parent, so the
// gap above/below this whole group and between the pieces inside it stays
// the same pixel value either way.
//
// While the worked-example guide runs, "+ Add Tier" follows
// `GuideModel.allows_tier_form()` and every other action here follows
// `allows_tier_table()`: a locked button is dimmed, ignores clicks and shows the
// guide's lock tooltip instead of its own (see `GuideAllow`, `models/guide.slint`).
//
// The Simple interface (`GuideModel.shows_advanced()`) leaves out the filter box, "Adopt all",
// "Steps / Mirror" and its form, and "Adopt sel." in the multi-select bar; Select, Clear, Delete
// and Offset stay. A line says so when a tier is detached, since the Detach buttons are hidden
// too. The filter does nothing while it is hidden (`TierTableRow.row_matches`).
export component TierTableToolbar inherits VerticalLayout {
    // Mirrored two-way with `EditorTierTable.select_mode`: the "Select"
    // button here toggles it, and the tier table's header/rows both read it
    // (the checkbox column, and per-row multi-select toggling).
    in-out property <bool> select_mode: false;
    // Read-only here: the "Mirror" and multi-select "Offset" actions both
    // apply to whichever tier the tier list's own keyboard cursor is on.
    in property <int> keyboard_focus_index: -1;

    // Whether the "Generate steps..." inline form is open. Local to this
    // toolbar -- nothing outside it needs to know.
    property <bool> generate_steps_open: false;
    // The Steps form's "Keep linked" box: Generate then makes every tier after the first
    // follow the first (`RelationModel.generate_step_series_linked`), so moving the first
    // tier moves the whole ladder. Local, like `generate_steps_open`.
    property <bool> keep_linked: false;
    property <bool> advanced: GuideModel.shows_advanced();

    // Lets `EditorTierTable.focus_filter()` (Ctrl+F, see that function's own
    // doc comment) reach `filter_edit`, which now lives in this component
    // rather than in `EditorTierTable` itself. The field stays mounted while the
    // Simple interface hides it (an id inside an `if` could not be reached from
    // here), and Ctrl+F then does nothing.
    public function focus_filter() {
        if root.advanced {
            filter_edit.focus();
        }
    }

    spacing: 4px;

    // The search/filter box itself -- narrows the rendered rows by
    // name/index/block/strategy/meets substring (row indices stay whatever
    // `EditorTierItem.index` already says, so every callback below still
    // identifies the right tier regardless of what's dimmed). Non-matching
    // rows are DIMMED rather than removed from layout, so Up/Down/Home/End's
    // arithmetic (all of it keyed on `EditorModel.tiers.length`, not a
    // filtered count) keeps working exactly as it does with no filter set.
    Rectangle {
        height: root.advanced ? 28px : 0px;
        visible: root.advanced;
        background: Theme.bg-input;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: filter_edit.has-focus ? Theme.accent-cyan : Theme.border-subtle;
        HorizontalLayout {
            padding-left: 6px;
            padding-right: 6px;
            spacing: 4px;
            VerticalLayout {
                alignment: center;
                Image {
                    source: @image-url("../../icons/search.svg");
                    colorize: Theme.text-muted;
                    width: 12px;
                    height: 12px;
                    image-fit: contain;
                }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                filter_edit := LineEdit {
                    height: 22px;
                    min-width: 0px;
                    enabled: root.advanced;
                    text <=> EditorModel.tier_filter_text;
                    placeholder-text: "Filter tiers by name, index, block or strategy...";
                    font-size: 10px;
                    accessible-label: "Filter tiers";
                    accessible-description: "Type part of a name, an index, a block or a strategy. Tiers that do not match are dimmed.";
                    changed has-focus => { EditorModel.text_focus = self.has-focus; }
                }
            }
            if EditorModel.tier_filter_text != "": VerticalLayout {
                alignment: center;
                CompactButton {
                    width: 20px;
                    text: "x";
                    ink: Theme.text-muted;
                    hint: "Clear the filter.";
                    clicked => { EditorModel.tier_filter_text = ""; }
                }
            }
        }
    }

    // Bulk-adopts every tier that still has an unadopted imported meet,
    // as one undoable step, instead of one Adopt click (and one
    // re-solve) per tier. Always shown rather than conditioned on "does
    // anything need adopting" -- Slint has no cheap way to ask that of
    // `EditorModel.tiers` from a binding here -- so a click with nothing
    // to adopt is a harmless no-op handled on the Rust side
    // (`EditorModel.adopt_all`, declared on `EditorModel` and wired to
    // `gui::editor::callbacks::tier_actions::setup_adopt_all_callback`).
    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        spacing: 6px;
        // A discoverable "+ Add Tier" affordance right in the table
        // itself, alongside the Tier tab's inspector form below (the
        // empty-state text names it, but nothing here does). Reuses the
        // SAME `selected_tier_index
        // = -1` + `inspector_tab`/`inspector_collapsed` properties the
        // "Add Anchor" row action below already drives, so no new
        // `EditorModel` surface is needed. The round-trip-through-another-
        // value guard (see the "Add Anchor" touch handler's own comment for
        // why) is not needed here: entering Add mode when already IN Add
        // mode has nothing to reload, unlike jumping between two different
        // real tiers.
        CompactButton {
            width: 78px;
            text: "+ Add Tier";
            ink: Theme.accent-emerald;
            hint: GuideModel.allows_tier_form() ? "Open the Tier tab in Add mode to author a new tier." : GuideModel.locked_hint;
            enabled: GuideModel.allows_tier_form();
            clicked => {
                EditorModel.selected_tier_index = -1;
                EditorModel.inspector_tab = 0;
                EditorModel.inspector_collapsed = false;
            }
        }
        // The tool-cut counterpart: opens the same Tier tab on the concave form
        // (tool, theta, X/Y/Z, D/W) instead of the flat one. Handled in Rust
        // (`EditorModel.add_concave_tier`), which also sets `inspector_concave_mode`.
        CompactButton {
            width: 110px;
            text: "+ Add Concave Tier";
            hint: GuideModel.allows_concave_tier() ? "Open the Tier tab in Add mode for a concave tier -- a facet cut with a tool (cylinder, cone, circle, disc or sphere) instead of a flat lap." : GuideModel.locked_hint;
            enabled: GuideModel.allows_concave_tier();
            clicked => { EditorModel.add_concave_tier(); }
        }
        Rectangle { horizontal-stretch: 1; }
        if root.advanced: CompactButton {
            width: 64px;
            text: "Adopt all";
            hint: GuideModel.allows_tier_table() ? "Adopt every tier's imported meet at once, as one Undo step. See the glossary." : GuideModel.locked_hint;
            enabled: GuideModel.allows_tier_table();
            clicked => { EditorModel.adopt_all(); }
        }
        // A visible affordance for the Ctrl/Shift-click multi-select
        // gesture, which
        // otherwise has no on-screen hint that it exists at all. Toggling
        // this does not itself select/deselect anything -- it only shows a
        // checkbox column (below) that clicking, without holding Ctrl,
        // acts on the same way Ctrl+click already does.
        CompactButton {
            width: 54px;
            text: "Select";
            lit: root.select_mode;
            checkable: true;
            hint: GuideModel.allows_tier_table() ? "Show a tick box column for choosing several tiers at once -- the same group Ctrl+click and Shift+click build, without needing the modifier key. From the keyboard, press Space on a row." : GuideModel.locked_hint;
            enabled: GuideModel.allows_tier_table();
            clicked => { root.select_mode = !root.select_mode; }
        }
        HelpButton {
            topic: HelpTopics.tier-table;
            hint: "Open the manual page on reading the tier table";
        }
    }

    // Quick-add buttons for three common first anchors. Each calls
    // `EditorModel.save_tier` with `index -1` and a `ScaleReference`
    // constraint pre-filled with reasonable starting mast values, so a
    // first-time cutter has something solvable to adjust. Single-facet by
    // design, matching `ConstraintTier::girdle` convention.
    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        spacing: 6px;
        Text { text: "Quick add:"; font-size: 9px; color: Theme.text-muted; vertical-alignment: center; accessible-role: AccessibleRole.text; }
        CompactButton {
            width: 46px;
            text: "Table";
            ink: Theme.accent-emerald;
            hint: GuideModel.allows_tier_table() ? "Add a Table tier (0\u{b0}, pinned to an exact scale value) -- a starting anchor for the crown. See the glossary." : GuideModel.locked_hint;
            enabled: GuideModel.allows_tier_table();
            clicked => { EditorModel.save_tier(-1, "0", 2, "0.32", "Table", ""); }
        }
        CompactButton {
            width: 46px;
            text: "Girdle";
            ink: Theme.accent-emerald;
            hint: GuideModel.allows_tier_table() ? "Add a Girdle tier (90\u{b0}, pinned to an exact scale value = half-width) -- 90\u{b0} is required for a real girdle band. See the glossary." : GuideModel.locked_hint;
            enabled: GuideModel.allows_tier_table();
            clicked => { EditorModel.save_tier(-1, "90", 2, "1", "Girdle", ""); }
        }
        CompactButton {
            width: 46px;
            text: "Culet";
            ink: Theme.accent-emerald;
            hint: GuideModel.allows_tier_table() ? "Add a Culet tier (a flat pavilion facet, pinned to an exact scale value) -- a starting anchor for the pavilion. See the glossary." : GuideModel.locked_hint;
            enabled: GuideModel.allows_tier_table();
            clicked => { EditorModel.save_tier(-1, "-0", 2, "0.88", "Culet", ""); }
        }
        Rectangle { horizontal-stretch: 1; }
        // Toggles the "Generate steps..."/"Mirror to other block" panel below.
        if root.advanced: CompactButton {
            width: 96px;
            text: "Steps / Mirror";
            lit: root.generate_steps_open;
            checkable: true;
            hint: GuideModel.allows_tier_table() ? "Generate a step-cut ladder, or mirror the current tier to the opposite block." : GuideModel.locked_hint;
            enabled: GuideModel.allows_tier_table();
            clicked => { root.generate_steps_open = !root.generate_steps_open; }
        }
    }

    // The Simple interface hides the Detach buttons: say so while a tier is detached.
    if !root.advanced && TierTableModel.any_detached(EditorModel.tiers): HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        AdvancedNote { }
    }

    // The "Generate steps" ladder form and "Mirror to other block" buttons.
    // Both call `EditorModel`, which uses `ConstraintTier::step_series` and
    // `mirrored_to_other_block` in `indicatrix-cut-core`.
    if root.advanced && root.generate_steps_open: VerticalLayout {
        padding-left: 4px;
        padding-right: 4px;
        padding-top: 2px;
        padding-bottom: 2px;
        spacing: 4px;
        Rectangle { height: 1px; background: Theme.border-subtle; }
        HorizontalLayout {
            spacing: 4px;
            step_name_edit := TipField {
                width: 60px;
                placeholder: "Step";
                hint: "The name for the ladder: the tiers are called Step1, Step2 and so on if you type Step.";
                reader_label: "Ladder name";
            }
            step_start_edit := TipField {
                width: 44px;
                placeholder: "start\u{b0}";
                hint: "The angle of the first tier, in degrees. Blank is 0.";
                reader_label: "Start angle in degrees";
            }
            step_delta_edit := TipField {
                width: 44px;
                placeholder: "step\u{b0}";
                hint: "How much each tier's angle changes from the one before it, in degrees. Blank is 0.";
                reader_label: "Step in degrees";
            }
            step_count_edit := TipField {
                width: 32px;
                placeholder: "N";
                hint: "How many tiers to generate.";
                reader_label: "Number of tiers";
            }
            step_indices_edit := TipField {
                width: 70px;
                placeholder: "indices";
                hint: "The index positions every generated tier uses, for example 96, 16, 32.";
                reader_label: "Index positions";
            }
            step_anchor_edit := TipField {
                width: 50px;
                placeholder: "anchor";
                hint: "An exact scale value to pin the first tier to. Leave it blank to let the first tier meet an existing anchor elsewhere in the design.";
                reader_label: "Anchor scale value";
            }
            CompactButton {
                width: 60px;
                text: "Generate";
                hint: GuideModel.allows_tier_table() ? "Generate N tiers named \"Step1\", \"Step2\", ... stepping by the given angle from the given start angle, all sharing the given indices. If Anchor is set, the first tier is pinned to that exact scale value; otherwise it meets an existing anchor elsewhere in the design." : GuideModel.locked_hint;
                enabled: GuideModel.allows_tier_table();
                clicked => {
                    if step_name_edit.text != "" && step_count_edit.text != "" {
                        if root.keep_linked {
                            RelationModel.generate_step_series_linked(
                                step_name_edit.text,
                                step_start_edit.text == "" ? "0" : step_start_edit.text,
                                step_delta_edit.text == "" ? "0" : step_delta_edit.text,
                                Math.round(step_count_edit.text.to-float()),
                                step_indices_edit.text,
                                step_anchor_edit.text
                            );
                        } else {
                            EditorModel.generate_step_series(
                                step_name_edit.text,
                                step_start_edit.text == "" ? "0" : step_start_edit.text,
                                step_delta_edit.text == "" ? "0" : step_delta_edit.text,
                                Math.round(step_count_edit.text.to-float()),
                                step_indices_edit.text,
                                step_anchor_edit.text
                            );
                        }
                    }
                }
            }
        }
        // Makes the ladder follow its first tier: every later tier gets a relation
        // ("Step1 + 2", "Step1 + 4", ...), so editing the first tier moves them all.
        HorizontalLayout {
            spacing: 4px;
            Rectangle {
                width: 110px;
                height: 20px;
                opacity: GuideModel.allows_tier_table() ? 1.0 : 0.4;
                Tooltip { text: GuideModel.allows_tier_table() ? @markdown("Later changes to the first tier move the others by the same steps. See the glossary.") : @markdown("\{GuideModel.locked_hint}"); }
                CheckBox {
                    text: "Keep linked";
                    enabled: GuideModel.allows_tier_table();
                    checked <=> root.keep_linked;
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        HorizontalLayout {
            spacing: 4px;
            Text { text: "Mirror current tier ("; font-size: 9px; color: Theme.text-muted; vertical-alignment: center; accessible-role: AccessibleRole.text; }
            mirror_suffix_edit := TipField {
                width: 30px;
                text: "'";
                hint: "The text added to the mirrored tier's name, so it does not clash with the original.";
                reader_label: "Name suffix for the mirrored tier";
            }
            Text { text: ") to other block:"; font-size: 9px; color: Theme.text-muted; vertical-alignment: center; accessible-role: AccessibleRole.text; }
            CompactButton {
                width: 56px;
                text: "Mirror";
                hint: GuideModel.allows_tier_table() ? "Duplicates the currently selected/cursor tier to the opposite block (angle negated), suffixing its name." : GuideModel.locked_hint;
                enabled: root.keyboard_focus_index >= 0 && GuideModel.allows_tier_table();
                clicked => {
                    EditorModel.mirror_tier_to_other_block(root.keyboard_focus_index, mirror_suffix_edit.text);
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }

    // The "N selected" indicator plus Clear/Delete batch actions -- shown only
    // while a multi-select group of more than one row exists. Lives in the
    // tier table's header for clear, always-visible placement.
    if EditorModel.multi_selected_count > 1: HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        spacing: 6px;
        Rectangle {
            width: 76px;
            height: 20px;
            background: Theme.bg-card-hover;
            border-radius: 3px;
            Text {
                text: EditorModel.multi_selected_count + " selected";
                font-size: 9px;
                font-weight: 600;
                color: Theme.accent-cyan;
                horizontal-alignment: center;
                vertical-alignment: center;
                accessible-role: AccessibleRole.text;
            }
        }
        CompactButton {
            width: 40px;
            text: "Clear";
            ink: Theme.text-secondary;
            hint: GuideModel.allows_tier_table() ? "Clear the selection. No tier is changed." : GuideModel.locked_hint;
            enabled: GuideModel.allows_tier_table();
            clicked => { EditorModel.clear_multi_select(); }
        }
        CompactButton {
            width: 48px;
            text: "Delete";
            ink: Theme.accent-ruby;
            hint: GuideModel.allows_tier_table() ? "Delete every selected tier (one Undo step per tier)." : GuideModel.locked_hint;
            enabled: GuideModel.allows_tier_table();
            clicked => { EditorModel.remove_multi_selected(); }
        }
        // "Adopt all" restricted to the current multi-selection, freeing a
        // Ctrl-clicked group for Optimize without disturbing other tiers.
        if root.advanced: CompactButton {
            width: 64px;
            text: "Adopt sel.";
            hint: GuideModel.allows_tier_table() ? "Adopt the imported meet of every selected tier, as one Undo step. See the glossary." : GuideModel.locked_hint;
            enabled: GuideModel.allows_tier_table();
            clicked => { EditorModel.adopt_selected(); }
        }
        // A batch "offset angle by X" mini-form, reusing `nudge_angle` instead
        // of adding a new callback. `root.keyboard_focus_index` is the anchor.
        // Edge case: applying after a Ctrl+click that just removed a row from
        // the group offsets only that single (now-deselected) tier. The text goes
        // through Rust (`TierTableModel.offset_selected`), which reads a plain
        // number or a small calculation and says in a toast when it cannot.
        offset_edit := TipField {
            width: 54px;
            placeholder: "deg";
            hint: "How many degrees to move every selected tier's angle by. You can type arithmetic, for example 0.5+0.25. Press Enter, or Offset, to apply.";
            reader_label: "Offset in degrees";
            accepted => {
                if offset_edit.text != "" && TierTableModel.offset_selected(root.keyboard_focus_index, offset_edit.text) {
                    offset_edit.text = "";
                }
            }
        }
        CompactButton {
            width: 46px;
            text: "Offset";
            hint: GuideModel.allows_tier_table() ? "Offset every selected tier's angle by the degrees you typed, as one Undo step. You can type arithmetic, for example 0.5+0.25." : GuideModel.locked_hint;
            enabled: GuideModel.allows_tier_table();
            clicked => {
                if offset_edit.text != "" && TierTableModel.offset_selected(root.keyboard_focus_index, offset_edit.text) {
                    offset_edit.text = "";
                }
            }
        }
        Rectangle { horizontal-stretch: 1; }
    }
}
