import { Slider } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { SolidPreviewModel } from "../models/solid_preview.slint";
import { ViewportModel } from "../models/viewport.slint";
import { EditorModel } from "../models/editor.slint";
// The Tilt Curve pill/dialog is reachable from this tab too, not only from the
// Live Render tab's `GemViewportView` -- `PerformanceGraphDialog`
// (`components/performance_graph_dialog.slint`) is bound entirely through
// globals (`TiltModel`/`ViewportModel`), so mounting it here too is safe: it
// carries no dependency on `GemViewportView`'s own local state.
import { TiltModel } from "../models/tilt.slint";
import { PerformanceGraphDialog } from "performance_graph_dialog.slint";
// The custom-material editor is mounted here too, not only in the Live Render
// tab's `GemViewportView` (which also mounts `MaterialEditorDialog`), so a
// cutter working the Edit tab can create/edit a custom material without
// switching tabs -- mirroring the same mounting pattern used above for
// `PerformanceGraphDialog`: `SolidViewportView` and `GemViewportView` are
// mutually exclusive (only the Edit tab OR the Live Render tab is ever
// mounted at once, see `app.slint`), so there is never a second copy of this
// dialog on screen despite both files mounting it conditionally on the same
// `ViewportModel.material_editor_open`.
import { MaterialEditorDialog } from "material_editor_dialog.slint";
// The mode toggle/cut slider, camera pose pills, Tilt Curve/Preform toggles
// and status strip -- see `SolidViewportToolbar`'s own doc comment
// (`solid_viewport/toolbar.slint`) for why this is split out.
import { SolidViewportToolbar } from "solid_viewport/toolbar.slint";

// The Edit tab's solid-inspection viewport: a flat-shaded software render of the
// current design's solid, shown as a static image after Solve. Reads
// `SolidPreviewModel` directly rather than taking its state as local properties.
//
// `view_mode` picks among the images this component accepts: `0` (Solid) shows
// `image` alone, `1` (Path-traced) shows `render_image` alone -- the same image
// `GemViewportView` draws in the Live Render tab, forwarded here so a user can compare
// without switching tabs. `2` (Both) shows `render_image` as a base layer
// with `edges_image` (the solid's transparent-fill/opaque-edges render --
// `gui::solid_preview::edges_layer`) composited on top. `3` (Diagram) shows
// `diagram_image` -- a GemCAD-style three-panel (crown/pavilion/profile) 2D facet
// diagram (`gui::solid_preview::diagram2d`), fixed/orthographic rather than tied to
// the shared orbit camera. Dragging/scrolling in this mode pans/zooms the diagram
// image itself (`diagram_pan_x`/`diagram_pan_y`/`diagram_zoom`, #29) rather than
// the shared camera, and hover/click route through their OWN `diagram_facet_hover`/
// `diagram_facet_click` callbacks against the diagram's own pick buffer, since its
// pixel layout is entirely different from the Solid rasterizer's.
export component SolidViewportView inherits Rectangle {
    vertical-stretch: 1;
    min-height: 0px;
    min-width: 0px;
    preferred-height: 480px;
    clip: true;

    // Diagram mode (view_mode 3) shows its own hover text; every other mode keeps the
    // Solid rasterizer's.
    property <string> hover_text: SolidPreviewModel.view_mode == 3 ? SolidPreviewModel.diagram_hover_text : SolidPreviewModel.hover_text;

    property <bool> is_dragging: false;
    property <length> last_mouse_x;
    property <length> last_mouse_y;
    // Accumulated |dx| + |dy| since the last pointer-down, in logical pixels --
    // reset on `down` and grown on every `moved` while dragging. `clicked` only
    // forwards to `facet_click`/`diagram_facet_click` below this threshold, so an
    // orbit drag that happens to release over a facet doesn't also re-select it.
    property <float> drag_distance: 0;

    // #29: Diagram mode's own zoom/pan -- the fixed orthographic 2D facet diagram
    // has no shared orbit camera to reuse (unlike Solid/Path-traced/Both), so this
    // is a plain scale + translate applied to the whole three-panel image, entirely
    // presentational (the underlying `diagram_image` raster is unchanged). `1.0`/
    // `0px` is "no zoom, no pan" -- the diagram fills the viewport exactly as
    // before. Reset by the "Reset View" pill, shown only in Diagram mode.
    property <float> diagram_zoom: 1.0;
    property <length> diagram_pan_x: 0px;
    property <length> diagram_pan_y: 0px;
    // Maps a viewport-local mouse coordinate back to the SAME logical-pixel space
    // `diagram_facet_hover`/`diagram_facet_click` already expected before zoom/pan
    // existed (that is, "where this point would be if `diagram_zoom` were `1.0`
    // and both pans were `0px`") -- `gui::solid_preview::diagram_wiring`'s hover/
    // click callbacks, and the HiDPI scale-factor multiplication they already do,
    // are unaffected by this component ever zooming or panning.
    function diagram_unzoomed_x(mouse_x: length) -> length {
        return (mouse_x - root.diagram_pan_x) / root.diagram_zoom;
    }
    function diagram_unzoomed_y(mouse_y: length) -> length {
        return (mouse_y - root.diagram_pan_y) / root.diagram_zoom;
    }
    // Keeps a zoomed-in diagram from being dragged entirely off-screen -- clamps
    // to the extra width/height `diagram_zoom` adds beyond the viewport's own
    // size, on each side.
    function clamp_diagram_pan(value: length, extent: length, zoom: float) -> length {
        return max(-(extent * (zoom - 1)), min(extent * (zoom - 1), value));
    }

    background: #080a0f;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-subtle;

    // Slint has no built-in way to report a widget's rendered size back to Rust (see
    // `bridge::render_thread::context::RenderContext`'s own `width`/`height` doc
    // comment on the same limitation for the Live Render viewport) -- push this
    // component's own layout size straight into the global on every change so
    // `gui::editor::view::refresh_viewport` sizes the rasterizer to exactly the
    // logical size, never the render resolution.
    //
    // #26: this size push must be observed, or dragging the dock splitter or
    // maximising the window leaves the shown image simply rescaled/letterboxed to
    // the new size, with the pick buffer (still sized to the OLD frame) misaligned
    // from the cursor until the next orbit/zoom redraw. `resize_pulse` bumps on
    // every width/height change; a 50ms poll timer fires `viewport_resized()` once
    // that pulse has stopped moving for a tick, so a drag-resize coalesces to one
    // redraw request rather than one per intermediate layout pass. Handled in
    // `gui::mod::build_main_window` (`on_viewport_resized`), which calls
    // `render::camera_lighting::resubmit_at_current_pose`.
    property <int> resize_pulse: 0;
    property <int> resize_pulse_seen: 0;
    changed width => { SolidPreviewModel.viewport_width = self.width; root.resize_pulse += 1; }
    changed height => { SolidPreviewModel.viewport_height = self.height; root.resize_pulse += 1; }

    // #116: a global's own property can't get a `changed` handler outside the
    // file that declares it -- mirrored into this plain local property so a
    // view-mode switch can clear whichever tooltip belonged to the OLD mode
    // (Diagram's `diagram_hover_text` vs every other mode's `hover_text`)
    // instead of leaving it on screen, naming a facet that may not even exist
    // in the new mode's own facet space.
    property <int> hover_view_mode: SolidPreviewModel.view_mode;
    changed hover_view_mode => {
        SolidPreviewModel.hover_text = "";
        SolidPreviewModel.diagram_hover_text = "";
    }
    Timer {
        interval: 50ms;
        running: true;
        triggered => {
            if (root.resize_pulse != root.resize_pulse_seen) {
                root.resize_pulse_seen = root.resize_pulse;
                SolidPreviewModel.viewport_resized();
            }
        }
    }

    // #229: wraps `drag_area` so the viewport can take keyboard focus (on a
    // left-`down`, alongside the existing drag bookkeeping) and clear the tier
    // selection with Escape -- the same "back to nothing selected" effect a
    // click that misses the silhouette now has (see `diagram_facet_click`'s own
    // doc comment in `solid_preview::diagram_wiring`, and `tier_actions.rs`'s
    // `setup_solid_facet_click_callback` for the Solid-view half, which is not
    // this pass's file to touch). Setting `EditorModel.selected_tier_index`
    // directly, exactly like `editor_inspector.slint`'s "New" button and
    // `editor_tier_table.slint`'s delete path already do, is enough: `changed
    // selected_tier_index` in `models/editor.slint` fires `selected_tier_changed`
    // on its own, which re-seeds/clears the inspector form and the 3D
    // highlight.
    // Forwards Up/Down/PageUp/PageDown straight to `EditorModel.
    // selected_tier_index` so a cutter watching the 3D view can step through
    // tiers without switching focus to the tier table.
    // Mirrors `editor_tier_table.slint`'s own FocusScope arithmetic (clamped to
    // `[0, tiers.length - 1]`, `-1` treated as "start from the top") but writes
    // `selected_tier_index` directly rather than calling a local `tier_selected`
    // callback: `EditorTierTable` has its own `keyboard_focus_index` cursor to
    // keep in step with a click, but this viewport has no such cursor of its
    // own, and `changed selected_tier_index` in `models/editor.slint` already
    // re-seeds the inspector form and the 3D highlight on its own.
    function step_selection(delta: int) {
        if EditorModel.tiers.length <= 0 {
            return;
        }
        if EditorModel.selected_tier_index < 0 {
            EditorModel.selected_tier_index = delta >= 0 ? 0 : EditorModel.tiers.length - 1;
            return;
        }
        EditorModel.selected_tier_index = Math.max(0, Math.min(EditorModel.tiers.length - 1, EditorModel.selected_tier_index + delta));
    }
    viewport_focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                EditorModel.selected_tier_index = -1;
                return accept;
            } else if event.text == Key.DownArrow {
                root.step_selection(1);
                return accept;
            } else if event.text == Key.UpArrow {
                root.step_selection(-1);
                return accept;
            } else if event.text == Key.PageDown {
                root.step_selection(10);
                return accept;
            } else if event.text == Key.PageUp {
                root.step_selection(-10);
                return accept;
            }
            reject
        }

    drag_area := TouchArea {
        // Matches `GemViewportView`'s own `touch_area.enabled` guard --
        // without this, an orbit-drag or scroll-to-zoom could still reach the
        // viewport underneath the (fully covering) Tilt Curve dialog.
        enabled: !TiltModel.dialog_open;
        pointer-event(event) => {
            // #29: Diagram mode now drags too -- panning the zoomed-in diagram --
            // so `down`/`up` are tracked exactly like every other view mode.
            //
            // #124: only the LEFT button starts an orbit/pan drag. Muscle memory
            // from the Live tab's Gem viewport (right-drag moves the light, see
            // `gem_viewport.slint`'s own `is_right_drag`) could otherwise rotate
            // the stone here instead -- there is no light to move in this
            // viewport, so a right or middle drag does nothing rather than
            // surprise-orbiting.
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                root.last_mouse_x = drag_area.mouse-x;
                root.last_mouse_y = drag_area.mouse-y;
                root.drag_distance = 0;
                root.is_dragging = true;
                // #229: grabs keyboard focus so Escape (handled by the wrapping
                // `viewport_focus` FocusScope above) works right after a click,
                // without requiring a separate Tab into the viewport.
                viewport_focus.focus();
                // #116: an orbit/pan drag is about to start -- the tooltip's own
                // guard below already hides it once `is_dragging` is true, but
                // clearing the text too means a MID-drag `moved` (which never
                // reaches the `else` branch below that would refresh it) can't
                // leave a stale value sitting there for the instant between
                // `down` and the drag threshold, nor for a click that lands
                // exactly on `down`+`up` with no `moved` at all.
                SolidPreviewModel.hover_text = "";
                SolidPreviewModel.diagram_hover_text = "";
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                root.is_dragging = false;
            }
        }
        moved => {
            if (SolidPreviewModel.view_mode == 3) {
                if (root.is_dragging) {
                    // #29: pan, clamped so the zoomed diagram can't be dragged
                    // entirely off-screen.
                    let dx = drag_area.mouse-x - root.last_mouse_x;
                    let dy = drag_area.mouse-y - root.last_mouse_y;
                    root.last_mouse_x = drag_area.mouse-x;
                    root.last_mouse_y = drag_area.mouse-y;
                    root.drag_distance += Math.abs(dx / 1px) + Math.abs(dy / 1px);
                    root.diagram_pan_x = root.clamp_diagram_pan(root.diagram_pan_x + dx, root.width, root.diagram_zoom);
                    root.diagram_pan_y = root.clamp_diagram_pan(root.diagram_pan_y + dy, root.height, root.diagram_zoom);
                } else {
                    SolidPreviewModel.diagram_facet_hover(root.diagram_unzoomed_x(drag_area.mouse-x), root.diagram_unzoomed_y(drag_area.mouse-y));
                }
            } else if (root.is_dragging) {
                let dx = (drag_area.mouse-x - root.last_mouse_x) / 1px;
                let dy = (drag_area.mouse-y - root.last_mouse_y) / 1px;
                root.last_mouse_x = drag_area.mouse-x;
                root.last_mouse_y = drag_area.mouse-y;
                root.drag_distance += Math.abs(dx) + Math.abs(dy);
                ViewportModel.camera_orbit(dx, dy);
            } else {
                // Only picking, not dragging -- the hover tooltip.
                SolidPreviewModel.facet_hover(drag_area.mouse-x, drag_area.mouse-y);
            }
        }
        clicked => {
            if (SolidPreviewModel.view_mode == 3) {
                // #29: a pan drag ends in a `clicked` too, exactly like an orbit
                // drag in every other mode -- only forward it as a real pick when
                // the pointer barely moved between down and up, so panning the
                // diagram never also re-triggers a facet pick.
                if (root.drag_distance < 3) {
                    SolidPreviewModel.diagram_facet_click(root.diagram_unzoomed_x(drag_area.mouse-x), root.diagram_unzoomed_y(drag_area.mouse-y));
                }
            } else if (root.drag_distance < 3) {
                // An orbit drag ends in a `clicked` too -- only forward it as a real
                // pick when the pointer barely moved between down and up, so
                // rotating the stone never also re-selects whatever facet ends up
                // under the cursor.
                SolidPreviewModel.facet_click(drag_area.mouse-x, drag_area.mouse-y);
            }
        }
        // Scroll-to-zoom (#27, and #29 for Diagram mode): the same shared orbit
        // camera `gem_viewport.slint`'s Live Render viewport already zooms with
        // `ViewportModel.camera_zoom` -- this viewport had no wheel handler at all,
        // so inspecting a small facet (a girdle break, the culet) meant switching
        // tabs, scrolling there, and switching back. Diagram mode has no shared
        // camera to zoom (see this component's own doc comment), so it zooms its
        // own `diagram_zoom` instead, clamped to `[1.0, 6.0]`.
        scroll-event(event) => {
            if (SolidPreviewModel.view_mode != 3) {
                ViewportModel.camera_zoom(event.delta-y / 1px);
                return accept;
            }
            root.diagram_zoom = max(1.0, min(6.0, root.diagram_zoom - (event.delta-y / 1px) * 0.003));
            accept
        }
    }
    } // FocusScope (viewport_focus)

    if SolidPreviewModel.view_mode == 0 && SolidPreviewModel.has_solid: Image {
        width: 100%;
        height: 100%;
        source: SolidPreviewModel.image;
        image-fit: contain;
    }

    if SolidPreviewModel.view_mode == 1 && ViewportModel.has_render: Image {
        width: 100%;
        height: 100%;
        source: ViewportModel.render_image;
        image-fit: contain;
    }

    // "Both" mode: the path-traced image as a base layer, with the solid's
    // transparent-fill/opaque-edges layer composited on top -- see
    // `gui::solid_preview::edges_layer`'s own doc comment.
    //
    // #32: `edges_image` rebuilds from the CURRENT (possibly just-edited) design on
    // every edit, while `render_image` only changes when the path tracer's own
    // planes are resubmitted -- this reconciles the two layers' provenance so a
    // misaligned edge overlay after an edit reads as the render simply being one
    // edit behind, rather than a solver error. Gated on `trace_matches_solid`
    // (defaults to `true`, so this composites normally until something actually
    // sets it `false`); when mismatched, the base dims and a small note explains
    // why, rather than silently overlaying stale edges.
    if SolidPreviewModel.view_mode == 2 && ViewportModel.has_render: Image {
        width: 100%;
        height: 100%;
        source: ViewportModel.render_image;
        image-fit: contain;
        opacity: SolidPreviewModel.trace_matches_solid ? 1.0 : 0.5;
    }
    if SolidPreviewModel.view_mode == 2 && SolidPreviewModel.has_solid_edges && SolidPreviewModel.trace_matches_solid: Image {
        width: 100%;
        height: 100%;
        source: SolidPreviewModel.edges_image;
        image-fit: contain;
    }
    if SolidPreviewModel.view_mode == 2 && ViewportModel.has_render && !SolidPreviewModel.trace_matches_solid: Text {
        text: "Render is behind the current edit -- edges hidden until it catches up";
        font-size: 12px;
        color: Theme.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        wrap: word-wrap;
    }

    // Diagram mode: the three-panel 2D facet diagram (`gui::solid_preview::diagram2d`)
    // -- see this component's own doc comment. #29: scaled/translated by
    // `diagram_zoom`/`diagram_pan_x`/`diagram_pan_y` -- `root`'s own `clip: true`
    // (set above) is what keeps a zoomed-in image from spilling outside the
    // viewport.
    if SolidPreviewModel.view_mode == 3 && SolidPreviewModel.has_diagram: Image {
        x: root.diagram_pan_x;
        y: root.diagram_pan_y;
        width: root.width * root.diagram_zoom;
        height: root.height * root.diagram_zoom;
        source: SolidPreviewModel.diagram_image;
        image-fit: contain;
    }

    // Placeholder: nothing solved yet in Solid mode, nothing rendered yet in
    // Path-traced/Both mode, or nothing solved yet in Diagram mode.
    if (SolidPreviewModel.view_mode == 0 && !SolidPreviewModel.has_solid) || (SolidPreviewModel.view_mode == 3 && !SolidPreviewModel.has_diagram) || (SolidPreviewModel.view_mode != 0 && SolidPreviewModel.view_mode != 3 && !ViewportModel.has_render): VerticalLayout {
        alignment: center;
        spacing: 12px;

        Image {
            source: @image-url("../icons/gem.svg");
            colorize: Theme.text-muted;
            width: 48px;
            height: 48px;
            horizontal-alignment: center;
        }

        Text {
            // A brand-new, zero-tier design has nothing TO solve, so this names
            // the actual next step rather than telling a first-time cutter to
            // press "Solve to preview" on a button that cannot yet do anything
            // (New/Load Selected/Open Native all live in the catalogue panel
            // and the command bar, neither of which this viewport can reach
            // directly, hence naming them rather than linking them).
            text: EditorModel.tiers.length == 0
                ? "Nothing to show yet -- start with New, Load Selected from the catalogue, or Open Native."
                : ((SolidPreviewModel.view_mode == 0 || SolidPreviewModel.view_mode == 3) ? "Solve to preview" : "Nothing rendered yet");
            font-size: 13px;
            color: Theme.text-muted;
            horizontal-alignment: center;
            wrap: word-wrap;
            width: 80%;
        }
    }

    // A small hover tooltip panel, bottom-left of the image -- see `hover_text`'s own
    // doc comment above.
    //
    // #116: gated on `drag_area.has-hover && !root.is_dragging` too, not just a
    // non-empty string -- the pointer-event handler above cleared the text on
    // `down` and on a view-mode switch, but the mouse leaving for the tier
    // table (no `has-hover`) or an orbit drag in progress (`is_dragging`) used
    // to leave the LAST hover's text on screen since nothing else re-ran
    // `facet_hover`/`diagram_facet_hover` to refresh or clear it.
    if root.hover_text != "" && drag_area.has-hover && !root.is_dragging: Rectangle {
        x: 10px;
        y: parent.height - self.height - 46px;
        width: hover_label.preferred-width + 16px;
        height: hover_label.preferred-height + 10px;
        background: Theme.bg-elevated;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: Theme.border-subtle;

        hover_label := Text {
            text: root.hover_text;
            font-size: 11px;
            color: Theme.text-primary;
            x: 8px;
            y: 5px;
        }
    }

    // --- Mode toggle: Solid | Path-traced, camera pose pills, Tilt Curve/
    // Preform toggles and the status strip -- see `SolidViewportToolbar`'s own
    // doc comment (`solid_viewport/toolbar.slint`) for why this is split out.
    // `diagram_zoom`/`diagram_pan_x`/`diagram_pan_y` stay on THIS component
    // (its own Image rendering and drag handling above read them too) and are
    // shared two-way so the toolbar's "Reset View" pill can reset them.
    SolidViewportToolbar {
        diagram_zoom <=> root.diagram_zoom;
        diagram_pan_x <=> root.diagram_pan_x;
        diagram_pan_y <=> root.diagram_pan_y;
    }

    // Mounted here too (mirroring `GemViewportView`'s own identical mount) so
    // the Tilt Curve pill above has a dialog to open -- `SolidViewportView`
    // and `GemViewportView` are mutually exclusive (only the Edit tab OR the
    // Live Render tab is ever mounted at once, see `app.slint`), so there is
    // never a second copy of this dialog on screen at once despite both
    // files mounting it conditionally on the same `TiltModel.dialog_open`.
    if TiltModel.dialog_open: PerformanceGraphDialog {
        width: 100%;
        height: 100%;
        z: 350;
    }

    // Mounted here too (mirroring `GemViewportView`'s own identical mount,
    // same `z` value) so the "New/Edit material..." button
    // `editor_design_settings.slint` adds next to the Design Settings material
    // combo has a dialog to open without leaving the Edit tab.
    if ViewportModel.material_editor_open: MaterialEditorDialog {
        width: 100%;
        height: 100%;
        z: 300;
    }
}
