import { Theme } from "../../theme.slint";
import { EditorModel } from "../../models/editor.slint";

// The Inspector's "Schedule" tab -- the design's OWN cut order, not only ever
// the catalogue's original schedule -- built from
// `Design::to_asc_schedule_from_solved`, the same conversion "Export Edited
// .asc" already writes. Read-only: copying a row/the whole table is not
// wired here (that lives behind `LibraryModel`'s clipboard callbacks) --
// Export Edited .asc is the copyable form for now. Purely a view over
// `EditorModel.cutting_rows`, so this component needs no properties of its
// own.
export component ScheduleTab inherits VerticalLayout {
    spacing: 6px;
    Text { text: "Schedule"; font-size: 12px; font-weight: 700; color: Theme.text-primary; }
    if EditorModel.cutting_rows.length == 0: Text {
        text: "Not solved -- click Solve to see this design's own cut order here.";
        font-size: 10px;
        color: Theme.text-muted;
        wrap: word-wrap;
    }
    if EditorModel.cutting_rows.length > 0: VerticalLayout {
        spacing: 2px;
        HorizontalLayout {
            spacing: 6px;
            Text { horizontal-stretch: 1; text: "FACET"; font-size: 9px; font-weight: 700; color: Theme.text-muted; }
            Text { width: 48px; text: "ANGLE"; font-size: 9px; font-weight: 700; color: Theme.text-muted; }
            Text { horizontal-stretch: 1; text: "INDEX"; font-size: 9px; font-weight: 700; color: Theme.text-muted; }
        }
        for row in EditorModel.cutting_rows: HorizontalLayout {
            spacing: 6px;
            Text { horizontal-stretch: 1; text: row.facet; font-size: 10px; color: Theme.text-secondary; overflow: elide; }
            Text { width: 48px; text: row.angle; font-size: 10px; color: Theme.text-secondary; }
            Text { horizontal-stretch: 1; text: row.index_val; font-size: 10px; color: Theme.text-secondary; overflow: elide; }
        }
        Text { text: "For a copyable file, use Export Edited .asc."; font-size: 9px; color: Theme.text-muted; wrap: word-wrap; }
    }
}
