import { Theme } from "../../theme.slint";
import { EditorModel } from "../../models/editor.slint";

// The Inspector's "Schedule" tab -- the design's OWN cut order, not only ever
// the catalogue's original schedule -- built from
// `Design::to_asc_schedule_from_solved`, the same conversion "Export Edited
// .asc" already writes. Read-only: copying a row/the whole table is not
// wired here (that lives behind `LibraryModel`'s clipboard callbacks) --
// Export Edited .asc is the copyable form for now. Purely a view over
// `EditorModel.cutting_rows`, so this component needs no properties of its
// own.
//
// For a screen reader the list is a list of rows, each row read as one sentence ("P1, angle
// 42.00, index 96"). The tab is advanced; the Simple interface does not show it (the
// Inspector hides its pill and body).
export component ScheduleTab inherits VerticalLayout {
    spacing: 6px;
    // The shared column grid of the header and the rows.
    private property <length> code-w: 40px;
    private property <length> angle-w: 56px;
    private property <length> col-gap: 8px;
    private property <length> row-pad: 6px;
    // Packed at the top, as the other inspector tabs: no row takes the spare height.
    alignment: start;
    Rectangle {
        height: schedule_title.preferred-height;
        Tooltip { text: @markdown("The order in which the facets are cut, one line per facet, as this design has them now. It is the same list \"Export Edited .asc\" writes."); }
        schedule_title := Text { text: "Schedule"; font-size: 12px; font-weight: 700; color: Theme.text-primary; accessible-role: AccessibleRole.text; }
    }
    if EditorModel.cutting_rows.length == 0: Text {
        text: "Not solved -- click Solve to see this design's own cut order here.";
        font-size: 10px;
        color: Theme.text-muted;
        wrap: word-wrap;
        accessible-role: AccessibleRole.text;
    }
    if EditorModel.cutting_rows.length > 0: Rectangle {
        accessible-role: AccessibleRole.list;
        accessible-label: "Cutting schedule";
        VerticalLayout {
            spacing: 2px;
            // One column grid for the header and every row: the code and angle columns are
            // fixed, the index column takes the rest, so the columns line up whatever a row holds.
            HorizontalLayout {
                spacing: root.col-gap;
                padding-left: root.row-pad;
                padding-right: root.row-pad;
                Rectangle {
                    width: root.code-w;
                    height: facet_head.preferred-height;
                    Tooltip { text: @markdown("The facet's code, in cutting order: P pavilion, G girdle, C crown, T table."); }
                    facet_head := Text { width: parent.width; text: "FACET"; horizontal-alignment: left; font-size: 9px; font-weight: 700; color: Theme.text-muted; accessible-role: AccessibleRole.text; }
                }
                Rectangle {
                    width: root.angle-w;
                    height: angle_head.preferred-height;
                    Tooltip { text: @markdown("The angle to set on the machine, in degrees."); }
                    angle_head := Text { width: parent.width; text: "ANGLE"; horizontal-alignment: right; font-size: 9px; font-weight: 700; color: Theme.text-muted; accessible-role: AccessibleRole.text; }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    height: index_head.preferred-height;
                    Tooltip { text: @markdown("The index-wheel positions to cut the facet at, written as on the cutting sheet. See the glossary."); }
                    index_head := Text { width: parent.width; text: "INDEX"; horizontal-alignment: left; font-size: 9px; font-weight: 700; color: Theme.text-muted; accessible-role: AccessibleRole.text; }
                }
            }
            // One shaded band per tier, the zebra alternating per tier (not per line): a
            // concave tier's facet line and its tool line (`AngleItem.second_line`) share
            // their band, so the pair reads as one entry.
            for row in EditorModel.cutting_rows: Rectangle {
                background: Math.mod(row.order_idx, 2) == 0 ? Theme.bg-input : Theme.bg-card;
                border-radius: Theme.radius-sm;
                accessible-role: AccessibleRole.list-item;
                accessible-label: row.facet + ", angle " + row.angle + ", index " + row.index_val + (row.second_line != "" ? ", " + row.second_line : "");
                VerticalLayout {
                    padding-left: root.row-pad;
                    padding-right: root.row-pad;
                    padding-top: 1px;
                    padding-bottom: 1px;
                    HorizontalLayout {
                        spacing: root.col-gap;
                        alignment: start;
                        Text { width: root.code-w; text: row.facet; horizontal-alignment: left; vertical-alignment: top; font-size: 10px; color: Theme.text-secondary; overflow: elide; }
                        Text { width: root.angle-w; text: row.angle; horizontal-alignment: right; vertical-alignment: top; font-size: 10px; color: Theme.text-secondary; }
                        Text { horizontal-stretch: 1; text: row.index_val; horizontal-alignment: left; vertical-alignment: top; font-size: 10px; color: Theme.text-secondary; wrap: word-wrap; }
                    }
                    // The tool line sits under the index column.
                    if row.second_line != "": HorizontalLayout {
                        spacing: root.col-gap;
                        Rectangle { width: root.code-w + root.angle-w + root.col-gap; }
                        Text {
                            horizontal-stretch: 1;
                            text: row.second_line;
                            font-size: 9px;
                            color: Theme.accent-cyan;
                            wrap: word-wrap;
                        }
                    }
                }
            }
            Text { text: "For a copyable file, use Export Edited .asc."; font-size: 9px; color: Theme.text-muted; wrap: word-wrap; accessible-role: AccessibleRole.text; }
        }
    }
}
