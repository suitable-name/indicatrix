import { Slider, ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { SettingsModel } from "../models/settings.slint";
import { ViewportModel } from "../models/viewport.slint";
import { TiltModel } from "../models/tilt.slint";
import { GuideModel } from "../models/guide.slint";
import { HelpTopics } from "../models/help.slint";
import { HelpButton } from "help_button.slint";
import { IconButton } from "icon_button.slint";
import { SegmentPill } from "pill_button.slint";
import { ResolutionPicker } from "settings_dialog/resolution_picker.slint";
import { MotionPreviewPicker } from "settings_dialog/motion_preview_picker.slint";
import { LiveComputePicker } from "settings_dialog/live_compute_picker.slint";
import { LocalComputePicker } from "settings_dialog/local_compute_picker.slint";
import { BouncesPicker } from "settings_dialog/bounces_picker.slint";
import { CrystalAxisSection } from "settings_dialog/crystal_axis_section.slint";
import { EnvironmentMapSection } from "settings_dialog/environment_map_section.slint";
import { LightingPresetsSection } from "settings_dialog/lighting_presets_section.slint";
import { PerformanceCurvePanel } from "settings_dialog/performance_curve_panel.slint";
import { SettingLabel } from "settings_dialog/setting_label.slint";
import { ToggleRow } from "toggle_switch.slint";
// `gui::editor::view::refresh_design_settings` pushes the design's own
// `girdle_diameter_mm` into
// `ctx.stone_width_mm`/`SettingsModel.stone_width_mm` under the same
// Edit-tab/`viewport_material_linked` gate the material sync uses -- this
// file only reads that same global to say so next to the slider, rather than
// showing a typed-in-looking number the slider itself did not set.
import { EditorModel } from "../models/editor.slint";

// One button of the dialog's footer: Reset to Defaults, its Confirm and Cancel, and Done.
// `kind` 0 is a plain button, 1 the main action (the dialog's cyan), 2 a destructive one.
// Tab reaches it, Space or Enter presses it, a tooltip says what it does.
component FooterButton inherits Rectangle {
    in property <string> text;
    in property <string> hint;
    in property <image> icon;
    in property <int> kind: 0;
    callback clicked();

    height: 30px;
    border-radius: Theme.radius-sm;
    background: root.kind == 1
        ? (footer_touch.has-hover ? Theme.accent-cyan-hover : Theme.accent-cyan)
        : (root.kind == 2
            ? (footer_touch.has-hover ? Theme.accent-ruby.darker(0.25) : Theme.accent-ruby)
            : (footer_touch.has-hover ? Theme.surface-raised : Theme.surface-sunken));
    border-width: footer_focus.has-focus ? 2px : (root.kind == 0 ? 1px : 0px);
    border-color: footer_focus.has-focus ? Theme.accent-cyan-hover : Theme.border-dialog;

    accessible-role: AccessibleRole.button;
    accessible-label: root.text;
    accessible-description: root.hint;
    accessible-action-default => { root.clicked(); }

    Tooltip { text: @markdown("\{root.hint}"); }

    footer_focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    HorizontalLayout {
        alignment: center;
        spacing: 5px;
        if root.icon.width > 0: Image {
            source: root.icon;
            colorize: Theme.text-secondary;
            width: 11px;
            height: 11px;
            vertical-alignment: center;
        }
        Text {
            text: root.text;
            font-size: root.kind == 1 ? 12px : 11px;
            font-weight: root.kind == 0 ? 600 : 700;
            color: root.kind == 1 ? Theme.text-on-accent : (root.kind == 2 ? Theme.text-on-primary : Theme.text-secondary);
            vertical-alignment: center;
            overflow: elide;
        }
    }

    footer_touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A small underlined-on-hover text button inside a settings row ("Reset to 100 %"). Tab
// reaches it, Space or Enter presses it.
component TextLink inherits Rectangle {
    in property <string> text;
    in property <string> hint;
    callback clicked();

    width: link_text.preferred-width + 4px;
    height: link_text.preferred-height + 4px;
    border-radius: 2px;
    border-width: link_focus.has-focus ? 1px : 0px;
    border-color: Theme.accent-cyan-hover;

    accessible-role: AccessibleRole.button;
    accessible-label: root.text;
    accessible-description: root.hint;
    accessible-action-default => { root.clicked(); }

    Tooltip { text: @markdown("\{root.hint}"); }

    link_focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    link_text := Text {
        x: 2px;
        y: 2px;
        text: root.text;
        font-size: 10px;
        color: link_touch.has-hover ? Theme.accent-cyan : Theme.text-muted;
        vertical-alignment: center;
    }

    link_touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The Live Render viewport's "Rendering Settings" card (the gear in its toolbar): picture
// quality, resolution, compute, lighting and a few material effects.
//
// Simple mode (`GuideModel.shows_advanced()`) keeps the controls most designs need -- target
// samples, resolution, inclusion haze, crystal axis, frosted girdle, edge rounding, stone
// size, environment map, exposure, backdrop, surface glare, light direction and the lighting
// presets -- and hides the rest: catalogue preview size and samples, motion preview, live and
// local compute, ray bounces and the tilt curve panel. A hidden control keeps its value and
// still applies; the card says so when one is off its default.
export component SettingsDialog inherits Rectangle {
    // This popup is positioned by absolute x/y/z in `gem_viewport.slint` rather than
    // laid out in a container, so `GemViewportView` passes its own height through
    // explicitly; the cap below is a fraction of it instead of a fixed pixel number.
    in property <length> available_height: 600px;

    // Rounded exponent driving the displayed sample count: `SliderBase` only snaps to
    // `step` on arrow-key nudges, not on pointer drag, so the rounding happens here.
    property <int> sample_exponent: Math.round(SettingsModel.target_samples_exponent);
    property <int> target_samples_count: Math.round(Math.pow(2.0, root.sample_exponent));

    property <string> live_remote_unavailable_reason: "";

    property <bool> confirming_reset: false;
    // While linked, `SettingsModel.stone_width_mm` is
    // overwritten by the design's own girdle diameter on every Edit-tab
    // refresh (a solve, an edit, a design load) -- dragging the Stone Size
    // slider would only be clobbered on the next one, so the slider says so
    // instead of looking like an independent, sticky manual setting.
    property <bool> stone_size_is_design_driven: EditorModel.enabled && ViewportModel.viewport_material_linked;
    // Surface glare only scales the built-in lighting presets: a loaded HDR map
    // (`SettingsModel.env_map_loaded`) ignores it, so the slider greys out with a hint
    // rather than looking like it does something.
    property <bool> surface_glare_enabled: !SettingsModel.env_map_loaded;
    property <int> surface_glare_shown: Math.round(SettingsModel.surface_glare_pct / 5.0) * 5;
    property <bool> head_shadow_enabled: !SettingsModel.env_map_loaded;
    property <int> head_shadow_shown: Math.round(SettingsModel.head_shadow_deg);
    property <string> stone_size_tooltip: root.stone_size_is_design_driven
        ? "Stone Size: the width of the stone across the girdle in millimetres, so the colour and depth of a render match a real stone. Currently set from the linked design's own girdle diameter -- turn off \"Linked to design\" to set this manually."
        : "Stone Size: the width of the stone across the girdle in millimetres, so the colour and depth of a render match a real stone. 0 leaves the picture unscaled.";
    // Simple mode hides some controls that are off their defaults: say so (see the
    // callback's own comment in `models/settings.slint`).
    property <bool> advanced_note_visible: !GuideModel.shows_advanced() && SettingsModel.advanced_in_use(
        Math.round(SettingsModel.preview_size_val),
        Math.round(SettingsModel.preview_spp_val),
        SettingsModel.local_preview_scale_index,
        SettingsModel.live_compute_target_index,
        SettingsModel.live_transfer_index,
        SettingsModel.contribute_to_final_picture,
        SettingsModel.local_compute_target_index,
        SettingsModel.bounce_index);

    // `SettingsModel` used to carry its own `close()` callback here too,
    // invoked with no Rust `on_close` ever registered for it (dead wiring --
    // `is_open` below is the whole close contract, and `open_performance_
    // graph` right below already closes this dialog by setting `is_open`
    // alone, with no matching `close()` call, which was the tell). Deleted
    // along with that callback rather than adding a handler that would only
    // duplicate the assignment already right here.
    callback close();
    close => { SettingsModel.is_open = false; }

    // Goes through `TiltModel.toggle_dialog()` -- the SAME shared
    // open/close + stale-cached-curve check `gem_viewport.slint`'s/`solid_viewport.slint`'s
    // own Tilt Curve buttons use (see that function's own doc comment). Do not
    // set `TiltModel.dialog_open = true` directly: that skips the stale-curve
    // check.
    callback open_performance_graph();
    open_performance_graph => {
        SettingsModel.is_open = false;
        TiltModel.toggle_dialog();
    }

    // The defaults here are also in `gui::render::advanced_in_use::HiddenRenderSettings::
    // DEFAULT` (a test keeps that equal to the persisted defaults): change both together.
    function reset_defaults() {
        SettingsModel.target_samples_exponent = 8.0;
        SettingsModel.resolution_index = 1;
        SettingsModel.preview_size_val = 160.0;
        SettingsModel.preview_spp_val = 256.0;
        SettingsModel.local_preview_scale_index = 0;
        SettingsModel.live_compute_target_index = 2;
        SettingsModel.live_transfer_index = 0;
        SettingsModel.contribute_to_final_picture = true;
        SettingsModel.local_compute_target_index = 1;
        SettingsModel.bounce_index = 2;
        SettingsModel.exposure_val = 1.0;
        SettingsModel.backdrop_index = 1;
        SettingsModel.surface_glare_pct = 100.0;
        SettingsModel.head_shadow_deg = 16.0;
        SettingsModel.light_yaw_deg = SettingsModel.default_light_yaw_deg;
        SettingsModel.light_pitch_deg = SettingsModel.default_light_pitch_deg;
        SettingsModel.inclusion_sigma_s = 0.0;
        SettingsModel.c_axis_override_enabled = false;
        SettingsModel.c_axis_tilt_deg = 0.0;
        SettingsModel.c_axis_azimuth_deg = 0.0;
        SettingsModel.girdle_frosted = false;
        SettingsModel.edge_rounding_radius = 0.0;
        SettingsModel.stone_width_mm = 0.0;
        SettingsModel.target_samples_changed(8);
        SettingsModel.resolution_changed(800, 600);
        SettingsModel.preview_size_changed(160);
        SettingsModel.preview_spp_changed(256);
        SettingsModel.local_preview_scale_changed(0);
        SettingsModel.live_compute_target_changed(2);
        SettingsModel.live_transfer_changed(0);
        SettingsModel.contribute_to_final_picture_changed(true);
        SettingsModel.local_compute_target_changed(1);
        SettingsModel.bounces_changed(12);
        SettingsModel.exposure_changed(1.0);
        SettingsModel.backdrop_changed(1);
        SettingsModel.surface_glare_changed(100.0);
        SettingsModel.head_shadow_changed(16.0);
        ViewportModel.light_pos_changed(SettingsModel.default_light_yaw_deg, SettingsModel.default_light_pitch_deg);
        SettingsModel.inclusion_changed(0.0);
        SettingsModel.c_axis_override_changed(false);
        SettingsModel.c_axis_angles_changed(0.0, 0.0);
        SettingsModel.girdle_frosted_changed(false);
        SettingsModel.edge_rounding_changed(0.0);
        SettingsModel.stone_width_changed(0.0);
        // Every actual reset effect above goes through its own `*_changed`
        // callback, which is wired up in Rust.
    }
    width: 380px;
    // Content-driven height, capped: unset, this `Rectangle` would expand to fill
    // `GemViewportView`, the full-viewport area it's anchored inside; `height_cap`
    // bounds it to a fraction of `available_height` instead of a fixed pixel number,
    // and `ScrollView` below makes the part past the cap reachable.
    //
    // THE TRAP: a `ScrollView` always sizes to its constraint (unlike a bare
    // `Rectangle`), so naively wrapping `content` in one and leaving this binding as
    // `content.preferred-height` would reintroduce the stretch-to-bottom failure this
    // exists to prevent. `min(content.preferred-height, height_cap)` keeps both cases
    // working: short content is unaffected, tall content is clamped and scrollable.
    property <length> height_cap: root.available_height * 0.85;
    height: content.preferred-height < root.height_cap ? content.preferred-height : root.height_cap;
    background: Theme.popup-surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-dialog;
    drop-shadow-blur: 24px;
    drop-shadow-color: Theme.shadow-heavy;
    drop-shadow-offset-y: 6px;

    // `width`/`height: 100%` are deliberate: `root.height` above is already the
    // resolved min(content, cap), so 100% matches the `ScrollView` to that.
    ScrollView {
        width: 100%;
        height: 100%;

    content := VerticalLayout {
        padding: 16px;
        spacing: 14px;

        // Header with Title, the manual's "?" and the Close '×' button
        HorizontalLayout {
            alignment: space-between;

            HorizontalLayout {
                spacing: 8px;
                Image { source: @image-url("../icons/gear.svg"); colorize: Theme.accent-cyan; width: 15px; height: 15px; vertical-alignment: center; }
                Text { text: "Rendering Settings"; font-size: 13px; font-weight: 700; color: Theme.text-primary; vertical-alignment: center; }
            }

            HorizontalLayout {
                spacing: 6px;
                VerticalLayout {
                    alignment: center;
                    HelpButton {
                        topic: HelpTopics.render-settings;
                        hint: "Open the manual page on the rendering settings";
                    }
                }
                IconButton {
                    icon: @image-url("../icons/close.svg");
                    glyph: 12px;
                    hint: "Close the rendering settings";
                    clicked => { root.close(); }
                }
            }
        }

        // Simple mode hides some settings; one of them is off its default.
        if root.advanced_note_visible: Rectangle {
            border-radius: Theme.radius-sm;
            background: Theme.notice-surface;
            border-width: 1px;
            border-color: Theme.notice-accent;
            height: advanced_note.preferred-height + 12px;
            accessible-role: AccessibleRole.text;
            accessible-label: "Some advanced settings are in use. Switch to Advanced to see them.";
            Tooltip { text: @markdown("Simple mode hides some render settings (preview size and samples, motion preview, compute choices, ray bounces). One of them is not at its default. It still applies. Switch to Advanced in the header to see and change it."); }
            advanced_note := Text {
                x: 8px;
                y: 6px;
                width: parent.width - 16px;
                text: "Some advanced settings are in use. Switch to Advanced to see them.";
                font-size: 11px;
                color: Theme.notice-text;
                wrap: word-wrap;
            }
        }

        // Target Samples moves in powers of two -- noise falls as 1/sqrt(N), so a
        // linear 8..1024 control would spend ~97% of its travel above 32 spp where
        // each step barely changes anything visible. The slider drags the EXPONENT
        // (3..=10); `sample_exponent`/`target_samples_count` above derive the count.
        VerticalLayout {
            spacing: 4px;
            HorizontalLayout {
                alignment: space-between;
                SettingLabel {
                    text: "Target Samples";
                    hint: "Target Samples: how many light paths are traced for every pixel before the picture counts as finished. More samples mean less grain and a longer wait; each step doubles the number.";
                }
                Text { text: root.target_samples_count; font-size: 11px; font-weight: 700; color: Theme.accent-cyan; }
            }
            Slider {
                minimum: 3;
                maximum: 10;
                step: 1;
                accessible-label: "Target Samples";
                value <=> SettingsModel.target_samples_exponent;
                // `SliderBase.set-value` updates `target_samples_exponent` BEFORE
                // firing `changed`, so `root.sample_exponent` reflects this change
                // by the time it's read here.
                changed(val) => { SettingsModel.target_samples_changed(root.sample_exponent); }
            }
        }

        // Catalogue preview thumbnails: size and quality. Plain linear sliders (not
        // the samples-exponent's drag-then-round idiom) since both ranges (96-256px,
        // 32-512spp) are narrow enough for a linear drag to stay fine-grained. Advanced.
        if GuideModel.shows_advanced(): VerticalLayout {
            spacing: 4px;
            HorizontalLayout {
                alignment: space-between;
                SettingLabel {
                    text: "Preview Image Size";
                    hint: "Preview Image Size: the width of the small pictures the catalogue draws for each design, in pixels. Larger pictures are sharper and take longer to draw.";
                }
                Text { text: Math.round(SettingsModel.preview_size_val) + "px"; font-size: 11px; font-weight: 700; color: Theme.accent-cyan; }
            }
            Slider {
                minimum: 96;
                maximum: 256;
                step: 16;
                accessible-label: "Preview Image Size";
                value <=> SettingsModel.preview_size_val;
                changed(val) => { SettingsModel.preview_size_changed(Math.round(val)); }
            }
        }
        if GuideModel.shows_advanced(): VerticalLayout {
            spacing: 4px;
            HorizontalLayout {
                alignment: space-between;
                SettingLabel {
                    text: "Preview Samples";
                    hint: "Preview Samples: how many light paths are traced for each pixel of a catalogue picture. More samples mean less grain and a slower batch.";
                }
                Text { text: Math.round(SettingsModel.preview_spp_val); font-size: 11px; font-weight: 700; color: Theme.accent-cyan; }
            }
            Slider {
                minimum: 32;
                maximum: 512;
                step: 32;
                accessible-label: "Preview Samples";
                value <=> SettingsModel.preview_spp_val;
                changed(val) => { SettingsModel.preview_spp_changed(Math.round(val)); }
            }
        }

        // Render Resolution - Segmented Pill Selector, same idiom as the Ray Bounces
        // picker below and `export_dialog.slint`'s "Output Size" pills. A fixed list
        // rather than a slider -- see `resolution_index` above for why.
        ResolutionPicker { }

        // Motion Preview Resolution, off by default. Same segmented-pill idiom as
        // Render Resolution above; a discrete choice rather than a slider since
        // there's no meaningful continuum between "half" and "0.47". Advanced.
        if GuideModel.shows_advanced(): MotionPreviewPicker { }

        // Live Compute: which engine(s) trace the settled viewport image. Same
        // segmented-pill idiom, and the same disabled-with-a-reason treatment, as
        // `export_dialog.slint`'s "Compute" section. Advanced.
        if GuideModel.shows_advanced(): LiveComputePicker {
            unavailable_reason: root.live_remote_unavailable_reason;
        }

        // Local Compute: which engine(s) the LOCAL (non-remote) render loop uses --
        // only shown on a GPU-capable build (`gpu_build`), since the choice is
        // meaningless without a `gpu` feature to route through. Advanced.
        if SettingsModel.gpu_build && GuideModel.shows_advanced(): LocalComputePicker { }

        // Ray Bounces - Segmented Pill Selector. Advanced.
        //
        // Ladder is 4/8/12/24/64/128, backed by
        // `crates/indicatrix/examples/bounce_cost.rs` measurements: cost is nearly
        // flat in the cap (an 85x spread from 12 to 1024 costs under 1.4x wall-clock,
        // CPU) because the path population is short-tailed (median 4 bounces, p95 29,
        // only 0.03% ever reach 128). 12 is the default, the sane interactive middle.
        // 64 and 128 are the measured points where the hardest case (Diamond) crosses
        // 99.5% and 99.99% converged against a 1024-bounce reference; nothing above
        // 128 is offered since the measurement shows zero further change up to 1024.
        if GuideModel.shows_advanced(): BouncesPicker { }

        // Inclusion Haze: subsurface/inclusion scattering amount, off by default.
        // Linear, unlike the samples slider above, since `scattering_sigma_s` is
        // already a physical linear coefficient.
        VerticalLayout {
            spacing: 4px;
            HorizontalLayout {
                alignment: space-between;
                SettingLabel {
                    text: "Inclusion Haze";
                    hint: "Inclusion Haze: a milky veil inside the stone, from 0 (clean) to 3 (milky), as tiny inclusions scatter the light.";
                }
                Text {
                    text: SettingsModel.inclusion_sigma_s <= 0.0 ? "Off" : Math.round(SettingsModel.inclusion_sigma_s * 100.0) / 100.0 + "";
                    font-size: 11px;
                    font-weight: 700;
                    color: Theme.accent-cyan;
                }
            }
            Slider {
                minimum: 0.0;
                maximum: 3.0;
                accessible-label: "Inclusion Haze";
                value <=> SettingsModel.inclusion_sigma_s;
                changed(val) => { SettingsModel.inclusion_changed(val); }
            }
        }

        // Crystal Axis Orientation: tilt/azimuth of the optic axis relative to the
        // table normal (+Y). Off ("As Cut") by default. `c_axis_override_available`
        // (Rust-driven) is false for an isotropic material, which has no crystal axis
        // to orient: the switch is disabled and greyed out rather than silently doing
        // nothing.
        CrystalAxisSection { }

        // Frosted Girdle: renders the girdle band with a bruted (ground, diffusely
        // scattering) finish instead of polished. Off by default.
        ToggleRow {
            text: "Frosted Girdle";
            hint: "Frosted Girdle: draw the girdle band ground (matt) instead of polished.";
            checked: SettingsModel.girdle_frosted;
            toggled => {
                SettingsModel.girdle_frosted = !SettingsModel.girdle_frosted;
                SettingsModel.girdle_frosted_changed(SettingsModel.girdle_frosted);
            }
        }

        // Edge Rounding: softens meet-point edges from perfectly sharp (0.0, default)
        // toward a subtle rounded glint.
        VerticalLayout {
            spacing: 4px;
            HorizontalLayout {
                alignment: space-between;
                SettingLabel {
                    text: "Edge Rounding";
                    hint: "Edge Rounding: soften the edges between facets from perfectly sharp toward a faint rounded glint, as on a real polished stone.";
                }
                Text {
                    text: SettingsModel.edge_rounding_radius <= 0.0 ? "Off" : Math.round(SettingsModel.edge_rounding_radius * 1000.0) / 1000.0 + "";
                    font-size: 11px;
                    font-weight: 700;
                    color: Theme.accent-cyan;
                }
            }
            Slider {
                minimum: 0.0;
                maximum: 0.03;
                accessible-label: "Edge Rounding";
                value <=> SettingsModel.edge_rounding_radius;
                changed(val) => { SettingsModel.edge_rounding_changed(val); }
            }
        }

        // Stone Size: physical width across the girdle, in mm. 0.0 (default) means
        // off: unscaled.
        VerticalLayout {
            spacing: 4px;
            HorizontalLayout {
                alignment: space-between;
                SettingLabel {
                    text: "Stone Size";
                    note: root.stone_size_is_design_driven ? "(from design)" : "";
                    hint: root.stone_size_tooltip;
                }
                Text {
                    text: SettingsModel.stone_width_mm <= 0.0 ? "Off" : Math.round(SettingsModel.stone_width_mm * 100.0) / 100.0 + "mm";
                    font-size: 11px;
                    font-weight: 700;
                    color: Theme.accent-cyan;
                }
            }
            Slider {
                minimum: 0.0;
                maximum: 20.0;
                accessible-label: "Stone Size in millimetres";
                value <=> SettingsModel.stone_width_mm;
                changed(val) => { SettingsModel.stone_width_changed(val); }
            }
        }

        // Environment Map (HDR): loads a Radiance .hdr equirectangular panorama as the
        // render's environment in place of the analytic studio rig below (Studio
        // Exposure / Light Azimuth / Light Elevation), superseded while a map is
        // loaded.
        EnvironmentMapSection { }

        // Studio Exposure Slider
        VerticalLayout {
            spacing: 4px;
            HorizontalLayout {
                alignment: space-between;
                SettingLabel {
                    text: "Studio Exposure";
                    hint: "Studio Exposure: the overall brightness of the picture. 1x is the normal level.";
                }
                Text { text: Math.round(SettingsModel.exposure_val * 100.0) / 100.0 + "x"; font-size: 11px; font-weight: 700; color: Theme.accent-cyan; }
            }
            Slider {
                minimum: 0.4;
                maximum: 2.5;
                accessible-label: "Studio Exposure";
                value <=> SettingsModel.exposure_val;
                changed(val) => { SettingsModel.exposure_changed(val); }
            }
        }

        // Backdrop -- the card behind the stone. Only the camera sees it; the stone's
        // optics never do, so leakage stays dark whatever is picked here.
        VerticalLayout {
            spacing: 4px;
            SettingLabel {
                text: "Backdrop";
                hint: "Backdrop: what the camera sees behind the stone. As lit: the lighting's own ground. Grey: a neutral grey card (about sRGB 160), for like-for-like comparisons. White: a light box. The stone's optics never see the card, so light leaking out of the back stays dark.";
            }
            HorizontalLayout {
                spacing: 4px;
                SegmentPill {
                    text: "As lit";
                    hint: "Show the ground of the chosen lighting behind the stone.";
                    selected: SettingsModel.backdrop_index == 0;
                    picked => {
                        SettingsModel.backdrop_index = 0;
                        SettingsModel.backdrop_changed(0);
                    }
                }
                SegmentPill {
                    text: "Grey";
                    hint: "Show a neutral grey card behind the stone, the same for every design.";
                    selected: SettingsModel.backdrop_index == 1;
                    picked => {
                        SettingsModel.backdrop_index = 1;
                        SettingsModel.backdrop_changed(1);
                    }
                }
                SegmentPill {
                    text: "White";
                    hint: "Show a white light box behind the stone.";
                    selected: SettingsModel.backdrop_index == 2;
                    picked => {
                        SettingsModel.backdrop_index = 2;
                        SettingsModel.backdrop_changed(2);
                    }
                }
            }
        }

        // Surface glare: scales the white mirror image of the light on the table (the
        // cross-polarised look), 0-100 % in steps of 5. Rust snaps and applies it
        // (`gui::render::material_quality::setup_surface_glare_callback`).
        VerticalLayout {
            spacing: 4px;
            HorizontalLayout {
                alignment: space-between;
                spacing: 6px;
                SettingLabel {
                    text: "Surface glare";
                    note: !root.surface_glare_enabled ? "(not used with an HDR map)" : "";
                    hint: "Surface glare: hides the white mirror image of the light on the table so the inner facets stay visible. 0 % keeps only light that entered the stone. Applies to the built-in lighting presets, not to HDR maps, and to the path-traced view and exports (the Solid view is unaffected).";
                }
                HorizontalLayout {
                    spacing: 6px;
                    if root.surface_glare_shown < 100 && root.surface_glare_enabled: TextLink {
                        text: "Reset to 100 %";
                        hint: "Put the surface glare back to 100 %, the unchanged look.";
                        clicked => {
                            SettingsModel.surface_glare_pct = 100.0;
                            SettingsModel.surface_glare_changed(100.0);
                        }
                    }
                    Text { text: root.surface_glare_shown + " %"; font-size: 11px; font-weight: 700; color: Theme.accent-cyan; }
                }
            }
            Slider {
                minimum: 0.0;
                maximum: 100.0;
                step: 5.0;
                enabled: root.surface_glare_enabled;
                accessible-label: "Surface glare in percent";
                value <=> SettingsModel.surface_glare_pct;
                changed(val) => { SettingsModel.surface_glare_changed(Math.round(val / 5.0) * 5.0); }
            }
        }

        // Head shadow: the angular radius of the viewer's head shadow on the lit presets,
        // 0-30 degrees (0 = off). Rust rounds and applies it
        // (`gui::render::material_quality::setup_head_shadow_callback`).
        VerticalLayout {
            spacing: 4px;
            HorizontalLayout {
                alignment: space-between;
                spacing: 6px;
                SettingLabel {
                    text: "Head shadow";
                    note: !root.head_shadow_enabled ? "(not used with an HDR map)" : "";
                    hint: "How much of the sky the viewer's head hides: the dark table reflections a face-up stone shows. 16 degrees is a head at arm's length; 0 turns it off. Product-photography rigs (D65 Daylight, Incandescent, Ring Lights, Dark Spotlight) ignore it.";
                }
                HorizontalLayout {
                    spacing: 6px;
                    if root.head_shadow_shown != 16 && root.head_shadow_enabled: TextLink {
                        text: "Reset to 16°";
                        hint: "Put the head shadow back to 16 degrees, a head at arm's length.";
                        clicked => {
                            SettingsModel.head_shadow_deg = 16.0;
                            SettingsModel.head_shadow_changed(16.0);
                        }
                    }
                    Text { text: root.head_shadow_shown == 0 ? "Off" : root.head_shadow_shown + "°"; font-size: 11px; font-weight: 700; color: Theme.accent-cyan; }
                }
            }
            Slider {
                minimum: 0.0;
                maximum: 30.0;
                step: 1.0;
                enabled: root.head_shadow_enabled;
                accessible-label: "Head shadow in degrees";
                value <=> SettingsModel.head_shadow_deg;
                changed(val) => { SettingsModel.head_shadow_changed(Math.round(val)); }
            }
        }

        // Light Source Azimuth
        VerticalLayout {
            spacing: 4px;
            HorizontalLayout {
                alignment: space-between;
                SettingLabel {
                    icon: @image-url("../icons/lightbulb.svg");
                    text: "Light Azimuth";
                    hint: "Light Azimuth: the direction the main light shines from, as an angle around the stone (0 to 360 degrees). Dragging with the right mouse button, or Shift and the left button, in the viewport moves it too.";
                }
                Text { text: Math.round(SettingsModel.light_yaw_deg) + "°"; font-size: 11px; font-weight: 700; color: Theme.accent-cyan; }
            }
            Slider {
                minimum: 0.0;
                maximum: 360.0;
                accessible-label: "Light Azimuth in degrees";
                value <=> SettingsModel.light_yaw_deg;
                changed(val) => { ViewportModel.light_pos_changed(val, SettingsModel.light_pitch_deg); }
            }
        }

        // Light Source Elevation
        VerticalLayout {
            spacing: 4px;
            HorizontalLayout {
                alignment: space-between;
                SettingLabel {
                    icon: @image-url("../icons/lightbulb.svg");
                    text: "Light Elevation";
                    hint: "Light Elevation: how high the main light is above the stone, from 10 degrees (low and raking) to 90 degrees (straight overhead).";
                }
                Text { text: Math.round(SettingsModel.light_pitch_deg) + "°"; font-size: 11px; font-weight: 700; color: Theme.accent-cyan; }
            }
            Slider {
                minimum: 10.0;
                maximum: 90.0;
                accessible-label: "Light Elevation in degrees";
                value <=> SettingsModel.light_pitch_deg;
                changed(val) => { ViewportModel.light_pos_changed(SettingsModel.light_yaw_deg, val); }
            }
        }

        // Named Lighting Presets. A preset bundles light yaw/pitch, exposure, the
        // lighting-rig selection, and camera distance -- deliberately NOT camera
        // yaw/pitch, so applying one never spins the gem out from under the user.
        LightingPresetsSection { }

        // Performance Curve over Tilt Angles (Extinction & Brilliance Graph). Advanced.
        if GuideModel.shows_advanced(): PerformanceCurvePanel {
            open_performance_graph => { root.open_performance_graph(); }
        }

        // Footer Actions
        HorizontalLayout {
            alignment: space-between;
            spacing: 8px;

            // Two-step affordance: the first click only opens the confirm prompt
            // below; nothing resets until "Confirm" is clicked.
            if !root.confirming_reset: FooterButton {
                width: 130px;
                icon: @image-url("../icons/reset.svg");
                text: "Reset to Defaults";
                hint: "Reset every setting here to its default. Cannot be undone.";
                clicked => { root.confirming_reset = true; }
            }
            if root.confirming_reset: HorizontalLayout {
                spacing: 6px;
                Text {
                    text: "Reset everything?";
                    font-size: 11px;
                    color: Theme.accent-amber;
                    vertical-alignment: center;
                }
                FooterButton {
                    width: 64px;
                    kind: 2;
                    text: "Confirm";
                    hint: "Yes, put every setting here back to its default.";
                    clicked => {
                        root.confirming_reset = false;
                        root.reset_defaults();
                    }
                }
                FooterButton {
                    width: 60px;
                    text: "Cancel";
                    hint: "Keep the settings as they are.";
                    clicked => { root.confirming_reset = false; }
                }
            }

            FooterButton {
                horizontal-stretch: 1;
                kind: 1;
                text: "Done";
                hint: "Close the rendering settings.";
                clicked => { root.close(); }
            }
        }
    }
    }
}
