import { Slider } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { SolidPreviewModel } from "../../models/solid_preview.slint";
import { ViewportModel } from "../../models/viewport.slint";
import { EditorModel } from "../../models/editor.slint";
import { TiltModel } from "../../models/tilt.slint";
import { ManipulateModel } from "../../models/manipulate.slint";
// A running catalogue-wide batch (tilt sweep or preview render) sets
// `ctx.export_active`, which suspends the live tracer exactly like an explicit
// pause -- this strip folds that into a banner so a frozen Path-traced/Both
// image doesn't read as current. Mirrors `gem_viewport.slint`'s identical
// `batch_suspends_tracer` property.
import { BatchModel } from "../../models/batch.slint";

// The Edit tab's Solid viewport toolbar: mode toggle/cut slider, camera pose
// pills, Tilt Curve/Preform toggles, the Diagram-mode enlarge pills, and the
// status strip -- split out of `solid_viewport.slint` to keep that file under
// its line budget. Everything here is driven directly by globals
// (`SolidPreviewModel`/`ViewportModel`/`EditorModel`/`TiltModel`/`BatchModel`)
// except `diagram_zoom`/`diagram_pan_x`/`diagram_pan_y`, which `SolidViewportView`
// owns (its own Image rendering and drag handling read them too) and shares
// two-way so the "Reset View" pill below can reset them.
//
// The pills take about 1350px in one row, and the Edit viewport is only
// guaranteed 380px, so the toolbar re-flows by its own width (see
// `SolidViewportToolbar` below): one row, two rows, three rows, or four rows
// with tighter pills. The pills live in the small row components right below
// (`CutSlider`, `ModePills`, `ViewPills`, `ToolPills`) so each layout can mount
// the same pills in a different grouping.

// The "Cut" tier-cutoff slider: how far through the cutting instructions to
// draw, so a cutter can see what the next course actually lands on. The
// mount sites show it only when there is a solved solid to truncate, and only
// in the two modes that draw one -- there is nothing to cut back in a
// path-traced render of the finished stone. `-1` is the whole design.
component CutSlider inherits Rectangle {
    height: 28px;
    width: cut_layout.preferred-width;
    background: Theme.bg-input;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: SolidPreviewModel.tier_cutoff >= 0 ? Theme.accent-amber : Theme.border-subtle;

    Tooltip { text: @markdown("Draw the stone as it stands after this many tiers of the cutting instructions. Drag fully right for the finished design."); }

    cut_layout := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;

        Text {
            text: SolidPreviewModel.tier_cutoff < 0
                ? "Cut: all"
                : "Cut: " + SolidPreviewModel.tier_cutoff + "/" + EditorModel.tiers.length;
            font-size: 10px;
            font-weight: 600;
            color: SolidPreviewModel.tier_cutoff >= 0 ? Theme.accent-amber : Theme.text-secondary;
            vertical-alignment: center;
        }
        cut_slider := Slider {
            width: 90px;
            minimum: 1;
            // One past the last tier is the "all" position, so the
            // control has a natural home for "no cutoff" at its far
            // right rather than a separate reset button.
            maximum: EditorModel.tiers.length;
            value: SolidPreviewModel.tier_cutoff < 0
                ? EditorModel.tiers.length
                : SolidPreviewModel.tier_cutoff;
            // `changed(value)` is the Slider's own INTERACTION
            // callback (`SliderBase::set-value`, called only from an
            // actual drag/keyboard nudge/click), not a plain
            // property-change handler on the bound `value`
            // expression above -- a plain `changed value => { ... }`
            // handler would re-run on EVERY change to that
            // expression, including one driven by
            // `EditorModel.tiers.length` moving on an ordinary tier
            // push/remove/undo, not only an actual drag, firing a
            // redundant replan on every tier edit (on top of the one
            // already done through its own `refresh_*` call) and
            // risking a race with a Rust writer that still holds
            // `state.borrow_mut()` at the moment the queued
            // `changed` handler ran -- Slint queues `changed`
            // handlers and runs them at the next event-loop pass
            // rather than synchronously inside the setter, so a
            // Rust callback that pumps the event loop (a blocking
            // file dialog, most commonly) while still holding the
            // `EditorState` guard can flush a `changed` handler
            // mid-borrow. `SolidPreviewModel.tier_cutoff_changed`'s
            // own Rust handler
            // (`gui::editor::setup::setup_tier_cutoff_callback`) is
            // the only one that fires from this, and uses
            // `try_borrow` (skip on failure) for the same reason.
            changed(value) => {
                SolidPreviewModel.tier_cutoff =
                    value >= EditorModel.tiers.length ? -1 : Math.round(value);
                SolidPreviewModel.tier_cutoff_changed();
            }
        }
    }
}

// The view-mode pills: Solid / Path-traced / Both / Diagram. `tight` is the
// phone-width variant with narrower pills.
component ModePills inherits HorizontalLayout {
    in property <bool> tight: false;
    spacing: root.tight ? 4px : 8px;

    Rectangle {
        height: 28px;
        width: root.tight ? 56px : 84px;
        background: SolidPreviewModel.view_mode == 0 ? Theme.primary : (solid_pill_touch.has-hover ? Theme.bg-elevated : Theme.bg-input);
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: SolidPreviewModel.view_mode == 0 ? Theme.accent-cyan : Theme.border-subtle;

        Tooltip { text: @markdown("Flat-shaded software render of the solved solid -- independent of the spectral path tracer."); }

        solid_pill_touch := TouchArea {
            clicked => { SolidPreviewModel.view_mode = 0; }
        }
        Text {
            text: "Solid";
            font-size: 12px;
            font-weight: 600;
            color: SolidPreviewModel.view_mode == 0 ? Theme.text-on-primary : Theme.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Rectangle {
        height: 28px;
        width: root.tight ? 92px : 110px;
        background: SolidPreviewModel.view_mode == 1 ? Theme.primary : (traced_pill_touch.has-hover ? Theme.bg-elevated : Theme.bg-input);
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: SolidPreviewModel.view_mode == 1 ? Theme.accent-cyan : Theme.border-subtle;

        Tooltip { text: @markdown("The same spectral path-traced image shown in the Live Render tab."); }

        traced_pill_touch := TouchArea {
            clicked => { SolidPreviewModel.view_mode = 1; }
        }
        Text {
            text: "Path-traced";
            font-size: 12px;
            font-weight: 600;
            color: SolidPreviewModel.view_mode == 1 ? Theme.text-on-primary : Theme.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Rectangle {
        height: 28px;
        width: root.tight ? 52px : 84px;
        background: SolidPreviewModel.view_mode == 2 ? Theme.primary : (both_pill_touch.has-hover ? Theme.bg-elevated : Theme.bg-input);
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: SolidPreviewModel.view_mode == 2 ? Theme.accent-cyan : Theme.border-subtle;

        Tooltip { text: @markdown("The path-traced image with the solid's own facet edges overlaid."); }

        both_pill_touch := TouchArea {
            clicked => { SolidPreviewModel.view_mode = 2; }
        }
        Text {
            text: "Both";
            font-size: 12px;
            font-weight: 600;
            color: SolidPreviewModel.view_mode == 2 ? Theme.text-on-primary : Theme.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Rectangle {
        height: 28px;
        width: root.tight ? 72px : 96px;
        background: SolidPreviewModel.view_mode == 3 ? Theme.primary : (diagram_pill_touch.has-hover ? Theme.bg-elevated : Theme.bg-input);
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: SolidPreviewModel.view_mode == 3 ? Theme.accent-cyan : Theme.border-subtle;

        Tooltip { text: @markdown("A GemCAD-style crown/pavilion/profile 2D faceting diagram with the index wheel -- fixed, not tied to the orbit camera."); }

        diagram_pill_touch := TouchArea {
            clicked => { SolidPreviewModel.view_mode = 3; }
        }
        Text {
            text: "Diagram";
            font-size: 12px;
            font-weight: 600;
            color: SolidPreviewModel.view_mode == 3 ? Theme.text-on-primary : Theme.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// The camera pose pills: Front / Top / Bottom / Left / Right / Fit / Reset.
// `tight` is the phone-width variant with narrower pills.
component ViewPills inherits HorizontalLayout {
    in property <bool> tight: false;
    spacing: root.tight ? 4px : 8px;

    // Front / Top -- canonical poses for the shared orbit camera (the same
    // `ViewportModel.set_view` the Live Render viewport's buttons call).
    Rectangle {
        height: 28px;
        width: root.tight ? 50px : 56px;
        background: front_pill_touch.has-hover ? Theme.bg-elevated : Theme.bg-input;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: Theme.border-subtle;
        Tooltip { text: @markdown("Look at the stone from the front: girdle edge-on, index 0 towards you."); }
        front_pill_touch := TouchArea { clicked => { ViewportModel.set_view(0); } }
        Text {
            text: "Front";
            font-size: 12px;
            font-weight: 600;
            color: Theme.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    Rectangle {
        height: 28px;
        width: root.tight ? 38px : 48px;
        background: top_pill_touch.has-hover ? Theme.bg-elevated : Theme.bg-input;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: Theme.border-subtle;
        Tooltip { text: @markdown("Look straight down onto the table."); }
        top_pill_touch := TouchArea { clicked => { ViewportModel.set_view(1); } }
        Text {
            text: "Top";
            font-size: 12px;
            font-weight: 600;
            color: Theme.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // #118: Bottom/Left/Right -- a one-click pavilion view, the commonest
    // inspection for windowing, and a way to look at either side without
    // a free-drag orbit. Same `ViewportModel.set_view` as Front/Top above, new kinds
    // (`render::camera_lighting::setup_set_view_callback`'s own doc
    // comment has the full kind -> pose mapping).
    Rectangle {
        height: 28px;
        width: root.tight ? 56px : 66px;
        background: bottom_pill_touch.has-hover ? Theme.bg-elevated : Theme.bg-input;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: Theme.border-subtle;
        Tooltip { text: @markdown("Look straight up at the culet/pavilion tip."); }
        bottom_pill_touch := TouchArea { clicked => { ViewportModel.set_view(2); } }
        Text {
            text: "Bottom";
            font-size: 12px;
            font-weight: 600;
            color: Theme.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    Rectangle {
        height: 28px;
        width: root.tight ? 44px : 52px;
        background: left_pill_touch.has-hover ? Theme.bg-elevated : Theme.bg-input;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: Theme.border-subtle;
        Tooltip { text: @markdown("Look at the stone's left side."); }
        left_pill_touch := TouchArea { clicked => { ViewportModel.set_view(3); } }
        Text {
            text: "Left";
            font-size: 12px;
            font-weight: 600;
            color: Theme.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    Rectangle {
        height: 28px;
        width: root.tight ? 48px : 58px;
        background: right_pill_touch.has-hover ? Theme.bg-elevated : Theme.bg-input;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: Theme.border-subtle;
        Tooltip { text: @markdown("Look at the stone's right side."); }
        right_pill_touch := TouchArea { clicked => { ViewportModel.set_view(4); } }
        Text {
            text: "Right";
            font-size: 12px;
            font-weight: 600;
            color: Theme.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    // #118: recovers a usable framing after a free-drag orbit ends up
    // pointed at empty space or edge-on to every facet -- unlike
    // Front/Top/Bottom/Left/Right, Fit (`set_view` kind `5`) leaves the
    // CURRENT orbit angle alone and only recomputes distance from the
    // live mesh's own bounding radius.
    Rectangle {
        height: 28px;
        width: root.tight ? 34px : 44px;
        background: fit_pill_touch.has-hover ? Theme.bg-elevated : Theme.bg-input;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: Theme.border-subtle;
        Tooltip { text: @markdown("Keep the current angle, but recompute distance to frame the whole stone."); }
        fit_pill_touch := TouchArea { clicked => { ViewportModel.set_view(5); } }
        Text {
            text: "Fit";
            font-size: 12px;
            font-weight: 600;
            color: Theme.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    // #118: `ViewportModel.reset_camera` -- the same canonical pose/light
    // reset `gem_viewport.slint`'s own Reset button already calls for the
    // Live Render tab; `render::camera_lighting::setup_camera_and_lighting_
    // callbacks`'s `on_reset_camera` also re-requests a redraw at the new
    // pose so both viewports show it, not just the one that triggered it.
    Rectangle {
        height: 28px;
        width: root.tight ? 48px : 56px;
        background: reset_camera_pill_touch.has-hover ? Theme.bg-elevated : Theme.bg-input;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: Theme.border-subtle;
        Tooltip { text: @markdown("Reset the camera angle, distance and light to their defaults."); }
        reset_camera_pill_touch := TouchArea { clicked => { ViewportModel.reset_camera(); } }
        Text {
            text: "Reset";
            font-size: 12px;
            font-weight: 600;
            color: Theme.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// The tool pills: Tilt Curve, Preform, Snap and Slice, plus Diagram mode's own
// Reset View and Crown/Pavilion/Profile enlarge pills. `tight` is the phone-width
// variant with narrower pills. `diagram_zoom`/`diagram_pan_*` are the toolbar's
// two-way properties (the "Reset View" pill resets them).
component ToolPills inherits HorizontalLayout {
    in property <bool> tight: false;
    in-out property <float> diagram_zoom: 1.0;
    in-out property <length> diagram_pan_x: 0px;
    in-out property <length> diagram_pan_y: 0px;
    spacing: root.tight ? 4px : 8px;

    // The Edit tab's own route to the tilt-performance chart, so a
    // cutter isn't forced to leave the Edit tab and use the Live
    // Render tab's "Tilt Curve" button (and, to change what it showed,
    // the catalogue list, which overwrites the design being edited).
    // Same open/close + stale-cache-check sequence as
    // `GemViewportView`'s own button, shared via
    // `TiltModel.toggle_dialog()`.
    Rectangle {
        height: 28px;
        width: root.tight ? 76px : 82px;
        background: TiltModel.dialog_open ? Theme.primary : (tilt_pill_touch.has-hover ? Theme.bg-elevated : Theme.bg-input);
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: TiltModel.dialog_open ? Theme.accent-cyan : Theme.border-subtle;
        Tooltip { text: @markdown("Open the tilt-performance chart: brilliance, windowing and extinction versus tilt."); }
        tilt_pill_touch := TouchArea { clicked => { TiltModel.toggle_dialog(); } }
        Text {
            text: "Tilt Curve";
            font-size: 12px;
            font-weight: 600;
            color: TiltModel.dialog_open ? Theme.text-on-primary : Theme.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // #122: toggles the rough's own bounding (preform) planes on/off in
    // the Solid view -- shown only there, since Path-traced/Both/Diagram
    // either don't draw the preform at all (the path tracer) or handle
    // it separately (Diagram's own facet labels).
    if SolidPreviewModel.view_mode == 0: Rectangle {
        height: 28px;
        width: root.tight ? 68px : 96px;
        background: SolidPreviewModel.show_preform_planes ? Theme.primary : (preform_pill_touch.has-hover ? Theme.bg-elevated : Theme.bg-input);
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: SolidPreviewModel.show_preform_planes ? Theme.accent-cyan : Theme.border-subtle;
        Tooltip { text: @markdown("Show or hide the rough's own bounding (preform) planes."); }
        preform_pill_touch := TouchArea {
            clicked => { SolidPreviewModel.show_preform_planes = !SolidPreviewModel.show_preform_planes; }
        }
        Text {
            text: "Preform";
            font-size: 12px;
            font-weight: 600;
            color: SolidPreviewModel.show_preform_planes ? Theme.text-on-primary : Theme.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // Snapping for the angle and depth drag handles on the selected facet
    // (`ManipulateModel`): lit while snapping is on. Shown in the three modes
    // that draw the handles (Solid, Path-traced, Both), not in Diagram.
    if SolidPreviewModel.view_mode != 3: Rectangle {
        height: 28px;
        width: root.tight ? 46px : 64px;
        background: !ManipulateModel.snap_off ? Theme.primary : (snap_pill_touch.has-hover ? Theme.bg-elevated : Theme.bg-input);
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: !ManipulateModel.snap_off ? Theme.accent-cyan : Theme.border-subtle;
        Tooltip { text: @markdown("Snapping for the angle and depth handles on the selected facet: coarse by default (0.1 degree, 0.01 mast), fine while you hold Shift, none when this is off. The index handle always moves in whole teeth."); }
        snap_pill_touch := TouchArea {
            clicked => {
                ManipulateModel.snap_off = !ManipulateModel.snap_off;
                ManipulateModel.snap_toggled();
            }
        }
        Text {
            text: "Snap";
            font-size: 12px;
            font-weight: 600;
            color: !ManipulateModel.snap_off ? Theme.text-on-primary : Theme.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // Slice: cut a new facet with the mouse (`ManipulateModel`, shortcut S). Lit
    // while the tool is on; shown in the three modes that draw the stone.
    if SolidPreviewModel.view_mode != 3: Rectangle {
        height: 28px;
        width: root.tight ? 46px : 64px;
        background: ManipulateModel.slice_mode ? Theme.primary : (slice_pill_touch.has-hover ? Theme.bg-elevated : Theme.bg-input);
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: ManipulateModel.slice_mode ? Theme.accent-cyan : Theme.border-subtle;
        Tooltip { text: @markdown("Cut a new facet with the mouse (shortcut S): drag a line across the stone and the part to the right of your drag is cut away. Nothing is kept until you press Keep."); }
        slice_pill_touch := TouchArea {
            clicked => {
                ManipulateModel.slice_mode = !ManipulateModel.slice_mode;
                ManipulateModel.slice_toggled();
            }
        }
        Text {
            text: "Slice";
            font-size: 12px;
            font-weight: 600;
            color: ManipulateModel.slice_mode ? Theme.text-on-primary : Theme.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // #29: Diagram mode's own zoom/pan reset -- shown only in Diagram mode,
    // where Front/Top (the shared orbit camera's poses) don't apply.
    if SolidPreviewModel.view_mode == 3: Rectangle {
        height: 28px;
        width: 76px;
        background: reset_diagram_view_touch.has-hover ? Theme.bg-elevated : Theme.bg-input;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: Theme.border-subtle;
        Tooltip { text: @markdown("Reset the diagram's zoom and pan."); }
        reset_diagram_view_touch := TouchArea {
            clicked => {
                root.diagram_zoom = 1.0;
                root.diagram_pan_x = 0px;
                root.diagram_pan_y = 0px;
            }
        }
        Text {
            text: "Reset View";
            font-size: 11px;
            font-weight: 600;
            color: Theme.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // A single-panel enlarged view: lets a cutter
    // enlarge one of the diagram's three panels to fill the whole
    // image, rather than reading it at one-third width. Re-clicking the
    // already-enlarged panel's own pill returns to the three-column
    // layout. Three explicit pills (matching every other pill in this
    // file, e.g. Front/Top above) rather than a generated `for` loop,
    // since `diagram_enlarged_panel`'s three values (0/1/2) each need
    // their own label anyway. See `ui/models/solid_preview.slint`'s
    // `diagram_enlarged_panel` doc comment for the Rust-side handoff
    // this still needs (this pass owns only the Slint side).
    if SolidPreviewModel.view_mode == 3: Rectangle {
        height: 28px;
        width: root.tight ? 52px : 58px;
        background: SolidPreviewModel.diagram_enlarged_panel == 0 ? Theme.primary : (enlarge_crown_touch.has-hover ? Theme.bg-elevated : Theme.bg-input);
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: SolidPreviewModel.diagram_enlarged_panel == 0 ? Theme.accent-cyan : Theme.border-subtle;
        Tooltip { text: @markdown("Enlarge the Crown panel to fill the view (or double-click a panel). Click again, double-click or press Escape to go back to all three."); }
        enlarge_crown_touch := TouchArea {
            clicked => { SolidPreviewModel.diagram_enlarged_panel = SolidPreviewModel.diagram_enlarged_panel == 0 ? -1 : 0; }
        }
        Text {
            text: "Crown";
            font-size: 11px;
            font-weight: 600;
            color: SolidPreviewModel.diagram_enlarged_panel == 0 ? Theme.text-on-primary : Theme.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    if SolidPreviewModel.view_mode == 3: Rectangle {
        height: 28px;
        width: root.tight ? 60px : 68px;
        background: SolidPreviewModel.diagram_enlarged_panel == 1 ? Theme.primary : (enlarge_pavilion_touch.has-hover ? Theme.bg-elevated : Theme.bg-input);
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: SolidPreviewModel.diagram_enlarged_panel == 1 ? Theme.accent-cyan : Theme.border-subtle;
        Tooltip { text: @markdown("Enlarge the Pavilion panel to fill the view (or double-click a panel). Click again, double-click or press Escape to go back to all three."); }
        enlarge_pavilion_touch := TouchArea {
            clicked => { SolidPreviewModel.diagram_enlarged_panel = SolidPreviewModel.diagram_enlarged_panel == 1 ? -1 : 1; }
        }
        Text {
            text: "Pavilion";
            font-size: 11px;
            font-weight: 600;
            color: SolidPreviewModel.diagram_enlarged_panel == 1 ? Theme.text-on-primary : Theme.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    if SolidPreviewModel.view_mode == 3: Rectangle {
        height: 28px;
        width: root.tight ? 54px : 62px;
        background: SolidPreviewModel.diagram_enlarged_panel == 2 ? Theme.primary : (enlarge_profile_touch.has-hover ? Theme.bg-elevated : Theme.bg-input);
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: SolidPreviewModel.diagram_enlarged_panel == 2 ? Theme.accent-cyan : Theme.border-subtle;
        Tooltip { text: @markdown("Enlarge the Profile panel to fill the view (or double-click a panel). Click again, double-click or press Escape to go back to all three."); }
        enlarge_profile_touch := TouchArea {
            clicked => { SolidPreviewModel.diagram_enlarged_panel = SolidPreviewModel.diagram_enlarged_panel == 2 ? -1 : 2; }
        }
        Text {
            text: "Profile";
            font-size: 11px;
            font-weight: 600;
            color: SolidPreviewModel.diagram_enlarged_panel == 2 ? Theme.text-on-primary : Theme.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// The toolbar re-flows by its own width (it is explicitly x/y/width-positioned
// at 100% of the viewport, so reading `root.width` here is not a binding loop):
//   wide   (>= 1400px)  one row: Cut, modes, views, tools.
//   medium (940-1400)   two rows: [Cut, modes, tools] and [views].
//   low    (600-940)    three rows: [Cut, modes], [views], [tools].
//   narrow (< 600)      four rows of tighter pills: Cut, modes, views, tools.
// The widths are the pills' own sums (about 1350px / 940px / 590px / 380px).
// `top_height` is the rows' total height, for the hint strip that sits under
// them (`ManipulateHintBar.toolbar_height`).
export component SolidViewportToolbar inherits VerticalLayout {
    // Explicit `x`/`y`/`width`/`height`: keeps this overlay's pill row from
    // becoming the viewport's maximum WIDTH (an overlay child positioned by
    // default propagates its constraints to the parent) -- see `app.slint`'s
    // "Sizing notes".
    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    padding: 10px;
    alignment: space-between;

    in-out property <float> diagram_zoom: 1.0;
    in-out property <length> diagram_pan_x: 0px;
    in-out property <length> diagram_pan_y: 0px;

    property <bool> wide: root.width >= 1400px;
    property <bool> narrow: root.width < 600px;
    property <bool> medium: !root.wide && root.width >= 940px;
    property <bool> low: !root.wide && !root.medium && !root.narrow;
    // Only with a solved solid to truncate, and only in the two modes that draw one.
    property <bool> has_cut: (SolidPreviewModel.view_mode == 0 || SolidPreviewModel.view_mode == 2) && SolidPreviewModel.has_solid && EditorModel.tiers.length > 1;
    // The pill rows' height (28px rows, 6px between rows), for the hint strip
    // that goes under them.
    out property <length> top_height: root.wide ? 28px : (root.medium ? 62px : (root.low ? 96px : (root.has_cut ? 130px : 96px)));

    // The "Not solved" banner takes precedence over mesh_cache status when the shown
    // solid is stale. A running catalogue-wide batch outranks both: while
    // it holds `ctx.export_active`, the Path-traced/Both image is frozen at whatever
    // it showed when the batch started, and the cutter needs to know that before
    // anything else this strip could say.
    property <bool> batch_suspends_tracer: BatchModel.tilt_batch_running || BatchModel.preview_batch_running;
    // "Not solved" states what is actually true (one edit behind, already
    // catching up) rather than demanding the cutter press Solve, since an
    // in-budget edit's own debounced auto-solve (or the very next edit)
    // refreshes this automatically. Solve is still the right thing to suggest
    // when nothing has ever solved at all (`SolidPreviewModel.has_solid`
    // false), which keeps its own, more actionable phrasing.
    property <string> status_text: root.batch_suspends_tracer ? "Live render paused -- a catalogue batch is running in the background." : (SolidPreviewModel.stale ? (SolidPreviewModel.has_solid ? "Preview one edit behind -- updating." : "Not solved -- click Solve to refresh.") : SolidPreviewModel.status);

    if root.wide: HorizontalLayout {
        spacing: 8px;
        if root.has_cut: CutSlider { }
        ModePills { }
        ViewPills { }
        ToolPills {
            diagram_zoom <=> root.diagram_zoom;
            diagram_pan_x <=> root.diagram_pan_x;
            diagram_pan_y <=> root.diagram_pan_y;
        }
        // Filler: keeps the pills at their own width.
        Rectangle { horizontal-stretch: 1; }
    }

    if root.medium: VerticalLayout {
        spacing: 6px;
        HorizontalLayout {
            spacing: 8px;
            if root.has_cut: CutSlider { }
            ModePills { }
            ToolPills {
                diagram_zoom <=> root.diagram_zoom;
                diagram_pan_x <=> root.diagram_pan_x;
                diagram_pan_y <=> root.diagram_pan_y;
            }
            Rectangle { horizontal-stretch: 1; }
        }
        HorizontalLayout {
            spacing: 8px;
            ViewPills { }
            Rectangle { horizontal-stretch: 1; }
        }
    }

    if root.low: VerticalLayout {
        spacing: 6px;
        HorizontalLayout {
            spacing: 8px;
            if root.has_cut: CutSlider { }
            ModePills { }
            Rectangle { horizontal-stretch: 1; }
        }
        HorizontalLayout {
            spacing: 8px;
            ViewPills { }
            Rectangle { horizontal-stretch: 1; }
        }
        HorizontalLayout {
            spacing: 8px;
            ToolPills {
                diagram_zoom <=> root.diagram_zoom;
                diagram_pan_x <=> root.diagram_pan_x;
                diagram_pan_y <=> root.diagram_pan_y;
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }

    if root.narrow: VerticalLayout {
        spacing: 6px;
        if root.has_cut: HorizontalLayout {
            spacing: 8px;
            CutSlider { }
            Rectangle { horizontal-stretch: 1; }
        }
        HorizontalLayout {
            spacing: 8px;
            ModePills { tight: true; }
            Rectangle { horizontal-stretch: 1; }
        }
        HorizontalLayout {
            spacing: 8px;
            ViewPills { tight: true; }
            Rectangle { horizontal-stretch: 1; }
        }
        HorizontalLayout {
            spacing: 8px;
            ToolPills {
                tight: true;
                diagram_zoom <=> root.diagram_zoom;
                diagram_pan_x <=> root.diagram_pan_x;
                diagram_pan_y <=> root.diagram_pan_y;
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }

    if root.status_text != "": Rectangle {
        height: 22px;
        background: Theme.bg-input;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: Theme.border-subtle;

        Text {
            text: root.status_text;
            font-size: 11px;
            color: Theme.text-secondary;
            horizontal-alignment: left;
            vertical-alignment: center;
            x: 8px;
            width: parent.width - 16px;
            height: parent.height;
            overflow: elide;
        }
    }
}
