import { Theme } from "../../theme.slint";
import { ExportModel } from "../../models/export.slint";
import { SettingsModel } from "../../models/settings.slint";
import { RemoteWorkerModel } from "../../models/remote_worker.slint";
import { SegmentPill } from "../pill_button.slint";
import { WrappedNote } from "wrapped_note.slint";

// A caption with a tooltip, above a row of pills.
component SectionCaption inherits Rectangle {
    in property <string> text;
    in property <string> hint;

    height: caption.preferred-height;
    Tooltip { text: @markdown("\{root.hint}"); }
    caption := Text {
        text: root.text;
        font-size: 11px;
        font-weight: 600;
        color: Theme.text-secondary;
        accessible-role: AccessibleRole.text;
    }
}

// Compute target (Local/Remote/Local+Remote) and Max Ray Bounces -- split out
// of `export_dialog.slint` to keep that file under its line budget. The pill
// selections live in `ExportModel` (`compute_target_index`, `bounce_index`): they are seeded
// from the last-used values (`AppSettings::output.still`) every time the dialog opens and
// written back when an export starts, so a click in this component writes straight into the
// model and the dialog reads the same values.
//
// The dialog shows this whole component only in Advanced mode (or while a tutorial step
// unlocks it): the defaults (local plus remote when a worker is reachable, and the last-used
// bounce cap) are what most exports want.
export component ExportComputeAndBounces inherits VerticalLayout {
    spacing: 14px;

    // 2c. Compute target: which engine(s) trace this export. Same segmented-
    // pill idiom as "Output Size"/"color Space" in `export_dialog.slint` --
    // the Remote/Local+Remote pills are disabled (not hidden) with
    // `remote_unavailable_reason` shown beneath whenever the remote is not
    // usable (`RemoteWorkerModel.availability.reachable_render_capable`), so a user without a
    // worker configured always sees WHY those choices aren't offered right now. The pill that
    // shows as selected is the effective one: Local only while the remote is unusable, the
    // remembered choice otherwise.
    VerticalLayout {
        spacing: 6px;
        SectionCaption {
            text: "Compute";
            hint: "Which computers draw the export: this one, a remote worker, or both sharing the work.";
        }

        HorizontalLayout {
            spacing: 4px;

            SegmentPill {
                text: "Local Only";
                hint: "Draw the picture on this computer only.";
                selected: ExportModel.effective_compute_target == 0;
                enabled: !ExportModel.is_exporting;
                picked => { ExportModel.compute_target_index = 0; }
            }
            SegmentPill {
                text: "Remote Only";
                hint: RemoteWorkerModel.availability.reachable_render_capable
                    ? "Draw the picture on the remote worker only."
                    : "Not available right now. " + ExportModel.remote_unavailable_reason;
                selected: ExportModel.effective_compute_target == 1;
                enabled: !ExportModel.is_exporting && RemoteWorkerModel.availability.reachable_render_capable;
                picked => { ExportModel.compute_target_index = 1; }
            }
            SegmentPill {
                text: "Local + Remote";
                hint: RemoteWorkerModel.availability.reachable_render_capable
                    ? "Share the work between this computer and the remote worker."
                    : "Not available right now. " + ExportModel.remote_unavailable_reason;
                selected: ExportModel.effective_compute_target == 2;
                enabled: !ExportModel.is_exporting && RemoteWorkerModel.availability.reachable_render_capable;
                picked => { ExportModel.compute_target_index = 2; }
            }
        }

        if !RemoteWorkerModel.availability.reachable_render_capable: WrappedNote {
            text: ExportModel.remote_unavailable_reason == "" ? "Checking for the remote..." : ExportModel.remote_unavailable_reason;
            font-size: 11px;
            color: Theme.text-muted;
            wrap: word-wrap;
            accessible-role: AccessibleRole.text;
        }
    }

    // 2c'. Transfer: how the remote's result comes home. Only
    // offered while a remote is available and the Compute pill includes it -- with
    // "Local only" there is nothing to transfer.
    if ExportModel.effective_compute_target != 0: VerticalLayout {
        spacing: 6px;
        SectionCaption {
            text: "Transfer";
            hint: "How the remote worker's result comes back to this computer.";
        }

        HorizontalLayout {
            spacing: 4px;
            SegmentPill {
                text: "Full Data";
                hint: "The remote sends its raw light samples, which are merged with this computer's own.";
                selected: ExportModel.transfer_index == 0;
                enabled: !ExportModel.is_exporting;
                picked => { ExportModel.transfer_index = 0; }
            }
            SegmentPill {
                text: "Final Picture Only";
                hint: "The remote draws and finishes the whole picture and sends one PNG file. Far less data, but this computer does not help.";
                selected: ExportModel.transfer_index == 1;
                enabled: !ExportModel.is_exporting;
                picked => { ExportModel.transfer_index = 1; }
            }
        }

        WrappedNote {
            text: ExportModel.transfer_index == 1
                ? "The remote renders and tone-maps the whole image and sends one PNG -- far less data, but your own CPU/GPU do not help. Needs a coordinator; a plain worker falls back to full data."
                : "The remote sends raw radiance, which is merged with your own CPU/GPU's samples.";
            font-size: 11px;
            color: Theme.text-muted;
            wrap: word-wrap;
            accessible-role: AccessibleRole.text;
        }
    }

    // 2d. Max Ray Bounces -- the export's OWN cap, independent of the live
    // viewport's. Same segmented-pill idiom as the Render & Output tab's "Max Ray Bounces",
    // and the same ladder: Rust publishes it once (`settings::model::BOUNCE_LADDER` ->
    // `SettingsModel.bounce_ladder`), so there is no second copy here. See the Rust
    // constant's doc comment for the `bounce_cost.rs` measurements behind the rungs.
    VerticalLayout {
        spacing: 6px;
        SectionCaption {
            text: "Max Ray Bounces";
            hint: "How many times a ray of light may bounce inside the stone before it is dropped. More bounces follow the light further and take longer.";
        }

        HorizontalLayout {
            spacing: 4px;

            for cap[idx] in SettingsModel.bounce_ladder: SegmentPill {
                text: "" + cap;
                hint: "Allow up to " + cap + " bounces per ray.";
                selected: ExportModel.bounce_index == idx;
                enabled: !ExportModel.is_exporting;
                picked => { ExportModel.bounce_index = idx; }
            }
        }

        // Same wording/measurement basis as the live view's bounce-ladder hint: flat cost on
        // CPU (the `bounce_cost.rs` benchmark measured only a 1.3-1.4x spread from a cap of
        // 12 all the way to 1024), but GPU threads run in lockstep, so the few long paths in
        // the tail stall the whole workgroup and this rung range costs noticeably more there
        // than on CPU.
        if ExportModel.bounce_index >= 4: WrappedNote {
            text: "Cheap on CPU, but noticeably steeper on GPU -- lockstep execution makes long paths expensive there.";
            font-size: 11px;
            color: Theme.text-muted;
            wrap: word-wrap;
            accessible-role: AccessibleRole.text;
        }
    }
}
