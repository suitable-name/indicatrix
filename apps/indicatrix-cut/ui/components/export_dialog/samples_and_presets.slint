import { Slider } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { ExportModel } from "../../models/export.slint";
import { SettingsModel } from "../../models/settings.slint";
import { GuideModel } from "../../models/guide.slint";
import { TipBox } from "../tip_box.slint";
import { WrappedNote } from "wrapped_note.slint";

// One row of the preset list: a check box drawn by hand, built as a real check box for the
// keyboard (Tab, then Space or Enter) and for a screen reader.
component PresetRow inherits Rectangle {
    in property <string> name;
    in property <bool> checked;
    in property <bool> has_env_map;
    in property <bool> enabled: true;
    callback toggled();

    height: 26px;
    border-radius: Theme.radius-sm;
    opacity: root.enabled ? 1.0 : 0.5;
    background: Theme.surface-sunken;
    border-width: row_focus.has-focus ? 2px : 1px;
    border-color: row_focus.has-focus ? Theme.accent-cyan-hover : (root.checked ? Theme.accent-cyan : Theme.border-dialog);

    accessible-role: AccessibleRole.checkbox;
    accessible-label: root.has_env_map ? root.name + ", uses an HDR map" : root.name;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.toggled();
        }
    }

    Tooltip {
        text: @markdown("Also render the stone with the \{root.name} saved lighting. It makes one more file next to the current view.");
    }

    row_focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.toggled();
                return accept;
            }
            return reject;
        }
    }

    row_touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.toggled(); }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;

        Rectangle {
            width: 14px;
            height: 14px;
            border-radius: 3px;
            background: root.checked ? Theme.accent-cyan : transparent;
            border-width: 1px;
            border-color: root.checked ? Theme.accent-cyan : Theme.border-control;
            y: (parent.height - self.height) / 2;

            if root.checked: Image {
                source: @image-url("../../icons/check.svg");
                colorize: Theme.text-on-accent;
                width: 9px;
                height: 9px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        Text {
            text: root.name;
            font-size: 11px;
            font-weight: 600;
            color: Theme.text-primary;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        // HDR badge: THIS preset lights the stone with an environment map.
        // The GPU renders it directly; only a map past the adapter's
        // storage-buffer limit falls back to the CPU (see the export
        // wiring in `gui::render::render_export::wiring`).
        if root.has_env_map: Text {
            text: "HDR";
            font-size: 11px;
            font-weight: 600;
            color: Theme.accent-amber;
            vertical-alignment: center;
        }
    }
}

// Sample Count (a power-of-two slider) and preset fan-out -- split out of
// `export_dialog.slint` to keep that file under its line budget.
// `effective_samples`/`sample_exponent` are read-only mirrors of
// `ExportDialog`'s own identically-named computed properties (kept there,
// not duplicated here, since the dialog's footer/key handler need them too)
// -- see that file's own doc comments for the exponent-vs-linear rationale.
//
// Sample Count is shown in both modes. The preset fan-out is an Advanced choice: it multiplies
// the export time, so Simple mode leaves it out (the dialog's note says when presets are
// ticked).
export component ExportSamplesAndPresets inherits VerticalLayout {
    spacing: 14px;

    in property <int> effective_samples: 0;
    in property <int> sample_exponent: 0;

    // 3. Sample Count -- a power-of-two slider rather than pills, since the
    // useful range (8..32768) is now far too wide for a handful of presets.
    // "higher = slower" is honest at 4096 but understates it badly at 32768,
    // hence the plain-language cost hint that appears near the top of the range.
    if ExportModel.engine_index == 0: VerticalLayout {
        spacing: 6px;
        Rectangle {
            height: samples_caption.preferred-height;
            Tooltip { text: @markdown("How many light rays are traced for every pixel of the picture. More rays give a smoother picture and take longer."); }
            samples_caption := Text {
                text: "Sample Count (Higher = Slower, Smoother)";
                font-size: 11px;
                font-weight: 600;
                color: Theme.text-secondary;
                accessible-role: AccessibleRole.text;
            }
        }

        HorizontalLayout {
            alignment: space-between;
            Text { text: "Samples per Pixel:"; font-size: 10px; color: Theme.text-muted; vertical-alignment: center; accessible-role: AccessibleRole.text; }
            Text { text: root.effective_samples; font-size: 13px; font-weight: 700; color: Theme.accent-cyan; accessible-role: AccessibleRole.text; }
        }

        TipBox {
            hint: "Drag to choose the sample count. Each step doubles it, and doubles the time too.";
            Slider {
                minimum: SettingsModel.export_samples_min_exponent;
                maximum: SettingsModel.export_samples_max_exponent;
                step: 1;
                value <=> ExportModel.sample_exponent_raw;
                enabled: !ExportModel.is_exporting;
                accessible-label: "Samples per Pixel (Each Step Doubles It)";
            }
        }

        if root.sample_exponent >= SettingsModel.export_samples_max_exponent - 1: WrappedNote {
            text: "Very high sample counts can take hours to render, especially at large output sizes.";
            font-size: 11px;
            color: Theme.text-muted;
            wrap: word-wrap;
            accessible-role: AccessibleRole.text;
        }
    }

    // 3b. Preset fan-out -- only shown when at least one preset is
    // export-usable; an empty list here means nobody has marked a saved lighting "usable for
    // export" yet (the Lighting & Environment tab's Saved lighting list), so
    // there is nothing to fan out and showing an empty section would just be
    // clutter. Advanced mode only.
    if GuideModel.shows_advanced() && ExportModel.fanout_presets.length > 0: VerticalLayout {
        spacing: 6px;
        Rectangle {
            height: presets_caption.preferred-height;
            Tooltip { text: @markdown("Render the stone again with other saved lighting. Each ticked lighting makes one more file next to the current view."); }
            presets_caption := Text {
                text: "Also Render With Saved Lighting";
                font-size: 11px;
                font-weight: 600;
                color: Theme.text-secondary;
                accessible-role: AccessibleRole.text;
            }
        }
        WrappedNote {
            text: "Each checked lighting produces an ADDITIONAL file alongside the current view -- export time multiplies linearly with how many are selected.";
            font-size: 11px;
            color: Theme.text-muted;
            wrap: word-wrap;
            accessible-role: AccessibleRole.text;
        }

        for preset[idx] in ExportModel.fanout_presets: preset-row-name := PresetRow {
            name: preset.name;
            checked: preset.selected;
            has_env_map: preset.has_env_map;
            enabled: !ExportModel.is_exporting;
            toggled => { ExportModel.toggle_preset_selected(idx); }
        }
    }
}
