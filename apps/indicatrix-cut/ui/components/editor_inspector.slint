import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { EditorModel } from "../models/editor.slint";
import { CompareModel } from "../models/compare.slint";
import { GuideModel } from "../models/guide.slint";
import { HelpTopics } from "../models/help.slint";
import { GuideLockTip } from "guide_lock.slint";
import { HelpButton } from "help_button.slint";
import { TipButton } from "compact_controls.slint";
// Optical metrics read-only from ViewportModel (brilliance, windowing,
// extinction). Lets the user judge edit results without leaving the Edit tab.
import { ViewportModel } from "../models/viewport.slint";
import { SectionHeader } from "section_header.slint";
import { ConcaveFormData } from "../types.slint";
import { TierFormTab } from "editor_inspector/tier_form_tab.slint";
import { ConcaveFormTab } from "editor_inspector/concave_form_tab.slint";
import { PreformTab } from "editor_inspector/preform_tab.slint";
import { OptimizeTab } from "editor_inspector/optimize_tab.slint";
import { ScheduleTab } from "editor_inspector/schedule_tab.slint";
import { HistoryTab } from "editor_inspector/history_tab.slint";

// One tab of the Inspector. It takes Tab and answers Space and Enter, shows a ring while it has
// focus, and is a tab (picked or not) to a screen reader. `hint` says what the tab holds.
component InspectorTabPill inherits Rectangle {
    in property <string> label;
    // One plain sentence: what the tab is for. Shown as the tooltip while the tab is usable.
    in property <string> hint;
    in property <bool> active;
    // `false` while the worked-example guide locks this tab (see `GuideAllow`).
    in property <bool> allowed: true;
    // The guide's accent outline, for a step that points at this tab.
    in property <bool> highlighted: false;
    callback clicked();

    height: 26px;
    background: root.active ? Theme.primary : (touch.has-hover ? Theme.bg-elevated : Theme.bg-input);
    border-radius: Theme.radius-sm;
    border-width: (root.highlighted || pill_focus.has-focus) ? 2px : 1px;
    border-color: pill_focus.has-focus ? Theme.accent-cyan-hover : ((root.active || root.highlighted) ? Theme.accent-cyan : Theme.border-subtle);
    opacity: root.allowed ? 1.0 : 0.4;

    accessible-role: AccessibleRole.tab;
    accessible-label: root.label;
    accessible-description: root.hint;
    accessible-enabled: root.allowed;
    accessible-checkable: true;
    accessible-checked: root.active;
    accessible-action-default => {
        if root.allowed {
            root.clicked();
        }
    }

    if root.allowed && root.hint != "": Tooltip { text: @markdown("\{root.hint}"); }
    pill_focus := FocusScope {
        enabled: root.allowed;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.allowed;
        clicked => { root.clicked(); }
    }
    GuideLockTip { locked: !root.allowed; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;
        Text {
            text: root.label;
            font-size: 11px;
            font-weight: 600;
            color: root.active ? Theme.text-on-primary : Theme.text-secondary;
            vertical-alignment: center;
        }
    }
}

// The Edit sub-tab's per-tier/preform/optimize/schedule inspector -- a
// resizable dock panel below the tier table, tabbed instead of the old
// always-visible right column, since the tier table needed the width and
// vertical room the old layout gave the toolbar/banners/design settings
// instead (see `app.slint`'s Edit-mode layout doc comment).
// `EditorModel.inspector_tab` (0 = Tier, 1 = Preform, 2 = Optimize,
// 3 = Schedule, 4 = History) tracks which tab is showing. Its own `SectionHeader` (title
// "INSPECTOR") carries the tab pills in its right-side slot, so switching tabs
// (which also re-expands the section, per each pill's own `clicked` below)
// stays reachable even while collapsed.
//
// The Tier tab's Save/Add Tier row is pinned outside the scrollable body so
// it stays visible even when the inspector is shorter than the form.
export component EditorInspector inherits Rectangle {
    // Header-row-only height while collapsed (the `SectionHeader`'s own 24px
    // plus this component's 8px top/bottom padding) -- see `EditorModel.
    // inspector_collapsed`'s own doc comment (`ui/models/editor.slint`).
    property <length> header_height: 40px;
    height: EditorModel.inspector_collapsed ? root.header_height : EditorModel.inspector_height;
    background: Theme.bg-darkest;
    border-radius: Theme.radius-sm;
    // The worked-example guide's outline while a step points at the Tier or the
    // Preform tab (the pill itself is outlined too, see `InspectorTabPill`).
    property <bool> guide_highlighted: GuideModel.highlight_target == "inspector_tier" || GuideModel.highlight_target == "preform_tab";
    // Whether the worked-example guide leaves the CURRENT tab's group usable --
    // Tier: tier form, Preform: preform tab, Optimize: advanced, History: undo and
    // redo. The read-only Schedule tab never locks.
    property <bool> tab_unlocked: EditorModel.inspector_tab == 0 ? GuideModel.allows_tier_form()
        : EditorModel.inspector_tab == 1 ? GuideModel.allows_preform_tab()
        : EditorModel.inspector_tab == 2 ? GuideModel.allows_advanced()
        : EditorModel.inspector_tab == 4 ? GuideModel.allows_history()
        : true;
    // Whether the Advanced interface shows. The Simple interface leaves out the Schedule tab
    // (its pill and its body); each other tab hides its own advanced controls.
    property <bool> advanced: GuideModel.shows_advanced();
    // The tab being shown, mirrored so a change can be answered here.
    property <int> tracked_inspector_tab: EditorModel.inspector_tab;
    // Switching to the Simple interface while the Schedule tab is open (or a command that opens
    // the Schedule tab while the Simple interface is on) lands on the Tier tab instead of an
    // empty panel. The Schedule tab itself is never changed.
    function leave_hidden_tab() {
        if !root.advanced && EditorModel.inspector_tab == 3 {
            EditorModel.inspector_tab = 0;
        }
    }
    changed advanced => { root.leave_hidden_tab(); }
    changed tracked_inspector_tab => { root.leave_hidden_tab(); }
    // The name of the open tab, for a screen reader.
    property <string> tab_name: EditorModel.inspector_tab == 0
        ? (root.concave_loaded ? "Concave tier form" : "Tier form")
        : EditorModel.inspector_tab == 1 ? "Preform"
        : EditorModel.inspector_tab == 2 ? "Optimize"
        : EditorModel.inspector_tab == 3 ? "Schedule"
        : "History";
    // The manual page for the open tab's "?" button. History keeps the topic of its own tab.
    property <string> tab_help_topic: EditorModel.inspector_tab == 0
        ? (root.concave_loaded ? HelpTopics.concave-tier : HelpTopics.tier-form)
        : EditorModel.inspector_tab == 1 ? HelpTopics.preform-tab
        : EditorModel.inspector_tab == 2 ? HelpTopics.optimize-tab
        : EditorModel.inspector_tab == 3 ? HelpTopics.schedule-tab
        : HelpTopics.history;
    border-width: root.guide_highlighted ? 2px : 1px;
    border-color: root.guide_highlighted ? Theme.accent-cyan : Theme.border-subtle;
    clip: true;

    // Tier-edit form scratch state -- doubles as the current value's display
    // (seeded from the selection via `load_tier_into_form`, called by `EditorView`'s
    // own `EditorModel.selected_tier_index` watcher every time that global property
    // changes -- a row click, the Solid/Diagram viewport's click, or "Duplicate,"
    // see `EditorView`'s own doc comment) and the user's in-progress edit, via a
    // two-way `<=>` alias, the same idiom `remote_worker_dialog.slint`'s `form_*`
    // fields use. Nothing commits until "Save Tier"/"Add Tier" below.
    //
    // The form is a SNAPSHOT of the tier, not a binding to it, so it must be told
    // when the design moves underneath it. The rule:
    //   * selection change -> `load_tier_into_form` (a dirty draft is guarded by
    //     the dirty-warning banner);
    //   * New/Load/Open/Remove that clears the selection -> `clear_form`;
    //   * any edit that leaves the selected tier selected (a handle drag, nudge,
    //     pin, adopt, facet edit, gear remap, retarget/optimize apply, symmetry
    //     change, Undo/Redo) -> `EditorModel.form_reseed_pulse`, which the Rust
    //     refresh bumps once per design generation -> `reseed_after_external_change`:
    //     a CLEAN form follows the design; a DIRTY form keeps the draft and, when
    //     the loaded tier's own values moved, raises `external_change_pending` so
    //     the form says so and offers a reload instead of silently saving stale
    //     values over the edit.
    property <string> tier_angle: "0.0";
    property <int> tier_constraint_kind: 0;
    property <string> tier_constraint_text: "";
    property <string> tier_name: "";
    property <string> tier_indices: "";
    // Per-facet scratch fields: typed position for "+ Add" and tooth count for
    // "Rotate". Not covered by `form_dirty` since they don't commit to Design.
    property <string> new_facet_position: "";
    property <string> rotate_by_text: "1";

    // The CONCAVE tier form's scratch fields (`ConcaveFormTab`), the tool-cut
    // counterpart of the five above: seeded from `EditorModel.concave_form_data`,
    // snapshotted and dirty-tracked the same way (one joined `concave_signature`
    // instead of a snapshot per field). `loaded_tier_index` below is the table
    // POSITION for either kind; `concave_loaded` says which form it describes.
    property <string> c_name: "";
    property <string> c_angle: "";
    property <string> c_indices: "";
    property <string> c_instructions: "";
    property <int> c_tool: 0;
    property <string> c_theta: "";
    property <string> c_x: "";
    property <string> c_y: "";
    property <string> c_z: "";
    property <string> c_diameter: "";
    property <string> c_tool_angle: "";
    property <bool> c_reciprocating: false;

    // In-progress "Add Tier" draft or tier edit. `loaded_tier_index` tracks which
    // tier (or `-1` for "Add") the five fields above actually represent, which can
    // now disagree with `EditorModel.selected_tier_index` for as long as
    // `show_dirty_warning` is up (see below) -- `save_form`/the header/the
    // "Solved" section all read `loaded_tier_index`, never the global selection,
    // specifically so a guarded, not-yet-confirmed selection change can never
    // make Save Tier write to the wrong row.
    property <int> loaded_tier_index: -1;
    // Snapshot of the five fields above as `apply_load`/`clear_form`/`save_form`
    // last set them. `form_dirty` below is a pure comparison against this
    // snapshot, not a flag toggled by per-field `changed` handlers guarded by a
    // `loading` flag (the previous design): those handlers are QUEUED (Slint runs them
    // later) and only run on the next
    // event-loop turn or tree flush, strictly AFTER `apply_load`'s own
    // assignments already completed and `loading` was already back to `false` --
    // so the guard could never actually suppress anything, and every load
    // (including a same-tier reload, e.g. the tier table's "Add Anchor" action)
    // marked the form dirty against itself. A plain property-binding compare has
    // no such ordering to get wrong: both sides are ordinary properties,
    // re-evaluated together whenever either changes, and both are written by the
    // exact same call (`apply_load`/`clear_form`/`save_form`), so they can never
    // observe each other mid-update.
    property <string> loaded_angle_snapshot: "0.0";
    property <int> loaded_constraint_kind_snapshot: 0;
    property <string> loaded_constraint_text_snapshot: "";
    property <string> loaded_name_snapshot: "";
    property <string> loaded_indices_snapshot: "";
    property <string> loaded_concave_snapshot: "";
    // The concave draft as one comparable string. `\u{1}` cannot be typed into a
    // `LineEdit`, so two different drafts never join to the same signature.
    property <string> concave_signature: root.c_name + "\u{1}" + root.c_angle + "\u{1}" + root.c_indices + "\u{1}"
        + root.c_instructions + "\u{1}" + root.c_tool + "\u{1}" + root.c_theta + "\u{1}" + root.c_x + "\u{1}"
        + root.c_y + "\u{1}" + root.c_z + "\u{1}" + root.c_diameter + "\u{1}" + root.c_tool_angle + "\u{1}"
        + (root.c_reciprocating ? "1" : "0");
    property <bool> form_dirty: root.tier_angle != root.loaded_angle_snapshot
        || root.tier_constraint_kind != root.loaded_constraint_kind_snapshot
        || root.tier_constraint_text != root.loaded_constraint_text_snapshot
        || root.tier_name != root.loaded_name_snapshot
        || root.tier_indices != root.loaded_indices_snapshot
        || root.concave_signature != root.loaded_concave_snapshot;
    // Which form the loaded draft belongs to: a loaded row's own `kind`, or -- for an
    // "Add" draft (`loaded_tier_index == -1`) -- the mode "+ Add Concave Tier" set.
    property <bool> concave_loaded: (root.loaded_tier_index >= 0 && root.loaded_tier_index < EditorModel.tiers.length)
        ? EditorModel.tiers[root.loaded_tier_index].kind == 1
        : EditorModel.inspector_concave_mode;
    // The concave form's angle check (the only local one): beyond 90 degrees, or Rust
    // reported an angle-field error.
    property <bool> concave_angle_invalid: Math.abs(root.c_angle.to-float()) > 90
        || EditorModel.tier_form_error_field == "angle";
    // Angle field invalid if > 90 degrees (locally checkable) or if Rust
    // reported an angle-field error.
    property <bool> angle_field_invalid: Math.abs(root.tier_angle.to-float()) > 90
        || EditorModel.tier_form_error_field == "angle";
    // Name, indices, and constraint fields: invalid if Rust-classified error
    // for that field (rules that require Rust validation).
    property <bool> name_field_invalid: EditorModel.tier_form_error_field == "name";
    property <bool> indices_field_invalid: EditorModel.tier_form_error_field == "indices";
    property <bool> constraint_field_invalid: EditorModel.tier_form_error_field == "constraint";
    // The selection `load_tier_into_form`/`request_new` deferred because the form
    // was dirty -- `-1` means "Add Tier" was requested, matching `loaded_tier_index`'s
    // own convention. Only meaningful while `show_dirty_warning` is true.
    property <int> pending_load_index: -1;
    property <bool> show_dirty_warning: false;
    // A dirty draft's tier changed in the design after the form loaded it (a drag,
    // nudge or pin landed while the cutter was typing). The draft is kept; the form
    // shows a notice with "Reload From Design"/"Keep Draft". Cleared by every
    // `snapshot_form` (load, clear, save), so it never outlives the baseline it
    // describes.
    property <bool> external_change_pending: false;
    // What `TierFormTab` actually shows: only while the draft still differs from its
    // baseline (a draft typed back to the original needs no notice) and still names a
    // real tier.
    property <bool> show_external_change: root.external_change_pending && root.form_dirty && root.loaded_tier_index >= 0;

    // The tool combo's index for a tool code (`CYL` 0, `CON` 1, `CIR` 2, `DSC` 3, `SPH` 4;
    // anything else reads as the first), and back.
    function tool_index(code: string) -> int {
        if code == "CON" { return 1; }
        if code == "CIR" { return 2; }
        if code == "DSC" { return 3; }
        if code == "SPH" { return 4; }
        return 0;
    }
    function tool_code(index: int) -> string {
        if index == 1 { return "CON"; }
        if index == 2 { return "CIR"; }
        if index == 3 { return "DSC"; }
        if index == 4 { return "SPH"; }
        return "CYL";
    }
    // The concave draft as the struct `EditorModel.save_concave_tier` takes.
    function concave_draft() -> ConcaveFormData {
        return {
            name: root.c_name,
            angle_deg: root.c_angle,
            indices: root.c_indices,
            instructions: root.c_instructions,
            tool: root.tool_code(root.c_tool),
            tool_azimuth_deg: root.c_theta,
            x: root.c_x,
            y: root.c_y,
            z: root.c_z,
            diameter_ratio: root.c_diameter,
            tool_angle_deg: root.c_tool_angle,
            reciprocating: root.c_reciprocating,
        };
    }
    // Seeds the concave scratch fields from a tier read back at full precision.
    function seed_concave(data: ConcaveFormData) {
        root.c_name = data.name;
        root.c_angle = data.angle_deg;
        root.c_indices = data.indices;
        root.c_instructions = data.instructions;
        root.c_tool = root.tool_index(data.tool);
        root.c_theta = data.tool_azimuth_deg;
        root.c_x = data.x;
        root.c_y = data.y;
        root.c_z = data.z;
        root.c_diameter = data.diameter_ratio;
        root.c_tool_angle = data.tool_angle_deg;
        root.c_reciprocating = data.reciprocating;
    }
    function blank_concave() {
        root.c_name = "";
        root.c_angle = "";
        root.c_indices = "";
        root.c_instructions = "";
        root.c_tool = 0;
        root.c_theta = "";
        root.c_x = "";
        root.c_y = "";
        root.c_z = "";
        root.c_diameter = "";
        root.c_tool_angle = "";
        root.c_reciprocating = false;
    }
    // The signature `concave_signature` would read after `seed_concave(data)` -- the
    // same join, for `loaded_tier_changed_in_design`'s comparison with the design.
    function data_signature(data: ConcaveFormData) -> string {
        return data.name + "\u{1}" + data.angle_deg + "\u{1}" + data.indices + "\u{1}" + data.instructions + "\u{1}"
            + root.tool_index(data.tool) + "\u{1}" + data.tool_azimuth_deg + "\u{1}" + data.x + "\u{1}" + data.y + "\u{1}"
            + data.z + "\u{1}" + data.diameter_ratio + "\u{1}" + data.tool_angle_deg + "\u{1}"
            + (data.reciprocating ? "1" : "0");
    }

    // The Angle field's text for the flat tier at `idx`: its full-precision angle, or -- when
    // the angle follows a relation (`P2 = P1 - 2`) -- "=" and the relation as a cutter reads
    // it ("=P1 - 2"). Typing a relation back into the field and saving keeps it; typing a
    // plain number on such a tier is refused with the reason (see `TierFormTab`).
    function angle_seed(idx: int) -> string {
        return EditorModel.tiers[idx].relation_text != ""
            ? "=" + EditorModel.tiers[idx].relation_text
            : EditorModel.tiers[idx].angle_full;
    }

    // Snapshots the five fields' CURRENT values as the new "clean" baseline --
    // shared tail of `apply_load`/`clear_form`/`save_form`, all of which just
    // assigned (or left unchanged) exactly these fields and want `form_dirty` to
    // read `false` again immediately afterward.
    function snapshot_form() {
        root.loaded_angle_snapshot = root.tier_angle;
        root.loaded_constraint_kind_snapshot = root.tier_constraint_kind;
        root.loaded_constraint_text_snapshot = root.tier_constraint_text;
        root.loaded_name_snapshot = root.tier_name;
        root.loaded_indices_snapshot = root.tier_indices;
        root.loaded_concave_snapshot = root.concave_signature;
        root.external_change_pending = false;
    }

    // The guarded entry point every selection change reaches (`EditorView`'s
    // `tracked_selected_tier_index` watcher, called AFTER `EditorModel.
    // selected_tier_index` has already moved to `idx` -- see that file's own doc
    // comment). When the form is clean, or `idx` is the tier already loaded, this
    // loads immediately exactly like before. Otherwise the table's row highlight
    // has already moved to `idx`, but the FORM deliberately does not follow until
    // the cutter says so -- `show_dirty_warning` puts up the choice instead of
    // silently overwriting the draft.
    public function load_tier_into_form(idx: int) {
        if idx < 0 || idx >= EditorModel.tiers.length {
            return;
        }
        if root.form_dirty && idx != root.loaded_tier_index {
            root.pending_load_index = idx;
            root.show_dirty_warning = true;
            return;
        }
        root.apply_load(idx);
    }

    function apply_load(idx: int) {
        // Clear validation errors when loading a different tier, so error markers
        // don't point at fields that now describe something else.
        EditorModel.tier_form_error = "";
        EditorModel.tier_form_error_field = "";
        EditorModel.selected_tier_index = idx;
        // A concave row has its own form, seeded from Rust at full precision (the
        // table row carries only the display strings).
        if EditorModel.tiers[idx].kind == 1 {
            root.seed_concave(EditorModel.concave_form_data(idx));
            root.loaded_tier_index = idx;
            root.snapshot_form();
            return;
        }
        // A flat row ends the concave "Add" mode: the flat form is what shows.
        EditorModel.inspector_concave_mode = false;
        // Seeded from the FULL-precision string, not the 2-decimal display
        // `angle_deg` -- see `EditorTierItem.angle_full`'s own doc comment: a
        // Save with nothing retyped must round-trip bit-exact, which a rounded
        // seed cannot do for an angle like 41.2367. A tier whose angle follows a
        // relation is seeded with the relation instead (`angle_seed`).
        root.tier_angle = root.angle_seed(idx);
        // `suggested_constraint_kind >= 0` is the tier table's "Add Anchor" action
        // (see that property's own doc comment on `EditorModel`) asking this
        // specific load to open on "Exact scale value" rather than the tier's own
        // current kind -- consumed (reset to `-1`) right here so it can never leak
        // into a later, unrelated selection change.
        root.tier_constraint_kind = EditorModel.suggested_constraint_kind >= 0
            ? EditorModel.suggested_constraint_kind
            : EditorModel.tiers[idx].constraint_kind;
        EditorModel.suggested_constraint_kind = -1;
        root.tier_constraint_text = EditorModel.tiers[idx].constraint_text;
        root.tier_name = EditorModel.tiers[idx].name;
        // Same full-precision reasoning as `tier_angle` above, for a fractional
        // gear-index shorthand (e.g. "13.71" rounds a real "x7" position).
        root.tier_indices = EditorModel.tiers[idx].indices_full;
        root.loaded_tier_index = idx;
        root.snapshot_form();
    }

    // The "New" button's guarded entry point -- mirrors `load_tier_into_form`, but
    // (unlike a row click) runs BEFORE touching `EditorModel.selected_tier_index`,
    // so a guarded "New" leaves the table's own selection/highlight untouched
    // rather than moving it out from under a draft the cutter chose to keep.
    function request_new() {
        if root.form_dirty && root.loaded_tier_index != -1 {
            root.pending_load_index = -1;
            root.show_dirty_warning = true;
            return;
        }
        root.apply_new();
    }

    function apply_new() {
        // `clear_form()` first, so `root.loaded_tier_index` is already -1
        // by the time `EditorModel.selected_tier_index` changes below --
        // that assignment is what fires `tracked_selection_for_new`'s own
        // `changed` handler further down, which re-enters THIS function if
        // it still sees a real (non -1) `loaded_tier_index`. Clearing first
        // makes that guard see the post-clear state -- `changed` handlers are
        // QUEUED, so that
        // handler cannot possibly re-enter before this function itself
        // returns; ordering the two assignments this way is what guarantees
        // it sees `loaded_tier_index == -1` once it does run.
        root.reset_fields();
        EditorModel.selected_tier_index = -1;
    }

    // Local "has this section been typed/changed since Apply" flags. Declared
    // on `root` so they resolve from anywhere in the component. UI-only state
    // kept on this side rather than round-tripping through Rust.
    property <bool> preform_pending: false;
    property <bool> yield_pending: false;
    // Local backing state for the optimize preview checkbox. EditorModel.
    // optimize_preview_toggled is a callback-only, not a two-way property.
    property <bool> optimize_preview_checked: false;
    // The compare window's Optimize "Discard" bumps this serial (on
    // `MainWindow`'s own `CompareModel`) to untick the checkbox above -- Rust
    // cannot reach this local property directly. Mirrored locally because a
    // global's own property cannot take a `changed` handler outside its file.
    property <int> tracked_compare_discard: CompareModel.optimize_preview_reset_serial;
    changed tracked_compare_discard => {
        root.optimize_preview_checked = false;
    }
    // Bumps on New/Load Selected/Open. The alias-plus-changed idiom
    // ensures the flag is relevant for the current design, not stale.
    property <int> tracked_form_reset_pulse: EditorModel.form_reset_pulse;
    changed tracked_form_reset_pulse => {
        root.preform_pending = false;
        root.yield_pending = false;
    }

    // Keeps form in sync when global selection moves to -1 directly (e.g., from
    // tier table's "+ Add Tier" or Escape shortcut). Guarded by form_dirty.
    // own row highlight may already have cleared alongside it.
    property <int> tracked_selection_for_new: EditorModel.selected_tier_index;
    changed tracked_selection_for_new => {
        if root.tracked_selection_for_new < 0 && root.loaded_tier_index != -1 {
            root.request_new();
        }
    }

    // The dirty-warning banner's two answers -- see `show_dirty_warning`'s own
    // call sites above for what deferred this.
    function confirm_discard_and_load() {
        root.show_dirty_warning = false;
        if root.pending_load_index < 0 {
            root.apply_new();
        } else {
            root.apply_load(root.pending_load_index);
        }
        root.pending_load_index = -1;
    }

    function keep_draft() {
        root.show_dirty_warning = false;
        root.pending_load_index = -1;
    }

    // Blanks the form back to "Add Tier" defaults -- the "New" button's own body
    // below, and `EditorView`'s `form_reset_pulse` watcher (see that property's own
    // doc comment in `ui/models/editor.slint`) for a selection reset that originates
    // outside this component (New Design/Load Selected/Open, or removing the
    // currently selected tier). Deliberately unguarded (unlike `load_tier_into_form`/
    // `request_new` above) -- every one of those callers is already a deliberate,
    // confirmed, design-changing action of its own, not an incidental row click.
    public function clear_form() {
        root.reset_fields();
        // New/Load/Open/Remove all start from the flat "Add Tier" form again.
        EditorModel.inspector_concave_mode = false;
    }

    // `clear_form` minus the mode reset: also what "New Tier"/an Escape back to
    // selection -1 (`apply_new`) uses, since "+ Add Concave Tier" reaches `apply_new`
    // through the very selection change it makes and must stay in concave mode.
    function reset_fields() {
        // Clear validation errors so stale errors don't survive into "Add Tier" draft.
        EditorModel.tier_form_error = "";
        EditorModel.tier_form_error_field = "";
        root.tier_angle = "0.0";
        root.tier_constraint_kind = 0;
        root.tier_constraint_text = "";
        root.tier_name = "";
        root.tier_indices = "";
        root.blank_concave();
        root.loaded_tier_index = -1;
        root.snapshot_form();
        root.show_dirty_warning = false;
        root.pending_load_index = -1;
    }

    // Re-seeds the form from the (possibly just-changed) Design after an
    // any edit that left the currently selected tier selected -- a handle drag,
    // nudge, pin, adopt, facet edit, gear remap, retarget/optimize apply, symmetry
    // change, or an in-range Undo/Redo (an out-of-range one instead clears the
    // selection and reaches `clear_form` through `form_reset_pulse`, same as
    // New/Load Selected/Open).`EditorView`'s `tracked_form_reseed_pulse`
    // watcher calls this -- see `EditorModel.form_reseed_pulse`'s own doc comment
    // (`ui/models/editor.slint`) for the Rust side.
    //
    // Never shows the dirty-warning banner the way `load_tier_into_form` does --
    // the SELECTION did not move here, so there is no "which draft do you want"
    // choice to offer. A clean form is simply refreshed (e.g. a drag retargeted
    // THIS very tier's angle, and a stale form would otherwise keep showing the
    // pre-edit value for Save Tier to write back). A DIRTY form keeps the draft:
    //   * `tier_count_changed` (a structural `AddTier`/`RemoveTier`, which can
    //     shift every later index): the draft may now describe an entirely
    //     different row, so this forgets which tier it belonged to rather than
    //     risking a save landing on the wrong one; the next save/dirty-warning
    //     path recomputes cleanly from there instead of guessing;
    //   * otherwise, when the loaded tier's values in the design no longer match
    //     the baseline the draft was typed on top of, `external_change_pending`
    //     raises the notice.
    //
    // A pulse that arrives after the selection already moved on (a Remove that
    // shifted it, a multi-delete that cleared it) does nothing: the selection's own
    // watcher loads the right row, and re-seeding the OLD index here would drag the
    // selection back to it.
    public function reseed_after_external_change(tier_count_changed: bool) {
        if root.form_dirty {
            if tier_count_changed {
                root.loaded_tier_index = -1;
            } else if root.loaded_tier_changed_in_design() {
                root.external_change_pending = true;
            }
            return;
        }
        if root.loaded_tier_index >= 0
            && root.loaded_tier_index < EditorModel.tiers.length
            && root.loaded_tier_index == EditorModel.selected_tier_index {
            root.apply_load(root.loaded_tier_index);
        }
    }

    // Whether the loaded tier's values in the design differ from the baseline the
    // form was last seeded with -- the five fields `form_dirty` compares, read from
    // the same full-precision strings `apply_load` seeds from.
    function loaded_tier_changed_in_design() -> bool {
        if root.loaded_tier_index < 0 || root.loaded_tier_index >= EditorModel.tiers.length {
            return false;
        }
        if EditorModel.tiers[root.loaded_tier_index].kind == 1 {
            return root.data_signature(EditorModel.concave_form_data(root.loaded_tier_index)) != root.loaded_concave_snapshot;
        }
        return root.angle_seed(root.loaded_tier_index) != root.loaded_angle_snapshot
            || EditorModel.tiers[root.loaded_tier_index].constraint_kind != root.loaded_constraint_kind_snapshot
            || EditorModel.tiers[root.loaded_tier_index].constraint_text != root.loaded_constraint_text_snapshot
            || EditorModel.tiers[root.loaded_tier_index].name != root.loaded_name_snapshot
            || EditorModel.tiers[root.loaded_tier_index].indices_full != root.loaded_indices_snapshot;
    }

    // The external-change notice's two answers: take the design's values (dropping
    // the draft) or keep the draft and stop showing the notice.
    function reload_from_design() {
        if root.loaded_tier_index >= 0 && root.loaded_tier_index < EditorModel.tiers.length {
            root.apply_load(root.loaded_tier_index);
        }
        root.external_change_pending = false;
    }

    function dismiss_external_change() {
        root.external_change_pending = false;
    }

    // Commits whichever tier `loaded_tier_index` says the form represents,
    // not `EditorModel.selected_tier_index` directly. When dirty-warning is up,
    // they can disagree; reading the global could write to the wrong tier.
    function save_form() {
        // Every save path (the Add/Save Tier button, Enter in a form field) funnels
        // through here, so this one check covers them all while the guide locks
        // the tier form.
        if !GuideModel.allows_tier_form() {
            return;
        }
        // The concave form commits through its own callback (`index` is the row's table
        // position, -1 to add) and its own, stricter guide lock.
        if root.concave_loaded {
            if !GuideModel.allows_concave_tier() {
                return;
            }
            EditorModel.save_concave_tier(root.loaded_tier_index, root.concave_draft());
            root.snapshot_form();
            return;
        }
        EditorModel.save_tier(root.loaded_tier_index, root.tier_angle, root.tier_constraint_kind, root.tier_constraint_text, root.tier_name, root.tier_indices);
        // Optimistic: the cutter just committed these values, so the form is
        // clean against them regardless of whether Rust's own validation
        // actually accepted the save. On validation failure, the text is still
        // here to fix and resubmit.
        root.snapshot_form();
    }

    // Up/Down/Shift/Ctrl stepping for the Angle field is done in Rust
    // (`SliderModel.stepped_angle_text`, called from `TierFormTab`), so the text keeps
    // the form's own number format whatever the locale.

    VerticalLayout {
        padding: 8px;
        spacing: 6px;

        SectionHeader {
            title: "INSPECTOR";
            collapsed: EditorModel.inspector_collapsed;
            toggled => { EditorModel.inspector_collapsed = !EditorModel.inspector_collapsed; }

            HorizontalLayout {
                spacing: 6px;
                // Each pill also re-expands the section -- switching tabs
                // while collapsed must be visibly useful, not just recorded
                // for whenever the section next opens.
                InspectorTabPill {
                    label: "Tier";
                    hint: "Add a tier, or edit the one selected in the table: its angle, what it meets, its name and its index positions.";
                    active: EditorModel.inspector_tab == 0;
                    allowed: GuideModel.allows_tier_form();
                    highlighted: GuideModel.highlight_target == "inspector_tier";
                    clicked => { EditorModel.inspector_tab = 0; EditorModel.inspector_collapsed = false; }
                }
                InspectorTabPill {
                    label: "Preform";
                    hint: "The starting rough: its shape and size, the stone's proportions and how much of the rough is kept. See the glossary.";
                    active: EditorModel.inspector_tab == 1;
                    allowed: GuideModel.allows_preform_tab();
                    highlighted: GuideModel.highlight_target == "preform_tab";
                    clicked => { EditorModel.inspector_tab = 1; EditorModel.inspector_collapsed = false; }
                }
                InspectorTabPill {
                    label: "Optimize";
                    hint: "Let the program search for angles that give a brighter stone, then preview and apply one of the results. See the glossary.";
                    active: EditorModel.inspector_tab == 2;
                    allowed: GuideModel.allows_advanced();
                    highlighted: GuideModel.highlight_target == "optimize_tab";
                    clicked => { EditorModel.inspector_tab = 2; EditorModel.inspector_collapsed = false; }
                }
                // The Schedule tab is advanced: the Simple interface leaves out its pill and body.
                if root.advanced: InspectorTabPill {
                    label: "Schedule";
                    hint: "The cutting order of this design, one line per facet, as the program has it now.";
                    active: EditorModel.inspector_tab == 3;
                    clicked => { EditorModel.inspector_tab = 3; EditorModel.inspector_collapsed = false; }
                }
                InspectorTabPill {
                    label: "History";
                    hint: "Every edit made to this design, with a picture of each step, and saved variants of it.";
                    active: EditorModel.inspector_tab == 4;
                    allowed: GuideModel.allows_history();
                    highlighted: GuideModel.highlight_target == "history_tab";
                    clicked => { EditorModel.inspector_tab = 4; EditorModel.inspector_collapsed = false; }
                }
                // The manual page for the open tab. The History tab brings its own.
                if EditorModel.inspector_tab != 4: VerticalLayout {
                    alignment: center;
                    HelpButton {
                        topic: root.tab_help_topic;
                        hint: EditorModel.inspector_tab == 0
                            ? (root.concave_loaded ? "Open the manual page on adding a concave tier" : "Open the manual page on the tier form")
                            : EditorModel.inspector_tab == 1 ? "Open the manual page on the Preform tab"
                            : EditorModel.inspector_tab == 2 ? "Open the manual page on Optimize"
                            : "Open the manual page on the Schedule tab";
                    }
                }
            }
        }

        if !EditorModel.inspector_collapsed: VerticalLayout {
            spacing: 6px;
            vertical-stretch: 1;

            // A compact always-visible readout of the
            // shared viewport's current optical metrics, visible regardless of
            // which inspector tab is open, so a cutter judging whether an
            // angle change helped does not have to switch to the Live Render
            // tab and back. Only shown while that viewport is actually
            // following this design (`viewport_material_linked`); otherwise
            // the numbers would describe some unrelated display override.
            if ViewportModel.viewport_material_linked: Rectangle {
                height: metrics_row.preferred-height;
                accessible-role: AccessibleRole.text;
                accessible-label: "Brilliance " + Math.round(ViewportModel.brilliance_pct) + " percent, windowing "
                    + Math.round(ViewportModel.windowing_pct) + " percent, extinction " + Math.round(ViewportModel.extinction_pct) + " percent";
                Tooltip { text: @markdown("Brilliance (the light returned to the eye), windowing (the see-through share) and extinction (the dead-dark share) at the current lighting, from the linked Live Render viewport. See the glossary."); }
                metrics_row := HorizontalLayout {
                    spacing: 10px;
                    Text { text: "Brilliance " + Math.round(ViewportModel.brilliance_pct) + "%"; font-size: 9px; color: Theme.text-muted; }
                    Text { text: "Windowing " + Math.round(ViewportModel.windowing_pct) + "%"; font-size: 9px; color: Theme.text-muted; }
                    Text { text: "Extinction " + Math.round(ViewportModel.extinction_pct) + "%"; font-size: 9px; color: Theme.text-muted; }
                    Rectangle { horizontal-stretch: 1; }
                }
            }

            // Wrapped so the whole tab body can dim and explain itself while the
            // worked-example guide locks the current tab's group (the same
            // `GuideModel.allows_*()` helper as that tab's pill); each tab also
            // disables its own inputs through `unlocked`.
            Rectangle {
                vertical-stretch: 1;
                opacity: root.tab_unlocked ? 1.0 : 0.55;
                accessible-role: AccessibleRole.tab-panel;
                accessible-label: root.tab_name;
            // The History tab is a list of its own (virtualised, so it scrolls itself):
            // this scroll view steps aside for it.
            ScrollView {
                visible: EditorModel.inspector_tab != 4;
                width: 100%;
                height: 100%;
                VerticalLayout {
                    spacing: 8px;

                if EditorModel.inspector_tab == 0 && root.concave_loaded: ConcaveFormTab {
                    unlocked: GuideModel.allows_concave_tier();
                    c_name <=> root.c_name;
                    c_angle <=> root.c_angle;
                    c_indices <=> root.c_indices;
                    c_instructions <=> root.c_instructions;
                    c_tool <=> root.c_tool;
                    c_theta <=> root.c_theta;
                    c_x <=> root.c_x;
                    c_y <=> root.c_y;
                    c_z <=> root.c_z;
                    c_diameter <=> root.c_diameter;
                    c_tool_angle <=> root.c_tool_angle;
                    c_reciprocating <=> root.c_reciprocating;
                    loaded_tier_index: root.loaded_tier_index;
                    show_dirty_warning: root.show_dirty_warning;
                    show_external_change: root.show_external_change;
                    pending_load_index: root.pending_load_index;
                    keep_draft => { root.keep_draft(); }
                    confirm_discard_and_load => { root.confirm_discard_and_load(); }
                    reload_from_design => { root.reload_from_design(); }
                    dismiss_external_change => { root.dismiss_external_change(); }
                    save_form => { root.save_form(); }
                }

                if EditorModel.inspector_tab == 0 && !root.concave_loaded: TierFormTab {
                    unlocked: GuideModel.allows_tier_form();
                    tier_angle <=> root.tier_angle;
                    tier_constraint_kind <=> root.tier_constraint_kind;
                    tier_constraint_text <=> root.tier_constraint_text;
                    tier_name <=> root.tier_name;
                    tier_indices <=> root.tier_indices;
                    new_facet_position <=> root.new_facet_position;
                    rotate_by_text <=> root.rotate_by_text;
                    loaded_tier_index: root.loaded_tier_index;
                    show_dirty_warning: root.show_dirty_warning;
                    show_external_change: root.show_external_change;
                    pending_load_index: root.pending_load_index;
                    angle_field_invalid: root.angle_field_invalid;
                    name_field_invalid: root.name_field_invalid;
                    indices_field_invalid: root.indices_field_invalid;
                    constraint_field_invalid: root.constraint_field_invalid;
                    keep_draft => { root.keep_draft(); }
                    confirm_discard_and_load => { root.confirm_discard_and_load(); }
                    reload_from_design => { root.reload_from_design(); }
                    dismiss_external_change => { root.dismiss_external_change(); }
                    save_form => { root.save_form(); }
                }

                if EditorModel.inspector_tab == 1: PreformTab {
                    unlocked: GuideModel.allows_preform_tab();
                    preform_pending <=> root.preform_pending;
                    yield_pending <=> root.yield_pending;
                }

                // --- Optimize -- see `optimize_available` above for the
                // zero-free-tiers case every freshly imported design starts in
                // (correct, not broken).
                if EditorModel.inspector_tab == 2: OptimizeTab {
                    unlocked: GuideModel.allows_advanced();
                    optimize_preview_checked <=> root.optimize_preview_checked;
                }

                // --- The design's OWN cut order, not only
                // ever the catalogue's original schedule -- built from
                // `Design::to_asc_schedule_from_solved`, the same conversion
                // "Export Edited .asc" already writes. Read-only: copying a
                // row/the whole table is not wired here (that lives behind
                // `LibraryModel`'s clipboard callbacks) -- Export Edited .asc
                // is the copyable form for now.
                if EditorModel.inspector_tab == 3 && root.advanced: ScheduleTab { }
                }
            }
                if EditorModel.inspector_tab == 4: HistoryTab {
                    width: 100%;
                    height: 100%;
                }
                GuideLockTip { locked: !root.tab_unlocked; }
            } // tab body wrapper

            // Button row pinned outside the scroll view above.
            if EditorModel.inspector_tab == 0: HorizontalLayout {
                spacing: 6px;
                TipButton {
                    text: root.concave_loaded
                        ? (root.loaded_tier_index < 0 ? "Add Concave Tier" : "Save Concave Tier")
                        : (root.loaded_tier_index < 0 ? "Add Tier" : "Save Tier");
                    hint: root.loaded_tier_index < 0
                        ? "Add the tier in the form to the design. It is one Undo step."
                        : "Write the changes in the form onto the selected tier. It is one Undo step; the table's mast and solve columns go stale until you Solve.";
                    // Save button gated on angle_field_invalid (also covers
                    // Rust-reported angle rejection). Other fields validated after save attempt.
                    enabled: root.concave_loaded
                        ? (!root.concave_angle_invalid && GuideModel.allows_tier_form() && GuideModel.allows_concave_tier())
                        : (!root.angle_field_invalid && GuideModel.allows_tier_form());
                    clicked => { root.save_form(); }
                }
                TipButton {
                    // Named "New Tier" -- identical
                    // to the command bar's "New Design..." button/menu item that
                    // discards the WHOLE design, although this one only clears
                    // the tier-edit form. "New Tier" (not "Clear") since it also
                    // arms the form for the next Add Tier, matching the command
                    // bar's own "+ Add Tier" affordance more than a plain reset.
                    text: "New Tier";
                    hint: "Clear the form for a new tier. The design is not changed.";
                    enabled: GuideModel.allows_tier_form();
                    clicked => {
                        // The flat form is what "New Tier" arms, even from the concave one.
                        EditorModel.inspector_concave_mode = false;
                        root.request_new();
                    }
                }
            }
        }
    }
}
