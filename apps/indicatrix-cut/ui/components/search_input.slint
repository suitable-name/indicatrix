import { Theme } from "../theme.slint";

// The text part of a search box: a frameless single-line input with a placeholder, for a
// search field that draws its own frame and magnifier (the header's library search, the
// manual's and the glossary's). The std-widgets `LineEdit` draws a frame of its own and is
// taller than these 28 px fields, so inside one it showed as a second, offset box.
export component SearchInput inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder-text;
    // Called on every change, with the new text (as `LineEdit.edited`).
    callback edited(string);

    // Puts the caret here (the Ctrl+F shortcuts). Not `focus()`: every element has that one
    // and it cannot be overridden.
    public function focus-input() {
        input.focus();
    }

    min-width: 0px;
    min-height: 20px;
    accessible-role: text-input;
    // A default only: every use names its field ("Search the Library").
    accessible-label: root.placeholder-text;
    accessible-value: root.text;
    accessible-placeholder-text: root.placeholder-text;

    if root.text == "": Text {
        width: 100%;
        height: 100%;
        text: root.placeholder-text;
        font-size: 12px;
        color: Theme.text-muted;
        vertical-alignment: center;
        overflow: elide;
    }

    input := TextInput {
        width: 100%;
        height: 100%;
        text <=> root.text;
        font-size: 12px;
        color: Theme.text-primary;
        selection-background-color: Theme.accent-cyan-surface;
        selection-foreground-color: Theme.text-primary;
        single-line: true;
        vertical-alignment: center;
        // The typing part is a control of its own for a screen reader and the harness; the
        // suffix keeps it apart from the box that carries the name.
        accessible-role: text-input;
        accessible-label: root.accessible-label + " Field";
        accessible-placeholder-text: root.placeholder-text;
        edited => { root.edited(self.text); }
    }
}
