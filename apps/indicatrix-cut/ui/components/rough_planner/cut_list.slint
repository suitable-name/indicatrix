import { Theme } from "../../theme.slint";
import { LineEdit, ComboBox } from "std-widgets.slint";
import { RoughPlanModel, RoughCutRow } from "../../models/rough_plan.slint";
import { RoughPill } from "fields.slint";
import { TipBox, FieldCaption } from "../tip_box.slint";

// Compact field for cut parameters that reports edits directly. The incoming
// `text` is pushed into the `LineEdit` again on every change: once the user has
// typed, the `LineEdit` no longer follows a plain binding, so without this a
// value pushed from Rust (undo, default setbacks, a shape-worker echo) would not
// show.
component CutParamField inherits VerticalLayout {
    in property <string> label;
    // One plain sentence: what the number means. The tooltip of the caption and the field.
    in property <string> hint;
    in property <string> text;
    in property <bool> editable: true;
    // The field of a cut that was just added takes the keyboard focus when it appears,
    // so the default value can be typed over at once.
    in property <bool> autofocus: false;
    callback edited(string);
    callback committed();
    // The field took keyboard focus: its owner selects the row.
    callback focused();
    // The field took the keyboard focus because its cut was just added.
    callback autofocused();

    // Set by a keystroke, cleared by the commit, so Enter followed by the focus
    // loss it causes reports one edit, not two.
    property <bool> dirty: false;

    horizontal-stretch: 1;
    spacing: 2px;

    init => {
        if root.autofocus {
            field.focus();
            field.select-all();
            root.autofocused();
            RoughPlanModel.focus_cut_row = -1;
        }
    }

    changed text => {
        field.text = root.text;
        root.dirty = false;
    }

    FieldCaption { text: root.label; hint: root.hint; font_size: 10px; }
    TipBox {
        hint: root.hint;
        field := LineEdit {
            min-width: 0px;
            text: root.text;
            enabled: root.editable;
            accessible-label: root.label;
            accessible-description: root.hint;
            edited(t) => {
                root.dirty = true;
                root.edited(t);
            }
            accepted => {
                if root.dirty {
                    root.dirty = false;
                    root.committed();
                }
            }
            changed has-focus => {
                if self.has-focus {
                    root.focused();
                } else if root.dirty {
                    root.dirty = false;
                    root.committed();
                }
            }
        }
    }
}

// The edge or corner picker of a cut row. The incoming `index` is pushed into the
// combo box again on every change, for the same reason as `CutParamField`.
component FaceCombo inherits VerticalLayout {
    in property <[string]> options;
    in property <int> index;
    in property <string> hint;
    in property <string> label;
    in property <bool> editable: true;
    callback picked(int);

    changed index => { combo.current-index = root.index; }

    TipBox {
        hint: root.hint;
        combo := ComboBox {
            min-width: 0px;
            model: root.options;
            current-index: root.index;
            enabled: root.editable;
            accessible-label: root.label;
            selected(value) => { root.picked(self.current-index); }
        }
    }
}

// The small delete button of a cut row: a 20 px square that takes Tab, Space and Enter, has a
// tooltip, and names the cut it deletes for a screen reader.
component CutDelete inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();

    width: 20px;
    height: 20px;
    border-radius: Theme.radius-sm;
    background: !root.enabled ? Theme.surface-disabled
        : (del_touch.has-hover ? Theme.danger-surface-hover : Theme.danger-surface);
    border-width: del_focus.has-focus ? 2px : 1px;
    border-color: !root.enabled ? Theme.border-subtle
        : (del_focus.has-focus ? Theme.accent-cyan-hover : Theme.danger-border);

    accessible-role: AccessibleRole.button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    property <string> tip: root.enabled ? root.label : "Not while a plan is running. Wait for it to finish, or cancel it.";

    Tooltip { text: @markdown("\{root.tip}"); }

    del_focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    Text {
        text: "\u{00D7}";
        font-size: 12px;
        font-weight: 700;
        color: root.enabled ? Theme.danger : Theme.text-disabled;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    del_touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: self.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// One cut row in the shape section
component CutRowItem inherits Rectangle {
    in property <RoughCutRow> cut;
    in property <int> index;
    in property <bool> is_selected;
    callback selected();
    callback remove();
    // The row was just added and is laid out: its window position and height, so the
    // scrolling list around it can bring it into view.
    callback revealed(length, length);

    // Editing a field of a row selects the row, as a click on it does.
    function select_row() {
        if RoughPlanModel.selected_cut != root.index {
            RoughPlanModel.selected_cut = root.index;
            RoughPlanModel.cut_selected(root.index);
        }
    }

    // Set when a field of this row takes focus because the row is new; the timer
    // reports the row's position once the layout has placed it.
    property <bool> reveal_pending: false;

    background: root.is_selected ? Theme.surface-raised : Theme.bg-card;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: root.is_selected ? Theme.accent-cyan : Theme.border-subtle;

    accessible-role: AccessibleRole.list-item;
    accessible-label: "Cut " + (root.index + 1) + ": " + root.cut.title;
    accessible-item-selectable: true;
    accessible-item-selected: root.is_selected;
    accessible-action-default => { root.selected(); }

    Timer {
        interval: 40ms;
        running: root.reveal_pending;
        triggered => {
            root.reveal_pending = false;
            root.revealed(root.absolute-position.y, root.height);
        }
    }

    // Declared first, so it sits under the fields and buttons and only receives
    // the clicks they do not handle.
    TouchArea {
        clicked => { root.selected(); }
    }

    VerticalLayout {
        padding: 6px;
        spacing: 4px;

        // Row header: title and delete button
        HorizontalLayout {
            spacing: 6px;
            alignment: center;

            Text {
                horizontal-stretch: 1;
                text: (root.index + 1) + ". " + root.cut.title;
                font-size: 11px;
                font-weight: 700;
                color: root.is_selected ? Theme.accent-cyan : Theme.text-primary;
                vertical-alignment: center;
                overflow: elide;
            }

            // Deleting edits the model, which a running plan is using.
            CutDelete {
                label: "Delete cut " + (root.index + 1) + ": " + root.cut.title;
                enabled: !RoughPlanModel.running;
                clicked => { root.remove(); }
            }
        }

        // A note on the cut itself (a vertical face ignores its azimuth)
        if root.cut.hint != "": Text {
            text: root.cut.hint;
            font-size: 11px;
            color: Theme.text-muted;
            wrap: word-wrap;
        }

        // Which edge or corner the cut sits on (faces have a direction instead)
        if root.cut.kind != 2: FaceCombo {
            label: root.cut.kind == 0 ? "Edge of the cut" : "Corner of the cut";
            hint: root.cut.kind == 0 ? "Which edge of the block this cut takes off." : "Which corner of the block this cut takes off.";
            options: root.cut.kind == 0 ? RoughPlanModel.edge_options : RoughPlanModel.corner_options;
            index: root.cut.face_index;
            editable: !RoughPlanModel.running;
            picked(i) => {
                RoughPlanModel.selected_cut = root.index;
                RoughPlanModel.cut_faces_changed(root.index, i);
            }
        }

        // Row fields depending on cut kind (0 edge, 1 corner, 2 face)
        if root.cut.kind == 0: HorizontalLayout {
            spacing: 6px;
            CutParamField {
                label: "Setback A (mm)";
                hint: "How far from the edge or corner the cut starts, along the first side, in millimetres.";
                autofocus: RoughPlanModel.focus_cut_row == root.index;
                autofocused => { root.reveal_pending = true; }
                text: root.cut.a;
                editable: !RoughPlanModel.running;
                edited(t) => { RoughPlanModel.cut_field_edited(root.index, 0, t); }
                committed => { RoughPlanModel.cut_field_committed(root.index); }
                focused => { root.select_row(); }
            }
            CutParamField {
                label: "Setback B (mm)";
                hint: "How far from the edge or corner the cut starts, along the second side, in millimetres.";
                text: root.cut.b;
                editable: !RoughPlanModel.running;
                edited(t) => { RoughPlanModel.cut_field_edited(root.index, 1, t); }
                committed => { RoughPlanModel.cut_field_committed(root.index); }
                focused => { root.select_row(); }
            }
        }

        if root.cut.kind == 1: HorizontalLayout {
            spacing: 6px;
            CutParamField {
                label: "Setback A (mm)";
                hint: "How far from the edge or corner the cut starts, along the first side, in millimetres.";
                autofocus: RoughPlanModel.focus_cut_row == root.index;
                autofocused => { root.reveal_pending = true; }
                text: root.cut.a;
                editable: !RoughPlanModel.running;
                edited(t) => { RoughPlanModel.cut_field_edited(root.index, 0, t); }
                committed => { RoughPlanModel.cut_field_committed(root.index); }
                focused => { root.select_row(); }
            }
            CutParamField {
                label: "Setback B (mm)";
                hint: "How far from the edge or corner the cut starts, along the second side, in millimetres.";
                text: root.cut.b;
                editable: !RoughPlanModel.running;
                edited(t) => { RoughPlanModel.cut_field_edited(root.index, 1, t); }
                committed => { RoughPlanModel.cut_field_committed(root.index); }
                focused => { root.select_row(); }
            }
            CutParamField {
                label: "Setback C (mm)";
                hint: "How far from the corner the cut starts, along the third side, in millimetres.";
                text: root.cut.c;
                editable: !RoughPlanModel.running;
                edited(t) => { RoughPlanModel.cut_field_edited(root.index, 2, t); }
                committed => { RoughPlanModel.cut_field_committed(root.index); }
                focused => { root.select_row(); }
            }
        }

        if root.cut.kind == 2: HorizontalLayout {
            spacing: 6px;
            CutParamField {
                label: "Azimuth (\u{00B0})";
                hint: "The compass direction the face looks toward, in degrees around the vertical axis. A vertical face ignores it.";
                autofocus: RoughPlanModel.focus_cut_row == root.index;
                autofocused => { root.reveal_pending = true; }
                text: root.cut.azimuth;
                editable: !RoughPlanModel.running;
                edited(t) => { RoughPlanModel.cut_field_edited(root.index, 3, t); }
                committed => { RoughPlanModel.cut_field_committed(root.index); }
                focused => { root.select_row(); }
            }
            CutParamField {
                label: "Elevation (\u{00B0})";
                hint: "How steeply the face tilts, in degrees: 0 is a vertical face, 90 a flat top.";
                text: root.cut.elevation;
                editable: !RoughPlanModel.running;
                edited(t) => { RoughPlanModel.cut_field_edited(root.index, 4, t); }
                committed => { RoughPlanModel.cut_field_committed(root.index); }
                focused => { root.select_row(); }
            }
            CutParamField {
                label: "Depth (mm)";
                hint: "How deep the face cuts into the rough, in millimetres.";
                text: root.cut.depth;
                editable: !RoughPlanModel.running;
                edited(t) => { RoughPlanModel.cut_field_edited(root.index, 5, t); }
                committed => { RoughPlanModel.cut_field_committed(root.index); }
                focused => { root.select_row(); }
            }
        }

        if root.cut.removed_text != "": Text {
            text: root.cut.removed_text;
            font-size: 10px;
            color: Theme.text-muted;
            wrap: word-wrap;
        }

        if root.cut.error != "": Text {
            text: root.cut.error;
            font-size: 10px;
            color: Theme.danger;
            wrap: word-wrap;
        }
    }
}

// Shape section: undo/redo, cut creation buttons, list of cut rows
export component CutList inherits VerticalLayout {
    // A cut row that was just added reports where it sits (window position, height)
    // once laid out; the scroll view that holds this list scrolls it into view.
    callback reveal_row(length, length);

    spacing: 8px;

    // Header with Undo / Redo
    HorizontalLayout {
        spacing: 6px;
        alignment: center;

        Text {
            horizontal-stretch: 1;
            text: "SHAPE";
            font-size: 11px;
            font-weight: 700;
            color: Theme.text-muted;
            vertical-alignment: center;
        }

        // Every model edit is locked while a plan runs (the plan works on a snapshot,
        // and the window keeps showing the model it is planning).
        RoughPill {
            text: "Undo";
            hint: RoughPlanModel.running ? "Not while a plan is running." : "Take back the last change to the shape. Ctrl+Z does the same.";
            enabled: RoughPlanModel.can_undo && !RoughPlanModel.running;
            clicked => { RoughPlanModel.undo_shape(); }
        }
        RoughPill {
            text: "Redo";
            hint: RoughPlanModel.running ? "Not while a plan is running." : "Do the change to the shape again that Undo took back. Ctrl+Y does the same.";
            enabled: RoughPlanModel.can_redo && !RoughPlanModel.running;
            clicked => { RoughPlanModel.redo_shape(); }
        }
    }

    // Add buttons
    HorizontalLayout {
        spacing: 4px;
        alignment: start;

        RoughPill {
            text: "+Edge";
            hint: RoughPlanModel.base_kind != 0 ? "Edge cuts need a block of rough."
                : (RoughPlanModel.running ? "Not while a plan is running." : "Add a cut that takes off one edge of the block.");
            enabled: RoughPlanModel.base_kind == 0 && !RoughPlanModel.running;
            clicked => { RoughPlanModel.add_cut(0); }
        }
        RoughPill {
            text: "+Corner";
            hint: RoughPlanModel.base_kind != 0 ? "Corner cuts need a block of rough."
                : (RoughPlanModel.running ? "Not while a plan is running." : "Add a cut that takes off one corner of the block.");
            enabled: RoughPlanModel.base_kind == 0 && !RoughPlanModel.running;
            clicked => { RoughPlanModel.add_cut(1); }
        }
        RoughPill {
            text: "+Face";
            hint: RoughPlanModel.running ? "Not while a plan is running." : "Add a flat cut through the rough, set by a direction, a tilt and a depth.";
            active: true;
            enabled: !RoughPlanModel.running;
            clicked => { RoughPlanModel.add_cut(2); }
        }
        RoughPill {
            text: "Face from view";
            hint: RoughPlanModel.running ? "Not while a plan is running."
                : (RoughPlanModel.view_mode != 0 && !RoughPlanModel.face_from_view_armed
                    ? "Show the Rough view first: a face is picked on the rough, not on a result."
                    : (RoughPlanModel.face_from_view_armed
                        ? "Stop picking a face in the view. Escape does the same."
                        : "Then click a face of the rough in the 3D view to add a cut along it."));
            active: RoughPlanModel.face_from_view_armed;
            // It picks a face of the rough in the model view; the result view shows
            // the stones instead. An armed pick can still be switched off there.
            enabled: !RoughPlanModel.running
                && (RoughPlanModel.view_mode == 0 || RoughPlanModel.face_from_view_armed);
            clicked => {
                RoughPlanModel.face_from_view_armed = !RoughPlanModel.face_from_view_armed;
            }
        }
    }

    if RoughPlanModel.base_kind != 0: Text {
        text: "Edge and corner cuts need a block";
        font-size: 10px;
        color: Theme.text-muted;
        wrap: word-wrap;
    }

    // Cut rows
    for cut[index] in RoughPlanModel.cuts: CutRowItem {
        cut: cut;
        index: index;
        is_selected: RoughPlanModel.selected_cut == index;
        selected => {
            RoughPlanModel.selected_cut = index;
            RoughPlanModel.cut_selected(index);
        }
        remove => { RoughPlanModel.remove_cut(index); }
        revealed(row_y, row_height) => { root.reveal_row(row_y, row_height); }
    }

    if RoughPlanModel.cuts.length == 0: Text {
        text: "No cuts yet. Cut edges or corners, or click faces in the 3D view.";
        font-size: 10px;
        color: Theme.text-muted;
        wrap: word-wrap;
    }
}
