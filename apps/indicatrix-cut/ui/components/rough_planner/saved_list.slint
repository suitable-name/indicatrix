import { Theme } from "../../theme.slint";
import { ScrollView, LineEdit } from "std-widgets.slint";
import { RoughPlanModel, SavedRoughPlanRow } from "../../models/rough_plan.slint";
import { RoughPill, BackChevron } from "fields.slint";
import { TipBox } from "../tip_box.slint";

// One saved plan row in the saved plans list
component SavedPlanCard inherits Rectangle {
    in property <SavedRoughPlanRow> plan;
    property <bool> renaming: false;
    property <string> new_name: root.plan.name;
    property <bool> confirming_delete: false;

    // The rename row closes when the list comes back with the change, not when the
    // button is pressed: a name Rust refuses leaves the row open beside the error.
    changed plan => { root.renaming = false; }

    background: Theme.bg-card;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Theme.border-subtle;

    VerticalLayout {
        padding: 8px;
        spacing: 6px;

        // Top line: Name (or rename field) and date
        if !root.renaming: HorizontalLayout {
            spacing: 6px;
            alignment: center;

            Text {
                horizontal-stretch: 1;
                text: root.plan.name;
                font-size: 12px;
                font-weight: 700;
                color: Theme.text-primary;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: AccessibleRole.text;
            }

            Text {
                text: root.plan.date;
                font-size: 10px;
                color: Theme.text-muted;
                vertical-alignment: center;
            }
        }

        // Inline renaming row
        if root.renaming: HorizontalLayout {
            spacing: 6px;
            alignment: center;

            TipBox {
                horizontal-stretch: 1;
                hint: "The new name of the plan. Enter keeps it.";
                LineEdit {
                    min-width: 0px;
                    text <=> root.new_name;
                    accessible-label: "New name of " + root.plan.name;
                    init => {
                        self.focus();
                        self.select-all();
                    }
                    accepted => { RoughPlanModel.rename_saved(root.plan.id, root.new_name); }
                }
            }

            RoughPill {
                text: "Save";
                hint: "Keep the new name. Enter does the same.";
                active: true;
                clicked => { RoughPlanModel.rename_saved(root.plan.id, root.new_name); }
            }

            RoughPill {
                text: "Cancel";
                hint: "Keep the old name.";
                clicked => {
                    root.new_name = root.plan.name;
                    root.renaming = false;
                }
            }
        }

        // Summary line (e.g. "Pebble · Aquamarine · 3 results")
        Text {
            text: root.plan.summary;
            font-size: 11px;
            color: Theme.text-secondary;
            overflow: elide;
        }

        // Actions: Open, Rename, Export, Delete
        HorizontalLayout {
            spacing: 6px;
            alignment: end;

            // Opening replaces the model and the results, which a running plan is using.
            if !root.confirming_delete: RoughPill {
                text: "Open";
                hint: RoughPlanModel.running ? "Not while a plan is running. Wait for it to finish, or cancel it."
                    : "Open this plan: its rough, cuts, settings and layouts replace the ones in the window.";
                active: true;
                enabled: !RoughPlanModel.running;
                clicked => { RoughPlanModel.open_saved(root.plan.id); }
            }

            if !root.confirming_delete && !root.renaming: RoughPill {
                text: "Rename";
                hint: "Give this plan another name.";
                clicked => {
                    root.new_name = root.plan.name;
                    root.renaming = true;
                }
            }

            if !root.confirming_delete: RoughPill {
                text: "Export";
                hint: "Save this plan as a file you can keep, send or import again later.";
                clicked => { RoughPlanModel.export_saved(root.plan.id); }
            }

            if !root.confirming_delete: RoughPill {
                text: "Delete";
                hint: "Delete this saved plan. You are asked to confirm first.";
                clicked => { root.confirming_delete = true; }
            }

            if root.confirming_delete: Text {
                text: "Delete plan?";
                font-size: 10px;
                color: Theme.danger;
                vertical-alignment: center;
            }

            if root.confirming_delete: RoughPill {
                text: "Yes, delete";
                hint: "Delete this saved plan for good.";
                clicked => {
                    RoughPlanModel.delete_saved(root.plan.id);
                    root.confirming_delete = false;
                }
            }

            if root.confirming_delete: RoughPill {
                text: "Cancel";
                hint: "Keep this plan.";
                clicked => { root.confirming_delete = false; }
            }
        }
    }
}

// Side list of saved plans replacing the results column
export component SavedList inherits VerticalLayout {
    spacing: 8px;

    // Header: Back button to results, title, and Import button
    HorizontalLayout {
        spacing: 8px;
        alignment: center;

        // Back to the results: a pill-shaped button with a Path chevron
        Rectangle {
            width: 72px;
            height: 20px;
            border-radius: 10px;
            border-width: back_focus.has-focus ? 2px : 1px;
            border-color: back_focus.has-focus ? Theme.accent-cyan-hover : Theme.border-control;
            background: back_touch.has-hover ? Theme.surface-control-hover : Theme.surface-control;

            accessible-role: AccessibleRole.button;
            accessible-label: "Back to the results";
            accessible-description: "Close the saved plans and show the results again.";
            accessible-action-default => { RoughPlanModel.saved_open = false; }

            Tooltip { text: @markdown("Close the saved plans and show the results again."); }

            back_focus := FocusScope {
                key-pressed(event) => {
                    if event.text == Key.Space || event.text == Key.Return {
                        RoughPlanModel.saved_open = false;
                        return accept;
                    }
                    return reject;
                }
            }

            HorizontalLayout {
                spacing: 5px;
                alignment: center;

                VerticalLayout {
                    alignment: center;
                    BackChevron {
                        stroke_color: back_touch.has-hover ? Theme.text-primary : Theme.text-secondary;
                    }
                }

                Text {
                    text: "Results";
                    font-size: 10px;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                }
            }

            back_touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { RoughPlanModel.saved_open = false; }
            }
        }

        Text {
            horizontal-stretch: 1;
            text: "Saved Plans";
            font-size: 13px;
            font-weight: 700;
            color: Theme.text-primary;
            vertical-alignment: center;
        }

        RoughPill {
            text: "Import\u{2026}";
            hint: RoughPlanModel.running ? "Not while a plan is running. Wait for it to finish, or cancel it."
                : "Load a plan from a file that Export wrote, and add it to this list.";
            enabled: !RoughPlanModel.running;
            clicked => { RoughPlanModel.import_saved(); }
        }
    }

    // The latest note (a plan opened, renamed, exported) and the latest error
    if RoughPlanModel.status_text != "": Text {
        text: RoughPlanModel.status_text;
        font-size: 11px;
        color: RoughPlanModel.status_level == 1 ? Theme.accent-amber : Theme.text-secondary;
        wrap: word-wrap;
    }

    if RoughPlanModel.error_text != "": Text {
        text: RoughPlanModel.error_text;
        font-size: 11px;
        color: Theme.danger;
        wrap: word-wrap;
    }

    if RoughPlanModel.saved_plans.length == 0: Rectangle {
        vertical-stretch: 1;
        VerticalLayout {
            alignment: center;
            spacing: 6px;
            Text {
                text: "No saved plans yet.";
                font-size: 12px;
                color: Theme.text-muted;
                horizontal-alignment: center;
            }
            Text {
                text: "Save plans from the results column to see them here, or click Import to load a file.";
                font-size: 11px;
                color: Theme.text-secondary;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }

    if RoughPlanModel.saved_plans.length > 0: ScrollView {
        vertical-stretch: 1;

        VerticalLayout {
            alignment: start;
            spacing: 6px;

            for plan in RoughPlanModel.saved_plans: SavedPlanCard {
                plan: plan;
            }
        }
    }
}
