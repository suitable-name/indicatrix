import { Slider, ComboBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { PerformanceFilterRow } from "../types.slint";
import { LibraryModel } from "../models/library.slint";
import { RemoteWorkerModel } from "../models/remote_worker.slint";
import { GuideModel } from "../models/guide.slint";
import { HelpTopics } from "../models/help.slint";
import { HelpButton } from "help_button.slint";
import { TipButton } from "compact_controls.slint";
import { ToggleRow } from "toggle_switch.slint";
import { ChipToggle } from "chip_toggle.slint";
import { TouchButton } from "touch_button.slint";

// One attribute's min/max range control: a label + current "min – max" readout above
// two stacked sliders (Slint has no built-in dual-handle slider, so two single-handle
// ones -- following the existing single-value-slider convention from
// `material_editor_dialog.slint`/`settings_dialog.slint`). Each slider's own `minimum`/
// `maximum` is the *data* bound, so its whole travel communicates the real range
// present in the catalogue rather than an arbitrary fixed scale. Dragging one handle
// past the other pushes the other along, so `value_min` can never exceed `value_max`.
//
// `hint` says in plain words what the attribute is; it is the label's tooltip. Each slider
// has its own screen-reader name (the label plus "lowest" or "highest").
component RangeRow inherits VerticalLayout {
    in property <string> label: "";
    in property <string> hint: "";
    in property <image> icon;
    in property <color> accent: Theme.accent-cyan;
    in property <float> bound_min: 0.0;
    in property <float> bound_max: 1.0;
    in-out property <float> value_min: 0.0;
    in-out property <float> value_max: 1.0;
    // Facet counts display as whole numbers; every other attribute rounds to 2dp.
    in property <bool> is_integer: false;
    callback changed();

    spacing: 5px;

    Rectangle {
        height: label_row.preferred-height;
        accessible-role: AccessibleRole.text;
        accessible-label: root.label + " from "
            + (root.is_integer ? Math.round(root.value_min) : Math.round(root.value_min * 100) / 100)
            + " to "
            + (root.is_integer ? Math.round(root.value_max) : Math.round(root.value_max * 100) / 100);
        accessible-description: root.hint;
        Tooltip { text: @markdown("\{root.hint} Drag either handle to narrow the range. The ends of the bar are the lowest and highest values in your library."); }
        label_row := HorizontalLayout {
            spacing: 6px;
            alignment: space-between;

            HorizontalLayout {
                spacing: 5px;
                Image { source: root.icon; colorize: root.accent; width: 11px; height: 11px; vertical-alignment: center; }
                Text { text: root.label; font-size: 11px; font-weight: 600; color: Theme.text-muted; vertical-alignment: center; }
            }

            Text {
                text: (root.is_integer ? Math.round(root.value_min) : Math.round(root.value_min * 100) / 100)
                    + " – "
                    + (root.is_integer ? Math.round(root.value_max) : Math.round(root.value_max * 100) / 100);
                font-size: 11px;
                font-weight: 700;
                color: root.accent;
            }
        }
    }

    Slider {
        minimum: root.bound_min;
        maximum: root.bound_max;
        value <=> root.value_min;
        accessible-label: root.label + ", lowest value to keep";
        changed(v) => {
            if v > root.value_max {
                root.value_max = v;
            }
            root.changed();
        }
    }
    Slider {
        minimum: root.bound_min;
        maximum: root.bound_max;
        value <=> root.value_max;
        accessible-label: root.label + ", highest value to keep";
        changed(v) => {
            if v < root.value_min {
                root.value_min = v;
            }
            root.changed();
        }
    }
}

// Floating filter panel. Inherits `PopupWindow`, not `Rectangle`: a `PopupWindow`
// renders in Slint's dedicated popup layer, always on top of the rest of the window
// regardless of sibling declaration order, and (like every popup/dialog card in this
// app) needs an explicit content-driven `height` since plain `Rectangle`s default to
// filling their parent's size when no height is set. See `header.slint`'s
// `filter_popup` instantiation for the show()/close() wiring this requires -- a
// `PopupWindow` cannot be used with an `if condition: FilterPanel { ... }` pattern
// (that's a compile error: "PopupWindow cannot be directly repeated or
// conditional").
//
// Keyboard: the panel takes the focus when it opens, Tab walks every control, Escape closes
// it. The "?" in the header opens the manual page on the filters. The Simple interface leaves
// out the two buttons that start whole-library work ("Compute missing tilt curves" and the
// "Regenerate for filtered set" section).
export component FilterPanel inherits PopupWindow {
    // Add-performance-filter form local draft state
    property <int> perf_draft_metric: 2; // Windowing
    property <int> perf_draft_bound: 0; // At Most
    property <float> perf_draft_threshold: 20.0;
    property <float> perf_draft_radius: 45.0;
    property <int> perf_draft_aggregate: 0; // Worst

    pure function perf_metric_label(idx: int) -> string {
        return idx == 0 ? "Brilliance" : idx == 1 ? "Extinction" : "Windowing";
    }
    pure function perf_bound_label(idx: int) -> string {
        return idx == 0 ? "at most" : "at least";
    }
    pure function perf_aggregate_label(idx: int) -> string {
        return idx == 0 ? "worst" : "mean";
    }

    close-policy: PopupClosePolicy.no-auto-close;

    function reset() {
        LibraryModel.ri_filter_min = LibraryModel.ri_bounds_min;
        LibraryModel.ri_filter_max = LibraryModel.ri_bounds_max;
        LibraryModel.lw_filter_min = LibraryModel.lw_bounds_min;
        LibraryModel.lw_filter_max = LibraryModel.lw_bounds_max;
        LibraryModel.volume_filter_min = LibraryModel.volume_bounds_min;
        LibraryModel.volume_filter_max = LibraryModel.volume_bounds_max;
        LibraryModel.facets_filter_min = LibraryModel.facets_bounds_min;
        LibraryModel.facets_filter_max = LibraryModel.facets_bounds_max;
        LibraryModel.ri_tolerance_enabled = false;
        LibraryModel.ri_tolerance_center = LibraryModel.ri_material_default;
        LibraryModel.ri_tolerance_value = 0.02;
        LibraryModel.show_ignored = false;
        LibraryModel.local_only_filter = false;
        LibraryModel.performance_filters_clear();
        LibraryModel.filters_changed();
    }

    // "N of M matching designs shown"/"N designs match" --
    // `LibraryModel.matched_count` is the real, uncapped match count for the active
    // search/filters; `diagram_list.length` is the shown page, capped at
    // `SEARCH_RESULT_CAP` (1000). Comparing either against `total_count` (the
    // whole catalogue) instead would be wrong whenever any filter -- or just a
    // catalogue over 1000 rows -- is in play.
    pure function match_summary() -> string {
        return LibraryModel.diagram_list.length < LibraryModel.matched_count
            ? LibraryModel.diagram_list.length + " of " + LibraryModel.matched_count + " matching designs shown"
            : LibraryModel.matched_count + " design" + (LibraryModel.matched_count == 1 ? "" : "s") + " match";
    }
    width: 360px;
    // Content-driven height: matches whatever `content` (the padded VerticalLayout
    // below) actually needs, instead of defaulting to the height of whatever this
    // popup happens to be anchored to.
    height: content.preferred-height;

    Rectangle {
        background: Theme.popup-surface;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: Theme.border-dialog;
        drop-shadow-blur: 24px;
        drop-shadow-color: Theme.modal-shadow;
        drop-shadow-offset-y: 6px;
        accessible-role: AccessibleRole.groupbox;
        accessible-label: "Advanced filters";

        // Escape closes the panel from the keyboard; the panel takes the focus as it opens.
        panel_focus := FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.close();
                    return accept;
                }
                reject
            }

        content := VerticalLayout {
        padding: 16px;
        spacing: 14px;

        // Header with Title, the manual page and the Close button
        HorizontalLayout {
            alignment: space-between;

            HorizontalLayout {
                spacing: 8px;
                Image { source: @image-url("../icons/ruler.svg"); colorize: Theme.accent-cyan; width: 15px; height: 15px; vertical-alignment: center; }
                Text { text: "Advanced Filters"; font-size: 13px; font-weight: 700; color: Theme.text-primary; vertical-alignment: center; }
            }

            HorizontalLayout {
                spacing: 6px;
                VerticalLayout {
                    alignment: center;
                    HelpButton {
                        topic: HelpTopics.filters;
                        hint: "Open the manual page on the advanced filters";
                    }
                }
                Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: 12px;
                    background: close_btn.has_hover ? Theme.bg-card-hover : transparent;

                    Text {
                        text: "×";
                        font-size: 16px;
                        color: Theme.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    close_btn := TouchButton {
                        label: "Close the filters";
                        hint: "Close this panel (Esc). The filters you set stay on.";
                        ring_radius: 12px;
                        clicked => { root.close(); }
                    }
                }
            }
        }

        Text {
            text: root.match_summary();
            font-size: 11px;
            color: LibraryModel.diagram_list.length == 0 ? Theme.accent-ruby : Theme.text-muted;
            accessible-role: AccessibleRole.text;
        }

        RangeRow {
            label: "Refractive Index";
            hint: "Refractive index (RI): how strongly the stone bends light. See the glossary.";
            icon: @image-url("../icons/gem.svg");
            accent: Theme.accent-cyan;
            bound_min: LibraryModel.ri_bounds_min;
            bound_max: LibraryModel.ri_bounds_max;
            value_min <=> LibraryModel.ri_filter_min;
            value_max <=> LibraryModel.ri_filter_max;
            changed => { LibraryModel.filters_changed(); }
        }

        RangeRow {
            label: "L/W Ratio";
            hint: "Length divided by width: 1.0 is round or square, 1.5 is a long oval.";
            icon: @image-url("../icons/ruler.svg");
            accent: Theme.accent-purple;
            bound_min: LibraryModel.lw_bounds_min;
            bound_max: LibraryModel.lw_bounds_max;
            value_min <=> LibraryModel.lw_filter_min;
            value_max <=> LibraryModel.lw_filter_max;
            changed => { LibraryModel.filters_changed(); }
        }

        RangeRow {
            label: "Volume (vol/w³)";
            hint: "Volume divided by width cubed: how much stone there is for its width. A bigger number is a deeper, heavier cut.";
            icon: @image-url("../icons/bar-chart.svg");
            accent: Theme.accent-emerald;
            bound_min: LibraryModel.volume_bounds_min;
            bound_max: LibraryModel.volume_bounds_max;
            value_min <=> LibraryModel.volume_filter_min;
            value_max <=> LibraryModel.volume_filter_max;
            changed => { LibraryModel.filters_changed(); }
        }

        RangeRow {
            label: "Facet Count";
            hint: "How many facets the finished stone has.";
            icon: @image-url("../icons/diamond.svg");
            accent: Theme.accent-amber;
            bound_min: LibraryModel.facets_bounds_min;
            bound_max: LibraryModel.facets_bounds_max;
            value_min <=> LibraryModel.facets_filter_min;
            value_max <=> LibraryModel.facets_filter_max;
            is_integer: true;
            changed => { LibraryModel.filters_changed(); }
        }

        Rectangle { height: 1px; background: Theme.border-dialog; }

        // --- RI CENTRE + TOLERANCE FILTER ---
        // A second, independent RI predicate alongside the min/max `RangeRow` above --
        // see `RangeFilter::ri_tolerance`'s own doc comment for why the two compose by
        // intersection rather than one replacing the other.
        VerticalLayout {
            spacing: 5px;

            ToggleRow {
                text: "RI Match (current material)";
                hint: "Find designs whose refractive index is close to one value, for example the material you are cutting. It works together with the range above.";
                checked: LibraryModel.ri_tolerance_enabled;
                label_color: Theme.accent-emerald;
                toggled => {
                    LibraryModel.ri_tolerance_enabled = !LibraryModel.ri_tolerance_enabled;
                    LibraryModel.filters_changed();
                }
            }

            if LibraryModel.ri_tolerance_enabled: VerticalLayout {
                spacing: 4px;
                HorizontalLayout {
                    spacing: 6px;
                    alignment: space-between;
                    Text {
                        text: "Centre " + (Math.round(LibraryModel.ri_tolerance_center * 1000) / 1000)
                            + " \u{b1} " + (Math.round(LibraryModel.ri_tolerance_value * 1000) / 1000);
                        font-size: 11px;
                        font-weight: 700;
                        color: Theme.accent-emerald;
                        accessible-role: AccessibleRole.text;
                    }
                    Rectangle {
                        width: use_current_txt.preferred-width + 10px;
                        height: 20px;
                        border-radius: 3px;
                        background: use_current_touch.has_hover ? Theme.bg-card-hover : transparent;
                        border-width: 1px;
                        border-color: Theme.border-subtle;
                        use_current_txt := Text {
                            text: "Use current material";
                            font-size: 9px;
                            color: Theme.text-secondary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        use_current_touch := TouchButton {
                            label: "Use current material";
                            hint: "Set the centre to the refractive index of the material the viewport is showing.";
                            ring_radius: 3px;
                            clicked => {
                                LibraryModel.ri_tolerance_center = LibraryModel.ri_material_default;
                                LibraryModel.filters_changed();
                            }
                        }
                    }
                }
                Text { text: "Centre"; font-size: 9px; color: Theme.text-muted; }
                Slider {
                    minimum: LibraryModel.ri_bounds_min;
                    maximum: LibraryModel.ri_bounds_max;
                    value <=> LibraryModel.ri_tolerance_center;
                    accessible-label: "RI match centre";
                    changed => { LibraryModel.filters_changed(); }
                }
                Text { text: "Tolerance (\u{b1})"; font-size: 9px; color: Theme.text-muted; }
                Slider {
                    minimum: 0.001;
                    maximum: (LibraryModel.ri_bounds_max - LibraryModel.ri_bounds_min) / 2;
                    value <=> LibraryModel.ri_tolerance_value;
                    accessible-label: "RI match tolerance, plus or minus";
                    changed => { LibraryModel.filters_changed(); }
                }
            }
        }

        Rectangle { height: 1px; background: Theme.border-dialog; }

        // --- SHOW IGNORED DESIGNS TOGGLE ---
        ToggleRow {
            text: "Show ignored designs";
            hint: "Include the designs you marked Ignored. They show dimmed, with an amber border.";
            checked: LibraryModel.show_ignored;
            toggled => {
                LibraryModel.show_ignored = !LibraryModel.show_ignored;
                LibraryModel.filters_changed();
            }
        }

        Rectangle { height: 1px; background: Theme.border-dialog; }

        // --- "MY DESIGNS" TOGGLE ---
        // Restricts the catalogue to the cutter's own locally-imported designs,
        // distinguishing them from the wider scraped corpus -- same toggle-switch
        // styling and `filters_changed()` wiring as "Show ignored designs" above.
        //
        // A remote worker's search reply has no local-only concept at all (there
        // is no local import to distinguish from), so this toggle is greyed out
        // and refuses clicks while `RemoteWorkerModel.library_is_remote`.
        ToggleRow {
            text: "My designs only";
            hint: RemoteWorkerModel.library_is_remote
                ? "\"My designs\" applies to the library on this computer only."
                : "Show only the designs you imported yourself, not the wider catalogue.";
            checked: LibraryModel.local_only_filter;
            enabled: !RemoteWorkerModel.library_is_remote;
            toggled => {
                LibraryModel.local_only_filter = !LibraryModel.local_only_filter;
                LibraryModel.filters_changed();
            }
        }

        Rectangle { height: 1px; background: Theme.border-dialog; }

        // --- TAG CHIP FILTER ---
        // A flat tag set, deliberately not folders/collections -- see
        // `indicatrix_vault::db::sqlite::Database::migrate_tag_tables`'s doc comment.
        // Lives in this panel rather than header.slint because it composes with
        // every other filter here (range sliders, "My designs", tilt performance)
        // through the same AND-together `RangeFilter`-adjacent predicate, not with
        // the header's search/sort/import controls. Clicking the active chip again
        // clears the restriction (`active_tag_filter_name = ""`); at most one tag
        // can be the active filter at a time, matching the shape/gear dropdowns'
        // own "one active choice, or All" convention rather than a multi-select
        // set. Identified by NAME, not id -- see `gui::library::diagram_list::
        // sync_tag_vocabulary_to_ui`'s own doc comment for why the Slint side never
        // handles a tag id directly.
        // `gui::library::search::refresh_diagram_list_remote` sends the active
        // chip's name on the wire (`LibraryRequest::Search::tag_filter`) and
        // `apps/indicatrix-worker::serve::library` resolves and applies it against
        // its own catalogue, so a remote search honours the chip exactly like a
        // local one, and this control stays enabled in remote mode.
        VerticalLayout {
            spacing: 6px;
            visible: LibraryModel.all_tags.length > 0;
            Text { text: "Tags"; font-size: 11px; font-weight: 600; color: Theme.text-muted; }
            // A plain scrollable row, not a wrapping grid -- matches the shape/
            // Ignored/Mine badge row's own non-wrapping convention in
            // diagram_list.slint, and this panel is a fixed-width sidebar where a
            // wrapping chip grid would need a more complex height-negotiating
            // container than Slint's fixed layouts give for free.
            Flickable {
                height: 28px;
                content-width: tag_row.preferred-width;
                tag_row := HorizontalLayout {
                    spacing: 4px;
                    for tag_name[idx] in LibraryModel.all_tags: ChipToggle {
                        text: tag_name;
                        hint: LibraryModel.active_tag_filter_name == tag_name
                            ? "Stop showing only designs tagged " + tag_name + "."
                            : "Show only designs tagged " + tag_name + ". Click it again to stop.";
                        active: LibraryModel.active_tag_filter_name == tag_name;
                        height: 24px;
                        width: self.preferred-width;
                        toggled => {
                            LibraryModel.active_tag_filter_name = LibraryModel.active_tag_filter_name == tag_name ? "" : tag_name;
                            LibraryModel.filters_changed();
                        }
                    }
                }
            }
        }

        Rectangle { height: 1px; background: Theme.border-dialog; }

        // --- TILT-PERFORMANCE SEARCH FILTERS ---
        VerticalLayout {
            spacing: 6px;

            Rectangle {
                height: tilt_perf_header.preferred-height;
                accessible-role: AccessibleRole.text;
                accessible-label: "Tilt performance filters";
                accessible-description: "Keep designs by how they look when tilted, for example windowing at most 20 percent.";
                Tooltip { text: @markdown("Keep designs by how bright, dark or see-through they look when tilted, for example \"windowing at most 20 %, worst case within ±45° of face-up\". The figures come from each design's tilt curves. See the glossary."); }
                tilt_perf_header := HorizontalLayout {
                    spacing: 5px;
                    Image { source: @image-url("../icons/bar-chart.svg"); colorize: Theme.accent-purple; width: 11px; height: 11px; vertical-alignment: center; }
                    Text { text: "Tilt Performance"; font-size: 11px; font-weight: 600; color: Theme.text-muted; vertical-alignment: center; }
                }
            }

            for row[idx] in LibraryModel.performance_filters: Rectangle {
                background: Theme.surface-sunken;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.border-dialog;
                HorizontalLayout {
                    padding: 6px;
                    alignment: space-between;
                    Text {
                        text: root.perf_metric_label(row.metric_index) + " " + root.perf_bound_label(row.bound_index)
                            + " " + (Math.round(row.threshold_pct * 10) / 10) + "% (" + root.perf_aggregate_label(row.aggregate_index)
                            + ", \u{b1}" + (Math.round(row.tilt_radius_deg * 10) / 10) + "\u{b0})";
                        font-size: 10px;
                        color: Theme.text-secondary;
                        wrap: word-wrap;
                        accessible-role: AccessibleRole.text;
                    }
                    Rectangle {
                        width: 20px;
                        height: 20px;
                        border-radius: 4px;
                        background: perf_remove_touch.has_hover ? Theme.danger-surface-hover : transparent;
                        Text { text: "×"; font-size: 12px; color: Theme.danger; horizontal-alignment: center; vertical-alignment: center; }
                        perf_remove_touch := TouchButton {
                            label: "Remove this tilt filter: " + root.perf_metric_label(row.metric_index) + " " + root.perf_bound_label(row.bound_index) + " " + (Math.round(row.threshold_pct * 10) / 10) + " percent";
                            hint: "Remove this filter.";
                            ring_radius: 4px;
                            clicked => {
                                LibraryModel.performance_filter_remove(idx);
                                LibraryModel.filters_changed();
                            }
                        }
                    }
                }
            }

            // Excluded-for-missing-curves notice -- these designs must never be
            // silently hidden, so this is shown whenever a performance filter is
            // actually active and it excluded at least one design this way. The button that
            // computes the missing curves is advanced; the Simple interface says where to find
            // it instead.
            if LibraryModel.performance_filters.length > 0 && LibraryModel.performance_excluded_count > 0: Rectangle {
                background: Theme.surface-warning;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.accent-amber;
                VerticalLayout {
                    padding: 6px;
                    spacing: 4px;
                    Text {
                        text: LibraryModel.performance_excluded_count + (LibraryModel.performance_excluded_count == 1 ? " design has" : " designs have")
                            + " no computed tilt-performance curves, so they can't be tested against these filters and are excluded."
                            + (GuideModel.shows_advanced() ? "" : " Switch to Advanced to compute them.");
                        font-size: 10px;
                        color: Theme.accent-amber;
                        wrap: word-wrap;
                        accessible-role: AccessibleRole.text;
                    }
                    if GuideModel.shows_advanced(): Rectangle {
                        height: 22px;
                        border-radius: 3px;
                        background: compute_now_touch.has_hover ? Theme.bg-card-hover : transparent;
                        border-width: 1px;
                        border-color: Theme.accent-amber;
                        Text {
                            text: "Compute missing tilt curves";
                            font-size: 9px;
                            font-weight: 600;
                            color: Theme.accent-amber;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        compute_now_touch := TouchButton {
                            label: "Compute missing tilt curves";
                            hint: "Work out the tilt curves of every design that has none yet, in the background. This can take a while for a large library.";
                            ring_radius: 3px;
                            clicked => { root.close(); LibraryModel.compute_missing_tilt_curves(); }
                        }
                    }
                }
            }

            // Add-filter form: metric x bound x threshold% x tilt radius x aggregate,
            // committed as one new row via `performance_filter_add` -- see this
            // component's own `perf_draft_*` doc comment.
            VerticalLayout {
                spacing: 4px;
                HorizontalLayout {
                    spacing: 4px;
                    ComboBox {
                        model: ["Brilliance", "Extinction", "Windowing"];
                        current-index <=> root.perf_draft_metric;
                        accessible-label: "Tilt figure";
                        accessible-description: "Brilliance is the light returned, extinction the dark patches, windowing the see-through patches.";
                    }
                    ComboBox {
                        model: ["at most", "at least"];
                        current-index <=> root.perf_draft_bound;
                        accessible-label: "At most or at least";
                    }
                }
                Text { text: "Threshold: " + (Math.round(root.perf_draft_threshold * 10) / 10) + "%"; font-size: 9px; color: Theme.text-muted; }
                Slider {
                    minimum: 0;
                    maximum: 100;
                    value <=> root.perf_draft_threshold;
                    accessible-label: "Threshold in percent";
                }
                Text { text: "Tilt radius: \u{b1}" + (Math.round(root.perf_draft_radius * 10) / 10) + "\u{b0}"; font-size: 9px; color: Theme.text-muted; }
                Slider {
                    minimum: 0;
                    maximum: 90;
                    value <=> root.perf_draft_radius;
                    accessible-label: "Tilt radius in degrees";
                }
                ComboBox {
                    model: ["worst", "mean"];
                    current-index <=> root.perf_draft_aggregate;
                    accessible-label: "Worst case or mean";
                    accessible-description: "Judge the worst tilt inside the radius, or the average of all of them.";
                }
                TipButton {
                    text: "+ Add Filter";
                    reader_label: "Add the tilt filter";
                    hint: "Add the filter described above, for example windowing at most 20 percent, worst case within 45 degrees of face-up.";
                    clicked => {
                        LibraryModel.performance_filter_add({
                            metric_index: root.perf_draft_metric,
                            bound_index: root.perf_draft_bound,
                            threshold_pct: root.perf_draft_threshold,
                            tilt_radius_deg: root.perf_draft_radius,
                            aggregate_index: root.perf_draft_aggregate,
                        });
                        LibraryModel.filters_changed();
                        // Reset the draft to its defaults for the NEXT addition -- see
                        // this component's own `perf_draft_*` doc comment.
                        root.perf_draft_metric = 2;
                        root.perf_draft_bound = 0;
                        root.perf_draft_threshold = 20.0;
                        root.perf_draft_radius = 45.0;
                        root.perf_draft_aggregate = 0;
                    }
                }
            }
        }

        TipButton {
            text: "Reset Filters";
            hint: "Put every filter back to its full range and turn the switches off, so the whole library shows again.";
            icon: @image-url("../icons/reset.svg");
            clicked => { root.reset(); }
        }

        // --- REGENERATE FOR THE CURRENT FILTERED SET ---
        // Runs the same catalogue-wide preview/tilt-curve batches every other
        // trigger of them uses (`gui::batch::preview`/`gui::batch::tilt`'s own
        // confirm/progress/cancel dialog), but scoped to whatever this panel's
        // search/filters currently match rather than the whole catalogue --
        // useful right after a renderer or material change, to refresh only the
        // designs currently in view. Advanced: the Simple interface leaves it out.
        if GuideModel.shows_advanced(): Rectangle { height: 1px; background: Theme.border-dialog; }

        if GuideModel.shows_advanced(): VerticalLayout {
            spacing: 6px;
            Text { text: "Regenerate for filtered set"; font-size: 11px; font-weight: 600; color: Theme.text-muted; }
            TipButton {
                text: "Regenerate Previews";
                hint: "Draw the front and top pictures again for the designs the filters show now. Useful after a change to the renderer or a material.";
                icon: @image-url("../icons/gem.svg");
                clicked => { LibraryModel.regenerate_previews_for_filtered_set(); }
            }
            TipButton {
                text: "Regenerate Tilt Curves";
                hint: "Work out the tilt curves again for the designs the filters show now. See the glossary.";
                icon: @image-url("../icons/bar-chart.svg");
                clicked => { LibraryModel.regenerate_tilt_curves_for_filtered_set(); }
            }
        }
        }
        }
    }
}
