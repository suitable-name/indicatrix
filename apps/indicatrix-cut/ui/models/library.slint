import { DiagramItem, PerformanceFilterRow, PreviewThumbnails, AngleItem, FileItem, DiagramDetailData } from "../types.slint";

export global LibraryModel {
    in-out property <string> search_text: "";
    in property <[string]> shape_options: ["All Shapes"];
    in-out property <int> selected_shape_index: 0;
    in property <[string]> gear_options: ["All Gears"];
    in-out property <int> selected_gear_index: 0;
    in property <string> status_message: "Database ready.";

    in property <float> ri_bounds_min: 1.0;
    in property <float> ri_bounds_max: 3.0;
    in-out property <float> ri_filter_min: 1.0;
    in-out property <float> ri_filter_max: 3.0;
    in property <float> lw_bounds_min: 1.0;
    in property <float> lw_bounds_max: 3.0;
    in-out property <float> lw_filter_min: 1.0;
    in-out property <float> lw_filter_max: 3.0;
    in property <float> volume_bounds_min: 0.0;
    in property <float> volume_bounds_max: 1.0;
    in-out property <float> volume_filter_min: 0.0;
    in-out property <float> volume_filter_max: 1.0;
    in property <float> facets_bounds_min: 0.0;
    in property <float> facets_bounds_max: 200.0;
    in-out property <float> facets_filter_min: 0.0;
    in-out property <float> facets_filter_max: 200.0;

    in property <float> ri_material_default: 2.417;
    in-out property <bool> ri_tolerance_enabled: false;
    in-out property <float> ri_tolerance_center: 2.417;
    in-out property <float> ri_tolerance_value: 0.02;

    in-out property <bool> show_ignored: false;

    // "My designs" toggle (`filter_panel.slint`) -- restricts the catalogue to the
    // cutter's own locally-imported designs (CAD audit item 189). Setting this and
    // calling `filters_changed()` is exactly how `show_ignored` above already drives a
    // re-search; see `gui::library::search::read_local_only`.
    in-out property <bool> local_only_filter: false;

    // Sort selector (`header.slint`'s toolbar) -- index<->`SortOrder` mapping happens
    // once, in Rust, at `gui::library::search::read_sort_order` (CAD audit item 190's
    // sort half): 0 = catalogue order, 1 = title, 2 = newest, 3 = recently edited.
    in-out property <int> sort_order_index: 0;

    // CAD audit item 190's tag chip filter. `all_tags` is the whole vocabulary,
    // refreshed by `sync_tag_vocabulary_to_ui`; `active_tag_filter_name` is the one
    // chip currently narrowing the list ("" for none). Tags are addressed by NAME
    // rather than id here because the Slint side never sees ids, and a name that no
    // longer resolves is a silent no-op on the Rust side rather than an error.
    in property <[string]> all_tags: [];
    in-out property <string> active_tag_filter_name: "";
    callback add_tag_to_entry(int, string);
    callback remove_tag_from_entry(int, string);

    // CAD audit item 187: the ids a batch import just created, so the list can
    // narrow to "show these N". Set BEFORE the refresh the import triggers, so that
    // refresh already applies it -- setting it afterwards raced the async reload.
    // Cleared the moment the cutter makes any real search or filter change.
    in-out property <[int]> recent_import_filter: [];

    // CAD audit item 98/197: keep the import popup open on completion instead of
    // auto-closing into a 3.5s toast, when the import either replaced an existing
    // row by filename or had per-file failures -- the two cases whose report is
    // worth reading.
    in property <bool> import_should_stay_open: false;

    in property <[PerformanceFilterRow]> performance_filters: [];
    callback performance_filter_add(PerformanceFilterRow);
    callback performance_filter_remove(int);
    callback performance_filters_clear();

    in property <int> performance_excluded_count: 0;
    callback compute_missing_tilt_curves();

    in property <bool> is_busy: false;
    in property <int> selected_entry_id: -1;

    in property <[DiagramItem]> diagram_list: [];
    in property <int> total_count: 0;
    // The real, uncapped count of designs matching the active search/filters --
    // distinct from `total_count` (the whole catalogue) and `diagram_list.length`
    // (capped at `SEARCH_RESULT_CAP`, currently 1000). Fixes "N of M designs match"
    // comparing the shown page against the whole catalogue instead of the actual match
    // count (CAD audit item 193). See `gui::library::search::FetchedDiagramList::matched_count`.
    in property <int> matched_count: 0;
    in property <DiagramDetailData> current_detail;

    pure callback get_preview_thumbnails(int, int) -> PreviewThumbnails;
    in-out property <int> preview_cache_version: 0;
    callback generate_previews_for_entry(int);
    callback toggle_ignored(int);
    callback compute_tilt_curves_for_entry(int);

    in property <[string]> shape_picker_options: [];
    in property <int> shape_picker_current_index: -1;

    in-out property <bool> metadata_editor_open: false;

    in property <[AngleItem]> current_angles: [];
    in property <[FileItem]> current_files: [];

    in-out property <bool> panel_collapsed: false;
    callback panel_collapsed_changed(bool);

    in property <string> import_result_text: "";
    in property <int> import_done: 0;
    in property <int> import_total: 0;
    in property <float> import_progress: 0.0;

    callback search_changed(string);
    callback filter_shape_changed(string);
    callback filter_gear_changed(string);
    callback filters_changed();
    callback select_diagram(int);
    callback pick_asc_file();
    callback pick_asc_folder(bool);
    callback rename_diagram(string);
    callback set_shape(string);
    callback delete_diagram();
    callback export_asc();
    callback save_metadata(string, string, string, string, string, string, string, bool, string, string, string, string, string);
    callback export_file(string);
    callback open_diagram_url(string);
    callback copy_text(string);
    callback copy_cutting_table();
    callback copy_cutting_row(int);
}
