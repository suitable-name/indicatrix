// The New Design template
// gallery's data -- pushed once at startup from
// `gui::editor::templates::setup_template_gallery`
// (`apps/indicatrix-cut/src/gui/editor/templates.rs`), which wraps
// `indicatrix_cut_core::templates::TEMPLATES`. See that Rust module's own doc
// comment for why only the first two entries are `ready` today.
export struct TemplateCardData {
    /// The template's display name -- also what `new_design_dialog.slint`
    /// writes into `EditorModel.new_template_index`'s matching selection
    /// (index 0 = "Empty", 1 = "Standard Round Brilliant", by position in this
    /// list -- see `templates.rs`'s own doc comment for the still-open
    /// integration step beyond that).
    name: string,
    /// A short shape/fold description shown under the name.
    shape: string,
    /// One sentence describing the design.
    description: string,
    /// Whether selecting this card and clicking Create actually seeds this
    /// template's tiers today. A not-ready card still shows its full
    /// description (so the gallery previews the whole built-in set), but
    /// `template_gallery.slint` disables selecting it, with a tooltip
    /// explaining why -- see that file's own doc comment.
    ready: bool,
}

export global TemplateGalleryModel {
    in property <[TemplateCardData]> templates: [];
}
