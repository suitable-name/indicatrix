import { WorkerItem } from "../types.slint";

// The one remote endpoint (a coordinator, rendering itself when started with
// `--render`) -- `RemoteWorkerDialog`'s "Remote coordinator" form, plus the "served by"
// indicator, the library switch and the pull-mirror state.
export global RemoteWorkerModel {
    // Whether a remote is configured; `endpoint` holds its settings (defaults when not).
    in property <bool> configured: false;
    in property <WorkerItem> endpoint;
    out property <bool> live_remote_available: root.configured;
    in-out property <bool> denoise_enabled: true;
    // How many pictures a catalogue preview or tilt batch keeps in flight on the remote
    // at once (`AppSettings::remote_batch_lanes`, 1..=32). The dialog's spin box edits it
    // in place; `remote_batch_lanes_changed` hands the new count to Rust to limit and
    // persist.
    in-out property <int> remote_batch_lanes: 4;
    in property <bool> testing_connection: false;
    in property <string> test_connection_result: "";
    in property <bool> test_connection_is_error: false;
    in property <bool> served_by_remote: false;
    in property <string> served_by_worker_name: "";

    // Which library is browsed: -1 = the local one, 0 = the remote endpoint's.
    in property <int> library_source_worker_index: -1;
    in property <string> library_source_label: "Local library";
    in property <bool> library_is_remote: false;

    in property <bool> mirror_in_progress: false;
    in property <float> mirror_progress_fraction: 0.0;
    in property <string> mirror_status_text: "";
    in property <bool> mirror_has_error: false;

    in property <bool> claiming_token: false;
    in property <string> claim_result_text: "";
    in property <bool> claim_result_is_error: false;
    in property <string> claimed_cert_dir: "";
    // Suggested render address after a successful claim: the enrollment host on the
    // server's default serve port (the dialog fills an empty Address field with it).
    in property <string> claimed_address: "";
    // The folder `pick_cert_dir` below picked, once its (off-UI-thread) dialog
    // completes. `pick_cert_dir` is a void callback rather than a
    // blocking-shaped, value-returning one, so `RemoteWorkerDialog`'s own
    // `changed picked_cert_dir` handler copies a non-empty value into
    // `form_cert_dir`, the same "one-shot property, not a running value" pattern
    // `claimed_cert_dir` above already uses.
    in property <string> picked_cert_dir: "";

    callback pick_cert_dir(string);
    callback denoise_toggled(bool);
    callback remote_batch_lanes_changed(int);
    // Address and certificate folder of the (possibly unsaved) form.
    callback test_worker_connection(string, string);
    callback save_remote(WorkerItem);
    callback remove_remote();
    // Name, enrollment address, token.
    callback claim_token(string, string, string);
    // -1 = local library, 0 = the remote endpoint's.
    callback switch_library_source(int);
    callback start_mirror_sync();
    callback cancel_mirror_sync();
}
