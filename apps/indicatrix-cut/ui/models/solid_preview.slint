// State for the Edit tab's solid-inspection viewport (`SolidViewportView`): a
// flat-shaded CPU render of the design's solid, independent of the GPU path tracer
// (`gui::solid_preview`). Rust reaches this via `ui.global::<SolidPreviewModel>()`.
export global SolidPreviewModel {
    in property <image> image;
    in property <bool> has_solid: false;
    in property <string> status: "";
    in-out property <int> view_mode: 0;
    // Sized by `gui::editor::view::refresh_viewport` to the rasterizer's actual
    // logical viewport size (not the render resolution); `SolidViewportView` pushes
    // these on every layout change since Slint has no built-in way to report a
    // widget's rendered size back to Rust.
    in-out property <length> viewport_width: 800px;
    in-out property <length> viewport_height: 600px;
    // The Live Render tab's OWN viewport size (`gem_viewport.slint`) -- a SEPARATE
    // pair of properties from `viewport_width`/`viewport_height` above. Keeping them
    // separate stops whichever viewport resizes last from silently overwriting the
    // other's pending redraw size (e.g. resizing the Live Render viewport
    // while the Edit tab is open would otherwise size the Edit tab's next redraw to
    // the Live tab's viewport, or vice versa). `render::camera_lighting::resubmit_at_current_pose`/
    // `resubmit_live_solid` read these for the Live tab, `viewport_width`/
    // `viewport_height` for the Edit tab.
    in-out property <length> live_viewport_width: 800px;
    in-out property <length> live_viewport_height: 600px;
    // Fired (debounced ~50ms, see `solid_viewport.slint`'s `resize_pulse`) after
    // `viewport_width`/`viewport_height` settle on a new value -- a resize/maximise
    // otherwise left the shown image rescaled and the pick buffer misaligned from
    // the cursor until the next orbit/zoom redraw. Handled in `gui::mod`'s
    // `build_main_window`, which calls `render::camera_lighting::
    // resubmit_at_current_pose` deferred by one event-loop turn (so it reads the
    // post-layout size), the same call `render_visibility.rs`'s tab-switch handler
    // already makes.
    callback viewport_resized();
    // `true` while the shown solid is the last SOLVED one, not the current
    // (edited-past-budget) design (`solid_preview::live_update::Freshness::Stale`).
    in property <bool> stale: false;
    // The "Both" view mode's transparent-fill/opaque-edges layer.
    in property <image> edges_image;
    in property <bool> has_solid_edges: false;
    // Whether `edges_image` was built from the SAME plane arrangement as
    // `ViewportModel.render_image` -- `solid_viewport.slint` only composites the
    // edges layer over the render when this holds, otherwise it dims the render
    // and explains why. Defaults to `true` so "Both" mode composites normally
    // until a real plane-generation comparison sets it otherwise. Set from `gui::mod`'s
    // `SlintSolidSink::apply` (a finished solid-preview frame) and from the path
    // tracer's own frame-push closure (also in `gui::mod::build_main_window`) --
    // see `planes_generations_match`'s doc comment for how the two sides agree.
    in property <bool> trace_matches_solid: true;
    // View mode 3 ("Diagram"): the GemCAD-style crown/pavilion/profile 2D facet
    // diagram (`gui::solid_preview::diagram2d`), plus its own hover text and picking
    // callbacks -- a separate pick buffer from the Solid rasterizer's, since the
    // diagram's pixel layout is entirely different (see `solid_viewport.slint`'s own
    // doc comment). Wired by `gui::solid_preview::diagram_wiring`.
    in property <image> diagram_image;
    in property <bool> has_diagram: false;
    in property <string> diagram_hover_text: "";
    callback diagram_facet_hover(length, length);
    callback diagram_facet_click(length, length);
    // The index wheel's own tooth pick buffer, threaded from the diagram
    // frame through `gui::solid_preview::preview_state`/`diagram_wiring` --
    // `diagram_facet_hover`/`diagram_facet_click` above now also check it
    // whenever the SAME `(x, y)` misses every facet (a wheel tick, not a facet
    // fill). `-1` means "nothing", exactly like `EditorModel.selected_tier_index`'s
    // own convention. A one-shot report of the last tooth actually clicked; only
    // the buffer is wired through here, see `diagram_wiring`'s own doc comment.
    // There is no `..._hovered_tooth` sibling: a hovered tooth's index is already
    // named in `diagram_hover_text` itself ("Index {t}", see
    // `diagram_wiring::setup_diagram_hover_and_click_callbacks`), so a separate
    // property for it would carry no information a reader of the tooltip text
    // doesn't already have.
    in property <int> diagram_clicked_tooth: -1;
    // Hover tooltip text and the picking callbacks driving it (`solid_viewport.slint`'s
    // `facet_hover`/`facet_click`/`hover_text`).
    in property <string> hover_text: "";
    callback facet_hover(length, length);
    callback facet_click(length, length);
    // Persists `view_mode` through the debounced settings writer
    // (`settings/persist.rs`'s `SettingsPersister::update`).
    callback view_mode_changed(int);
    changed view_mode => {
        view_mode_changed(view_mode);
        // The Diagram always shows the finished design: its facet numbers and tier
        // labels come from the whole design, so a truncated stone would not match them,
        // and it has no slider to show or undo the cut. Entering it puts the Cut slider
        // back to Finished (the rough is not restored on the way out).
        if (view_mode == 3 && tier_cutoff != -1) {
            tier_cutoff = -1;
            cut_position = cut_step_count;
            tier_cutoff_changed();
        }
    }

    // Whether the Solid view's rasterizer (`gui::solid_preview::raster`)
    // draws the rough's own bounding (preform) planes -- toggled by
    // `solid_viewport.slint`'s "Preform" pill. `true` (the default) keeps every
    // preform facet visible, tinted rather than invisible (see
    // `raster::SolidStyle::show_preform`'s own doc comment); `false` hides them
    // entirely so a cutter can see through the rough to the actual cut.
    //
    // Not implemented in this file: `gui::solid_preview::
    // preview_state`'s Solid-view style builder needs to read this and set
    // `SolidStyle::show_preform`/`preform_plane_count` (the latter from
    // `facet_map::FacetMap::preform_plane_count()`, already computed there)
    // accordingly -- see this crate's `raster.rs` for both fields.
    in-out property <bool> show_preform_planes: true;

    // Which diagram panel, if any, is shown enlarged (filling the
    // whole Diagram-mode image) instead of `solid_viewport.slint`'s ordinary
    // three-column layout. `-1` (the default) means "all three, side by side";
    // `0`/`1`/`2` mean Crown/Pavilion/Profile respectively, matching
    // `gui::solid_preview::diagram2d::PanelKind`'s own tag order.
    //
    // Not implemented in this file: `gui::solid_preview::
    // preview_state`'s `build_diagram_outputs` needs to read this and call
    // `diagram2d::render_diagram_single_panel(mesh, config, style, panel)`
    // instead of `diagram2d::render_diagram` whenever it is not `-1`; picking
    // is unaffected either way (`DiagramFrame::pick_at`/`panel_at` work
    // identically from either render function).
    in-out property <int> diagram_enlarged_panel: -1;
    // Setting `diagram_enlarged_panel` alone redraws nothing (the panel choice is
    // read by the plan worker, so a replan has to be requested). This callback is
    // raised by the `changed` handler just below on EVERY change, whichever path
    // made it -- a pill click, a double-click, Escape -- and `gui::editor`
    // (`gui::editor::setup::setup_tier_cutoff_callback`) turns it into that replan.
    callback diagram_enlarged_panel_changed();
    changed diagram_enlarged_panel => { diagram_enlarged_panel_changed(); }
    // A left double-click in Diagram mode at the unzoomed viewport coordinates (the
    // same space as `diagram_facet_click`): Rust resolves the panel under the pointer
    // and toggles `diagram_enlarged_panel`, like the web app does.
    callback diagram_double_click(length, length);

    // The Cut slider: how far through the cutting steps the stone is drawn, so a cutter
    // can see the rough after every tier. Slint has no `Option<int>`, so:
    // `-1` is the finished design, `-2` is the rough (the preform before any tier is
    // cut), and `n >= 0` is the stone after steps 0 to n (a planar design: "through
    // tier n"). Decoded by `gui::solid_preview::cut_slider::CutPosition`; read in
    // `gui::editor::view::submit_preview_replan` and handed to the plan worker, and by
    // every full redraw (background solve, refresh, optimise ghost) so they all draw the
    // same stone. New, Open and Load reset it to `-1`; so does entering Diagram mode.
    in-out property <int> tier_cutoff: -1;
    // The number of cutting steps (flat and concave tiers) of the loaded design: the
    // slider's last position is "Finished", this many steps in. Written by Rust
    // (`cut_slider::sync_model`) on every replan.
    in-out property <int> cut_step_count: 0;
    // The slider handle, 0 (Rough) to `cut_step_count` (Finished). Two-way bound to the
    // slider in `toolbar.slint` so Rust can move the handle (New/Open/Load put it back to
    // Finished), which a plain `value:` binding stops doing after the first drag.
    in-out property <float> cut_position: 0;
    // The slider's label for the current position: "Rough", "After <tier> (k of N)" or
    // "Finished". Written by Rust together with `tier_cutoff`, so label and view agree.
    in-out property <string> cut_label: "Finished";
    // Setting `tier_cutoff` alone changes nothing on screen: the preview only
    // redraws when something requests a replan, and a property write is not a
    // request. The slider fires this straight after writing the value, and
    // `gui::editor` turns it into one.
    callback tier_cutoff_changed();

    // Puts the Cut slider back on the finished design and asks for the replan, exactly as
    // dragging it to the far right does. Live Render's "Show finished" button calls this; it
    // does nothing when the stone is not cut.
    public function show_finished() {
        if (tier_cutoff != -1) {
            tier_cutoff = -1;
            cut_position = cut_step_count;
            tier_cutoff_changed();
        }
    }
}
