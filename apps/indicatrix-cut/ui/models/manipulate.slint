// State for the Solid viewport's direct-manipulation tools (`SolidViewportView`): the
// three drag handles (angle, depth, index) on the selected facet, the hint line under
// the toolbar, and the Snap pill. Rust reaches this via `ui.global::<ManipulateModel>()`
// (`gui::editor::manipulate`); the math behind it lives in `indicatrix_editor::manipulate`.
//
// Every position here is in the viewport's LOGICAL coordinates (the same space the
// pointer events use): Rust converts from the raster's pick frame with
// `logical = (pick + letterbox_margin) / scale_factor`.
//
// The Diagram view zooms and pans its picture inside `SolidViewportView`, which Rust does
// not see: there every position (the tips, and the pointer coordinates the callbacks
// below carry) is UNZOOMED -- where the point would be at zoom 1 and no pan -- and
// `ManipulateOverlay` maps the tips to the screen when it draws. `view_zoom` is the one
// number Rust needs from the zoom: a marker keeps its size on screen, so its hit radius
// in the unzoomed space shrinks as the picture zooms in.
export global ManipulateModel {
    // Whether the handle overlay is drawn and can be grabbed. Hidden by Rust when
    // nothing is selected, the design is not solved, the selected tier's centroid is off
    // screen, or (Diagram view) no panel offers a handle for the selected tier.
    in property <bool> handles_visible: false;
    // `false` when the Diagram panel the handles sit on offers no depth handle for the
    // facet (a table seen from above has nothing to push along). Always `true` in the 3D
    // views.
    in property <bool> depth_visible: true;
    // `false` for a tier with no index-wheel positions: turning nothing is
    // meaningless, so its index handle is neither drawn nor grabbable.
    in property <bool> index_visible: true;
    // `false` for a tier whose angle follows a relation (`P2 = P1 - 2`): its angle is set
    // by the tiers it follows, so its angle handle is neither drawn nor grabbable. The depth
    // and index handles stay.
    in property <bool> angle_visible: true;
    // The selected facet's centroid, where the three handles fan out from.
    in property <length> anchor_x;
    in property <length> anchor_y;
    // The tip of each handle.
    in property <length> angle_tip_x;
    in property <length> angle_tip_y;
    in property <length> depth_tip_x;
    in property <length> depth_tip_y;
    in property <length> index_tip_x;
    in property <length> index_tip_y;
    // The handle to draw bright and large: `-1` none, `0` angle, `1` depth, `2` index.
    // Rust keeps it on the dragged handle for the whole drag.
    in property <int> hovered_handle: -1;
    // `true` from a granted `drag_begin` until `drag_end`/`drag_cancel`. Rust writes
    // it; `solid_viewport.slint` reads it right after calling `drag_begin` to learn
    // whether the press grabbed a handle or was refused, and in the Escape handler.
    in-out property <bool> dragging: false;
    // The one-line hint under the toolbar; empty hides the strip.
    in property <string> hint_text: "";
    // The toolbar's Snap pill: `true` turns angle and depth snapping off (the index
    // handle always moves in whole teeth). Remembered in `AppSettings::manipulate_snap_off`
    // (Rust seeds it at start-up and saves it from `snap_toggled`); the Preferences dialog's
    // "Snap to gear steps" switch is the same setting, inverted.
    in-out property <bool> snap_off: false;
    // How much larger than normal the handle markers, strokes and hit areas are: `1.0`
    // normally, `1.6` with the "Larger handles" preference (touch screens and pens). Rust
    // writes it (`gui::preferences`) and multiplies the hit radius by the same factor.
    in property <float> handle_scale: 1.0;
    // The Diagram view's current zoom (`1.0` unzoomed), mirrored from `SolidViewportView`.
    // Slint writes it; Rust reads it for the handle hit radius.
    in-out property <float> view_zoom: 1.0;

    // Which handle tip, if any, lies under the pointer: `-1` none, `0` angle,
    // `1` depth, `2` index.
    callback handle_hit_test(length, length) -> int;
    // The pointer moved with no drag in progress: light the handle under it and show
    // what dragging it does.
    callback handle_hover(length, length);
    // A left press landed on handle `kind`. Rust sets `dragging` when it grants the
    // drag and leaves it `false` when it refuses (with an explanation in `hint_text`).
    callback drag_begin(int, length, length);
    // The pointer moved during a drag; the last argument is whether Shift is held
    // (fine snapping).
    callback drag_move(length, length, bool);
    // The button was released: keep the drag as one undo step.
    callback drag_end();
    // Escape (or a cancelled pointer): restore the design as it was at `drag_begin`.
    callback drag_cancel();
    // The Snap pill was toggled (`snap_off` already holds its new value).
    callback snap_toggled();

    // --- Slice mode: cut a new facet with a mouse line (`gui::editor::manipulate::slice`).
    // Lit while the Slice pill (or the S key) has the tool on. While it is on, a left
    // drag draws a line instead of orbiting, and the only handles shown are the
    // provisional tier's. Slint writes it (pill, S, Escape); Rust also clears it (Keep).
    in-out property <bool> slice_mode: false;
    // The rubber band while a line is being drawn, in the viewport's logical
    // coordinates (start -> end).
    in property <bool> slice_line_visible: false;
    in property <length> line_x0;
    in property <length> line_y0;
    in property <length> line_x1;
    in property <length> line_y1;
    // `true` while a provisional (not yet kept) slice tier exists: the hint bar then
    // offers Keep, Discard and Flip, and facet clicks select nothing.
    in property <bool> provisional_active: false;
    // The provisional tier's name ("C3"), for the Keep button.
    in property <string> provisional_label: "";
    // Whether a new facet gets the whole symmetric orbit of the snapped index (the
    // default) or a single index. Remembered in `AppSettings::slice_symmetric`; the Slice
    // mode itself is not (it changes what a left-drag does).
    in-out property <bool> slice_symmetric: true;

    // The Slice pill or S was used (`slice_mode` already holds its new value).
    callback slice_toggled();
    // A left press while `slice_mode` is on, and not on a handle, starts a line here.
    callback slice_begin(length, length);
    // The pointer moved while drawing the line.
    callback slice_move(length, length);
    // The release: snap the plane to the gear and show the provisional tier.
    callback slice_end(length, length);
    // Escape (or a cancelled pointer) while drawing: drop the line, change nothing.
    callback slice_cancel();
    // Cut the other side of the same line.
    callback slice_flip();
    // Commit the provisional tier as ONE undoable step.
    callback slice_keep();
    // Drop the provisional tier.
    callback slice_discard();
    // The Symmetric pill was toggled (`slice_symmetric` already holds its new value).
    callback slice_symmetric_toggled();
}
