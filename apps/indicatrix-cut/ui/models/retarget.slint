import { RetargetRowItem } from "../types.slint";

// "Retarget for material": reviews a `gui::editor::retarget::RetargetProposal` before
// applying it as one undoable `Edit::RetargetAngles`. `target_material_*` comes from
// the design settings panel's material combo, not necessarily `state.design.material`;
// `RetargetMode::Optimize` still runs synchronously on this first wiring pass
// (`gui::editor::callbacks::retarget_actions`).
export global RetargetModel {
    in-out property <bool> is_open: false;

    // Mode selector: 0 = Shift (deterministic, default), 1 = Optimize
    // (`optimize_design`-backed).
    in-out property <int> mode_index: 0;

    // Crown handling (`gui::editor::retarget::CrownShift`): a fraction (0.0..1.0) of
    // the pavilion's own critical-angle delta, OR (when `scale_crown_by_ratio` is on)
    // ignore the fraction and scale the raw crown angle by the two critical angles'
    // ratio instead. Disabled (not hidden) while `scale_crown_by_ratio` is on, so the
    // last fraction value survives toggling back off.
    in-out property <float> crown_fraction: 0.0;
    in-out property <bool> scale_crown_by_ratio: false;

    // The target material picker: owned by THIS dialog (not borrowed from the
    // design settings panel's own combo/RI-override fields any more -- see
    // `gui::editor::callbacks::retarget_actions`'s module doc comment). `open()`
    // seeds `target_material_index` from the design's own current material;
    // changing either fires `proposal_changed()` to rebuild against the new target.
    in-out property <int> target_material_index: 0;
    in-out property <string> target_ri_override_text: "";
    // The combo's own option list (built-ins, then custom catalogue materials, then
    // the trailing "Custom RI…" sentinel) -- pushed fresh by Rust every `open()`
    // since custom materials can change between dialog sessions.
    in property <[string]> material_options: [];

    // Target material readout (`ResolvedMaterial`, already resolved from the two
    // properties above) -- display only.
    in property <string> target_material_name: "";
    in property <string> target_material_ri: "";
    in property <string> target_critical_angle: "";
    // Item 183: `target_ri_override_text` failed to parse (not a number, or not a
    // valid refractive index) -- non-empty means the readout/rows above are stale
    // (frozen at whatever the last valid target was) and `rows`/`notes` were left
    // empty rather than silently rebuilt against the OLD material. Cleared the
    // moment the field parses again.
    in property <string> target_material_error: "";

    // The proposal itself: one row per pavilion/crown tier, plus the notes
    // `RetargetProposal::notes` carries. Rebuilt by Rust every time the mode/crown
    // controls change (a live re-proposal, not a stale snapshot from when the dialog
    // opened).
    in property <[RetargetRowItem]> rows: [];
    in property <[string]> notes: [];
    // Optimize mode's own refusal (`RetargetError::AnchoredTiers`), pre-formatted as
    // one line per anchored tier -- empty means either Shift mode (which never
    // refuses) or an Optimize proposal that built successfully.
    in property <[string]> anchored_tier_errors: [];
    // `RetargetError::Solve`'s message, or "" -- the OTHER way Optimize mode can fail
    // to produce a proposal at all.
    in property <string> solve_error: "";
    // Optimize mode's search is running, off the UI thread (see
    // `gui::editor::optimize_solve::spawn_optimize_solve`) -- the dialog stays
    // interactive while this is true; only the mode/crown/target controls and the
    // Apply button disable, and the footer's Cancel button switches to actually
    // cancelling the search instead of closing the dialog.
    in property <bool> is_busy: false;
    // Real running progress while `is_busy`, from `SearchHooks::on_progress` --
    // both `0` before the first tick arrives.
    in property <int> optimize_evaluations: 0;
    in property <int> optimize_max_evaluations: 0;

    // Opens the dialog and builds the first (Shift-mode) proposal.
    callback open();
    callback close();
    // The dialog's mode/crown/target controls changed -- rebuild the proposal.
    callback proposal_changed();
    // The footer's Cancel button, while `is_busy`: cancels the running Optimize
    // search (a real mid-search checkpoint, see `OptimizeSolveHandle::cancel`'s own
    // doc comment) without closing the dialog.
    callback cancel_optimize();
    callback apply();
}
