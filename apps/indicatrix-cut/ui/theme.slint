export global Theme {
    // Dark Theme Palette
    out property <color> bg-darkest: #0f1117;
    out property <color> bg-dark: #161922;
    out property <color> bg-card: #1c202c;
    out property <color> bg-card-hover: #252b3b;
    out property <color> bg-input: #12141c;
    out property <color> bg-elevated: #262c3d;

    // Borders & Dividers
    out property <color> border-subtle: #252b3b;
    out property <color> border-medium: #333b50;
    out property <color> border-accent: #3b82f6;

    // Accent & Highlights
    out property <color> primary: #3b82f6;
    out property <color> primary-hover: #60a5fa;
    out property <color> primary-glow: #3b82f633;
    out property <color> accent-cyan: #38bdf8;
    /// `accent-cyan`'s hovered state, mirroring `primary-hover` above -- named
    /// so `material_editor_dialog.slint`'s "Save & Apply" button uses the same
    /// token as the other colors on its line, rather than a bare hex literal.
    out property <color> accent-cyan-hover: #7dd3fc;
    /// The dark surface that carries `accent-cyan` content -- named so
    /// `header.slint`'s remote-library pill (paired with an `accent-cyan`
    /// border) and its "local" branch (`bg-elevated`) share a token for the
    /// same role instead of mixing a hex code and a token on one line.
    out property <color> accent-cyan-surface: #164e63;
    out property <color> accent-emerald: #10b981;
    out property <color> accent-amber: #f59e0b;
    out property <color> accent-ruby: #f43f5e;
    out property <color> accent-purple: #a855f7;
    /// `accent-amber` at low opacity, the same "-glow" convention `primary-glow`
    /// already established -- names the tier table's multi-selected-row
    /// highlight (`editor_tier_table.slint`) so it stays tied to `accent-amber`
    /// for a future palette change.
    out property <color> accent-amber-glow: #f59e0b33;

    // Text & Typography
    out property <color> text-primary: #f1f5f9;
    out property <color> text-secondary: #94a3b8;
    out property <color> text-muted: #64748b;
    out property <color> text-on-primary: #ffffff;
    /// Text that is present but not currently actionable -- a disabled label, or a
    /// chart's own axis tick labels, which must recede behind the plotted data.
    /// One step dimmer than `text-muted`. Same value as `border-control`, named
    /// separately because the two roles would not move together in a re-palette.
    /// Shared by `performance_graph_dialog.slint` (7 axis labels) and
    /// `settings_dialog.slint` (a disabled override label).
    out property <color> text-disabled: #475569;
    /// Dark text/icon color for content sitting directly on an `accent-amber`
    /// fill (a toggle button's own "on" state, e.g. `header.slint`'s Filters
    /// button) -- the amber-background counterpart to `text-on-primary`,
    /// naming the role so it stays tied together across every call site.
    out property <color> text-on-amber: #0f172a;

    /// Ink drawn on a LIGHT or saturated fill -- the counterpart to
    /// `text-on-primary` (white, for dark saturated fills) and the general form of
    /// `text-on-amber` (which stays as-is for its existing amber call sites).
    /// Names the role shared by `material_editor_dialog.slint`'s light "Clear"
    /// swatch label and the check icon + label on its accent-cyan "Save & Apply"
    /// button.
    out property <color> text-on-accent: #0f172a;

    // Control surfaces inside a dialog. Distinct from the
    // `bg-*` scale above, which describes the main window's panels: a dialog sits
    // on its own `surface-dialog` card and its controls need their own steps
    // against that, which is why these values never matched a `bg-*` token.
    /// A field, hairline divider, or hovered secondary button inside a dialog --
    /// one step ABOVE the dialog card. Shared by eight call sites in
    /// `material_editor_dialog.slint` alone.
    out property <color> surface-raised: #1e293b;
    /// A recessed secondary-button or chip-row background -- one step BELOW the
    /// dialog card. Same value as `text-on-accent` above, deliberately named
    /// separately because the roles are unrelated.
    out property <color> surface-sunken: #0f172a;
    /// A small square control (a dialog's own close button) at rest.
    out property <color> surface-control: #1a202c;
    /// ...and hovered.
    out property <color> surface-control-hover: #2d3748;
    /// A disabled button's flat fill. Same value as `border-dialog`, named
    /// separately for the same reason as the pair above: a fill is not a border,
    /// and a future palette change would almost certainly move one without the
    /// other.
    out property <color> surface-disabled: #334155;

    /// A selected list row's fill, matching `diagram_list.slint`'s ternary whose
    /// other two branches are already `bg-card-hover`/`bg-input`. Deliberately
    /// NOT shared with `header.slint`'s logo mark, which happens to use the
    /// same value for an unrelated, brand reason -- a palette change should
    /// move one without the other.
    out property <color> surface-selected: #1e3a8a;
    /// An informational banner's fill (the catalogue's "showing N just-imported
    /// designs" strip).
    out property <color> surface-info: #1e3a5f;
    /// A warning banner's fill -- the dark amber counterpart to `accent-amber`
    /// content, as `surface-info` is to a blue one.
    out property <color> surface-warning: #422006;

    // Radii
    out property <length> radius-sm: 4px;
    out property <length> radius-md: 8px;
    out property <length> radius-lg: 12px;

    // Overlay & Modal Surfaces -- every dialog card in this app
    // (`new_design_dialog.slint`, `retarget_dialog.slint`, `material_editor_dialog.slint`,
    // `metadata_editor_dialog.slint`, `confirm_action_dialog.slint`) uses these
    // exact four literals for its backdrop/card/border/shadow -- named here so the
    // convention is explicit and a future dialog (or a future palette change) doesn't
    // have to rediscover it by copying another file's hex codes.
    /// The full-viewport semi-transparent backdrop shown behind every modal dialog.
    out property <color> overlay-backdrop: #00000088;
    /// A modal dialog card's own background, distinct from `bg-elevated` (used for
    /// smaller in-panel popups like the Log popup rather than full dialogs).
    out property <color> surface-dialog: #11151f;
    /// A modal dialog card's own border color.
    out property <color> border-dialog: #334155;
    /// A checkbox, toggle or similar small control's border at rest, i.e. while
    /// unchecked -- one step brighter than `border-dialog` so the control reads as
    /// interactive against the card it sits on. Shared by five dialogs
    /// (`retarget_dialog`, `export_dialog`, `material_editor_dialog`,
    /// `performance_graph_dialog`, `settings_dialog`), always opposite an
    /// `accent-cyan` checked state.
    out property <color> border-control: #475569;
    /// The drop-shadow color under a floating modal dialog card.
    out property <color> modal-shadow: #000000bb;
    /// A small floating popup's own translucent card background -- distinct from
    /// the opaque `surface-dialog` (a full modal dialog card): names the role
    /// for `editor_status_strip.slint`'s "Details" popup. `border-dialog`/
    /// `modal-shadow` above already fit that same popup's border/shadow exactly
    /// (it independently uses the identical literals), so only the background
    /// needed a new name rather than reusing one of the four above.
    out property <color> popup-surface: #111827ee;

    // Semantic state, distinct from the decorative `accent-*` colors above (which
    // this codebase also reuses for non-status purposes, e.g. chart curves).
    /// Danger/error/destructive-action color -- already the de facto shade for this
    /// (toast error icon, Retarget's solve-error text, Material Editor's Delete
    /// button) before this token existed to name it.
    out property <color> danger: #f87171;
    /// A destructive button's own flat fill at rest, and hovered -- the dark-red
    /// surfaces that carry `danger` text/icons. Shared by the Material Editor's
    /// Delete button and the Filters panel's remove-row button, tying the two
    /// files to the same role.
    out property <color> danger-surface: #1f1111;
    out property <color> danger-surface-hover: #450a0a;
    /// A destructive button's border.
    out property <color> danger-border: #7f1d1d;
    /// Success/confirmation color -- the `danger` counterpart, and like `danger` a
    /// lighter shade than the `accent-emerald` it derives from, so it reads as ink
    /// or an icon on a dark surface rather than as a fill. Used by the toast's
    /// success icon, alongside `danger`/`accent-amber`/`accent-cyan` on the same
    /// line.
    out property <color> success: #34d399;

    // Toast backgrounds. Translucent by design -- a toast floats over live content
    // and must not hide it -- which is why these are their own tokens rather than
    // the opaque `*-surface` colors above. Named for `toast.slint`, the last
    // component in `ui/` to get tokens for its own colors.
    /// The success toast's translucent card fill.
    out property <color> toast-success-surface: #064e3bcc;
    /// The error toast's translucent card fill.
    out property <color> toast-error-surface: #7f1d1dcc;
    /// The warning toast's translucent card fill.
    out property <color> toast-warning-surface: #78350fcc;
    /// The neutral/info toast's translucent card fill.
    out property <color> toast-info-surface: #0f172acc;
    /// The drop-shadow under a toast -- lighter than `modal-shadow`, since a toast
    /// sits closer to the content than a modal dialog card does.
    out property <color> toast-shadow: #000000aa;
    /// A hover fill for a control that has no surface of its own and must tint
    /// whatever it floats over -- the toast's close button. Deliberately white at
    /// low alpha rather than a named surface, so it works on all four toast fills.
    out property <color> overlay-hover: #ffffff22;
}
